ices.length > 0){\n            this.selectedDevices.forEach((device)=>{\n                let result = this.dataService.getAllDevices().find((_device)=> device.value == _device.id);\n\n                if(result){\n                    this.equipment.devices.push(result);\n                }\n            })\n        }\n\n        this.subsNewEquipment = this.equipmentService.saveNewEquipment(this.equipment).subscribe((result: any) => { \n            this.notificationService.printSuccessMessage(this.translateJsonService.getTranslateSubs('EQUIPMENTS.success_new_equipment'));\n            this.router.navigate(['/pages/configs/equipment/reload']);\n        },\n        error => {\n           this.notificationService.printErrorMessage(error.message);   \n        });\n    }\n\n    // Volta para a Página com Todos Equipamentos\n    public backEquipment(){\n        this.router.navigate(['/pages/configs/equipment']); \n    }\n\n    // Abre modal para criar novo Dispositivo\n    public openNewDevice(){\n        this.actionModal.show();\n    }\n\n    // Fecha modal para criar novo Dispositivo\n    public hideChildModal(){\n        this.actionModal.hide();\n    }\n\n    /**\n     * Loading Bar \n     */\n    public initLoading(delayMs: number): void {\n        let that: any = this;\n        setTimeout(function(): void {\n                that.loadingAnimateService.setValue(true);\n        }, delayMs);\n    }\n  \n    public stopLoading(tempoLimiteMs: number): void {\n        let that: any = this;\n        setTimeout(function(): void {\n          that.loadingAnimateService.setValue(false);      \n        }, tempoLimiteMs);\n    }\n\n    deleteEquipment(id: number){\n        console.log(id);\n        this.equipmentService.deleteEquipment(id).then(result => {\n            this.notificationService.printSuccessMessage(result);\n            this.router.navigate(['/pages/configs/equipment/reload']);\n        }).catch(err => {\n            this.notificationService.printErrorMessage(err);\n   