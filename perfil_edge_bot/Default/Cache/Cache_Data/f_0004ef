larms: AlarmDto[] = [];\n  public selectedDevice: string;\n  public selectedAssetId: number;\n  public alertModalState: AlertModalState = AlertModalState.LOADING;\n  public pendingData: boolean = false;\n  public selectedLastAlarm: AlarmDto;\n  public displayAlert: boolean = false;\n  public showCollapseButton: boolean = false\n  public upperContainerHeight: number = 0;\n  public allAlarms: AlarmWithDetails[] = []; \n  public displayTable: boolean = false;\n  public reportIsLoading: boolean = false;\n  public isEquipmentDetailsLoading: boolean = false;\n  \n  public equipmentWithDetails: Equipament;\n  public equipmentDetailsTable: { label: string, value: string }[] = [];\n  \n  public lastDmsAlarm: AlarmWithDetails;\n  public lastValidDmsAlarm: AlarmWithDetails;\n  public lastAdasAlarm: AlarmWithDetails;\n  public lastValidAdasAlarm: AlarmWithDetails;\n  public lastTelemetry: any;\n  public lastHeartbeat: any;\n\n  public ticket: Ticket;\n\n  public selectedReport;\n  public reportOptions: any[] = [\n    { label: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.alarm_report\"), value: 10 }\n  ];\n\n  constructor(\n    private assetService: AssetService,\n    private userService: UserService,\n    private checkDeviceService: CheckDeviceService,\n    public translateJsonService: TranslateJsonService,\n    private notificationService: NotificationUtilService,\n    private deviceHealthService: DeviceHealthService,\n    private telemetryService: TelemetryService,\n    private heartbeatService: HeartbeatService,\n    private ticketService: TicketService,\n    private dataService: DataService\n  ) { \n    this.dataService.havePermission('HEALTH', 'CONFIGURACOES');\n  }\n\n  ngOnInit(): void {\n    this.upperContainerHeight = 60 * window.innerHeight / 100;\n    this.isEquipmentDetailsLoading = true;\n  }\n\n  async refreshRankingData(event) {\n    this.isEquipmentDetailsLoading = true;\n    this.showCollapseButton = true;\n    this.pendingData = true;\n    this.filterSelectedData = event;\n    this.showDeviceInfo = true;\n    this.displayTable = false;\n    this.selectedReport = null;\n    this.isCollapsed = false;\n\n    this.selectedDevice = this.filterSelectedData.selectedImei;\n    \n    this.selectedAssetId = this.filterSelectedData.selectedVehicles[0];\n\n    this.fillDetails();\n\n    await this.verifyDeviceStatus(this.selectedAssetId);\n\n    await this.getDeviceLastAlarmsNoFilter();\n  }\n  \n\n  toggleCollapse() {\n    this.isCollapsed = !this.isCollapsed;\n  }\n  \n\n  private async verifyDeviceStatus(assetId: number): Promise<void> {\n    try {\n      const res: Asset = await this.assetService.checkOnlineStatusByAssetId(assetId, this.selectedDevice).toPromise();\n      this.isDeviceOnline = res.isOnline;\n    } catch (error) {\n      console.error('Error checking device status:', error);\n    }\n  }\n\n  public async getDeviceLastAlarmsNoFilter() {\n    this.lastDeviceAlarms = [];\n    this.alertModalState = AlertModalState.LOADING;\n    let lastDeviceAlarms = await this.checkDeviceService.getDeviceLastAlarms(this.selectedDevice, this.selectedAssetId, 10);\n    lastDeviceAlarms = lastDeviceAlarms.filter(alarm => alarm.typeAlarm !== 0);\n    lastDeviceAlarms.forEach((alarm) => {\n        if (alarm.datetime && alarm.timeZone) {\n            alarm.datetime = this.dataService.convertToAlarmTimezone(alarm.datetime.toString(), alarm.timeZone);\n        }\n        alarm['_timezoneDifferent'] = this.dataService.isTimezoneDifferent(alarm.timeZone || \"-3:00\");\n        this.lastDeviceAlarms.push(alarm);\n    });\n    if (this.lastDeviceAlarms.length > 0) {\n        this.alertModalState = AlertModalState.LOADED;\n    } else {\n        this.alertModalState = AlertModalState.NO_DATA_AVAILABLE;\n    }\n  }\n\n\n  public async fillDetails() {\n    this.equipmentWithDetails = null;\n    this.equipmentDetailsTable = [];\n    this.allAlarms = [];\n  \n    try {\n\n      const equipmentPromise = this.deviceHealthService.getEquipmentByImei(this.selectedDevice);\n      const alarmsPromise = this.deviceHealthService.getAllAlarmsByImeiAndAssetId(this.selectedDevice, this.selectedAssetId);\n      const telemetryPromise = this.telemetryService.getCurrentPositionsByDeviceIdList([this.selectedDevice]);\n      await this.getLastTicket(this.selectedAssetId);\n\n      this.heartbeatService.getLastHeartbeatByImeis([this.selectedDevice]).subscribe((res: Heartbeat[]) => {\n        this.lastHeartbeat = res[0];\n      });\n\n      this.allAlarms = await alarmsPromise;\n      this.equipmentWithDetails = (await equipmentPromise)[0];\n      this.lastTelemetry = await telemetryPromise;\n\n      this.lastDmsAlarm = this.allAlarms.find(alarm => AlarmTypeSourceMap[alarm.typeAlarm] === AlarmSourceEnum.DMS);\n      this.lastValidDmsAlarm = this.allAlarms.find(alarm => AlarmTypeSourceMap[alarm.typeAlarm] === AlarmSourceEnum.DMS && alarm.visibleInSafety);\n      this.lastAdasAlarm = this.allAlarms.find(alarm => AlarmTypeSourceMap[alarm.typeAlarm] === AlarmSourceEnum.ADAS);\n      this.lastValidAdasAlarm = this.allAlarms.find(alarm => AlarmTypeSourceMap[alarm.typeAlarm] === AlarmSourceEnum.ADAS && alarm.visibleInSafety);\n      \n      this.populateEquipmentDetailsTable();\n    } catch (error) {\n      console.error('Error fetching equipment or alarms:', error);\n      this.isEquipmentDetailsLoading = false;\n    }\n  }\n\n  private populateEquipmentDetailsTable() {\n    \n    if (!this.equipmentWithDetails) {\n      return;\n    }\n    this.isEquipmentDetailsLoading = false;\n    this.equipmentDetailsTable.push({ label: 'IMEI', value: this.equipmentWithDetails.identification });\n    this.equipmentDetailsTable.push({ label: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.equipment_status\"), value: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.asset_status_\" + this.equipmentWithDetails.status.toString())});\n    this.equipmentDetailsTable.push({ label: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.vehicle\"), value: this.equipmentWithDetails.assetName });\n    this.equipmentDetailsTable.push({ label: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.vehicle_status\"), value: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.asset_status_\" + this.equipmentWithDetails.assetStatus.toString())});\n    this.equipmentDetailsTable.push({ label: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.registration_date\"), value: this.translateJsonService.transformDataFormat(this.equipmentWithDetails.createdAt)});\n    this.equipmentDetailsTable.push({ label: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.dealer_name\"), value: this.equipmentWithDetails.dealerName });\n    this.equipmentDetailsTable.push({ label: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.customer_profile_name\"), value: this.equipmentWithDetails.customerName });\n    this.equipmentDetailsTable.push({ label: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.customer_child_name\"), value: this.equipmentWithDetails.customerName });\n    this.equipmentDetailsTable.push({ label: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.equipment_type\"), value: this.equipmentWithDetails.equipmentTypeName });\n    this.equipmentDetailsTable.push({ label: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.last_instalation\"), value: this.translateJsonService.transformDataFormat(this.equipmentWithDetails.lastInstallationDate)});\n    this.equipmentDetailsTable.push({ label: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.last_uninstallation\"), value: this.translateJsonService.transformDataFormat(this.equipmentWithDetails.lastUninstallationDate)});\n  }\n  \n   showAlarmReport() {\n    if (!this.selectedReport) {\n      return;\n    } \n     if (this.allAlarms.length > 0) {\n      this.reportIsLoading = true;\n      this.displayTable = true;\n      this.reportIsLoading = false;\n      this.scrollToReportSection();\n     } else {\n      this.deviceHealthService.getAllAlarmsByImeiAndAssetId(this.filterSelectedData.selectedImei, this.selectedAssetId)\n         .then((alarms: AlarmWithDetails[]) => {\n           this.allAlarms = alarms;\n           this.reportIsLoading = false;\n           this.displayTable = true;\n           this.scrollToReportSection();\n         })\n         .catch(error => {\n           console.error('Error fetching alarms:', error);\n           this.reportIsLoading = false;\n         }\n        );\n     }\n   }\n\n   public showAlarmVideoModal(alarm: AlarmDto) {\n    this.selectedLastAlarm = { ...alarm }; \n    if (alarm.filter) {\n        this.selectedLastAlarm.filter = this.translateJsonService.getTranslateSubs(`DEVICE-HEALTH.filter_${alarm.filter.toLowerCase()}`);\n    }\n    this.displayAlert = true;\n  }\n\n  onModalClose() {\n    this.displayAlert = false;\n  }\n\n  async dataRead()\n  {\n    this.pendingData = false;\n  }\n\n  scrollToReportSection() {\n    setTimeout(() => {\n      this.reportSection.nativeElement.scrollIntoView({ behavior: 'smooth' });\n    }, 0);\n  }\n\n  private async getLastTicket(vehicleId: number){\n    \n    const openedTicketStatusList= [     \n      TicketStatus.OPEN,\n      TicketStatus.SCHEDULE,\n      TicketStatus.AWAITING_CUSTOMER,\n      TicketStatus.REMOTE_PROCEDURE,\n      TicketStatus.WAITING_FOR_CREATE\n    ]\n    let vehicleIdList: number[] = [vehicleId]\n    this.ticketService.getTickets(vehicleIdList, openedTicketStatusList).then(\n      ticketList=>{\n        this.ticket = ticketList[0].ticketUrl ? ticketList[0] : null;\n      }\n    ).catch(()=>{\n      this.ticket = null;\n    })\n  \n  }\n\n  getTimezoneTooltip(alarm: any, date: Date): string {\n    if (!alarm || !alarm['_timezoneDifferent'] || !date) {\n      return null;\n    }\n    const originalTime = this.dataService.formatDateInAlarmTimezone(date, alarm.timeZone);\n    const normalizedTimezone = this.dataService.normalizeTimezone(alarm.timeZone || '-03:00');\n    const label = this.translateJsonService.getTranslateSubs('GLOBAL.date_time_local');\n    return `${label}: ${originalTime} (${normalizedTimezone})`;\n  }\n  \n}\n","import { Injectable } from \"@angular/core\";\nimport { HttpClient, HttpHeaders, HttpErrorResponse } from \"@angular/common/http\";\nimport { ConfigService } from \"app/@core/config/config.service\";\nimport { AlarmWithDetails } from \"app/@core/models/alarmWithDetails\";\nimport { environment } from \"environments/environment\";\nimport { AuthenticationService } from \"app/pages/login/authentication.service\";\nimport { Equipament } from \"app/@core/models\";\n\n@Injectable({\n    providedIn: \"root\",\n})\nexport class DeviceHealthService {\n    constructor(\n        private httpClient: HttpClient,\n        private configService: ConfigService,\n        private auth: AuthenticationService \n    ) {}\n\n    public getAllAlarmsByImeiAndAssetId(imei: string, assetId: number): Promise<AlarmWithDetails[]> {\n        const _ws = this.configService.webServicesV2[\"getAllAlarmsByImeiAndAssetId\"];\n        const url = _ws.url(environment.urlApi, imei, assetId);\n        const headers = this.getHttpHeaders();\n\n        return new Promise<AlarmWithDetails[]>((resolve, reject) => {\n            this.httpClient.get<AlarmWithDetails[]>(url, { headers })\n                .subscribe(\n                    (response: AlarmWithDetails[]) => {\n                        const normalized = (response || []).map(item => this.normalizeAlarmKeys(item));\n                        const filteredResponse = this.AlarmTypeFilter(normalized);\n                        resolve(filteredResponse);\n                    },\n                    (error: HttpErrorResponse) => {\n                        reject(this.handleError(error));\n                    }\n                );\n        });\n    }\n\n    public getEquipmentByImei(imei: string): Promise<Equipament> {\n        const _ws = this.configService.webServices[\"equipmentsByDeviceIds\"];\n        const url = _ws.url(environment.urlApi, imei);\n        console.log(url)\n        const headers = this.getHttpHeaders();\n\n        return new Promise<Equipament>((resolve, reject) => {\n            this.httpClient.get<Equipament>(url, { headers })\n                .subscribe(\n                    (response: Equipament) => {\n                        resolve(response);\n                    },\n                    (error: HttpErrorResponse) => {\n                        reject(this.handleError(error));\n                    }\n                );\n        });\n    }\n\n    private handleError(error: HttpErrorResponse): string {\n        let errorMessage = 'An unknown error occurred!';\n        if (error.error instanceof ErrorEvent) {\n            errorMessage = `A client-side error occurred: ${error.error.message}`;\n        } else {\n            errorMessage = `Backend returned code ${error.status}, body was: ${error.error}`;\n        }\n        console.error(errorMessage);\n        return errorMessage;\n    }\n\n    private getHttpHeaders(): HttpHeaders {\n        let headers = new HttpHeaders()\n            .set(\"Content-Type\", \"application/json\");\n\n        const authToken = this.auth.getToken();\n        if (authToken) {\n            headers = headers.set(\"Authorization\", authToken);\n        }\n\n        return headers;\n    }\n\n\n    private AlarmTypeFilter(data: AlarmWithDetails[]): AlarmWithDetails[] {\n        return data.filter(item => item.typeAlarm !== 0);\n    }\n\n    private normalizeAlarmKeys(raw: any): AlarmWithDetails {\n        const item = { ...raw };\n        const snakeToCamel: [string, string][] = [\n            ['inserted_on', 'insertedOn'],\n            ['available_media_at', 'availableMediaAt'],\n            ['vehicle_plates', 'vehiclePlates'],\n            ['vehicle_prefix', 'vehiclePrefix'],\n            ['customer_child_id', 'customerChildId'],\n            ['customer_child_name', 'customerChildName'],\n            ['customer_profile_id', 'customerProfileId'],\n            ['customer_profile_name', 'customerProfileName'],\n            ['type_alarm', 'typeAlarm'],\n            ['asset_id', 'assetId'],\n            ['filter_id', 'filterId'],\n            ['risk_rating', 'riskRating'],\n            ['visible_in_safety', 'visibleInSafety'],\n            ['url_movie', 'urlMovie'],\n            ['url_picture', 'urlPicture'],\n            ['time_zone', 'timeZone']\n        ];\n        for (const [snake, camel] of snakeToCamel) {\n            if (item[snake] !== undefined && item[camel] === undefined) {\n                item[camel] = item[snake];\n            }\n        }\n        return item as AlarmWithDetails;\n    }\n}\n"],"sourceRoot":""}