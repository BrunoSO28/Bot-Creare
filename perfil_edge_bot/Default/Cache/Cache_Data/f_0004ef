rt { NotificationUtilService } from 'app/@core/utils/notification.util.service';\nimport * as moment from 'moment';\nimport { ModalDirective } from 'ngx-bootstrap/modal';\nimport { MenuItem, SortEvent } from 'primeng/api';\nimport { Subject, Subscription } from 'rxjs';\nimport { DataService } from '../../../@core/data/data.service';\nimport { DeviceService } from '../../../@core/data/device.service';\nimport { EquipmentService } from '../../../@core/data/equipment.service';\nimport { HeartbeatService } from '../../../@core/data/heartbeat.service';\nimport { EquipamentType } from '../../../@core/enum/equipament.type.enum';\nimport { Device, FilterAlarms } from '../../../@core/models';\nimport { Equipament } from '../../../@core/models/equipament.entity';\nimport { Heartbeat } from '../../../@core/models/heartbeat.entity';\nimport { customerChildsPermissions, Workspace } from '../../../@core/models/workspace.data.entity';\nimport { LoadingAnimateService } from '../../../@theme/components/ngxLoading/ngx-loading-animate.service';\nimport { TelemetryService } from 'app/pages/ui-alarms/telemetry/telemetry.service';\nimport { TelemetryPositionsModel } from 'app/pages/ui-alarms/telemetry/models/telemetry-positions.model';\n\n@Component({\n    selector: 'ngx-equipment',\n    styleUrls: ['./equipment.component.scss'],\n    templateUrl: './equipment.component.html',\n})\n\nexport class EquipmentComponent implements OnInit {\n    @ViewChild('reportHeartbeat') reportHeartbeat: ModalDirective;\n    @ViewChild('tableHeartbeat') tableHeartbeat: ElementRef;\n\n    private ngUnsubscribe: Subject<Subscription> = new Subject();\n    private subsEquipService: Subscription;\n    private subsDeviceService: Subscription;\n    private subsCustomerProfile: Subscription;\n\n    public equipmentType = EquipamentType;\n    public equipmentStatus = EquipmentStatus;\n    public items: MenuItem[];\n    public allEquipments: Equipament[];\n    public selectedEquipment: Equipament;\n    public tableHeader = [];\n    public filterSelectedData: FilterAlarms;\n\n    public isDownloading: boolean = false;\n    public progressPercentage: number = 0;\n\n    private subsworkspace: Subscription;\n\n    isUserCreare: boolean = false;\n    loadedEquipments: boolean = false;\n    loadedCustomersProfile: boolean = false;\n    loadedCustomersChild: boolean = false;\n    loadedDevices: boolean = false;\n    loadingLastHeartbeat: boolean = false;\n\n    customerProfileList: TreeInputModel[] = [];\n    customerChildList: TreeInputModel[] = [];\n    selectedCustomers: number[] = [];\n    selectedCustomersChild: number[] = [];\n    defaultTimeZone: string = \"-03:00\";\n\n    findedDevicesImeis: Device[] = [];\n    heartbeatReport: any[] = [];\n    exportReport;\n\n    constructor(\n        private router: Router,\n        private equipmentService: EquipmentService,\n        private deviceService: DeviceService,\n        private dataService: DataService,\n        private heartbeatService : HeartbeatService,\n        private loadingAnimateService: LoadingAnimateService,\n        public translateJsonService: TranslateJsonService,\n        private customerService: CustomerService,\n        private notificationService: NotificationUtilService,\n        private exportFilesService: ExportFilesService,\n        private alarmService: AlarmService,\n        private telemetryService: TelemetryService\n    ){\n        this.dataService.havePermission('EQUIPMENTS', 'CONFIGURACOES');\n    }\n\n    ngOnInit(){\n        this.loadUserWorkspace();\n\n        // Monta Header Tabela\n        this.tableHeader = [\n            { field: 'id', header: '#' },\n            { field: 'identification', header: this.translateJsonService.getTranslateSubs('EQUIPMENTS.identification')},\n            { field: 'assetIdentificationAndName', header: this.translateJsonService.getTranslateSubs('EQUIPMENTS.asset_plate_prefix')},\n            { field: 'customerName', header: this.translateJsonService.getTranslateSubs('EQUIPMENTS.name') },\n            { field: 'customerChildName', header: this.translateJsonService.getTranslateSubs('GLOBAL.customers_child')},\n            { field: 'equipmentTypeName', header: this.translateJsonService.getTranslateSubs('GLOBAL.type')},\n        ]\n\n        if(this.router.url.endsWith('/reload')){\n            this.initLoading(0);\n            //this.loadEquipments();\n        }\n    }\n\n    ngOnDestroy(){\n        if(this.subsEquipService) this.subsEquipService.unsubscribe();\n        if(this.subsDeviceService) this.subsDeviceService.unsubscribe();\n        if(this.subsworkspace) this.subsworkspace.unsubscribe();\n        if(this.subsCustomerProfile) this.subsCustomerProfile.unsubscribe();\n    }\n\n    // Navegar para página de cadastro de Equipamentos\n    public createEquipment(){\n        this.router.navigate(['/pages/configs/equipment/new']);\n    }\n\n    // Navegar para página de edição\n    public onEquipmentSelect($event){\n        this.router.navigate(['/pages/configs/equipment/'+$event.data.id+'/edit']);\n    }\n\n    // Carrega o Workspace, caso não exista, Cria\n    public loadUserWorkspace(): void {\n        this.initLoading(0);\n        if (!this.dataService.getWorkspace() || !this.dataService.getWorkspace().currentUserId) {\n           this.router.navigateByUrl('/pages/ui-alarms/fatigue');\n        } else {\n            this.isUserCreare = this.dataService.verifyIsCreareUser();\n\n            if(!this.isUserCreare){\n                let kp: Workspace = this.dataService.getWorkspace();\n                let selectedCustomers = kp.userCustomerChildIds.map((customer : customerChildsPermissions) => customer.customer);\n\n                this.loadEquipments(selectedCustomers);\n            }else{\n                this.loadCustomersProfile();\n            }\n\n            this.stopLoading(1000);\n        }\n    }\n\n    // Carregar Equipamentos\n    public loadEquipments(selectedCustomersChild : number[]){\n        this.selectedCustomersChild = selectedCustomersChild;\n        this.allEquipments = [];\n        this.findedDevicesImeis = [];\n        this.dataService.clearEquipments();\n        this.loadedDevices = false;\n        this.loadedEquipments = false;\n\n        if(selectedCustomersChild.length > 0){\n            this.subsEquipService = this.equipmentService.getAllEquipmentsByCustomersChildV2(selectedCustomersChild).subscribe((equipments)=>{\n                this.dataService.registerEquipments(equipments);\n                this.allEquipments = this.dataService.getAllEquipments();\n                this.allEquipments.forEach((equipment) => equipment.assetIdentificationAndName = `${equipment.assetIdentification} / ${equipment.assetName}`)\n                this.loadedEquipments = true;\n                this.loadedDevices = true;\n            });\n        }\n    }\n\n    /**\n     * Busca os Devices referentes a cada Equipamento listado\n     * @param equipments Id de todos equipamentos listados\n     */\n    public loadDevices(equipments : number[]){\n        this.loadedDevices = false;\n        this.deviceService.getDevicesByManyEquipmentsAndStatus(equipments, 1).subscribe((devices) => {\n            this.dataService.registerDevices(devices);\n\n            this.allEquipments.forEach((equip)=>{\n                equip.devices = devices.filter(device => device.equipment == equip.id);\n                let _device: Device = devices.find(device => device.equipment == equip.id);\n                if(_device){\n                    equip.deviceImei = _device.identification;\n                }\n                this.loadedDevices = true;\n            });\n\n            this.findedDevicesImeis = devices;\n            //this.loadHeartBeat(devices.map((device) => device.identification));\n        })\n    }\n\n    /**\n     * Método utilizado pelo componente de table Primeng\n     * @param event Evento do click\n     */\n    public customSort(event: SortEvent) {\n        event.data.sort((data1, data2) => {\n            let value1 = data1[event.field];\n            let value2 = data2[event.field];\n            let result = null;\n\n            if (value1 == null && value2 != null)\n                result = -1;\n            else if (value1 != null && value2 == null)\n                result = 1;\n            else if (value1 == null && value2 == null)\n                result = 0;\n            else if (typeof value1 === 'string' && typeof value2 === 'string')\n                result = value1.localeCompare(value2);\n            else\n                result = (value1 < value2) ? -1 : (value1 > value2) ? 1 : 0;\n\n            return (event.order * result);\n        });\n    }\n\n    /**\n     * Loading Bar Services\n     */\n    public initLoading(delayMs: number): void {\n        let that: any = this;\n        setTimeout(function(): void {\n                that.loadingAnimateService.setValue(true);\n        }, delayMs);\n    }\n\n    public stopLoading(tempoLimiteMs: number): void {\n        let that: any = this;\n        setTimeout(function(): void {\n          that.loadingAnimateService.setValue(false);\n        }, tempoLimiteMs);\n    }\n\n    /**\n     * Carrega uma lista de Empresas para o combo TreeInput\n     * */\n    loadCustomersProfile() {\n        this.subsCustomerProfile = this.customerService.getCustomerProfiles().subscribe((result) => {\n            result.forEach((cusProf : CustomerProfile) => {\n                this.customerProfileList.push({id: cusProf.id, name: cusProf.name, parentId: null});\n            })\n            this.loadedCustomersProfile = true;\n        });\n    }\n\n    // Carrega uma lista de Filiais a partir de uma Empresa\n    loadCustomerChilds(customerProfileId: number[]){\n        this.selectedCustomers = customerProfileId;\n        this.loadedCustomersChild = false;\n        this.dataService.clearCustomerChilds();\n\n        const wk = this.dataService.getWorkspace();\n\n        if(customerProfileId.length > 0){\n            this.customerService.getCustomerChildsByCustomerProfile(customerProfileId[0]).subscribe((result) => {\n                this.dataService.registerCustomerChilds(result);\n                this.customerChildList = this.customerService.convertCustomerChildsToTreeInputModel(result.filter(active => active.status === 1));\n                if(!wk.isDealer) {\n                    this.customerChildList = this.customerChildList.filter(customer => {\n                        return wk.userCustomerChildIds.some(c => c.customer === customer.id);\n                    });\n                }\n                this.loadedCustomersChild = true;\n            })\n        }\n        \n    }\n\n    async createHeartbetReport() {\n      this.progressPercentage = 0;\n      this.heartbeatReport = [];\n      this.loadingLastHeartbeat = true;\n\n      this.isDownloading = true;\n      this.reportHeartbeat.show();\n\n      try {\n        const imeis: string[] = this.allEquipments.map(equipment => equipment.identification);\n        const stepSize = 100;\n\n        for (const batch of this.chunkArray(imeis, stepSize)) {\n          const { lastAlarms, lastPositions, heartbeats } = await this.fetchBatchData(batch);\n\n          const batchReport = this.buildBatchReport(batch, lastAlarms, lastPositions, heartbeats);\n\n          this.heartbeatReport.push(...batchReport);\n          this.updateProgress(batch, imeis.length)\n        }\n      } catch (error) {\n        this.notificationService.printErrorMessage(\n          this.translateJsonService.getTranslateSubs('EQUIPMENTS.error_constult_last_heartbeat_valid')\n        )\n      }\n\n      this.loadingLastHeartbeat = false;\n      this.isDownloading = false;\n    }\n\n    private chunkArray<T>(array: T[], size: number): T[][] {\n      const chunks: T[][] = [];\n      for (let i = 0; i < array.length; i += size) {\n        chunks.push(array.slice(i, i + size));\n      }\n      return chunks;\n    }\n\n    private async fetchBatchData(batch: string[]) {\n      const [lastAlarms, lastPositions, heartbeats] = await Promise.all([\n        this.alarmService.getLastValidAlarm(batch),\n        this.telemetryService.getCurrentPositionsByDeviceIdList(batch),\n        this.heartbeatService.getLastHeartbeatByImeis(batch).toPromise()\n      ]);\n\n      return { lastAlarms, lastPositions, heartbeats };\n    }\n\n    private buildBatchReport(batch: string[], lastAlarms: any[], lastPositions: any[], heartbeats: any[]): any[] {\n      const dateLimit = moment(new Date()).subtract(1, \"days\").toDate();\n\n      return this.allEquipments\n        .filter(equip => batch.includes(equip.identification))\n        .map(equip => {\n          const heartbeat = this.resolveHeartbeat(equip, heartbeats, lastPositions);\n          const lastAlarm = lastAlarms.find(a => a.imei === equip.identification);\n          const telemetry = lastPositions.find(t => t.device_id === equip.identification);\n\n          return this.composeReportItem(equip, heartbeat, telemetry, lastAlarm, dateLimit);\n        });\n    }\n\n    private resolveHeartbeat(equip: any, heartbeats: any[], lastPositions: any[]) {\n    \n      const noHeartbeatTypes = [EquipamentType.WEARABLE, EquipamentType.DRIVER_HERO];\n\n      if (noHeartbeatTypes.includes(equip.equipmentTypeId)) {\n        return lastPositions.find(lp => lp.device_id === equip.identification);\n      }\n\n      return heartbeats.find(h => h.imei == equip.identification);\n    }\n\n    private composeReportItem(equip: any, heartbeat: any, telemetry: any, lastAlarm: any, dateLimit: Date) {\n      let assetInfo = {\n              \"assetIdentification\": equip.assetIdentification,\n              \"equipmentType\": equip.equipmentTypeName,\n              \"assetName\": equip.assetName,\n              \"imei\": equip.identification,\n              \"customerchild\": equip.customerChildName\n          }\n\n      let lastAlarmDate = null;\n      let lastAlarmTooltip = null;\n\n      if (lastAlarm && lastAlarm.date) {\n        const alarmTimezone = lastAlarm.timeZone || this.defaultTimeZone;\n        \n        if (lastAlarm.timeZone) {\n          lastAlarmDate = this.dataService.convertToAlarmTimezone(lastAlarm.date.toString(), lastAlarm.timeZone);\n        } else {\n          lastAlarmDate = lastAlarm.date;\n        }\n        \n        if (lastAlarmDate && moment(lastAlarmDate).isValid()) {\n          if (this.dataService.isTimezoneDifferent(alarmTimezone)) {\n            const normalizedTimezone = this.dataService.normalizeTimezone(alarmTimezone);\n            const originalTime = this.dataService.formatDateInAlarmTimezone(lastAlarmDate, alarmTimezone);\n            const label = this.translateJsonService.getTranslateSubs('GLOBAL.date_time_local');\n            lastAlarmTooltip = `${label}: ${originalTime} (${normalizedTimezone})`;\n          }\n        } else {\n          lastAlarmDate = null;\n          lastAlarmTooltip = null;\n        }\n      }\n\n      let heartbeatInfo = {\n          \"latitude\": null,\n          \"longitude\": null,\n          \"telemetry_datetime\": null,\n          \"datetime\": null,\n          \"inserted_on\": null,\n          \"ok\": false,\n          \"last_alarm\": lastAlarmDate,\n          \"last_alarm_tooltip\": lastAlarmTooltip,\n      }\n\n      if (heartbeat) {\n          heartbeatInfo = {\n              \"latitude\": (telemetry) ? telemetry.lat : null,\n              \"longitude\": (telemetry) ? telemetry.lng : null,\n              \"telemetry_datetime\": (telemetry) ? telemetry.datetime : null,\n              \"datetime\": heartbeat.datetime,\n              \"inserted_on\": heartbeat.inserted_on,\n              \"ok\": (dateLimit < new Date(heartbeat.datetime)) ? true : false,\n              \"last_alarm\": lastAlarmDate,\n              \"last_alarm_tooltip\": lastAlarmTooltip,\n          };\n      };\n\n      return { ...assetInfo, ...heartbeatInfo };\n    }\n\n    private updateProgress(batch: string[], total: number) {\n      const processed = this.heartbeatReport.length;\n      this.progressPercentage = Math.min(Math.round((processed / total) * 100), 100);\n    }\n\n    exportHeartbeatTable(): void {\n\n        const imeiHeader = \"IMEI\";\n        const equipTypeHeader = this.translateJsonService.getTranslateSubs('GLOBAL.type');\n        const assetPlateHeader = this.translateJsonService.getTranslateSubs('GLOBAL.plate');\n        const assetPrefixHeader = this.translateJsonService.getTranslateSubs('GLOBAL.prefix');\n        const customerchildHeader = this.translateJsonService.getTranslateSubs('GLOBAL.customers_child');\n        const latitudeHeader = this.translateJsonService.getTranslateSubs('MOSAIC.latitude');\n        const longitudeHeader = this.translateJsonService.getTranslateSubs('MOSAIC.longitude');\n        const telemetryDateHeader = this.translateJsonService.getTranslateSubs('EQUIPMENTS.telemetry_date');\n        const telemetryTimeHeader = this.translateJsonService.getTranslateSubs('EQUIPMENTS.telemetry_time');\n        const lastCommunicationDate = this.translateJsonService.getTranslateSubs('EQUIPMENTS.equipment_last_comunication_date');\n        const lastCommunicationHour = this.translateJsonService.getTranslateSubs('EQUIPMENTS.equipment_last_comunication_hour');\n        const lastAlarmDate = this.translateJsonService.getTranslateSubs('EQUIPMENTS.last_alarm_date');\n        const lastAlarmHour = this.translateJsonService.getTranslateSubs('EQUIPMENTS.last_alarm_hour');\n\n        this.exportReport = this.heartbeatReport.map((value) => {\n            return {                \n                [imeiHeader]: value.imei,\n                [equipTypeHeader]: value.equipmentType,\n                [assetPlateHeader]: value.assetIdentification,\n                [assetPrefixHeader]: value.assetName,\n                [customerchildHeader]: value.customerchild,\n                [latitudeHeader]: value.latitude,\n                [longitudeHeader]: value.longitude,\n                [telemetryDateHeader]: (value.telemetry_datetime) ? moment(value.telemetry_datetime).format('DD/MM/YYYY') : null,\n                [telemetryTimeHeader]: (value.telemetry_datetime) ? moment(value.telemetry_datetime).format('HH:mm:ss') : null,\n                [lastCommunicationDate]: (value.datetime) ? moment(value.datetime).format('DD/MM/YYYY') : null,\n                [lastCommunicationHour]: (value.datetime) ? moment(value.datetime).format('HH:mm:ss') : null,\n                [lastAlarmDate]: (value.last_alarm) ? moment(value.last_alarm).format('DD/MM/YYYY') : null,\n                [lastAlarmHour]: (value.last_alarm) ? moment(value.last_alarm).format('HH:mm:ss') : null,\n            }\n        });\n        this.exportFilesService.exportToXLSX(this.exportReport, 'ultimas-posicoes-validas');\n\n    }\n}\n","module.exports = \"<loading-animate></loading-animate>\\n<div class=\\\"row\\\">\\n        <div class=\\\"col-md-12\\\">\\n            <nb-card>\\n                    <nb-card-header>\\n                        <span *ngIf=\\\"!edit;else editEquipment\\\">{{'EQUIPMENTS.new_equip' | translate}}</span>\\n                        <ng-template #editEquipment>{{'EQUIPMENTS.edit_equip' | translate}}</ng-template>\\n                    </nb-card-header>\\n                    <nb-card-body>\\n                        <form #newEquipmentForm=\\\"ngForm\\\" novalidateEquip> \\n                        <div class=\\\"row\\\">\\n                            <ul *ngIf=\\\"equipAssetId.dirty && !equipAssetId.valid\\\" style=\\\"width: 100%;\\\">\\n                                <li style=\\\"list-style-type: none; margin: 0 15px;\\\" *ngIf=\\\"equipAssetId.errors.required\\\" class=\\\"alert alert-danger\\\">Ativo é necessário ser selecionado</li>\\n                            </ul>\\n                            <ul *ngIf=\\\"equipName.dirty && !equipName.valid\\\" style=\\\"width: 100%;\\\">\\n                                <li style=\\\"list-style-type: none; margin: 0 15px;\\\" *ngIf=\\\"equ