: CheckStonkamInfoState = CheckStonkamInfoState.NO_DATA_AVAILABLE;\n    public storageAnalysisMessage: string;\n    public showStorageError: boolean = false;\n\n    public stonkamEquipmentTypes = [EquipamentType.STONKAM, EquipamentType.STONKAM_K4, EquipamentType.STONKAM_K1_PLUS];\n    public jimiEquipmentTypes = [EquipamentType.JIMI, EquipamentType.JIMI_G7, EquipamentType.JIMI_V6, EquipamentType.JIMI_G5_PLUS, EquipamentType.JIMI_JC400AD_ID, EquipamentType.JIMI_JC400D_R];\n\n    statusPending: boolean = false;\n    configPending: boolean = false;\n    filteredStorages: Array<{ totalBytes: number, freeBytes: number, type: string }> = [];\n    public updateRequested: boolean = false;\n\n    constructor(\n        private checkDeviceService: CheckDeviceService,\n        private trasnlateJsonService: TranslateJsonService\n        ) {}\n\n    ngOnInit() {}\n    async ngOnChanges() {\n        let deviceData:DeviceData = this.filterDataToDeviceEntity(this.filterSelectedData);\n        \n        // só executa se mudou de vehicle no filtro\n        if(!this.deviceData || this.deviceData.vehicleId != deviceData.vehicleId || this.checkEquipmentInfoState === CheckStonkamInfoState.NO_DATA_AVAILABLE) {\n\n            this.checkEquipmentInfoState = CheckStonkamInfoState.NO_DATA_AVAILABLE;\n            this.deviceData = deviceData;\n\n            if (this.stonkamEquipmentTypes.includes(this.deviceData.type) || this.jimiEquipmentTypes.includes(this.deviceData.type)){\n                this.jimiData = {};\n                this.stonkamData = {};\n                this.getEquipmentInfo(this.deviceData);\n            }\n        }\n        this.refreshEquipmentInfo();\n    }\n\n    \n    public ngOnDestroy()\n    {\n        this.checkEquipmentInfoState = CheckStonkamInfoState.NO_DATA_AVAILABLE;\n    }\n    \n    /** Define que o comando de status terminou de executar.\n     *  Dispara calback registrada em onDataRead caso tenha terminado o comando de status e config */\n    private statusComplete(error = false) {\n        this.statusPending = false;\n        this.checkDataPending();\n    }\n\n    /** Define que o comando de status está executando. */\n    private statusRunning() {\n        this.statusPending = false;\n    }\n    \n    /** Define que o comando de config terminou de executar.\n     *  Dispara calback registrada em onDataRead caso tenha terminado o comando de status e config */\n    private configComplete(error = false) {\n        this.configPending = false;\n        this.checkDataPending();\n    }\n    \n    /** Define que o comando de status está executando. */\n    private configRunning() {\n        this.configPending = false;\n    }\n\n    private checkDataPending()\n    {\n        if(!this.configPending && !this.statusPending)\n            this.onDataRead.emit();\n    }\n\n    private getEquipmentInfo(deviceData: DeviceData) {\n        this.statusRunning();\n        this.configRunning();\n        this.checkEquipmentInfoState = CheckStonkamInfoState.LOADING;\n    \n        const commands = this.getCommandsForEquipment(deviceData.type);\n    \n        if (commands.statusCommand) {\n            this.checkDeviceService.sendCommandTask(\n                deviceData.imei,\n                deviceData.vehicleName,\n                deviceData.type,\n                commands.statusCommand\n            ).then(() => {\n                this.statusComplete();\n            }).catch(() => {\n                this.statusComplete(true);\n            });\n        }\n    \n        if (commands.configCommand) {\n            this.checkDeviceService.sendCommandTask(\n                deviceData.imei,\n                deviceData.vehicleName,\n                deviceData.type,\n                commands.configCommand\n            ).then(() => {\n                this.configComplete();\n            }).catch(() => {\n                this.configComplete(true);\n            });\n        }\n    }\n\n    private getCommandsForEquipment(equipmentType: EquipamentType) {\n        const commands = {\n            statusCommand: null,\n            configCommand: null\n        };\n    \n        switch (equipmentType) {\n            case EquipamentType.STONKAM:\n                commands.statusCommand = Commands.GET_DVR_STATUS;\n                commands.configCommand = Commands.GET_DVR_CONFIG;\n                break;\n            case EquipamentType.STONKAM_K4:\n                commands.statusCommand = Commands.GET_K4_DVR_STATUS;\n                commands.configCommand = Commands.GET_K4_DVR_CONFIG;\n                break;\n            case EquipamentType.STONKAM_K1_PLUS:\n                commands.statusCommand = Commands.GET_K1PLUS_DVR_STATUS;\n                commands.configCommand = Commands.GET_K1PLUS_DVR_CONFIG;\n                break;\n            case EquipamentType.JIMI_G7:\n                commands.statusCommand = Commands.GET_G7_VERSION; \n                break;\n            case EquipamentType.JIMI_V6:\n                commands.statusCommand = Commands.GET_G5_VERSION; \n                break;\n            case EquipamentType.JIMI_G5_PLUS:\n            case EquipamentType.JIMI_JC400AD_ID:\n            case EquipamentType.JIMI_JC400D_R:\n                commands.statusCommand = Commands.GET_G5PLUS_VERSION; \n                break;\n            default:\n                console.error('Tipo de equipamento desconhecido. Falha ao obter comandos.');\n        }\n    \n        return commands;\n    }\n\n\n    private fillStonkamData(lastSuccesfullGetDvrStatus: TaskLog, lastSuccesfullGetDvrConfig: TaskLog): StonkamInfo {\n        let stonkamInfo: StonkamInfo = {};\n        let getDvrStatusDate = null;\n        let getDvrConfigDate = null;\n    \n        if (lastSuccesfullGetDvrStatus) {\n            let getDvrStatusResponse = JSON.parse(lastSuccesfullGetDvrStatus.deviceResponse);\n    \n            this.filteredStorages = getDvrStatusResponse.Storage\n        .filter(storage => storage.TotalBytes > 0)\n        .map((storage, index) => {\n            let type;\n            if (index === 0) type = 'SSD';\n            else if (index === 1) type = 'SD';\n            else type = `SD ${index}`;\n            \n            return {\n                totalBytes: Math.round(storage.TotalBytes / Math.pow(10, 9)),\n                freeBytes: Math.round(storage.FreeBytes / Math.pow(10, 9)),\n                type: type\n            };\n        });\n    \n            if (this.deviceData.type == EquipamentType.STONKAM) {\n                stonkamInfo.dmsVersion = getDvrStatusResponse.AI.find((ver) => ver.name == \"DMS\")\n                    ? getDvrStatusResponse.AI.find((ver) => ver.name == \"DMS\").version\n                    : \"n/a\";\n                stonkamInfo.adasVersion = getDvrStatusResponse.AI.find((ver) => ver.name == \"ADAS\")\n                    ? getDvrStatusResponse.AI.find((ver) => ver.name == \"ADAS\").version\n                    : \"n/a\";\n            }\n    \n            this.checkEquipmentInfoState = CheckStonkamInfoState.OK;\n    \n            const completedLogStatus = lastSuccesfullGetDvrStatus.logs.find((log) => log.taskStatus == \"COMPLETED\");\n            if (completedLogStatus) {\n                getDvrStatusDate = moment(completedLogStatus.createdAt);\n            }\n        }\n    \n        if (lastSuccesfullGetDvrConfig) {\n            let getDvrConfigResponse = JSON.parse(lastSuccesfullGetDvrConfig.deviceResponse);\n    \n            stonkamInfo.dvrVersion = getDvrConfigResponse.Version ? getDvrConfigResponse.Version : \"n/a\";\n    \n            const completedLogConfig = lastSuccesfullGetDvrConfig.logs.find((log) => log.taskStatus == \"COMPLETED\");\n            if (completedLogConfig) {\n                getDvrConfigDate = moment(completedLogConfig.createdAt);\n            }\n        }\n    \n        if (getDvrStatusDate && getDvrConfigDate) {\n            let time = moment(getDvrStatusDate).isAfter(getDvrConfigDate) ? moment(getDvrStatusDate) : moment(getDvrConfigDate);\n            stonkamInfo.taskCompletedDate = time.tz('UTC', true).local().format(\"DD/MM/YYYY HH:mm:ss\");\n        }\n    \n        return stonkamInfo;\n    }\n    \n    private fillJimiData(lastSuccessfullGetVersionTask: TaskLog): JimiInfo {\n        let jimiInfo: JimiInfo = {};\n        let getVersionDate = null;\n\n        if (lastSuccessfullGetVersionTask) {\n            try {\n                let getVersionResponse = lastSuccessfullGetVersionTask.deviceResponse;\n                this.checkEquipmentInfoState = CheckStonkamInfoState.OK;\n                let versionMatch = getVersionResponse.match(/_([0-9]{6}\\.[0-9]{4})(?=,|\\b)/);\n                \n                if (versionMatch) {\n                    jimiInfo.firmwareVersion = versionMatch[1];\n                } else {\n                    jimiInfo.firmwareVersion = 'n/a';\n                }\n\n                getVersionDate = moment(lastSuccessfullGetVersionTask.createdAt);\n            }\n            catch (e) {\n                console.log('Erro ao tentar preencher dados de versão de equipamento Jimi', e);\n            }\n        }\n\n        if (getVersionDate) {\n            jimiInfo.taskCompletedDate =  getVersionDate.tz('UTC', true).local().format(\"DD/MM/YYYY HH:mm:ss\");\n        }\n\n        return jimiInfo;\n    }\n\n    private async retrieveEquipmentData(): Promise<any> {\n        \n        let lastCompletedTasks = await this.checkDeviceService.getCompletedTaskLogByCommands(this.filterSelectedData.selectedImei, [\n            Commands.GET_DVR_STATUS,\n            Commands.GET_DVR_CONFIG,\n            Commands.GET_G5PLUS_VERSION,\n            Commands.GET_G5_VERSION,,\n            Commands.GET_G7_VERSION,\n            Commands.GET_K1PLUS_DVR_CONFIG,\n            Commands.GET_K1PLUS_DVR_STATUS,\n            Commands.GET_K4_DVR_CONFIG,\n            Commands.GET_K4_DVR_STATUS\n        ]);\n\n        if (this.stonkamEquipmentTypes.includes(this.deviceData.type)) {\n\n            let sortedStonkamLogs = [...lastCompletedTasks].sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());\n            \n            let lastSuccesfullGetDvrStatus = sortedStonkamLogs.find((taskLog) => taskLog.command === \"GetDVRStatus\" && taskLog.taskStatus === \"COMPLETED\");\n            let lastSuccesfullGetDvrConfig = sortedStonkamLogs.find((taskLog) => taskLog.command === \"GetDVRConfig\" && taskLog.taskStatus === \"COMPLETED\");\n        \n            let stonkamData = this.fillStonkamData(lastSuccesfullGetDvrStatus, lastSuccesfullGetDvrConfig);\n            return stonkamData;\n        } else if (this.jimiEquipmentTypes.includes(this.deviceData.type)) {\n\n            let sortedJimiLogs = [...lastCompletedTasks].sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());\n            \n            let lastSuccesfullGetVersionTask = sortedJimiLogs.find((taskLog) => {\n                let normalizedCommand = taskLog.command.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();\n                return normalizedCommand.includes('consultar versao'.toLowerCase()) && taskLog.taskStatus === \"COMPLETED\";\n            });\n        \n            let jimiData = this.fillJimiData(lastSuccesfullGetVersionTask);\n            return jimiData;\n        }\n    }\n\n    public async refreshEquipmentInfo() {\n\n        let equipData = await this.retrieveEquipmentData();\n\n        if (_.isEmpty(equipData)) {\n            setTimeout(() => {\n                this.retrieveEquipmentData().then((res) => {\n                    if (!_.isEmpty(res)) {\n                        this.assignEquipmentData(res);\n                    } else {\n                        this.checkEquipmentInfoState = CheckStonkamInfoState.NO_DATA_AVAILABLE;\n                    }\n                });\n            }, 30000);\n        } else {\n            this.assignEquipmentData(equipData);\n        }\n    }\n\n    private assignEquipmentData(data: any) {\n        if (this.stonkamEquipmentTypes.includes(this.deviceData.type)) {\n            this.stonkamData = data;\n            this.analyseStorage(this.filteredStorages);\n        } else if (this.jimiEquipmentTypes.includes(this.deviceData.type)) {\n            this.jimiData = data;\n        }\n    }\n\n    public async updateEquipmentInfo() {\n        this.updateRequested = true;\n        this.getEquipmentInfo(this.deviceData);\n        this.refreshEquipmentInfo();\n    }\n\n    private filterDataToDeviceEntity(filterData: FilterAlarms): DeviceData {\n        return {\n            imei: filterData.selectedImei,\n            type: filterData.selectedEquipmentType,\n            vehicleName: filterData.selectedVehicleName,\n            vehicleId: filterData.selectedVehicles[0],\n        };\n    }\n\n    isStonkamEquipmentType(type: EquipamentType): boolean {\n        return this.stonkamEquipmentTypes.includes(type);\n    }\n\n    isJimiEquipmentType(type: EquipamentType): boolean {\n        return this.jimiEquipmentTypes.includes(type);\n    }\n\n    analyseStorage(storageDevices: { type: string, freeBytes: number, totalBytes: number }[]) {\n        let hasStorageError = false;\n        let isCorruptStorage = true;\n    \n        for (let storage of storageDevices) {\n            if (storage.totalBytes > 0 && storage.freeBytes === 0) {\n                hasStorageError = true;\n            }\n    \n            if (storage.totalBytes > 0 || storage.freeBytes > 0) {\n                isCorruptStorage = false;\n            }\n        }\n        if (hasStorageError) {\n            this.storageAnalysisMessage = this.trasnlateJsonService.getTranslateSubs(\"CHECK-DEVICE.storage_error_message\");\n            this.showStorageError = true;\n        } else if (isCorruptStorage) {\n            this.storageAnalysisMessage = this.trasnlateJsonService.getTranslateSubs(\"CHECK-DEVICE.corrupt_storage_error_message\");\n            this.showStorageError = true;\n        } else {\n            this.showStorageError = false;\n        }\n    }\n}\n","module.exports = \"<p-dialog\\n    header=\\\"{{ 'GLOBAL.alert_1' | translate }} - {{ selectedLastAlarm?.id }}\\\"\\n    [(visible)]=\\\"displayAlert\\\"\\n    modal=\\\"true\\\"\\n    [draggable]=\\\"false\\\"\\n    [resizable]=\\\"false\\\"\\n    [positionLeft]=\\\"50\\\"\\n    [appendTo]=\\\"body\\\"\\n    [dismissableMask]=\\\"true\\\"\\n    (onHide)=\\\"onModalClose()\\\"\\n  >\\n  <div class=\\\"d-flex justify-content-between\\\">\\n      <div id=\\\"alert-modal-content\\\">\\n          <div *ngFor=\\\"let urlMovie of selectedLastAlarm?.urlMovies; let i = index\\\">\\n              <div #videoWrapper data-wrapper-type=\\\"video-wrapper\\\" class=\\\"video-wrapper\\\">\\n                  <media-watermark [isFullscreen]=\\\"isFullscreenVideo\\\" [isPicture]=\\\"false\\\" [mediaPlates]=\\\"selectedLastAlarm.vehicle_plates\\\" [mediaPrefix]=\\\"selectedLastAlarm.vehicle_prefix\\\" [miniatureDisplay]=\\\"true\\\"></media-watermark>\\n                  <video syncVideo #moviePlayer autoplay controls controlsList=\\\"nofullscreen nodownload\\\" disablepictureinpicture muted #videoPlayer [id]=\\\"'health-video-' + i\\\" (play)=\\\"onVideoPlay()\\\" (pause)=\\\"onVideoPause()\\\" [ngClass]=\\\"isFullscreenVideo === true ? ['fullscreen-video-actived ','video' ]: 'video'\\\">\\n                      <source *ngIf=\\\"!mpegtsPlayerService.isTsUrl(urlMovie)\\\" type=\\\"video/mp4\\\" [src]=\\\"urlMovie\\\" />                        \\n                  </video>\\n                  <img src=\\\"../../../../assets/icon-fullscreen.png\\\" (click)=\\\"toggleFullscreen($event)\\\" #myImage [style.opacity]=\\\"imageOpacity\\\" [ngClass]=\\\"isFullscreenVideo === true ? 'fullscreen-button-actived' : 'fullscreen-button'\\\"> \\n                  <div class=\\\"download-container\\\">\\n                    <app-download-button \\n                    [isDownloading]=\\\"isDownloading\\\" \\n                    [value]=\\\"{ \\n             