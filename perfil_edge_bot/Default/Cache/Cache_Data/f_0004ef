]=\\\"100\\\" [height]=\\\"100\\\"></spinnerLoader>\\n              </div>\\n              <ng-container *ngSwitchCase=\\\"2\\\">\\n                  <div style=\\\"cursor: pointer\\\" *ngFor=\\\"let alarm of lastDeviceAlarms\\\">\\n                      <div\\n                          class=\\\"preview-alarm-list\\\"\\n                          [ngStyle]=\\\"{\\n                              'background-image': 'url(' + alarm.urlPictures[0] + ')'\\n                          }\\\"\\n                          (click)=\\\"showAlarmVideoModal(alarm)\\\"\\n                      >\\n                          <div>\\n                            <div>\\n                              {{ translateJsonService.getAlarmTypesTranslate(alarm?.typeAlarm) | translate }}\\n                            </div>\\n                            <div [ngbTooltip]=\\\"getTimezoneTooltip(alarm, alarm?.datetime)\\\"\\n                                 placement=\\\"top\\\"\\n                                 tooltipClass=\\\"tool-tip\\\"\\n                                 container=\\\"body\\\">{{ alarm?.datetime ? translateJsonService.transformDataFormat(alarm?.datetime) : '' }}</div>\\n                          </div>\\n                          <i class=\\\"pi pi-caret-right\\\" style=\\\"font-size: 4rem\\\"></i>\\n                      </div>\\n                  </div>\\n              </ng-container>\\n              <div id=\\\"no-telemetry-msg\\\" *ngSwitchCase=\\\"3\\\">\\n                  <i class=\\\"pi pi-times\\\" style=\\\"font-size: 2.5rem\\\"></i>\\n                  <div>\\n                      {{ \\\"CHECK-DEVICE.no_alarm_found\\\" | translate }}\\n                  </div>\\n              </div>\\n            </nb-card-body>\\n          </nb-card>\\n        </div>\\n\\n        <div class=\\\"col-md-3\\\">\\n          <nb-card class=\\\"upper-cards\\\">\\n            <nb-card-header>Streaming</nb-card-header>\\n            <nb-card-body>\\n              <streaming [assetId]=\\\"s