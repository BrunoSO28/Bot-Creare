rom 'rxjs';\nimport {catchError, map} from 'rxjs/operators';\nimport { Injectable } from '@angular/core';\nimport { Response, Http, Headers } from '@angular/http';\nimport { HttpClient, HttpErrorResponse, HttpHeaders } from '@angular/common/http';\n\nimport { SelectItem } from 'primeng/api';\n\nimport { Device } from '../models';\nimport { ConfigService } from '../config/config.service';\nimport { AuthenticationService } from 'app/pages/login/authentication.service';\n\n@Injectable()\nexport class DeviceService {\n    private baseUrl;\n\n    constructor(\n        private http: HttpClient,       \n        private configService: ConfigService,\n        private auth: AuthenticationService     \n    ) { \n      this.baseUrl = configService.getApiURI();\n    }\n\n    /**\n     * Deletar um Device\n     * @param deviceId Id do Device a ser excluido\n     */\n    public deleteDevice(deviceId : number[]) : Observable<any> {\n        let _ws = this.configService.webServices['deleteDevice'];\n\n        return this.http.delete(_ws.url(this.baseUrl, deviceId.join(',')), {headers: this.getHttpHeaders()})\n        .pipe(catchError(this.handleError));\n    }\n\n    /**\n     * Salva um novo Device\n     * @param device - Objeto device a ser salvo\n     */\n    public saveDevice(device: Device): Observable<any> {\n        let _ws = this.configService.webServices['saveNewDevice'];\n\n        let string = JSON.stringify({\n            \"name\": device.name,\n            \"integration\": device.identification,\n            \"identification\": device.identification,\n            \"type\": device.typeId,\n            \"status\": 2,\n            \"customer\": device.customerChild,\n            \"imsi\": device.imsi\n        });\n\n        return this.http.post(_ws.url(this.baseUrl), string, {headers: this.getHttpHeaders()})\n        .pipe(catchError(this.handleError));\n    }\n\n    /**\n     * Busca Devices por Filial e Status\n     * @param customerChilds Lista de Filiais\n     * @param status Status do Device\n     */\n    public getDevicesByCustomerChildAndStatus(customerChilds : number[], status: number): Observable<Device[]>{\n        let _ws = this.configService.webServices['devicesByCustomerChildAndStatus'];\n\n        return this.http.get<Device[]>(_ws.url(this.baseUrl, customerChilds.join(','), status), {headers: this.getHttpHeaders()})\n        .pipe(catchError(this.handleError));\n    }\n\n    /**\n     * Busca Devices por Equipamento e Status\n     * @param equipIds Equipamentos ID\n     * @param status Status\n     */\n    public getDevicesByManyEquipmentsAndStatus(equipIds: number[], status: number): Observable<Device[]>{\n        let _ws = this.configService.webServices['getDevicesByManyEquipmentsAndStatus'];\n\n        return this.http.get<Device[]>(_ws.url(this.baseUrl, equipIds.join(','), status), {headers: this.getHttpHeaders()})\n        .pipe(catchError(this.handleError),);\n    }\n\n    /**\n     * Converte uma lista de Devices em uma lista de SelectItem Menu\n     * @param _devices Devices Entidade\n     */\n    public getDevicesSelectItem(_devices: Device[]): SelectItem[] {\n        let _result: SelectItem[] = [];\n\n        _devices.forEach((device: Device) => {\n            _result.push({label: device.name + ' -- ' + device.identification, value: device.id});\n        });\n        return _result;\n    }\n\n    public getByIMEI(imei: string): Observable<Device> {\n        let _ws = this.configService.webServices['getDeviceByIMEI'];\n\n        return this.http.get<Device>(_ws.url(this.baseUrl, imei), {headers: this.getHttpHeaders()})\n        .pipe(catchError(this.handleError));\n    }\n\n    private handleError(error: HttpErrorResponse) {\n        return observableThrowError(error.message);\n    }\n\n    getHttpHeaders() : HttpHeaders {\n        let headers = new HttpHeaders({\n            'Content-Type': 'application/json',\n            'Authorization': this.auth.getToken()\n        });\n\n        return headers;\n    }\n