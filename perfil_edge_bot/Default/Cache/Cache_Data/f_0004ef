\n        <tr>\\n            <td *ngFor=\\\"let col of columns\\\">\\n              <span *ngIf=\\\"col.field === 'visibleInSafety'\\\">\\n                <i *ngIf=\\\"alarm.visibleInSafety\\\" class=\\\"pi pi-check\\\" style=\\\"color: green;\\\"></i>\\n                <i *ngIf=\\\"!alarm.visibleInSafety\\\" class=\\\"pi pi-times\\\" style=\\\"color: red;\\\"></i>\\n              </span>\\n              <span *ngIf=\\\"col.field === 'treated'\\\">\\n                <i *ngIf=\\\"alarm.treated\\\" class=\\\"pi pi-check\\\" style=\\\"color: green;\\\"></i>\\n                <i *ngIf=\\\"!alarm.treated\\\" class=\\\"pi pi-times\\\" style=\\\"color: red;\\\"></i>\\n              </span>\\n              <span *ngIf=\\\"col.field === 'hasMedia'\\\">\\n                <button *ngIf=\\\"alarm.hasMedia\\\" [disabled]=\\\"!alarm.hasMedia\\\" class=\\\"media-button\\\" (click)=\\\"loadAlarmMedia(alarm)\\\">\\n                  <img class=\\\"btn-alarm-audit\\\" src=\\\"assets\\\\images/icon_camera.svg\\\">\\n                </button>\\n                <button *ngIf=\\\"!alarm.hasMedia\\\" disabled class=\\\"media-button\\\" pTooltip=\\\"{{ 'DEVICE-HEALTH.no_media' | translate }}\\\" tooltipPosition=\\\"top\\\">\\n                  <img src=\\\"assets\\\\images/icon_camera.svg\\\">\\n                </button>\\n              </span>\\n              <span *ngIf=\\\"col.field === 'formatedDatetime'\\\"\\n                    [ngbTooltip]=\\\"alarm.datetimeTooltip\\\"\\n                    placement=\\\"top\\\"\\n                    tooltipClass=\\\"tool-tip\\\"\\n                    container=\\\"body\\\">{{ alarm[col.field] || '-' }}</span>\\n              <span *ngIf=\\\"col.field === 'formatedInsertedOn'\\\"\\n                    [ngbTooltip]=\\\"alarm.insertedOnTooltip\\\"\\n                    placement=\\\"top\\\"\\n                    tooltipClass=\\\"tool-tip\\\"\\n                    container=\\\"body\\\">{{ alarm[col.field] || '-' }}</span>\\n              <span *ngIf=\