nService: NotificationUtilService,        \n        private workspaceService: WorkspaceService,\n        private translateJsonService: TranslateJsonService,\n        private loadingAnimateService: LoadingAnimateService\n    ){}\n\n    ngOnInit(){\n        this.newDevice = new Device();\n        this.newDevice.name = 'CÂMERA DE FADIGA';\n        this.loadEquipamentComponent();\n        this.isCreareUser = this.dataService.verifyIsCreareUser();\n    }\n\n    ngOnDestroy(){\n        if(this.subsEquipmentSave) this.subsEquipmentSave.unsubscribe();\n        if(this.subsDevice) this.subsDevice.unsubscribe();\n        if(this.subsAssets) this.subsAssets.unsubscribe();\n        if(this.subsAssetsId) this.subsAssetsId.unsubscribe();\n        if(this.subsNewDevice) this.subsNewDevice.unsubscribe();\n        if(this.subsNewEquipment) this.subsNewEquipment.unsubscribe();\n        if(this.subsworkspace) this.subsworkspace.unsubscribe();\n    }\n\n    /**\n     * Faz o load das informações necessárias para exibir a tela\n     */\n    public loadEquipamentComponent(){\n        this.initLoading(0);\n        this.setFilters();\n        this.loadEquipmentTypes();\n        this.loadDeviceTypes();\n\n        this.selectedEquipmentTypeId = [];\n        this.selectedAssetId = [];\n        this.selectedDeviceTypeId = [];\n\n        if(this.router.url.endsWith('/new')){            \n            this.equipment  = new Equipament();\n            this.equipment.name = 'EQUIPAMENTO FADIGA';\n            this.stopLoading(1000);\n            this.edit = false;\n        }else{\n            this.equipmentId = this.route.snapshot.params['id'];\n            this.loadSelectedEquipment(this.equipmentId);\n            this.edit = true;\n        }\n        \n        this.loadDevices();\n    }\n\n    /**\n     * Seta os Filtros para os Customers e os Carrega-os\n     */\n    public setFilters(){\n        let kp: Workspace  = this.dataService.getWorkspace();\n        if(kp){\n            this.filterSelectedData.selectedCustomers = kp.userCustomerChildIds.map((customer : customerChildsPermissions) => customer.customer);\n        }else{\n            this.router.navigate(['/pages/ui-alarms/fatigue']); \n        }\n        \n        this.allCustomers = this.dataService.getAllCustomerChilds();\n        this.loadedContent = true;\n    }\n\n    /**\n     * Carrega as informações de um equipamento já existente.\n     * @param id PK do equipamento a ser carregado\n     */\n    public loadSelectedEquipment(id: number){\n        this.equipment = this.dataService.getEquipmentById(id);\n        \n        if(this.equipment){            \n            this.selectedEquipmentTypeId = [this.equipment.type];\n            this.selectedAssetId = [this.equipment.assetId];\n            this.selectedCustomers = [this.equipment.customerChildId];\n\n            this.loadAssets([this.equipment.customerChildId], false);\n        }else{\n            this.router.navigate(['/pages/configs/equipment']); \n        }\n        this.stopLoading(1000);\n    }\n\n    // Insere os devices que já estão ativos no equipamento\n    public insertDeviceEquip(){\n        if(this.equipment.devices){\n            this.selectedDevices = [];\n            this.equipment.devices.forEach((device)=> {\n                const _device = {label: device.identification, value: device.id};\n                this.selItemDevices.push(_device);\n                this.selectedDevices.push(_device);\n            });\n        }\n    }\n\n    // Carrega os Tipos de Equipamentos\n    public loadEquipmentTypes(){\n        for (var prop in this.typeEquipment) {\n            if (this.typeEquipment.hasOwnProperty(prop) && (isNaN(parseInt(prop)))) {\n                this.selTypesEquipment.push({label: prop, value: this.typeEquipment[prop]});\n            }\n        } \n    }\n\n    // Carrega os Tipos de Dispositivos\n    public loadDeviceTypes(){\n        for (var prop in this.typeDevice) {\n            if (this.typeDevice.hasOwnProperty(prop) && (isNaN(parseInt(prop)))) {\n                this.selTypesDevice.push({label: prop, value: this.typeDevice[prop]});\n            }\n        } \n    }\n\n    // Carrega os Veiculos\n    public loadAssets(selectedCustomers : number[], edit : boolean){\n        this.selectedCustomers = selectedCustomers;\n        if(selectedCustomers.length > 0){\n            this.subsAssets = this.assetService.getAssetsByManyCustomerChildAndAssetType(selectedCustomers, 3).subscribe((vehicles : Asset[]) => {\n                this.selItemAssets = [];\n                this.selItemAssets = this.assetService.getAssetsSelectItem(vehicles);\n             },\n             error => {\n                 this.router.navigate(['/pages/configs/equipment']);\n             });\n        }else{\n            this.selItemAssets = [];\n        }\n\n        if(edit){\n            this.selectedAssetId = [];\n        }\n   }\n\n    // Carrega Veiculo Especifico\n    public loadAssetId(id: number[]){\n        this.subsAssetsId = this.assetService.getAssetsByIds(id).subscribe((assets) => {\n            if(assets){\n                this.selItemAssets.push({label: assets[0].vehicle_plates, value: assets[0].id});\n                this.selectedAssetId = [assets[0].id];\n            }else{\n                this.selectedAssetId = [];\n            }\n        })\n    }\n\n    /**\n     * Retorna os Devices disponíveis para utilizar\n     */\n    public loadDevices(){\n        this.subsDevice = this.deviceService.getDevicesByCustomerChildAndStatus(this.allCustomers.map((customerChild)=>customerChild.id),2).subscribe((devices)=>{\n            this.dataService.registerDevices(devices);\n            this.selItemDevices = this.deviceService.getDevicesSelectItem(devices);\n           \n            this.insertDeviceEquip();\n        })\n    }\n\n    // Desativar Equipamento\n    public disableEquipment(){ \n        this.notificationService.openConfirmationDialog(\n            this.translateJsonService.getTranslateSubs('