t-align:center;font-size:1.2em;color:#999;margin:20px 0}::ng-deep .ui-table .ui-table-tbody>tr>td{white-space:nowrap}\\n\"","import { Component, Input } from '@angular/core';\nimport { AlarmService } from 'app/@core/data/alarm.service';\nimport { ExportFileService } from 'app/@core/data/export-file.service';\nimport { ExportFilesService } from 'app/@core/data/export-files.service';\nimport { TranslateJsonService } from 'app/@core/data/translate-json.service';\nimport { DataService } from 'app/@core/data/data.service';\nimport { AlarmTypeEnum } from 'app/@core/enum/alarm-type.enum';\nimport { AlarmDto } from 'app/@core/models';\nimport { AlarmWithDetails } from 'app/@core/models/alarmWithDetails'; \n\n@Component({\n  selector: 'app-alarm-table',\n  templateUrl: './alarm-table.component.html',\n  styleUrls: ['./alarm-table.component.scss']\n})\nexport class AlarmTableComponent {\n    @Input() alarms: AlarmWithDetails[];\n    @Input() deviceImei: string;\n\n    public riskOptions: any[];\n    public companyOptions: any[];\n    public branchOptions: any[];\n    public alarmTypeOptions: any[];\n    public processedAlarms: any[];\n    public filterIdOptions: any[];\n    public booleanOptions: any[];\n    public selectedAlarm: AlarmDto;\n    public displayAlarmMedia: boolean = false;\n    public fullPlate: any;\n    \n    allItemsLabel = this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.all_items\");\n\n    cols = [\n        { field: 'id', header: 'ID', width: '6%' },\n        { field: 'formatedDatetime', header: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.datetime\"), width: '9%', sortField: \"datetime\" },\n        { field: 'datetime', header: 'ISO dateTime', width: '0%', style: {'display': 'none'} }, \n        { field: 'formatedInsertedOn', header: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.inserted_on\"), width: '9%', sortField: \"insertedOn\" }, \n        { field: 'insertedOn', header: 'ISO insertedOne', width: '0%', style: {'display': 'none'} },\n        { field: 'formatedAvailableMediaAt', header: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.available_at\"), width: '9%', sortField: \"availableMediaAt\" },\n        { field: 'availableMediaAt', header: 'ISO availableMediaAt', width: '0%', style: {'display': 'none'} },\n        { field: 'customerProfileName', header: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.customer_profile_name\"), width: '7%' },\n        { field: 'customerChildName', header: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.customer_child_name\"), width: '7%' },\n        { field: 'riskRating', header: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.risk_rating\"), width: '5%' },\n        { field: 'translatedTypeAlarm', header: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.type_alarm\"), width: '8%' },\n        { field: 'speed', header: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.speed\"), width: '5%' },\n        { field: 'latLong', header: 'Lat-long', width: '6%' },\n        { field: 'filterId', header: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.filter\"), width: '10%' },\n        { field: 'treated', header: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.treated\"), width: '4%' },\n        { field: 'hasMedia', header: this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.has_media\"), width: '4%'}\n    ];\n\n  constructor(\n    public translateJsonService: TranslateJsonService,\n    private alarmService: AlarmService,\n    private exportFilesService: ExportFilesService,\n    private dataService: DataService\n  ) {}\n\n\n  ngOnInit() {\n    this.processAlarms();\n    this.initializeOptions();\n  }\n\n  private rawToDate(value: any): Date | null {\n    if (value == null || value === undefined) {\n      return null;\n    }\n    if (value instanceof Date) {\n      return isNaN(value.getTime()) ? null : value;\n    }\n    if (typeof value === 'number') {\n      const ms = value < 1e12 ? value * 1000 : value;\n      const d = new Date(ms);\n      return isNaN(d.getTime()) ? null : d;\n    }\n    if (typeof value === 'string') {\n      const trimmed = value.trim();\n      if (/^\\d+$/.test(trimmed)) {\n        const num = Number(trimmed);\n        const ms = num < 1e12 ? num * 1000 : num;\n        const d = new Date(ms);\n        return isNaN(d.getTime()) ? null : d;\n      }\n    }\n    return null;\n  }\n\n  private resolveDateValue(raw: any, timeZone: string | undefined): Date | null {\n    const fromTimestamp = this.rawToDate(raw);\n    if (fromTimestamp) {\n      return fromTimestamp;\n    }\n    if (raw != null && raw !== undefined && timeZone) {\n      const str = typeof raw === 'string' ? raw : String(raw);\n      return this.dataService.convertToAlarmTimezone(str, timeZone);\n    }\n    if (raw instanceof Date && !isNaN(raw.getTime())) {\n      return raw;\n    }\n    return null;\n  }\n\n  processAlarms() {\n    if (!this.alarms || this.alarms.length === 0) {\n        this.processedAlarms = [];\n        return;\n      }\n\n    this.processedAlarms = this.alarms.map(alarm => {\n      const insertedOnRaw = alarm.insertedOn != null ? alarm.insertedOn : (alarm as any).inserted_on;\n      const availableMediaAtRaw = alarm.availableMediaAt != null ? alarm.availableMediaAt : (alarm as any).available_media_at;\n\n      const convertedDatetime = this.resolveDateValue(alarm.datetime, alarm.timeZone);\n      const convertedInsertedOn = this.resolveDateValue(insertedOnRaw, alarm.timeZone);\n      const convertedAvailableMediaAt = this.resolveDateValue(availableMediaAtRaw, alarm.timeZone);\n\n      let datetimeTooltip = null;\n      let insertedOnTooltip = null;\n      let availableMediaAtTooltip = null;\n\n      const alarmTimezone = alarm.timeZone || \"-03:00\";\n      const normalizedTimezone = this.dataService.normalizeTimezone(alarmTimezone);\n      const tooltipLabel = this.translateJsonService.getTranslateSubs('GLOBAL.date_time_local');\n\n      if (convertedDatetime) {\n        const originalTime = this.dataService.formatDateInAlarmTimezone(convertedDatetime, alarmTimezone);\n        datetimeTooltip = `${tooltipLabel}: ${originalTime} (${normalizedTimezone})`;\n      }\n      if (convertedInsertedOn) {\n        const originalTime = this.dataService.formatDateInAlarmTimezone(convertedInsertedOn, alarmTimezone);\n        insertedOnTooltip = `${tooltipLabel}: ${originalTime} (${normalizedTimezone})`;\n      }\n      if (convertedAvailableMediaAt) {\n        const originalTime = this.dataService.formatDateInAlarmTimezone(convertedAvailableMediaAt, alarmTimezone);\n        availableMediaAtTooltip = `${tooltipLabel}: ${originalTime} (${normalizedTimezone})`;\n      }\n\n      return {\n        ...alarm,\n        datetime: convertedDatetime,\n        insertedOn: convertedInsertedOn,\n        availableMediaAt: convertedAvailableMediaAt,\n        vehicleInfo: `${alarm.vehiclePlates} - ${alarm.vehiclePrefix}`,\n        latLong: `${alarm.latitude} - ${alarm.longitude}`,\n        translatedTypeAlarm: this.getValidTranslateSubs(AlarmTypeEnum[alarm.typeAlarm], alarm.typeAlarm),\n        formatedDatetime: this.translateJsonService.transformDataFormat(convertedDatetime),\n        formatedInsertedOn: this.translateJsonService.transformDataFormat(convertedInsertedOn),\n        formatedAvailableMediaAt: this.translateJsonService.transformDataFormat(convertedAvailableMediaAt),\n        hasMedia: alarm.urlMovie ? true : false,\n        filterId: this.getValidTranslateSubs(`DEVICE-HEALTH.filter_${alarm.filterId.toLowerCase()}`, alarm.filterId.toLowerCase()),\n        riskRating: this.getValidTranslateSubs(`DEVICE-HEALTH.${this.getRiskLabel(alarm.riskRating)}`, alarm.riskRating),\n        datetimeTooltip,\n        insertedOnTooltip,\n        availableMediaAtTooltip\n      };\n    });\n    this.fullPlate = this.processedAlarms[0].vehicleInfo;\n  }\n\n  getRiskLabel(riskRating: number): string {\n    switch (riskRating) {\n      case 0: return 'low_risk';\n      case 1: return 'medium_risk';\n      case 2: return 'high_risk';\n    }\n  }\n\n  getValidTranslateSubs(translation: string, value: any): string {\n    try {\n      return this.translateJsonService.getTranslateSubs(translation);\n    } catch (e) {\n      return value;\n    }\n  }  \n  \n  initializeOptions() {\n    this.companyOptions = [{ label: this.allItemsLabel, value: null }, ...Array.from(new Set(this.alarms.map(alarm => alarm.customerProfileName))).map(company => ({ label: company, value: company }))];\n    this.branchOptions = [{ label: this.allItemsLabel, value: null }, ...Array.from(new Set(this.alarms.map(alarm => alarm.customerChildName))).map(branch => ({ label: branch, value: branch }))];\n    this.alarmTypeOptions = [{ label: this.allItemsLabel, value: null }, ...Array.from(new Set(this.processedAlarms.map(alarm => alarm.translatedTypeAlarm))).map(type => ({ label: type, value: type }))];\n    this.riskOptions = [{ label: this.allItemsLabel, value: null }, ...Array.from(new Set(this.processedAlarms.map(alarm => alarm.riskRating))).map(type => ({ label: type, value: type }))];\n    this.filterIdOptions = [{ label: this.allItemsLabel, value: null }, ...Array.from(new Set(this.processedAlarms.map(alarm => alarm.filterId))).map(filter => ({ label: filter, value: filter }))];\n    this.booleanOptions = [\n        { label: this.allItemsLabel, value: null },\n        { label: this.translateJsonService.getTranslateSubs(\"GLOBAL.yes\"), value: true },\n        { label: this.translateJsonService.getTranslateSubs(\"GLOBAL.no\"), value: false }\n    ];\n  }\n\n  loadAlarmMedia(alarm: any) {\n    this.selectedAlarm = null;\n    let alarmDto = new AlarmDto();\n    Object.assign(alarmDto, alarm);\n    this.alarmService.getPictureByAlarm(alarm.id).subscribe((res) => {\n        alarmDto.urlMovies = res.urlMovies;\n        alarmDto.urlPictures = res.urlPictures;\n        alarmDto.typeAlarm = alarm.typeAlarm;\n        alarmDto.vehicle_plates = alarm.vehiclePlates;\n        alarmDto.vehicle_prefix = alarm.vehiclePrefix;\n        alarmDto.filter = alarm.filterId;\n        });\n    this.selectedAlarm = alarmDto;\n    this.displayAlarmMedia = !this.displayAlarmMedia\n  }\n\n  onModalClose() {\n    this.displayAlarmMedia = false;\n  }\n    \n  exportToXLSX() {\n        let imei = this.alarms[0].imei;\n        const alarmsToExport = this.processedAlarms.map(alarm => {\n          const alarmData = {};\n          this.cols.forEach(col => {\n            alarmData[col.header] = alarm[col.field];\n          });\n\n          alarmData[this.translateJsonService.getTranslateSubs(\"DEVICE-HEALTH.has_media\")] = alarm.hasMedia ? this.translateJsonService.getTranslateSubs(\"GLOBAL.yes\") : this.translateJsonService.getTranslateSubs(\"GLOBAL.no\");\n          return alarmData;\n        });\n      \n        this.exportFilesService.exportToXLSX(alarmsToExport, `alarms_${imei}`);\n  }\n\n}\n","module.exports = \"<div class=\\\"main_div padding-default\\\">\\n  <nb-card class=\\\"container-fluid\\\">\\n\\n    <div class=\\\"row\\\">\\n      <div class=\\\"col-sm-6\\\">\\n        <span class=\\\"header-title\\\">\\n          {{ \\\"DEVICE-HEALTH.equipment_diagnosis\\\" | translate }}\\n        </span>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"row justify-content-end\\\">\\n      <div *ngIf=\\\"showDeviceInfo\\\" [ngClass]=\\\"{ 'online-status': isDeviceOnline, 'device-status': true }\\\">\\n        {{ \\\"EQUIPMENTS.equipments\\\" | translate }} {{ isDeviceOnline ? \\\"Online\\\" : \\\"Offline\\\" }}\\n        <i class=\\\"pi pi-wifi\\\"></i>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"row\\\">\\n      <div class=\\\"col-md-12\\\">\\n        <playback-filter (submitFilter)=\\\"refreshRankingData($event)\\\" [disable]=\\\"pendingData\\\"></playback-filter>\\n      </div>\\n    </div>\\n\\n    <div *ngIf=\\\"showCollapseButton\\\" class=\\\"row\\\">\\n      <div class=\\\"col-md-6 pl