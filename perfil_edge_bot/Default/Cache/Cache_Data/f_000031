al-header\">\n                    <div class=\"d-flex align-items-center justify-content-start gap-2\">\n                        <ng-container *ngIf=\"alarmSelectedRow\">\n                            <span style=\"font-size: 14px;\">{{ 'AUDIT.equipment_type' | translate }}: </span>\n                            <div class=\"equipment-type-display-box\">\n                                <span>{{ getEquipamentTypeName(alarmSelectedRow.equipmentTypeId) }}</span>\n                                <ng-container [ngSwitch]=\"alarmSelectedRow.equipmentTypeId\">\n                                    <img style=\"margin-left: 10px;\" height=\"20px\" width=\"30px\" aria-hidden=\"true\" *ngSwitchCase=\"equipmentType.WEARABLE\" src=\"assets\\images\\wearable\\wearable-enabled.svg\">\n                                    <img style=\"margin-left: 10px;\" height=\"20px\" width=\"30px\" aria-hidden=\"true\" *ngSwitchCase=\"equipmentType.DRIVER_HERO\" src=\"assets\\images\\icon_dhc.svg\">\n                                    <img style=\"margin-left: 10px;\" height=\"15px\" width=\"30px\" aria-hidden=\"true\" *ngSwitchDefault src=\"assets\\images\\icon_camera.svg\">\n                                </ng-container>\n                            </div>\n                            \n                            <span style=\"font-size: 14px; margin-left: 15px;\">{{ 'AUDIT.event_origin' | translate }}: </span>\n                            <div class=\"equipment-type-display-box\">\n                                <ng-container *ngIf=\"alarmSelectedRow.alarmOrigin !== alarmOrigin.COPILOT\">\n                                    <img style=\"height: 25px; width: 25px;\" aria-hidden=\"true\" src=\"assets/images/icon_camera.svg\">\n                                    <span style=\"margin-left: 5px;\">{{ 'PLAYBACK-PAGE.camera' | translate}}</span>\n                                </ng-container>\n                                <ng-container *ngIf=\"alarmSelectedRow.alarmOrigin === alarmOrigin.CO