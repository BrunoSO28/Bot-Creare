showMap()\" (onHide)=\"mapDestroyer()\">\n        <p-header>\n            <strong style=\"color: #4B4B4D; font-size: 14px\">{{ 'TRIPS-PAGE.trip_order' | translate }}: {{ passengerTripOrderTitleValue }}</strong>\n        </p-header>\n        <div class=\"d-flex flex-row\" style=\"height: 450px; width: 1200px; display: grid; grid-template-columns: auto auto; grid-gap: 4px\" *ngIf=\"!loadingFullTripInfo && progVsRealDetails; else tripDetailsLoader\">\n            <div class=\"table-container\">\n\n                <p-table [value]=\"progVsRealDetails\" [columns]=\"tripDetailsCols\" [style]=\"{'width':'521px'}\">\n                    <ng-template pTemplate=\"header\" let-columns>\n                        <tr style=\"height:30px; border:none!important\">\n                            <th *ngFor=\"let col of tripDetailsCols; let i =  index\" [ngSwitch]=\"col.field\" style=\"font-size: 11px!important; padding: 3px!important; text-align: center!important; border-bottom: none!important\"\n                            scope=\"col-details\" [ngStyle]=\"{ 'width': i == 0 ? '20%' : '40%'}\">\n                                {{ col.header | translate }}\n                            </th>\n                        </tr>\n                    </ng-template>\n                    <ng-template pTemplate=\"body\" let-rowData let-columns>\n                        <tr>\n                            <td *ngFor=\"let col of tripDetailsCols\" [ngSwitch]=\"col.field\" [ngStyle]=\"getTripDetailsRowDataStyle()\" style=\"border-left: 1px solid #cccccc75!important; border-right: 1px solid #cccccc75!important;\" class=\"table-data-trip-detail\" >\n                                <span *ngSwitchCase=\"'title'\">\n                                    <strong style=\"color:#4B4B4D;\">{{rowData[col.field]}}</strong>\n                                </span>\n                                <span *ngSwitchDefault>{{rowData[col.field] ? rowData[col.field] : '-'}}</span>\n                            </td>\n                        </tr>\n                    </ng-template>\n                </p-table>\n\n                <p-table [value]=\"genericTripDetails\" [columns]=\"genericTripCols\" [scrollable]=\"true\" scrollHeight=\"200px\" [style]=\"{'width':'521px'}\">\n                    <ng-template pTemplate=\"header\" let-columns>\n                        <tr style=\"height:30px; background:#4B4B4D; color:#FFFFFF; border:none!important\">\n                            <th *ngFor=\"let col of genericTripCols\" [ngSwitch]=\"col.field\" style=\"font-size: 11px!important; padding: 3px!important; text-align: center!important; border-bottom: none!important\">\n                                {{ col.header | translate }}\n                            </th>\n                        </tr>\n                    </ng-template>\n                    <ng-template pTemplate=\"body\" let-rowData let-columns>\n                        <tr>\n                            <td *ngFor=\"let col of genericTripCols\" [ngSwitch]=\"rowData[col.field]\" [ngStyle]=\"getTripDetailsRowDataStyle()\" style=\"border-left: 1px solid #cccccc75!important; border-right: 1px solid #cccccc75!important;\" class=\"table-data-generic-trip-detail\" >\n                                <span *ngSwitchCase=\"'icon'\" class=\"d-flex justify-content-center align-items: center\">\n                                    <i class=\"fa fa-list-alt\" style=\"font-size: 15px; cursor: pointer; color:#4B4B4D\" aria-hidden=\"true\" (click)=\"openDriverDetails()\" [ngClass]=\"{'driver-data-disabled': !driverDetails.length > 0}\"></i>\n                                </span>\n                                <span *ngSwitchCase=\"'checkpoint'\" class=\"d-flex justify-content-center align-items: center\">\n                                    <i class=\"fa ion-flag\" style=\"font-size: 15px; cursor: pointer; color:#4B4B4D\" aria-hidden=\"true\" (click)=\"openCheckPointDetails()\" [ngClass]=\"{'checkpoint-data-disabled': !checkPointDetails.length