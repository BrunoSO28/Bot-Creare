       <button class=\"close-button\"><i class=\"fa fa-times\" aria-hidden=\"true\" (click)=\"closeDriverDatais()\"></i></button>\n                </div>\n                <p-table [value]=\"driverDetails\" [columns]=\"infoDataCols\" [scrollable]=\"true\" scrollHeight=\"396px\" [style]=\"{'width':'675px'}\">\n                    <ng-template pTemplate=\"body\" let-rowData let-columns>\n                        <tr>\n                            <td *ngFor=\"let col of infoDataCols\" [ngSwitch]=\"rowData[col.field]\" [ngStyle]=\"getTripDetailsRowDataStyle()\" style=\"border-left: 1px solid #cccccc75!important; border-right: 1px solid #cccccc75!important;\" class=\"table-driver-data-detail\">\n                                <span *ngSwitchDefault>{{rowData[col.field] ? rowData[col.field] : '-'}}</span>\n                            </td>\n                        </tr>\n                    </ng-template>\n                </p-table>\n            </div>\n            \n            <!--* TABELA COM DADOS DOS CHECKPOINTS *-->\n            <div *ngIf=\"showCheckpointsInfo\" class=\".checkpoint-info-data\">\n                <div class=\"d-flex flex-row align-items-start justify-content-between passenger-info-data-header\">\n                    <div style=\"width: 100%\" class=\"d-flex justify-content-center\">\n                        <span><strong>CHECKPOINTS</strong></span>\n                    </div>\n                    <button class=\"close-button\"><i class=\"fa fa-times\" aria-hidden=\"true\" (click)=\"closeCheckpointDetails()\"></i></button>\n                </div>\n                <p-table [value]=\"checkPointDetails\" [columns]=\"infoCheckpointDetails\" [scrollable]=\"true\" scrollHeight=\"396px\" [style]=\"{'width':'675px'}\">\n                    <ng-template pTemplate=\"body\" let-rowData let-columns>\n                        <tr>\n                            <td *ngFor=\"let col of infoCheckpointDetails\" [ngSwitch]=\"col.field\" [ngStyle]=\"getTripDetailsRowDataStyle()\" style=\"border-left: 1px solid #cccccc75!important; border-right: 1px solid #cccccc75!important;\" class=\"table-checkpoint-data-detail\">\n                                <span *ngSwitchCase=\"'checkpoint_name'\">\n                                    <span style=\"font-style: italic\">{{ (('TRIPS-PAGE.'+rowData['interaction_type']) | translate) + ' ' }}</span> <strong>{{ rowData[col.field] }}</strong>\n                                </span>\n                                <span *ngSwitchDefault>{{rowData[col.field] ? rowData[col.field] : '-'}}</span>\n                            </td>\n                        </tr>\n                    </ng-template>\n                </p-table>\n            </div>\n        </div>\n    </p-dialog>\n\n\n    <!-- *PASSENGER LIST DIALOG -->\n\n    <p-dialog #passengerDialog class=\"passenger-dialog\" [modal]=\"true\" [(visible)]=\"displayPassengerList\" [draggable]=\"true\" [resizable]=\"false\" [dismissableMask]=\"true\" (onShow)=\"showMap()\" (onHide)=\"mapDestroyer()\">\n        <p-header>\n            <strong style=\"color: #4B4B4D; font-size: 14px\">{{ 'TRIPS-PAGE.passengers' | translate}} - {{ 'TRIPS-PAGE.trip_order' | translate }}: {{ passengerTripOrderTitleValue }}</strong>\n        </p-header>\n        <div class=\"passenger-dialog-content\" *ngIf=\"!loadingPassengerList && passengerList; else detailsLoader\">\n            <ul class=\"passenger-list\">\n                <li class=\"passenger-trip-card d-flex flex-column\" *ngFor=\"let passenger of passengerList\">\n                        <div class=\"d-flex flex-column justify-content-between card-info\">\n                            <span class=\"mb-1\" style=\"border-bottom: 1px solid #4B4B4D61; padding-bottom: 5px\"><strong>{{ passenger.passenger_name }}</strong></span>\n                            <span><strong>{{ 'TRIPS-PAGE.driver_badge' | translate }}: </strong>{{ passenger.passenger_badge }}</span>\n                            <span><strong>{{ 'TRIPS-PAGE.boa