alse;\n  errMessage = '';\n\n  private data: ReportMonths[];\n\n  googleChartType: string = 'ColumnChart';  \n  loadedChart: boolean = false;\n  \n  data_chart: {\"report_type\": string, \"data\": {\"id\": number, \"name\": string, \"columns\": any[]}[], \"options\": string}[] = [];\n  \n  colors_chart: string[] = ['#ED7D31', '#92D050', '#5B9BD5'];\n\n\n  constructor(\n    private reportService: ReportService,\n    private router: Router\n  ){}\n\n  ngOnInit() {    \n    this.loadData();\n  }\n\n  async loadData(){\n    const CUSTOMER_CHILD = this.reportService.customersChild;\n    const START_DATE = this.reportService.startDate;\n    const END_DATE = this.reportService.endDate;\n    const ALERT_TYPE = this.reportService.alertTypes;     \n\n    if(CUSTOMER_CHILD.length < 1 || ALERT_TYPE.length < 1){\n      this.router.navigate(['/pages/reports']);\n    }else{\n      /* const data: ReportMonths[] = await this.reportService.fetchTrendReport(CUSTOMER_CHILD, START_DATE.toISOString(), END_DATE.toISOString(), ALERT_TYPE);\n      this.data = data;\n      \n      this.creatingReports(['resumeAll', 'alertAndDevices', 'perCustomer']); */\n\n      this.reportService.fetchTrendReport(CUSTOMER_CHILD, START_DATE.toISOString(), END_DATE.toISOString(), ALERT_TYPE).then((result) => {        \n        if(result.length < 1) throw Error('dados insuficientes');\n        \n        const data: ReportMonths[] = result;\n        this.data = data;\n        this.creatingReports(['resumeAll', 'alertAndDevices', 'perCustomer']);\n\n        this.loadedChart = true;  \n      }).catch(err => {\n        this.errMessage = \"Não há dados suficientes para gerar o relatório.\";\n      });\n    }\n  }\n\n  private creatingReports(reports: string[]) {\n    this.reportService.setMomentLocale();\n\n    const data_reports = this.data.sort((n1, n2) => new Date(n1.month).getTime() - new Date(n2.month).getTime());\n\n    const HEADER_1 = ['Month', 'Alertas', { role: 'annotation' }];\n    const HEADER_2 = ['Month', 'Alertas', 'Equipamentos', { role: 'annotation' }];\n    \n    const TICKS = this.reportService.createTicks(data_reports);\n\n    reports.forEach((report) => {\n\n      switch(report){\n        case 'resumeAll': \n          this.constructResumeData(data_reports, HEADER_1, 'resumeAll', TICKS);\n        break;\n          \n        case 'alertAndDevices':\n          this.createAlertsAndDevices(data_reports, HEADER_2, 'alertAndDevices');\n        break;\n\n        case 'perCustomer':\n          this.createPerCustomer(data_reports, HEADER_1, 'perCustomer', TICKS);\n        break;\n      }\n\n    })\n  }\n\n  private createPerCustomer(data_reports, header, reportType, ticks){    \n    const OPTIONS = this.getOptions('#ED7D31', false, ticks);  \n    let data = [];    \n\n      data_reports.forEach((_month) => {\n        _month.customers_child.forEach((customers) => {\n          const media: number = this.calcMedia(customers.total_alerts, customers.total_devices);\n                            \n          const column = [{v: new Date(_month.month), f: moment(_month.month).format('MMMM / YY')}, media, media];\n\n          let findedCustomerData = data.find((d) => d.id == customers.id);\n\n          if(findedCustomerData){\n            findedCustomerData.columns.push(column);\n          }else{\n            data.push({\"id\": customers.id, \"name\": customers.name, \"columns\": [header, column]});            \n          }\n        })\n\n      })\n\n      this.verifyReportDataExists(reportType, data, OPTIONS); \n  }\n\n  private createAlertsAndDevices(data_reports, header, reportType) {\n    const OPTIONS = this.getOptions('#EC3439', true);\n\n    let columns = [header];\n    \n    data_reports.forEach((_month) => {     \n        let total_alertas = 0;\n        let total_devices = 0;\n\n        _month.customers_child.forEach((customers) => {\n          total_alertas = total_alertas + customers.total_alerts;\n          total_devices = total_devices + customers.total_devices;\n        })\n\n        columns.push([moment(_month.month).format('MMMM / YY'), total_alertas, total_devices, total_devices]); \n    })\n\n    const data = [{\"id\": 1, \"name\": \"Todas Filiais\", \"columns\": columns}];\n\n    this.verifyReportDataExists(reportType, data, OPTIONS); \n  }  \n\n  private constructResumeData(data_reports, header, reportType, ticks) {\n    const OPTIONS = this.getOptions('#4472C4', false, ticks);\n\n    let columns = [header];    \n    \n    data_reports.forEach((_month) => {\n      let total_alertas = 0;\n      let total_devices = 0;\n\n      _month.customers_child.forEach((customers) => {\n        total_alertas = total_alertas + customers.total_alerts;\n        total_devices = total_devices + customers.total_devices;\n      })\n\n      const media: number = this.calcMedia(total_alertas, total_devices);\n      \n      columns.push([{v: new Date(_month.month), f: moment(_month.month).format('MMMM / YY')}, media, media,]);\n    });\n\n    const data = [{\"id\": 1, \"name\": \"Todas Filiais\", \"columns\": columns}];\n\n    this.verifyReportDataExists(reportType, data, OPTIONS);    \n  }\n\n  getOptions(colorBars: string, dualY: boolean, _ticks?: any[]){\n    if(dualY){\n      return {    \n        backgroundColor: { fill:'transparent' },      \n        seriesType: 'bars',\n        annotations: {\n          alwaysOutside: true,\n          textStyle: {\n            fontSize: 16,\n            color: '#000',\n            auraColor: 'none'\n          }\n        },\n        series: {\n          1: {\n            type: 'line', \n            targetAxisIndex: 1,\n          }\n        },\n        vAxis: {\n          viewWindowMode:'explicit',\n          viewWindow: {\n              min:0\n          }\n        },\n        colors:[colorBars,'#4472C4'],          \n        lineWidth: 3,\n        bar: { groupWidth: \"20%\" },\n        baselineColor: '#CCC',\n        chartArea:{\n          left:45,\n          top:35,\n          width:'85%',\n          height:'80%',\n          backgroundColor: '#FFFFFF'\n        },\n        height: '400',\n      }\n    }else{\n      return {\n        height: '300',        \n        chartArea:{\n          width:'95%',  \n          height: '70%',\n          top: '0',\n          left: '0',\n          right: '0',\n          bottom: '30',               \n          backgroundColor: {\n            strokeWidth: 0 ,\n            fill: 'transparent'\n          }\n        },      \t\n        legend: { position: \"none\" },\n        vAxis: { \n          textPosition: 'none',\n          gridlines: {\n            color: 'transparent'\n          },\n          viewWindowMode:'explicit',\n          viewWindow: {\n              min:0\n          }\n        },\n        hAxis: {\n          ticks: _ticks,\n          gridlines: {\n            color: 'transparent'\n          }\n        },\n        annotations: {\n          alwaysOutside: true,\n          textStyle: {\n            fontSize: 14,\n            color: '#000',\n            auraColor: 'none'\n          }\n        },\n        tooltip: { trigger: 'none' },\n        colors:[colorBars,'#4472C4'],\n        bar: { groupWidth: \"20%\" },\n        baselineColor: '#CCC',\n        backgroundColor: { \n          fill: 'transparent',\n        },\n        series: {\n          0: {\n            lineDashStyle: [4, 1]\n          }\n        },\n        trendlines: {\n          0: {\n            type: 'linear',\n            showR2: false,\n            visibleInLegend: false,\n            color: '#4472C4'\n          }\n        }\n      }\n    }        \n  }\n\n  private calcMedia(n1: number, n2: number): number{\n    return Number((n1 / n2).toFixed(1)); \n  }\n\n  private verifyReportDataExists(reportType, data, options) {\n    let finded = this.data_chart.find((data) => data.report_type == reportType);\n\n    if(!finded){\n      this.data_chart.push({\"report_type\": reportType, data: data, options: options});\n    }else{\n      finded.data.push(data);\n    } \n  }\n  \n\n  getData(reportType: string, itemId?: number){\n    const finded = this.data_chart.find((data) => data.report_type == reportType);\n\n    if(finded){\n      return (itemId) ? finded.data.find((data) => data.id == itemId).columns : finded.data;      \n    }else{\n      console.log(\"O sistema não conseguiu encontrar o gráfico \"+ reportType);\n    }\n  }\n\n  getOption(reportType: string, color?: string) {\n    const finded = this.data_chart.find((data) => data.report_type == reportType);\n\n    if(finded){\n      return finded.options;\n    }else{\n      console.log(\"O sistema não conseguiu encontrar o gráfico \"+ reportType);\n    }\n  }\n\n  exportPDF(){\n    this.loadingPdf = true;\n    \n    let images: HTMLElement[] = [];\n\n    //images.push(document.getElementById('report-trend-1'));    \n\n    \n    this.reportService.saveReport([this.trendReport.nativeElement], \"Tendência dos Alertas\", this.reportService.startDate, this.reportService.endDate).then((result) => {      \n      this.loadingPdf = false;\n    }).catch((erro) => this.loadingPdf = false );\n  }\n}\n","import { NgModule } from '@angular/core';\nimport { Routes, RouterModule } from '@angular/router';\n\nimport { ReportsComponent } from './reports.component';\nimport { ReportTrendComponent } from './report-trend/report-trend.component';\nimport { ReportDaysOrHoursComponent } from './report-days-or-hours/report-days-or-hours.component';\nimport { ReportResumeComponent } from './report-resume/report-resume.component';\nimport { ReportTreatComponent } from './report-treat/report-treat.component';\n\nconst routes: Routes = [{\n  path: '',\n  component: ReportsComponent,\n  children: [\n    {\n      path: 'trend-report',\n      component: ReportTrendComponent\n    },\n    {\n      path: 'days-our-hours-report',\n      component: ReportDaysOrHoursComponent\n    },\n    {\n      path: 'resume-report',\n      component: ReportResumeComponent\n    },\n    {\n      path: 'treat-report',\n      component: ReportTreatComponent\n    }    \n  ],\n}];\n\n@NgModule({\n  imports: [RouterModule.forChild(routes)],\n  exports: [RouterModule],\n})\nexport class ReportsRoutingModule { }","module.exports = \".report-content{display:flex;flex-direction:column}.report-header{font-family:Arial;text-transform:uppercase;margin-bottom:1em}.report-header h1{font-size:1.7em;font-weight:bold;color:#4472C4}.report-header h2{font-size:1em;color:#999;margin-left:0.5em}.report-content h3{font-size:0.75em;color:#999;font-weight:bold;width:100%;margin-left:0.5em;position:absolute;left:5%}\\n\"","import { Component } from '@angular/core';\nimport { Router } from '@angular/router';\nimport { ReportService } from 'app/@core/data/report.service';\nimport { ReportTypes } from 'app/@core/enum/report-types.enum';\nimport { ViewEncapsulation } from '@angular/compiler/src/core';\n\n@Component({\n  selector: 'ngx-reports',\n  styleUrls: ['./reports.component.scss'],\n  template: `\n    <div class=\"row\">\n      <div class=\"col-md-3\">\n        <report-filter (submited)=\"openReport()\" (changed)=\"changedfilters()\"></report-filter>\n      </div>\n      <div class=\"col-md-9\" style=\"margin-bottom: 3em;\" *ngIf=\"showReport\">        \n        <router-outlet></router-outlet>        \n      </div>      \n    </div>    \n  `,\n})\nexport class ReportsComponent {\n\n  showReport: boolean = true;\n\n  constructor(\n    private router: Router,\n    private reportService: ReportService\n  ){}\n\n  changedfilters(){\n    this.showReport = false;\n  }\n\n  openReport(){    \n    this.showReport = false;\n    \n    const REPORT_TYPE = this.reportService.reportType;    \n\n    switch(REPORT_TYPE){\n      case ReportTypes[\"Consolidado de Alertas\"]:\n        this.router.navigate(['/pages/reports/days-our-hours-report']);\n      break;\n      case ReportTypes[\"Resumo de Alertas\"]:\n        this.router.navigate(['/pages/reports/resume-report']);\n      break;\n      case ReportTypes[\"Tendência de Alertas\"]:\n        this.router.navigate(['/pages/reports/trend-report']); \n      break;\n      case ReportTypes.Tratativas:\n        this.router.navigate(['/pages/reports/treat-report']);\n      break;\n    }\n\n    setTimeout(() => {this.showReport = true;}, 500);\n  }\n}\n","import { NgModule } from '@angular/core';\nimport { ReportsRoutingModule } from './reports-routing.module';\nimport { ReportsComponent } from './reports.component';\nimport { ReportTrendComponent } from './report-trend/report-trend.component';\nimport { ReportDaysOrHoursComponent } from './report-days-or-hours/report-days-or-hours.component';\nimport { ReportFilterComponent } from './component/report-filter/report-filter.component';\nimport { ThemeModule } from 'app/@theme/theme.module';\n\nimport { CalendarModule } from 'primeng/calendar';\nimport { MultiSelectModule } from 'primeng/multiselect';\nimport { DropdownModule } from 'primeng/dropdown';\nimport { ReportService } from 'app/@core/data/report.service';\nimport { ReportTreatComponent } from './report-treat/report-treat.component';\nimport { ReportResumeComponent } from './report-resume/report-resume.component';\nimport { GoogleChartModule } from 'app/@theme/directives/googleChart.module';\nimport { ExportFilesService } from 'app/@core/data/export-files.service';\nimport { ExportButtonsComponent } from '../components/export-buttons/export-buttons.component';\n\n@NgModule({\n    imports: [\n        ReportsRoutingModule,\n        ThemeModule,\n        CalendarModule,\n        MultiSelectModule,\n        DropdownModule,\n        GoogleChartModule\n    ],\n    declarations: [\n        ReportsComponent,\n        ReportTrendComponent,\n        ReportDaysOrHoursComponent,\n        ReportFilterComponent,\n        ReportTreatComponent,\n        ReportResumeComponent,\n        ExportButtonsComponent\n    ],\n    providers: [\n        ReportService,\n        ExportFilesService\n    ]\n})\n\nexport class ReportsModule{}"],"sourceRoot":""}