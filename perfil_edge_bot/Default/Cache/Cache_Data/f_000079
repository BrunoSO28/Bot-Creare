;\n        this.endDate = endDate;\n        this.alertTypes = alertTypes;\n        this.reportType = reportType;\n    }\n\n    fetchResumeReport(customersChild:number[] , startDate: string, endDate: string, alertTypes:number[]): Promise<any> {\n        const HEADERS = this.authService.getHttpHeaders();\n        const URL_TO_FETCH = this.configService.webServicesV2['reportResume']\n            .url(this.baseUrl, customersChild.join(','), startDate, endDate, alertTypes.join(','));        \n\n        return this.http.get(URL_TO_FETCH, {headers : HEADERS})\n            .toPromise()\n            .catch(err => {\n                return Promise.reject(err.message ? err.message : \"Server error\");\n            })\n    }\n\n    fetchTrendReport(customersChild: number[], startDate: string, endDate: string, alertTypes: number[]): Promise<any> {\n        const HEADERS = this.authService.getHttpHeaders();\n        const URL_TO_FETCH = this.configService.webServicesV2['reportTrend']\n            .url(this.baseUrl, customersChild.join(','), startDate, endDate, alertTypes.join(','));        \n\n        return this.http.get(URL_TO_FETCH, {headers : HEADERS})\n            .toPromise()\n            .catch(err => {\n                return Promise.reject(err.message ? err.message : \"Server error\");\n            }) \n    }\n\n    fetchDaysAndHoursReport(customersChild: number[], startDate: string, endDate: string, alertTypes: number[]): Promise<any> {\n        const HEADERS = this.authService.getHttpHeaders();\n        const URL_TO_FETCH = this.configService.webServicesV2['reportDaysOrHours']\n            .url(this.baseUrl, customersChild.join(','), startDate, endDate, alertTypes.join(','));\n\n        return this.http.get(URL_TO_FETCH, {headers : HEADERS})\n            .toPromise()\n            .catch(err => {\n                return Promise.reject(err.message ? err.message : \"Server error\");\n            }) \n    }\n\n    fetchTreatsReport(customersChild: number[], startDate: string, endDate: string, alertTypes: number[]): Promise<any> {\n        const HEADERS = this.authService.getHttpHeaders();\n        const URL_TO_FETCH = this.configService.webServicesV2['reportTreatment']\n            .url(this.baseUrl, customersChild.join(','), startDate, endDate, alertTypes.join(','));\n\n        return this.http.get(URL_TO_FETCH, {headers : HEADERS})\n            .toPromise()\n            .catch(err => {\n                return Promise.reject(err.message ? err.message : \"Server error\");\n            }) \n    }\n\n    setMomentLocale() {\n        moment.updateLocale('pt-br', {\n            months : 'Janeiro_Fevereiro_Março_Abril_Maio_Junho_Julho_Agosto_Setembro_Outubro_Novembro_Dezembro'.split('_'),\n        });\n\n        moment.locale('pt-br');\n        }\n\n        private calcMedia(n1: number, n2: number): number{\n        return Number((n1 / n2).toFixed(1)); \n    }\n    \n    createTicks(data_reports) {\n        let ticks: any[] = [];\n\n        data_reports.forEach((_month) => {\n            ticks.push({v: new Date(_month.month), f: moment(_month.month).format('MMMM / YY')});\n        })\n\n        return ticks\n    }\n    \n    async saveReport(elementos: HTMLElement[], titleReport: string, startDate: Date, endDate: Date) {\n         \n         let images = await Promise.all(elementos.map(async (elemento) => {\n            const image = await this.exportFiles.getImageByElement(elemento);\n                    \n            return image;\n        }))\n\n        this.exportFiles.saveInPDF(images, titleReport, startDate, endDate);\n\n        return true;\n    }\n}","export enum DaysName {\n    'Domingo' = 1,\n    'Segunda-Feira' = 2,\n    'Terça-Feira' = 3,\n    'Quarta-Feira' = 4,\n    'Quinta-feira' = 5,\n    'Sexta-Feira' = 6,\n    'Sábado' = 7\n}","export enum ReportTypes {\n    \"Resumo de Alertas\" = 'resumeReport',\n    \"Tendência de Alertas\" = 'trendReport',\n    \"Consolidado de Alertas\" = 'daysOrHoursReport',\n    \"Tratativas\" = 'treatReport'\n}","import { Component, Output, EventEmitter, Input, SimpleChanges } from '@angular/core';\n\n@Component({\n  selector: 'export-buttons',\n  template: `\n    <div class=\"export-options\" style=\"width: 100%\">        \n        <div alt=\"Exportar Dados em Planilha\" placement=\"top\" ngbTooltip=\"Funcionalidade em Desenvolvimento\">\n            <span class=\"export-options__btn\" *ngIf=\"loadingExcel; else loadedExcel\">Gerando Excel...</span>\n            <ng-template #loadedExcel>\n                <span (click)=\"clickedButton('excel')\" class=\"export-options__btn\">\n                    <i class=\"fa fa-file-excel-o\" aria-hidden=\"true\" style=\"margin-right: 5px\"></i>\n                    <p>Planilha</p>\n                </span>\n            </ng-template>      \n        </div>\n        <div aria-multiline=\"Exportar Gráficos em PDF\">\n            <span class=\"export-options__btn\" *ngIf=\"loadingPdf; else loadedPdf\">Gerando PDF...</span>\n            <ng-template #loadedPdf>\n                <span (click)=\"clickedButton('pdf')\"  style=\"display: flex;\" class=\"export-options__btn\">\n                    <i class=\"fa fa-file-pdf-o\" aria-hidden=\"true\" style=\"margin-right: 5px\"></i>\n                    <p>PDF</p>\n                </span>                \n            </ng-template>         \n        </div>\n        <span>{{ 'REPORT-INDICATORS.export-report' | translate }}: </span>\n    </div>\n  `,\n  styles: [`\n    .export-options {\n        width: 100%;\n        padding: 0.8em 1.2em;\n        border-top: 1px solid #d2dee8;\n        display: flex;\n        align-items: center;\n        flex-direction: row-reverse;\n    }\n    .export-options__btn {\n        border-radius: 5px;\n        font-size: 0.875em;\n        display: flex;\n        padding: 0.7em 1.5em;\n        background-color: #dedede;\n        color: #717171;\n        max-height: 35px;\n        margin: 0px 0 0 15px;\n    }\n    .export-options__btn:hover {\n        background-color: #f7c476;\n        color: #a17a3e;\n        cursor: pointer;\n    }\n    .export-options__btn i {\n        margin-right: 5px\n    }\n  `]\n})\nexport class ExportButtonsComponent {\n    @Output('clickedPDF') clickedPDF: EventEmitter<boolean> = new EventEmitter<boolean>();\n    @Output('clickedEXCEL') clickedEXCEL: EventEmitter<boolean> = new EventEmitter<boolean>();    \n\n    @Input('loadingExcel') loadingExcel: boolean = false;\n    @Input('loadingPdf') loadingPdf: boolean = false;\n\n    clickedButton(buttom : string){\n        if(buttom == 'pdf'){\n            this.clickedPDF.emit(true);            \n        }else{\n            this.clickedEXCEL.emit(true);\n        }\n    }\n\n    ngOnChanges(changes : SimpleChanges) {\n        console.log(changes);\n        if(changes && changes['loadingPdf']){\n            this.loadingPdf = changes['loadingPdf'].currentValue;\n        }\n    }\n}","module.exports = \"<nb-card class=\\\"mx-auto\\\" style=\\\"width: 300px;\\\">\\n  <div class=\\\"toolbar\\\">\\n    <div class=\\\"toolbar__sec\\\">\\n      <i class=\\\"fa fa-cogs\\\" aria-hidden=\\\"true\\\"></i>  \\n      <p>{{'FILTER-GLOBAL.filters' | translate}}</p>        \\n    </div>\\n    <i class=\\\"fa fa-info\\\" style=\\\"position: absolute;right: 45px;top: 20px;color: #a2a1a1;cursor: pointer;\\\"\\n      placement=\\\"bottom\\\" ngbTooltip=\\\"{{'FILTER-GLOBAL.filters_tooltip' | translate}}\\\"></i>\\n  </div>\\n\\n  <div class=\\\"report-filter report-filter--high-resolution\\\">\\n      <div class=\\\"report-filter__item\\\">\\n        <label>{{'FILTER-GLOBAL.customer_child' | translate}}</label>\\n        <span style=\\\"position: relative; display: block\\\">\\n          <focus-tree-input [pendingContent]=false [contentNodes]=\\\"selItemCustomerChild\\\" [loadedContent]=\\\"loadedCustomer\\\" \\n            [selectedNodes]=\\\"selectedCustomers\\\" [checkBox]=true [triStateChk]=true [multChk]=true [contentName]=\\\"'GLOBAL.customers' | translate\\\" \\n            [overlayPanelWidth]=\\\"'450px'\\\" (changedNodes)=\\\"changedCustomers($event)\\\">\\n          </focus-tree-input>\\n        </span>\\n      </div>\\n      <div class=\\\"report-filter__item\\\" *ngIf=\\\"loadedDates\\\">\\n        <label>{{'FILTER-GLOBAL.period' | translate}}</label>\\n        <div class=\\\"row\\\">\\n          <div class=\\\"col-md-5 data-atalhos pr-0\\\">\\n            \\n            <span class=\\\"data-atalhos__atalho\\\" [ngClass]=\\\"{'data-atalhos__atalho--active' : selectedPeriodAtalho == 2}\\\"\\n              (click)=\\\"updateDateRange(2)\\\">{{'FILTER-GLOBAL.lst_three_mths' | translate}}</span>\\n\\n            <span class=\\\"data-atalhos__atalho\\\" [ngClass]=\\\"{'data-atalhos__atalho--active' : selectedPeriodAtalho == 1}\\\" \\n              (click)=\\\"updateDateRange(1)\\\">{{'FILTER-GLOBAL.lst_four_mths' | translate}}</span>\\n            <!-- <span class=\\\"data-atalhos__atalho\\\" [ngClass]=\\\"{'data-atalhos__atalho--active' : selectedPeriodAtalho == 120}\\\"\\n              (click)=\\\"updateDateRange(120)\\\">120 Dias</span> -->\\n          </div>\\n          <div class=\\\"col-md-7\\\">\\n            <p-calendar [(ngModel)]=\\\"rangeDates\\\" selectionMode=\\\"range\\\" dateFormat=\\\"dd/mm/yy\\\" [readonlyInput]=\\\"true\\\" [maxDate]=\\\"maxDate\\\" (onSelect)=\\\"updateDateRange(0)\\\"></p-calendar>\\n          </div>\\n        </div>\\n      </div>\\n      <div class=\\\"report-filter__item\\\">\\n        <label>{{'GLOBAL.type_alert' | translate}}</label>\\n        <p-multiSelect [maxSelectedLabels]=1 [options]=\\\"selItemAlarmTypes\\\" [(ngModel)]=\\\"selectedAlertTypes\\\"\\n            styleClass=\\\"pt-2 pb-0 select-fatigue\\\" [style]=\\\"{'width': '100%'}\\\" [panelStyle]=\\\"{minWidth:'26em', width:'200px'}\\\"\\n            defaultLabel=\\\"Alarmes\\\"\\n            selectedItemsLabel=\\\"{0} {{ 'GLOBAL.alert' | translate }} {{ 'GLOBAL.selecteds' | translate }}\\\">\\n            <ng-template let-alarm pTemplate=\\\"item\\\" >\\n                <div class=\\\"row\\\" style=\\\"width: 370px; display: inline-flex; margin-left: 1px;\\\">\\n                    <div class=\\\"col-2\\\">\\n                        <img src=\\\"{{alarm.icon}}\\\" style=\\\"height:30px;width:30px;display:inline-block;vertical-align:middle;\\\"/>\\n                    </div>\\n                    <div class=\\\"col-10 pl-0\\\">\\n                        <div style=\\\"font-size:14px;margin-top:4px;\\\">{{alarm.label}}</div>\\n                    </div>\\n                </div>\\n            </ng-template>\\n        </p-multiSelect>\\n      </div>\\n      <div class=\\\"report-filter__item\\\">\\n        <label>{{'FILTER-GLOBAL.report_type' | translate}}</label>\\n        <p-dropdown [options]=\\\"selItemReportTypes\\\" [(ngModel)]=\\\"selectedReportType\\\" [style]=\\\"{'width': '100%'}\\\"></p-dropdown>\\n      </div>\\n      <div class=\\\"report-filter__item\\\">\\n        <button [disabled]=\\\"creatingReport\\\" (click)=\\\"submitedFilter()\\\" class=\\\"report-filter__button\\\">{{'FILTER-GLOBAL.create_report' | translate}}</button>\\n      </div>\\n    </div>\\n</nb-card>\\n\\n<div class=\\\"des\\\"></div>\"","module.exports = \".report-filter{display:flex;margin:1em}.report-filter--high-resolution{flex-direction:column}.report-filter__item{width:100%;margin-bottom:0.9em}.report-filter__item label{font-size:0.75em;color:#939cab;width:100%}.report-filter__button{border:0px;font-size:1em;padding:0.5em 1em;border-radius:0.5em;width:100%;cursor:pointer;background-color:#4B4B4D;color:#FFFFFF;transition:-webkit-filter ease 150ms;transition:filter ease 150ms;transition:filter ease 150ms, -webkit-filter ease 150ms}.report-filter__button:hover{-webkit-filter:brightness(1.3);filter:brightness(1.3)}:host ::ng-deep .ui-dropdown label.ui-dropdown-label{color:#4B4B4D}:host ::ng-deep .pi-caret-down:before{color:#4B4B4D}:host ::ng-deep .ui-multiselect .ui-multiselect-label{color:#4B4B4D}:host ::ng-deep .ui-state-default{background:transparent !important}:host ::ng-deep .ui-inputtext,:host ::ng-deep .ui-calendar{width:100%;cursor:pointer}:host ::ng-deep .ui-inputtext{padding:0.7em;background-color:white !important;cursor:text}:host ::ng-deep .ui-dropdown-panel .ui-dropdown-item{color:#4B4B4D !important}:host ::ng-deep .ui-dropdown-panel .ui-dropdown-item:not(.ui-state-highlight):not(.ui-state-disabled):hover{background-color:#E8E8E8 !important}.toolbar{width:100%;display:flex;flex-direction:row;flex-flow:wrap}.toolbar__sec{font-size:1.5em;display:flex;flex-grow:1;margin:0.7em 0.7em 0 0.7em;padding-bottom:0.3em;border-bottom:1px solid #eaeaea}.toolbar__sec p{margin-left:0.3em}.toolbar__sec p{margin-bottom:0px}.data-atalhos{display:flex;align-content:center}.data-atalhos__atalho{padding:0.2em 0.7em;font-size:0.75em;text-align:center;background-color:#EAEAEA;margin-right:0.5em;border-radius:0.5em;align-items:center;display:flex;cursor:pointer;transition:background-color ease 150ms}.data-atalhos__atalho:hover{background-color:#4B4B4Dd5;color:#fff}.data-atalhos__atalho--active{background-color:#4B4B4D;color:#fff}:host ::ng-deep .pi-chevron-left{color:#4B4B4D;font-weight:bold;transition:-webkit-filter ease 200ms;transition:filter ease 200ms;transition:filter ease 200ms, -webkit-filter ease 200ms}:host ::ng-deep .pi-chevron-right:before{color:#4B4B4D;font-weight:bold;transition:-webkit-filter ease 200ms;transition:filter ease 200ms;transition:filter ease 200ms, -webkit-filter ease 200ms}:host ::ng-deep .ui-datepicker .ui-datepicker-header a:hover{background-color:transparent;-webkit-filter:brightness(1.3);filter:brightness(1.3)}:host ::ng-deep .ui-widget-header{color:#4B4B4D}:host ::ng-deep .ui-datepicker-calendar td a.ui-state-active{background-color:rgba(204,64,64,0.835294) !important}:host ::ng-deep .tool-tip .tooltip-inner{background-color:#4B4B4D;font-size:13px;opacity:0.95}:host ::ng-deep .tool-tip .arrow::before{border-bottom-color:#4B4B4D;opacity:0.95}