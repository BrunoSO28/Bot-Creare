DataExists(reportType, DATA, OPTIONS);    \n  }\n\n  createOverviewReport(data_reports: ReportMonths[], reportType, ticks) {\n    const OPTIONS = this.getOptions(ticks);\n\n    let header: any[] = ['Month'];\n    let items: any[] = [];\n\n    data_reports.forEach((data, j) => {\n      let count_types: ReportCountAlertType[] = [];\n      \n      data.customers_child.forEach((customer, i) => {\n        customer.count_alert_type.forEach((c_alert_type) => {\n          let findedType = count_types.find((_alert_type) => _alert_type.alert_type == c_alert_type.alert_type);\n\n          if(findedType){\n            findedType.count = findedType.count + c_alert_type.count;\n          }else{\n            count_types.push({\"alert_type\": c_alert_type.alert_type, \"count\": c_alert_type.count});\n            \n            if(!header.includes(this.alarmTypeEnum[c_alert_type.alert_type])){\n              header.push(this.alarmTypeEnum[c_alert_type.alert_type]);\n              header.push({role: 'annotation'});\n            }\n          }\n        })\n      })\n      \n      let month: any[] = [{v: new Date(data.month), f: moment(data.month).format('MMMM / YY')}];\n          \n      count_types.forEach((types) => { month.push(types.count); month.push(types.count.toString()) });\n      \n      items.push(month);      \n    })\n\n    let final = [header];\n    items.forEach((item) => {final.push(item); console.log(item)});\n\n    // BUG FIX: Relatório com 1 mês apenas fica quebrado\n    if (final.length < 3) {\n      let teste = [];\n      for(let j=0; j<items[0].length; j++) {\n        teste.push(0);\n      }\n      final.push(teste);\n    }\n \n    const DATA = [{\"id\": 1, \"name\": \"Todas Filiais\", \"columns\": final}];\n\n    this.verifyReportDataExists(reportType, DATA, OPTIONS);\n\n\n    console.log(JSON.stringify(this.data_chart));\n  }\n\n  getOptions(_ticks: any[], simpleStyle?: boolean){\n    if(simpleStyle){\n      return {\n        chartArea:{\n          top:50,\n    