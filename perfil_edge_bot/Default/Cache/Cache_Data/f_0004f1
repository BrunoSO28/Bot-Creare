 this.filteredValue = event.filteredValue;\n  }\n\n  exportToXLSX() {\n      this.isDownloading = true;\n      this.progressPercentage = 0;\n      type alarms_export = {\n        \"ID Auditoria\"?: String,\n        \"ID Alerta\"?: String,\n        \"Alerta Original\"?: string,\n        \"Nível do risco original\"?: string,\n        \"Empresa >\"?: string,\n        \"Filial 1 >\"?: string,\n        \"Filial 2 >\"?: string,\n        \"Filial 3 >\"?: string,\n        \"Filial 4\"?: string,\n        \"Veículo\"?: string,\n        \"Prefixo\"?: string,\n        \"Alerta Após Tratativa\"?: string,\n        \"Nível Risco Após Tratativa\"?: string,\n        \"Reclassificado\"?: boolean,\n        \"Data inserido em\"?: string,\n        \"Hora inserido em\"?: string,\n        \"Data Disponível Em\"?: string,\n        \"Hora Disponível Em\"?: string,\n        \"Data Alerta\"?: string,\n        \"Hora Alerta\"?: string,\n        \"Tempo de Atraso\"?: String,\n        \"Data Tratado em\"?: string,\n        \"Hora Tratado em\"?: string,\n        \"Tempo até Tratativa\"?: String,\n        \"Data Primeira Tratativa\"?: string,\n        \"Hora Primeira Tratativa\"?: string,\n        \"Tempo até Primeira Tratativa\"?: string,\n        \"Data Tratativa Iniciada\"?: string,\n        \"Hora Tratativa Iniciada\"?: string,\n        \"Motorista\"?: string,\n        \"Tratativa\"?: string,\n        \"Autor Tratativa\"?: string,\n        \"Velocidade\"?: string,\n        \"Observação\"?: string,\n        \"Latitude\"?: string,\n        \"Longitude\"?: string,\n        \"Extra\"?: string,\n        \"Assinado\"?: string,\n        \"Revisao\"?: string,\n      };\n\n      var customerIds = new Set(this.allAlarms.map(value => value.customer_child_id));\n      this.customerService.getCustomerParentsByIds({custIds: [...customerIds]}).subscribe(customerParentsList => {\n        const customerParentsMappedById = {}\n        customerParentsList.forEach(customer => customerParentsMappedById[customer.customerId] = customer.customerParentsOrderedByHierarchy);\n        const alarmsToExport = this.table.filteredValue ? this.table.filteredValue : this.allAlarms;\n        this.loadFinalAlarms(alarmsToExport, customerParentsMappedById)\n            .then((finalAlarms: alarms_export[]) => {\n              const fileName = \"auditoria-\" + moment().format(\"DD-hh-mm-s\");\n              this.exportFilesService.exportToXLSX(finalAlarms, fileName);\n              this.isDownloading = false\n              this.progressPercentage = 0;\n            })\n            .catch(error => {\n              this.notificationService.printErrorMessage(this.translateJsonService.getTranslateSubs('AUDIT.export_error'));\n              this.isDownloading = false;\n              this.progressPercentage = 0;\n            });\n      });\n\n  }\n\n  async loadFinalAlarms(alarmList, customerParentsMappedById) {\n    const BATCH_SIZE = 500;\n    const total = alarmList.length;\n    let finalAlarms = [];\n    const translationKeys = [\n      'AUDIT-XLSX-EXPORT.audit_id',\n      'AUDIT-XLSX-EXPORT.alert_id',\n      'AUDIT-XLSX-EXPORT.original_alert',\n      'AUDIT-XLSX-EXPORT.original_risk_level',\n      'AUDIT-XLSX-EXPORT.customer',\n      'AUDIT-XLSX-EXPORT.branch_1',\n      'AUDIT-XLSX-EXPORT.branch_2',\n      'AUDIT-XLSX-EXPORT.branch_3',\n      'AUDIT-XLSX-EXPORT.branch_4',\n      'AUDIT-XLSX-EXPORT.vehicle',\n      'AUDIT-XLSX-EXPORT.prefix',\n      'AUDIT-XLSX-EXPORT.after_action_alarm',\n      'AUDIT-XLSX-EXPORT.after_action_alarm_level',\n      'AUDIT-XLSX-EXPORT.reclassified',\n      'AUDIT-XLSX-EXPORT.inserted_on_date',\n      'AUDIT-XLSX-EXPORT.inserted_on_time',\n      'AUDIT-XLSX-EXPORT.available_at_date',\n      'AUDIT-XLSX-EXPORT.available_at_time',\n      'AUDIT-XLSX-EXPORT.alarm_date',\n      'AUDIT-XLSX-EXPORT.alarm_time',\n      'AUDIT-XLSX-EXPORT.delay_time',\n      'AUDIT-XLSX-EXPORT.started_action_date',\n      'AUDIT-XLSX-EXPORT.started_action_time',\n      'AUDIT-XLSX-EXPORT.treated_date',\n      'AUDIT-XLSX-EXPORT.treated_time',\n      'AUDIT-XLSX-EXPORT.time_until_action',\n      'AUDIT-XLSX-EXPORT.retreated_date',\n      'AUDIT-XLSX-EXPORT.retreated_time',\n      'AUDIT-XLSX-EXPORT.total_time_until_retreated',\n      'AUDIT-XLSX-EXPORT.driver',\n      'AUDIT-XLSX-EXPORT.action',\n      'AUDIT-XLSX-EXPORT.action_author',\n      'AUDIT-XLSX-EXPORT.speed',\n      'AUDIT-XLSX-EXPORT.obs',\n      'AUDIT-XLSX-EXPORT.lat',\n      'AUDIT-XLSX-EXPORT.long',\n      'AUDIT-XLSX-EXPORT.extra',\n      'AUDIT-XLSX-EXPORT.send_date',\n      'AUDIT-XLSX-EXPORT.send_hour',\n      'AUDIT-XLSX-EXPORT.recipients',\n      'AUDIT-XLSX-EXPORT.review',\n      'AUDIT-XLSX-EXPORT.reviewed_by'\n    ];\n    const translations = {};\n    translationKeys.forEach(key => {\n      translations[key] = this.translateJsonService.getTranslateSubs(key);\n    });\n    const processBatch = (batch) => {\n      return new Promise((resolveBatch) => {\n        const alarmsIds = batch.map(alarm => alarm.id);\n        this.alarmService.getAlarmsAuditHistories(alarmsIds).subscribe(auditHistories => {\n          const auditHistoriesMap = {};\n          auditHistories.forEach(h => auditHistoriesMap[h.alarmId] = h);\n\n          let batchResult = [];\n          batch.forEach(alarm => {\n            let alarms_export = {};\n            const alarmAuditHistory = auditHistoriesMap[alarm.id];\n            let firstTreatment = null;\n            if (alarmAuditHistory && alarmAuditHistory.history && alarmAuditHistory.history.length > 0) {\n              firstTreatment = alarmAuditHistory.history[0].treatmentDate;\n            }\n            const hasRetreated = alarmAuditHistory && alarmAuditHistory.history && alarmAuditHistory.history.length >= 2;\n            const customerParentList = customerParentsMappedById[alarm.customer_child_id] || [];\n            const alertDate = this.translateJsonService.transformDataFormat(alarm.datetime);\n            const insertedDate = this.translateJsonService.transformDataFormat(alarm.insertDate);\n            const availableAtDate = this.translateJsonService.transformDataFormat(alarm.availableMediaAt);\n            let treatedDate;\n            if (alarm.auditCreate_date) {\n              treatedDate = this.translateJsonService.transformDataFormat(alarm.auditCreate_date);\n            } else if (alarm.firstAuditCreateDateWithTimezone) {\n              treatedDate = this.translateJsonService.transformDataFormat(new Date(alarm.firstAuditCreateDateWithTimezone));\n            } else if (alarm.firstAuditCreateDate) {\n              treatedDate = this.translateJsonService.transformDataFormat(alarm.firstAuditCreateDate);\n            } else {\n              treatedDate = '';\n            }\n            const treatmentStartedDate = this.translateJsonService.transformDataFormat(alarm.treatmentStartedAt);\n            let firstTreatmentDate = null;\n            if (firstTreatment) {\n              firstTreatmentDate = this.translateJsonService.transformDataFormat(firstTreatment);\n            }\n            if (alarm.auditDriver || alarm.auditAlarm) {\n              const auditId = alarm.auditDriver ? alarm.auditDriver.toString() : alarm.auditAlarm.toString();\n              alarms_export[translations['AUDIT-XLSX-EXPORT.audit_id']] = this.translateJsonService.getTranslateSubs(auditId ? auditId : '');\n            }\n            alarms_export[translations['AUDIT-XLSX-EXPORT.alert_id']] = this.translateJsonService.getTranslateSubs(alarm.id.toString());\n            alarms_export[translations['AUDIT-XLSX-EXPORT.original_alert']] = this.translateJsonService.getTranslateSubs(this.translateJsonService.getAlarmTypesTranslate(alarm.originalTypeAlarm));\n            alarms_export[translations['AUDIT-XLSX-EXPORT.original_risk_level']] = this.getRiskRatingTranslation(alarm.originalGroupRisk);\n            alarms_export[translations['AUDIT-XLSX-EXPORT.customer']] = customerParentList[0] || '';\n            alarms_export[translations[