this.deviceTypeId = selectedFiltered.selectedEquipmentType;\n\n        if (this.voiceMessageService.deviceCanReceiveMessage(this.deviceTypeId)) {\n            this.isSaving = true;\n            this.voiceMessageService.saveVoiceMessages(this.buildAudio(selectedFiltered)).then(result => {\n                this.currentVoiceMessageId = null;\n                this.loadMessages();\n                this.isSaving = false;\n                this.notificationService.printSuccessMessage(this.translateJsonService.getTranslateSubs(\"VOICE-MESSAGE-PAGE.success_send_msg\"));\n            }).catch(error => {\n                this.isSaving = false;\n                this.notificationService.printErrorMessage(this.translateJsonService.getTranslateSubs(\"VOICE-MESSAGE-PAGE.error_send_msg\"));\n            });\n        } else {\n            this.notificationService.printWarningMessage(this.translateJsonService.getTranslateSubs(\"PLAYBACK-PAGE.unavailable_feature\"));\n        }\n    }\n\n    private buildAudio(filter: any): Audio {\n        const audio: Audio = new Audio();\n        audio.deviceId = filter.selectedImei;\n        audio.deviceTypeId = this.deviceTypeId;\n        audio.userId = JSON.parse(localStorage.getItem(\"currentUser\")).id;\n        audio.voiceCommands = filter.messages;\n        return audio;\n    }\n\n    public filterMessages(event): void {\n        this.selectedVehicle = event.selectedVehicles;\n        this.selectedCustomers = event.selectedCustomers;\n        this.currentVoiceMessageId = null;\n        this.voiceMessageList = [];\n        this.isLoading = true;\n        this.selectedVehiclePlate = event.selectedPlate.substring(0, event.selectedPlate.lastIndexOf('-')).trim();\n        this.getVehicleStatus(this.selectedVehicle[0], event.selectedImei);\n        this.loadMessages();\n    }\n\n    private getVehicleStatus(assetId: number, imei: string): void {\n        this.assetService.checkOnlineStatusByAssetId(assetId, imei).toPromise().then(\n            (res: