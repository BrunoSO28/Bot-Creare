statrtIndex + endIndex))\n\n    const vehicleIds = this.getVehicleIdsFromTableRows(slicedData)\n    \n    const openedTicketStatusList= [     \n      TicketStatus.OPEN,\n      TicketStatus.SCHEDULE,\n      TicketStatus.AWAITING_CUSTOMER,\n      TicketStatus.REMOTE_PROCEDURE,\n      TicketStatus.WAITING_FOR_CREATE\n    ]\n\n    const lastOpenedTickets = await this.getLastTickets(vehicleIds, openedTicketStatusList)\n\n    let response = slicedData;\n\n    if (lastOpenedTickets.length > 0) {\n      response = this.enrichWithTicketData(slicedData, lastOpenedTickets)\n    }\n\n    return response\n\n  }\n\n  isNoTicketDate(ticket: Ticket) {\n    return (ticket && this.noTicketQueryStatusList.includes(TicketQueryStatus[ticket.queryStatus]))\n  }\n\n  getNoTicketDescription(ticket: Ticket): string {\n\n    let getNoTicketDescription: string\n\n    const ticketQueryStatus = TicketQueryStatus[ticket.queryStatus]\n\n    if (ticketQueryStatus == TicketQueryStatus.BAD_REQUEST) {\n\n      const errorMessage = ticket.queryErrorMessage\n\n      if (errorMessage.includes(\"Customer Child ID(s) Invalid(s)\")) {\n        let description = this.translateJsonService.getTranslateSubs('CAMERAS-NOT-COMUNICATION.bad_request_customer_child_id_integration_error')\n        getNoTicketDescription = description.replace(\"##CUSTOMER_CHILD_ID##\", ticket.ticketServiceCustomerChildId)\n      } else {\n        getNoTicketDescription = this.translateJsonService.getTranslateSubs('CAMERAS-NOT-COMUNICATION.bad_request_error')\n      }\n    }\n\n    if (ticketQueryStatus == TicketQueryStatus.TIMEOUT) {\n      getNoTicketDescription = this.translateJsonService.getTranslateSubs('CAMERAS-NOT-COMUNICATION.timeout_error')\n    }\n\n    if (ticketQueryStatus == TicketQueryStatus.UNKNOWN_ERROR) {\n      getNoTicketDescription = this.translateJsonService.getTranslateSubs('CAMERAS-NOT-COMUNICATION.unknown_error')\n    }\n\n    if (ticketQueryStatus == TicketQueryStatus.VEHICLE_DO_NOT_HAVE_TICKET_INTEGRATION) {\n      getNoTicketDescription = this.translateJsonService.getTranslateSubs('CAMERAS-NOT-COMUNICATION.vehicle_do_not_have_ticket_integration_error')\n    }\n\n    if (ticketQueryStatus == TicketQueryStatus.NOT_FOUND) {\n      getNoTicketDescription = this.translateJsonService.getTranslateSubs('CAMERAS-NOT-COMUNICATION.not_found_error')\n    }\n\n    if (ticketQueryStatus == TicketQueryStatus.PERMISSION_DENIED_TO_TICKET_INTEGRATION) {\n      getNoTicketDescription = this.translateJsonService.getTranslateSubs('CAMERAS-NOT-COMUNICATION.system_do_not_have_ticket_integration')\n    }\n\n    return getNoTicketDescription\n  }\n\n  getTicketDescription(ticket: Ticket) {\n    const ticketProblem = TicketProblems[ticket.ticketProblemId]\n    const ticketProblemSpec = getTicketProblemsSpec(ticketProblem)\n\n    let ticketDescription: string\n\n    if (ticketProblemSpec) {\n      ticketDescription = this.translateJsonService.getTranslateSubs(ticketProblemSpec.transtale_variable_name)\n    } else {\n      ticketDescription = ticket.ticketProblem\n    }\n\n    return ticketDescription\n  }\n\n  enrichWithTicketData(cameraNotCommunicatingTableDataList: CameraNotCommunicatingTableData[], ticketList: Ticket[]): CameraNotCommunicatingTableData[] {\n\n    return cameraNotCommunicatingTableDataList.map((dataToRich) => {\n\n      let ticketData = this.getTicket(ticketList, dataToRich.vehicleId)\n      dataToRich.lastOpenedTicketDescription = this.getLastOpenedTicketDescription(ticketData)\n      dataToRich.lastOpenedTicketDate = this.getLastOpenedTicketDate(ticketData)\n      dataToRich.ticketId = this.getTicketId(ticketData)\n      dataToRich.ticketUrl = this.getTicketUrl(ticketData)\n      return dataToRich\n    })\n  }\n\n  getLastOpenedTicketDescription(ticketData: Ticket): string {\n    if (this.isNoTicketDate(ticketData)) {\n      return this.getNoTicketDescription(ticketData)\n    } else {\n      return this.getTicketDescription(ticketData)\n    }\n  }\n\n  getLastOpenedTicketDate(ticketData: Ticket): Date {\n    if (this.isNoTicketDate(ticketData)) {\n      return null\n    } else {\n      return new Date(ticketData.createdAt)\n    }\n  }\n\n  getTicketId(ticketData: Ticket): number {\n    return ticketData.ticketId;\n  }\n\n  getTicketUrl(ticketData: Ticket): string {\n    return ticketData.ticketUrl;\n  }\n\n  paginate(event: any) {\n    this.displayTableDataLoading(true)\n  }\n\n  displayTableDataLoading(loading: boolean) {\n    this.isLoadingTableData = loading\n  }\n\n  getTableHeaderDateFields() {\n    return this.tableHeaderDateFields\n  }\n\n  isDataField(fieldName: string) {\n    return this.getTableHeaderDateFields().includes(fieldName)\n  }\n\n  getTableHeaderSortables() {\n    return this.tableHeaderSortables\n  }\n\n  isSortableField(fieldName: string) {\n    return this.getTableHeaderSortables().includes(fieldName)\n  }\n\n  setHeaderDataFieldNames(tableHeaders: Array<NotCommunicationTableHeader>) {\n    this.tableHeaderDateFields = this.getTableHeaderNamesFilteringByField(tableHeaders, 'isDataValue')\n  }\n\n  setHeaderSortables(tableHeaders: Array<NotCommunicationTableHeader>) {\n    this.tableHeaderSortables = this.getTableHeaderNamesFilteringByField(tableHeaders, 'isSortable')\n  }\n\n  getTableHeaderNamesFilteringByField(tableHeaders: Array<NotCommunicationTableHeader>, fieldName: string) {\n    return tableHeaders\n      .filter(tableColumn => tableColumn[fieldName])\n      .map(tableColumn => tableColumn.field)\n  }\n\n\n  sortTableData(event: SortMeta) {\n\n    this.displayTableDataLoading(true)\n\n    if (this.isDataField(event.field)) {\n      this.virtualDatabase = this.virtualDatabase.sort((cameraNotCommunicatingTableDataA, cameraNotCommunicatingTableDataB) => {\n        let dateA = new Date(cameraNotCommunicatingTableDataA[event.field])\n        let dateB = new Date(cameraNotCommunicatingTableDataB[event.field])\n        return dateA.getTime() - dateB.getTime()\n      })\n      if (event.order == -1) {\n        this.virtualDatabase = this.virtualDatabase.reverse()\n      }\n    } else {\n      this.virtualDatabase = this.virtualDatabase.sort((cameraNotCommunicatingTableDataA, cameraNotCommunicatingTableDataB) => {\n        if (event.order == 1) {\n          return (cameraNotCommunicatingTableDataA[event.field] < cameraNotCommunicatingTableDataB[event.field]) ? -1 : 1\n        } else {\n          return (cameraNotCommunicatingTableDataA[event.field] > cameraNotCommunicatingTableDataB[event.field]) ? -1 : 1\n        }\n      })\n    }\n\n  }\n\n  async ngOnInit() {\n    this.displayTableDataLoading(true)\n    this.tableHeaders = this.getTableHeaders()\n    this.virtualDatabase = this.buildVirtualDatabaseFrom(this.camerasWithoutCommunication)\n  }\n\n  getTableHeaders() {\n\n    const tableHeaders = [\n      { field: 'vehiclePlates', header: this.translateJsonService.getTranslateSubs('GLOBAL.vehicle'), width: '', isSortable: true },\n      { field: 'imei', header: 'IMEI', width: '', isSortable: true },\n      { field: 'customerChildName', header: this.translateJsonService.getTranslateSubs('CAMERAS-NOT-COMUNICATION.customer_child_name'), width: '', isDataValue: true, isSortable: true },\n      { field: 'equipmentDate', header: this.translateJsonService.getTranslateSubs('EQUIPMENTS.equipment_datetime'), width: '', isDataValue: true, isSortable: true },\n      { field: 'lastCommunication', header: this.translateJsonService.getTranslateSubs('REQUEST-IMG.last_communication'), width: '', isDataValue: true, isSortable: true },\n      { field: 'vehicleStatus', header: this.translateJsonService.getTranslateSubs('GLOBAL.status'), width: '100px', isSortable: true },\n      { field: 'ticketId', header: this.translateJsonService.getTranslateSubs('CAMERAS-NOT-COMUNICATION.last_opened_ticket_id'), width: '', isSortable: false },\n      { field: 'lastOpenedTicketDescription', header: this.translateJsonService.getTranslateSubs('CAMERAS-NOT-COMUNICATION.last_opened_ticket_description'), width: '', isSortable: false },\n      { field: 'lastOpenedTicketDate', header: this.translateJsonService.getTranslateSubs('CAMERAS-NOT-COMUNICATION.last_opened_ticket_date'), width: '', isDataValue: true, isSortable: false }\n    ]\n\n    this.setHeaderDataFieldNames(tableHeaders)\n    this.setHeaderSortables(tableHeaders)\n\n    return tableHeaders;\n  }\n\n  vehicleStatusFromCode(vehicleStatus: VehicleStatusEnum) {\n    return this.translateJsonService.getTranslateSubs('FILTER-GLOBAL.' + VehicleStatusEnum[vehicleStatus])\n  }\n\n  buildVirtualDatabaseFrom(camerasWithoutCommunication: LastHeartbeat[]): CameraNotCommunicatingTableData[] {\n    return camerasWithoutCommunication.map(cameraWithoutCommunication => {\n      return {\n        vehicleId: cameraWithoutCommunication.vehicle_id,\n        vehiclePlates: cameraWithoutCommunication.vehicle_plate,\n        vehiclePrefix: cameraWithoutCommunication.vehicle_prefix,\n        imei: cameraWithoutCommunication.imei,\n        equipmentDate: cameraWithoutCommunication.datetime,\n        lastCommunication: cameraWithoutCommunication.inserted_on,\n        vehicleStatus: cameraWithoutCommunication.vehicle_status,\n        lastOpenedTicketDescription: null,\n        lastOpenedTicketDate: null,\n        customerChildName: cameraWithoutCommunication.customer_child_name,\n        ticketId: null,\n        ticketUrl: null\n      }\n    })\n  }\n\n  private getVehicleIdsFromTableRows(lastHeartbeat: Array<CameraNotCommunicatingTableRow>) {\n    let allVehicleIds = lastHeartbeat.map(notCommunication =>\n      notCommunication.vehicleId\n    )\n    let uniqueVehicleIds = [...new Set(allVehicleIds)]\n    return uniqueVehicleIds\n  }\n\n  private async getLastTickets(vehiclesIds: Array<number>, ticketStatusList: TicketStatus[]): Promise<Array<Ticket>> {\n    try {\n      return await this.ticketService.getTickets(vehiclesIds, ticketStatusList)\n    } catch (err) {\n      if (err.status == 403) {\n        return vehiclesIds.map(vehicleId => {\n          return {\n            goAwakeVehicleId: vehicleId,\n            queryStatus: TicketQueryStatus[TicketQueryStatus.PERMISSION_DENIED_TO_TICKET_INTEGRATION]\n          }\n        })\n      }\n      return []\n    }\n  }\n\n}\n","import { Component, ElementRef, Input, ViewChild } from '@angular/core'\nimport { AlarmService } from 'app/@core/data/alarm.service'\nimport { TranslateJsonService } from 'app/@core/data/translate-json.service'\nimport { AlarmTypeCodeTranslationEnum } from 'app/@core/enum/alarm-type-code-translation-enum'\nimport { AlarmTypeCodeEnum } from 'app/@core/enum/alarm-type-codes'\nimport { AlarmTypeIconEnum } from 'app/@core/enum/alarm-type-icon.enum'\nimport { AlarmTypeIcon } from 'app/@core/interfaces/alarm-type-icon'\nimport { Chart, ChartData, ChartDataSets, ChartOptions, ChartPoint, ChartTooltipItem } from 'chart.js'\nimport * as moment from 'moment'\nimport {AlarmTypeIconSourcesEnum} from \"../../../@core/enum/alarm-type-icons-sources.enum\";\n\n@Component({\n  selector: 'chart-last-velocities-and-alarms',\n  templateUrl: './chart-last-velocities-and-alarms.component.html',\n  styleUrls: [\n    './chart-last-velocities-and-alarms.component.scss'\n  ]\n})\nexport class ChartLastVelocitiesAndAlarmsComponent {\n\n  @Input()\n  vehicleId: number\n\n  @Input()\n  vehicleLastAlarm: Date\n\n  @Input()\n  driverId: number\n\n  @Input()\n  canvasHeight: string\n\n  @Input()\n  canvasWidth: string\n\n  @ViewChild('chartChartLastVelocitiesAndAlarmsContainer') chartContainer: ElementRef<HTMLDivElement>;\n\n  chartCanvas: HTMLCanvasElement\n  chart: Chart\n  isCompact: boolean = false\n  xAxisMaxLabelsTimeline = 13\n  yAxisInMovement = 1\n  yAxisStopped = 0\n  alarmIconsDimensions = {\n    width: 64,\n    height: 64\n  }\n  displayLoader = true\n  alarmDatasetIndexList: Array<number> = []\n  chartTitle: string = ''\n  alarmArrowColor: string = '#f05b2e'\n\n\n  constructor(\n    private alarmService: AlarmService,\n    protected translateJsonService: TranslateJsonService\n  ) { }\n\n  public async getChartParameters(vehicleId: number, driverId: number, lastAlarm: Date): Promise<{\n    context: string | CanvasRenderingContext2D | HTMLCanvasElement | ArrayLike<CanvasRenderingContext2D | HTMLCanvasElement>,\n    configuration: Chart.ChartConfiguration\n  }> {\n\n    if (driverId) {\n      this.chartTitle = this.translateJsonService.getTranslateSubs('CHART-LAST-VELOCITIES-AND-ALARMS.driver-chart-name')\n    } else {\n      this.chartTitle = this.translateJsonService.getTranslateSubs('CHART-LAST-VELOCITIES-AND-ALARMS.vehicle-chart-name')\n    }\n\n    let chartLastVelocitiesAndAlarmsData = await this.getChartLastVelocitiesAndAlarmsData(vehicleId, driverId, lastAlarm)\n    let alarmsDataset = await this.getAlarmsDataset(chartLastVelocitiesAndAlarmsData)\n    let velocityDataset = this.getVelocitiesDataset(chartLastVelocitiesAndAlarmsData)\n\n    let xAxisLabels = this.getLabels(lastAlarm)\n    let options = this.getChartOptions(new Date(xAxisLabels[0]))\n    let datasets = [...alarmsDataset, ...velocityDataset]\n\n    return {\n      context: this.getNewChartCanvas(),\n      configuration: {\n        type: 'line',\n        data: {\n          labels: xAxisLabels,\n          datasets: datasets\n        },\n        options: options\n      }\n    }\n  }\n\n  public async renderChartInHtmlComponent(vehicleId: number, driverId: number, lastAlarm: Date) {\n\n    this.displayLoader = true\n\n    if (this.chartCanvas) {\n      this.chartCanvas.parentElement.removeChild(this.chartCanvas)\n    }\n\n    let chartParameters = await this.getChartParameters(vehicleId, driverId, lastAlarm)\n\n    this.chart = new Chart(\n      chartParameters.context,\n      chartParameters.configuration\n    )\n    this.displayLoader = false\n  }\n\n  getChartOptions(xAxisMinDateToDisplay: Date): ChartOptions {\n\n    let options: ChartOptions = {\n      responsive: true,\n      maintainAspectRatio: false,\n      title: {\n        text: this.chartTitle,\n        display: true\n      },\n      legend: {\n        display: false\n      },\n      tooltips: {\n        enabled: true,\n        mode: 'point',\n        intersect: true,\n        backgroundColor: 'rgba(0,0,0,0.7)',\n        titleFontColor: 'white',\n        bodyFontColor: 'white',\n        displayColors: false,\n        callbacks:this.getTooltipCallbacks()\n      },\n      scales: {\n        xAxes: [\n          {\n            gridLines: {\n              display: true\n            },\n            scaleLabel: {\n              display: false,\n            },\n            type: \"time\",\n            time: {\n              unit: \"hour\",\n              displayFormats: {\n                hour: this.translateJsonService.getTranslateSubs(`CHART-LAST-VELOCITIES-AND-ALARMS.x-axis-datetime-format`),\n              },\n              min: xAxisMinDateToDisplay.toISOString()\n            }\n          }\n        ],\n        yAxes: [\n          {\n            gridLines: {\n              display: true\n            },\n            scaleLabel: {\n              display: true,\n              labelString: this.translateJsonService.getTranslateSubs(`CHART-LAST-VELOCITIES-AND-ALARMS.y-axis-label`)\n            },\n            ticks: {\n              beginAtZero: true,\n              suggestedMin: 0,\n              suggestedMax: 3,\n              display: false\n            }\n          }\n        ]\n      }\n    }\n    return options\n  }\n\n  public async getAlarmsDataset(chartLastVelocitiesAndAlarms: ChartLastVelocitiesAndAlarms): Promise<ChartDataSets[]> {\n\n    this.alarmDatasetIndexList = [];\n\n    let alarms = chartLastVelocitiesAndAlarms.alarms.data\n    let alarmsGroupedByType = this.groupLastAlarmsByField(alarms, 'alarmTypeCode')\n\n    let alarmsDataset: Array<ChartDataSets> = []\n    let alarmsArrowsDataset: Array<ChartDataSets> = []\n\n    let indexAux = 0;\n\n    for (let alarmTypeCode in alarmsGroupedByType) {\n      if (!alarmsGroupedByType.hasOwnProperty(alarmTypeCode)) {\n        continue\n      }\n      let group = alarmsGroupedByType[alarmTypeCode];\n\n      let data = group.map((alarm: LastAlarms) => {\n        return {\n          t: alarm.datetime,\n          y: this.yAxisInMovement + 1,\n          alarmType: AlarmTypeCodeEnum[alarm.alarmTypeCode],\n          alarmDatetime: alarm.datetime\n        }\n      })\n\n      let firstAlarm = group[0]\n      let alarmTypeIconEnum = AlarmTypeIconEnum[AlarmTypeCodeEnum[firstAlarm.alarmTypeCode]]\n      if (!alarmTypeIconEnum) {\n        alarmTypeIconEnum = AlarmTypeIconEnum.UNKNOWN;\n      }\n      alarmsDataset.push({\n        pointStyle: await this.createCanvasImage(alarmTypeIconEnum),\n        label: AlarmTypeCodeEnum[firstAlarm.alarmTypeCode],\n        data: data,\n        showLine: false,\n        radius: 30,\n        pointHoverRadius: 25\n      })\n      this.alarmDatasetIndexList.push(indexAux)\n      indexAux++;\n\n      this.alarmDatasetIndexList = alarmsDataset.map((_alarm, index) => index)\n\n      alarmsArrowsDataset.push({\n        pointStyle: this.createCanvasImageArrow(),\n        label: `${AlarmTypeCodeEnum[firstAlarm.alarmTypeCode]}_ARROW`,\n        data: data,\n        showLine: false,\n        radius: 0,\n\n      })\n\n    }\n\n    return alarmsDataset.concat(alarmsArrowsDataset)\n  }\n\n\n  getTooltipCallbacks(): any {\n    return {\n      label: (tooltipItem: ChartTooltipItem, data: ChartData) => {\n        const datasetIndex = tooltipItem.datasetIndex;\n        const dataPoint = data.datasets[datasetIndex].data[tooltipItem.index] as any;\n  \n        if (this.alarmDatasetIndexList.includes(datasetIndex)) {\n          const tooltipDate = moment(dataPoint.t);\n          return `${tooltipDate.format('HH:mm:ss')}`;\n        }\n  \n        if (data.datasets[datasetIndex].label === 'first stop') {\n          const tooltipDate = moment(dataPoint.t || dataPoint.x || dataPoint.stopDatetime);\n          return `${this.translateJsonService.getTranslateSubs('C