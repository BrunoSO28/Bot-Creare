mpanyName = workspace.dealerName;\n        }\n\n        this.selItemAlarmTypes = this.dataService.alarmTypesNumber;\n        const alarmTypeEntries: [number, AlarmType][] = this.selItemAlarmTypes.map(\n            (at): [number, AlarmType] => [Number(at.value), at]\n        );\n        this.alarmTypeMap = new Map<number, AlarmType>(alarmTypeEntries);\n\n        this.tableAlertsCols = [\n            { field: 'checkbox', header: '' },\n            { field: 'group', header: '' },\n            { field: 'id', header: '#' },\n            { field: 'vehicle_plates', header: this.translateJsonService.getTranslateSubs('GLOBAL.plate') },\n            { field: 'driver_firstname', header: this.translateJsonService.getTranslateSubs('GLOBAL.driver') },\n            { field: 'datetime', header: this.translateJsonService.getTranslateSubs('TREATMENT-MODAL.alarm_date') },\n            { field: 'availableMediaAt', header: this.translateJsonService.getTranslateSubs('TREATMENT-MODAL.available_at')},\n            { field: 'typeAlarmDescription', header: this.translateJsonService.getTranslateSubs('GLOBAL.type') },\n            { field: 'aiEvaluationStatus', header: '' },\n            { field: 'treatment', header: '' },\n            { field: 'alarmRead', header: '' },\n            { field: 'vehicle_prefix', header: '' }\n        ]\n    }\n\n    ngOnInit(){\n        this.workspaceRef = this.dataService.getWorkspace();\n        this.changeOnlineState();\n        this.verifyNotification();\n        this.getCustomerIdUser();\n        this.portalPageAccess = this.dataService.verifyPortalPageAccess();\n        this.telemetryState.getHidePopupsEvents$().subscribe((isHiding: boolean) => {\n            this.hidePopupsEvents = isHiding;\n        });\n        this.loadEvents();\n        this.intervalEvents = setInterval(() => {\n          this.loadEvents();\n        }, 30000);\n    }\n\n    ngOnDestroy() {\n        this.isOnlineChecked = false;\n        this.clearPendingTimeouts();\n        this.destroy$.next();\n        this.destroy$.complete();\n        this.unsubscribeData();\n        this.workspaceService.setBotaoOnline(this.isOnlineChecked);\n        if (this.intervalEvents) {\n          clearInterval(this.intervalEvents);\n        }\n    }\n\n    private loadEvents() {\n        this.telemetryState.setLoadingEvents(true);\n        const sevenDaysInMilisSeconds = 604800000;\n        const dateNow = new Date();\n        const dateStart = dateNow.getTime() - sevenDaysInMilisSeconds;\n        const customersChildId = this.dataService.getCustomersIdFromPermissions();\n        const displayReaded = false;\n        const displayAllTypes = false;\n        this.telemetryService\n          .getEvents(\n            customersChildId.map(id => id.toString()),\n            [],\n            [],\n            new Date(dateStart),\n            dateNow,\n            displayReaded,\n            displayAllTypes\n          )\n          .then((result) => {\n            this.telemetryState.updateEvents(result);\n            this.telemetryState.setLoadingEvents(false);\n          })\n          .catch((error) => {\n            console.error('Erro ao carregar eventos na V3:', error);\n            this.telemetryState.setLoadingEvents(false);\n          });\n    }\n\n    closeNotification() {\n        window.localStorage.setItem('notice', 'seen');\n        this.noticeViewed = 'seen';\n    }\n\n    verifyNotification() {\n        let localNotice: string | null = null;\n        try {\n            localNotice = localStorage.getItem('notice');\n        } catch {}\n        this.noticeViewed = localNotice || 'notSeen';\n    }\n\n    public getFilterAlarms(): FilterAlarms {\n        let _filterData: FilterAlarms = new FilterAlarms();\n        let kp: Workspace = this.workspaceRef || this.dataService.getWorkspace();\n\n        if (this.workspaceHasSelectedFilterAlarms(kp)) {\n            this.filterSelectedData = (kp.selectedFilterAlams) ? kp.selectedFilterAlams : new FilterAlarms();\n            if(this.workspaceService.getBotaoOnline()){\n                this.requestAlarmData(true);\n            } else {\n                this.loadingTable = false;\n            }\n            this.fetchLastHeartbeat(this.filterSelectedData.selectedCustomers, true);\n        }\n        return _filterData;\n    }\n\n    private normalizeSelectedCustomers(filter: FilterAlarms): void {\n        if (filter.selectedCustomers && filter.selectedCustomers.length > 0) {\n            return;\n        }\n\n        const ws = this.workspaceRef || this.dataService.getWorkspace();\n        if (ws && ws.userCustomerChildIds) {\n            filter.selectedCustomers = ws.userCustomerChildIds.map(\n                (customerChildsPermissions : customerChildsPermissions) => customerChildsPermissions.customer\n            );\n        }\n    }\n\n    private buildFilter(filter: FilterAlarms): DefaultFilter {\n        if (this.isOnlineChecked) this.changeOnlineInterval();\n        const defaultFilter = new DefaultFilter();\n        defaultFilter.custIds = filter.selectedCustomers;\n        defaultFilter.date1 = this.configService.convertDateToIsoString(filter.selectedDateStart);\n        defaultFilter.date2 = this.configService.convertDateToIsoString(filter.selectedDateEnd);\n        defaultFilter.alarmTypes = filter.selectedAlarmTypes;\n        defaultFilter.driverIds = filter.selectedDrivers;\n        defaultFilter.vehicleIds = filter.selectedVehicles;\n        defaultFilter.timezone = this.dataService.getBrowserTimezoneOffset();\n        return defaultFilter;\n    }\n\n    public requestAlarmData(subscribe: boolean) {\n        this.loadingTable = true;\n        this.telemetryState.setLoadingEvents(true);\n        const _filter: FilterAlarms = this.filterSelectedData;\n        this.normalizeSelectedCustomers(_filter);\n\n        if (!_filter.isValidFilter()) {\n            this.loadingTable = false;\n            this.isLoadingAlarms = false;\n            this.updateRequestInProgress(false);\n            this.notificationService.printWarningMessage(this.getTranslateSubs('FILTER-GLOBAL.msg_notfilter'));\n            return;\n        }\n\n        this.loadTreatmentAlarmsCount();\n        this.fetchLastHeartbeat(_filter.selectedCustomers, false);\n        this.satelliteNotificationsList();\n\n        this.clearRetryRequestTimeout();\n        if (_filter.isValidFilter()) {\n            this.updateRequestInProgress(true);\n    \n            this.alarmService.getAlarmsByFilterDefaultV3(this.buildFilter(_filter))\n                .pipe(\n                    finalize(() => {\n                        this.isLoadingAlarms = false;\n                        this.loadingTable = false;\n                        this.isSubscribed = false;\n                        this.updateRequestInProgress(false);\n                        this.telemetryState.setLoadingEvents(false);\n                    })\n                )\n                .subscribe(\n                (_alarms: Array<Alarm>) => {\n                    if (_alarms.length < 1) {\n                        if (!subscribe) {\n                            this.notificationService.printWarningMessage(this.getTranslateSubs('PAGE-PORTAL.msg_no_results'));\n                        }\n                        this.getLocalAlarmData([]);\n                        this.loadingTable = false;\n                        this.isLoadingAlarms = false;\n                        this.telemetryState.updateEvents([]);\n                    } else {\n                        this.getLocalAlarmData(this.updateAlarmsWithDelayAndTimeRead(_alarms));\n                    }\n    \n                    if (subscribe) {\n                        this.subscribeToData();\n                    }\n                },\n                error => {\n                    if (subscribe) {\n                        this.retryRequestTimeoutId = setTimeout(() => {\n                            this.retryRequestTimeoutId = null;\n                            this.requestAlarmData(true);\n                        }, FatigueV3Component.RETRY_REQUEST_DELAY_MS);\n                    } else {\n                        this.notificationService.printErrorMessage(this.getTranslateSubs('FILTER-GLOBAL.msg_notresult'));\n                    }\n                    this.loadingTable = false;\n                    this.isLoadingAlarms = false;\n                }\n            );\n        }\n    }\n    \n\n    public subscribeToData(): void {\n        if (this.isSubscribed) return;\n\n        this.isSubscribed = true;\n\n        this.alarmSubscription = observableTimer(30000).pipe(takeUntil(this.destroy$)).subscribe(() => this.requestLoadAlarms());\n    }\n\n    public unsubscribeData(): void {\n        if (this.alarmSubscription) {\n            this.alarmSubscription.unsubscribe();\n            this.alarmSubscription = undefined;\n        }\n        this.isSubscribed = false;\n        this.updateRequestInProgress(false);\n    }\n\n    private requestLoadAlarms(): void {\n        if(!this.isOnlineChecked) {\n            this.unsubscribeData();\n            return;\n        }\n\n        if (this.isLoadingAlarms) return;\n        this.isLoadingAlarms = true;\n        this.changeOnlineInterval();\n        this.requestAlarmData(true);\n    }\n\n    public changeOnlineInterval(interval?: number) {\n        if (interval == null || !Number.isFinite(interval)) {\n            const ws = this.workspaceRef || this.dataService.getWorkspace();\n            const fromWs = ws && typeof ws.onlineTimeInterval === 'number' ? ws.onlineTimeInterval : Number.NaN;\n            interval = Number.isFinite(fromWs) && fromWs > 0 ? fromWs : 1;\n        }\n\n        let today: Date = new Date(),\n            todayLast: Date = new Date(),\n            todayForward: Date = new Date();\n\n            todayLast.setHours(today.getHours() - 1 * interval);\n            todayForward.setHours(today.getHours());\n\n        this.filterSelectedData.selectedDateStart = todayLast;\n        this.filterSelectedData.selectedDateEnd = todayForward;\n    }\n\n    private getLocalAlarmData(alertList: Alarm[]): void {\n        const { processedAlarms, chartsValues, markers } = this.processSinglePass(alertList);\n\n        this.alerts = processedAlarms;\n        this.chartsValues = chartsValues;\n        this.allMarkers = markers;\n\n        const oldAlerts = this.dataService.getAlarmList();\n        this.verifyNewAlerts(oldAlerts, this.alerts);\n        this.dataService.setAlarmList([...this.alerts]);\n        this.dataService.registerAlarms(this.alerts);\n\n        this.groupedAlerts = this.groupingAlertsByRiskGroup(this.alerts);\n        this.groupingDistinctVehiclesAndDriversByRiskGroup();\n        this.tableDataAlerts = this.groupOrUngroupAlerts(this.alertsGrouped);\n\n        this.loadingTable = false;\n        this.loadingMap = false;\n        this.updateIsCheckAllDisabled();\n\n\n        // Não-bloqueante: status de movimento carregado após renderização inicial da tabela\n        const imeisWithFatigueAlarms = this.setUniqueAssetsWithFatigueAlarms(this.alerts);\n        if (imeisWithFatigueAlarms.length > 0) {\n            this.getMovimentStatus(imeisWithFatigueAlarms, this.alerts);\n        }\n    }\n\n    /**\n     * Passagem única sobre a lista de alarmes:\n     * - filtra typeAlarm === 0\n     * - normaliza groupRisk/groupAlarm\n     * - inicializa groupAlarmsChild\n     * - aplica typeAlarmDescription e iconPath\n     * - acumula contadores de risco (chartsValues)\n     * - constrói markers do mapa\n     */\n    private processSinglePass(alertList: Alarm[]): {\n        processedAlarms: Alarm[];\n        chartsValues: { 'high-risk': number; 'medium-risk': number; 'low-risk': number; 'no-alerts': number };\n        markers: ModelMarkers[];\n    } {\n        const cv = { 'high-risk': 0, 'medium-risk': 0, 'low-risk': 0, 'no-alerts': 0 };\n        const markers: ModelMarkers[] = [];\n        const processedAlarms: Alarm[] = [];\n\n        for (const a of alertList) {\n            if (a.typeAlarm === 0) continue;\n\n            if (a.groupRisk !== 2 && a.groupRisk !== 1) {\n                a.groupRisk = 0;\n                a.groupAlarm = 0;\n            }\n            a.groupAlarmsChild = [];\n\n            const alarm: Alarm = { ...a, timeZone: a.timeZone };\n\n            const alarmType = (alarm.typeAlarm) ? this.alarmTypeMap.get(alarm.typeAlarm) : null;\n            if (alarmType) {\n                alarm.typeAlarmDescription = this.translateService.instant(alarmType.label);\n                alarm.iconPath = alarmType.icon;\n            }\n\n            switch (alarm.groupRisk) {\n                case 0: cv['low-risk']++; break;\n                case 1: cv['medium-risk']++; break;\n                case 2: cv['high-risk']++; break;\n            }\n\n            markers.push({\n                id: alarm.id,\n                name: `Alerta ${alarm.id} - ${alarm.driver_firstname}`,\n                category: alarm.typeAlarm,\n                type: alarm.typeAlarm,\n                enabled: true,\n                latitude: alarm.latitude,\n                longitude: alarm.longitude\n            } as ModelMarkers);\n\n            processedAlarms.push(alarm);\n        }\n\n        return { processedAlarms, chartsValues: cv, markers };\n    }\n\n\n    private getMovimentStatus(imeis: string[], alerts: Alarm[]): Promise<void> {\n        return this.movimentStatusService.getMovimentStatus(imeis).then(result => {\n            this.movimentStatus = result;\n            // Map pre-indexado por device_id: O(m) build + O(1) lookup por alarme\n            const statusByDevice = new Map<string, any>(\n                result.map((m: any) => [String(m.device_id), m])\n            );\n            const dateNow = new Date();\n            for (const alert of alerts) {\n                const found = statusByDevice.get(String(alert.imei));\n                if (found) {\n                    const initialDate = new Date(found.initial_date);\n                    alert.assetMovimentStatus = {\n                        inMoviment: found.status === 'EM_MOVIMENTO',\n                        status: found.status,\n                        initialDate,\n                        duration: this.dataService.diff(initialDate, dateNow)\n                    };\n                }\n            }\n        }).catch(err => { throw err; });\n    }\n\n    private setUniqueAssetsWithFatigueAlarms(alarms: Alarm[]): string[] {\n        const list: string[] = alarms\n            .filter(a => a.typeAlarm === AlarmTypeEnum[\"TYPES-ALERT.atten_warning\"] || a.typeAlarm === AlarmTypeEnum[\"TYPES-ALERT.tired\"]\n                || a.typeAlarm === AlarmTypeEnum[\"TYPES-ALERT.accumulated_drowsiness\"]\n                || a.typeAlarm === AlarmTypeEnum[\"TYPES-ALERT.incompatible_glasses\"])\n            .map(a => a.imei)\n            .filter((imei): imei is string => imei !== undefined);\n\n        const unique = new Set<string>(list);\n\n        return [...unique];\n    }\n\n    groupOrUngroupAlerts(agroupAlerts : boolean): Alarm[] {\n        return (agroupAlerts) ? this.groupedAlerts : this.alerts;\n    }\n\n    groupingAlertsByRiskGroup(alerts: Alarm[]): Alarm[] {\n        const groupedAlerts: Alarm[] = [];\n        // Map: primary key (sem driverId) → lista de cabeçalhos de grupo com esse mesmo veículo/tipo/risco\n        const primaryMap = new Map<string, Alarm[]>();\n\n        // Mesmo efeito prático do AS-IS (JSON.stringify no clone): datetime comparável como string.\n        // Sem isso, Date/undefined quebram localeCompare e o agrupamento falha — tabela vazia com cards ok.\n        const sortedAlarms = [...alerts].sort((compA: any, compB: any) => {\n            const sa = compA.datetime == null ? '' : String(compA.datetime);\n            const sb = compB.datetime == null ? '' : String(compB.datetime);\n            return sb.localeCompare(sa);\n        });\n\n        for (const a of sortedAlarms) {\n            const primaryKey = `${a.groupAlarm}|${a.typeAlarm}|${a.vehicleId}|${a.groupRisk}`;\n            const candidates = primaryMap.get(primaryKey);\n\n            let gAlerts: Alarm | null = null;\n            if (candidates) {\n                // Busca apenas dentro do subconjunto com mesma chave primária (geralmente 1 elemento)\n                gAlerts = candidates.find(ga =>\n                    ga.driverId == a.driverId || a.driverId == null || a.driverId === undefined ||\n                    ga.driverId == null || ga.driverId === undefined\n                ) || null;\n            }\n\n            if (gAlerts) {\n                if (!gAlerts.groupAlarmsChild) gAlerts.groupAlarmsChild = [];\n                gAlerts.groupAlarmsChild.push({ ...a, timeZone: a.timeZone });\n            } else {\n                const newGroup: Alarm = { ...a, timeZone: a.timeZone, groupAlarmsChild: [] };\n                groupedAlerts.push(newGroup);\n                if (candidates) {\n                    candidates.push(newGroup);\n                } else {\n                    primaryMap.set(primaryKey, [newGroup]);\n                }\n            }\n        }\n        return groupedAlerts;\n    }\n\n    isDrowsinesL1OrConfirmation(typeAlarm:number){\n        return [AlarmTypeEnum[\"TYPES-ALERT.drowsiness_l1_confirmation\"], AlarmTypeEnum[\"TYPES-ALERT.atten_warning\"]].includes(typeAlarm);\n    }\n    \n    isDrowsinesL2OrConfirmation(typeAlarm: number) {\n        return [AlarmTypeEnum[\"TYPES-ALERT.drowsiness_l2_confirmation\"], AlarmTypeEnum[\"TYPES-ALERT.tired\"]].includes(typeAlarm);\n    }\n\n    groupingDistinctVehiclesAndDriversByRiskGroup() {\n        this.groupedUniqueVehiclesAndDriversByRisk = [\n            {'risk': 0, 'vehicles': [], 'drivers': []},\n            {'risk': 1, 'vehicles': [], 'drivers': []},\n            {'risk': 2, 'vehicles': [], 'drivers': []},\n            {'risk': 3, 'vehicles': [], 'drivers': []}\n        ];\n\n        // Mapas de Set por risco para lookup O(1) de duplicatas\n        const vehicleIdSets: Set<number>[] = [new Set(), new Set(), new Set(), new Set()];\n        const driverIdSets: Set<number>[] = [new Set(), new Set(), new Set(), new Set()];\n\n        for (const alarm of this.alerts) {\n            const riskIdx = alarm.groupRisk && alarm.groupRisk >= 0 && alarm.groupRisk <= 3 ? alarm.groupRisk : 0;\n            const gv = this.groupedUniqueVehiclesAndDriversByRisk[riskIdx];\n\n            if (alarm.vehicleId && (!vehicleIdSets[riskIdx].has(alarm.vehicleId))) {\n                vehicleIdSets[riskIdx].add(alarm.vehicleId);\n                gv.vehicles.push({\n                    id: alarm.vehicleId,\n                    identification: alarm.vehicle_plates || '',\n                    name: alarm.vehicle_prefix || '',\n                    customerChildId: alarm.customer_child_id\n                });\n            }\n\n            if (alarm.driverId && (!driverIdSets[riskIdx].has(alarm.driverId))) {\n                driverIdSets[riskIdx].add(alarm.driverId);\n                gv.drivers.push({\n                    id: alarm.driverId,\n                    identification: alarm.driver_firstname || '',\n                    name: alarm.driver_firstname || '',\n                    customerChildId: alarm.customer_child_id\n                });\n            }\n        }\n\n        // SEM RISCO — veículos sem alarme\n        const noRisk = this.groupedUniqueVehiclesAndDriversByRisk[3];\n        const alertVehicleIds = new Set<number>(\n            this.alerts\n                .map(a => a.vehicleId)\n                .filter((id): id is number => id !== undefined)\n        );\n\n        for (const heartBeat of this.heartbeatComunication) {\n            if (!alertVehicleIds.has(heartBeat.vehicle_id)) {\n                const asset: Asset = new Asset();\n                asset.id = heartBeat.vehicle_id;\n                asset.name = heartBeat.vehicle_plate;\n                asset.identification = heartBeat.vehicle_prefix;\n                noRisk.vehicles.push(asset);\n            }\n        }\n\n        this.chartsValues['no-alerts'] = noRisk.vehicles.length;\n    }\n\n    getAlarmType(value: number | undefined): AlarmType | undefined {\n        if (value === undefined) {\n            return undefined;\n        }\n        return this.alarmTypeMap.get(value);\n    }\n\n    convertAlarmInMarker(alerts: Alarm[]): ModelMarkers[] {\n        const markers: ModelMarkers[] = [];\n        for (const alarm of alerts) {\n            markers.push({\n                id: alarm.id,\n                name: 'Alerta ' + alarm.id + ' - ' + alarm.driver_firstname,\n                category: alarm.typeAlarm,\n                type: alarm.typeAlarm,\n                enabled: true,\n                latitude: alarm.latitude,\n                longitude: alarm.longitude\n            } as ModelMarkers);\n        }\n        return markers;\n    }\n\n    private getTranslateSubs(key: string): string {\n        return this.translateService.instant(key);\n    }\n\n    filterGroupRisk(groupRisk: number) {\n        const index = this.groupSelected.indexOf(groupRisk);\n\n        if(index > -1){\n            this.groupSelected.splice(index, 1);\n        }else{\n            this.groupSelected.push(groupRisk);\n        }\n\n        if(this.groupSelected.length >= 3){\n            this.groupSelected = [];\n        }\n\n        this.updateIsCheckAllDisabled();\n\n        this.dt.filter(this.groupSelected, 'groupRisk', 'in');\n    }\n\n    filterVehicleOrDriver(assetId: number, assetSelected, assetCol: string) {\n        const index = assetSelected.indexOf(assetId);\n\n        if(index > -1){\n            assetSelected.splice(index, 1);\n        }else{\n            assetSelected.push(assetId);\n        }\n\n        this.dt.filter(assetSelected, assetCol, 'in');\n    }\n\n    onFilterTable($event){\n        const alarms = $event.filteredValue || [];\n        this.allMarkers = alarms.length > 0 ? this.convertAlarmInMarker(alarms) : [];\n    }\n\n    changeIconTreatment({alertIds, treatmentStarted}: {alertIds: number[], treatmentStarted: boolean}) {\n        if (!this.hasTableDataAlerts()) {\n            return;\n        }\n        const indexEntries: [number, number][] = this.tableDataAlerts.map((a, idx): [number, number] => [a.id, idx]);\n        const indexMap = new Map<number, number>(indexEntries);\n        const startedAtIso = new Date().toISOString();\n        for (const alarmId of alertIds) {\n            const indexTableAlert = indexMap.get(alarmId);\n            if (indexTableAlert === undefined) {\n                continue;\n            }\n            const row = this.tableDataAlerts[indexTableAlert];\n            if (treatmentStarted) {\n                if (!row.treatmentStartedAt) {\n                    row.treatmentStartedAt = startedAtIso;\n                }\n            } else {\n                row.treatmentStartedAt = null;\n            }\n        }\n    }\n\n    async openTreatmentModal(alert : Alarm, relatedAlarms: Alarm[]){\n        const ws = this.workspaceRef || this.dataService.getWorkspace();\n        const hasCentralPermission = this.workspaceHasCentralPermission(ws);\n\n        if(hasCentralPermission && !alert.treatmentStartedAt) {\n            alert.treatmentStartedAt = new Date().toISOString();\n        }\n\n        const alarmsGrouped = [alert, ...relatedAlarms];\n        const alarmsUpdated = await this.setReadAlarm(alarmsGrouped);\n        const relatedIds = new Set<number>(relatedAlarms.map(a => a.id));\n        const relatedAlarmsChecked = alarmsUpdated.filter(alarm => relatedIds.has(alarm.id));\n        const updatedEntries: [number, Alarm][] = alarmsUpdated.map((a): [number, Alarm] => [a.id, a]);\n        const updatedMap = new Map<number, Alarm>(updatedEntries);\n        alarmsGrouped.forEach(alarm => {\n            const checkCurAlarm = updatedMap.get(alarm.id);\n            if (checkCurAlarm) {\n                alarm.alarmRead = checkCurAlarm.alarmRead;\n                alarm.alarmReadByUsername = checkCurAlarm.alarmReadByUsername;\n                alarm.urlMovies = checkCurAlarm.urlMovies;\n                alarm.urlPictures = checkCurAlarm.urlPictures;\n                if (checkCurAlarm.datetimestampFormatted != null) alarm.datetimestampFormatted = checkCurAlarm.datetimestampFormatted;\n                if (checkCurAlarm.availableMediaAtTimestampFormatted != null) alarm.availableMediaAtTimestampFormatted = checkCurAlarm.availableMediaAtTimestampFormatted;\n            }\n        });\n        this.treatmentFlowService.setAlarms(alarmsGrouped);\n        this.showTreatmentModal(this.actionModal, alert, relatedAlarmsChecked, true);\n    }\n\n    async openTreatmentModalToAudit (alert : Alarm, relatedAlarms: Alarm[], actionModal, showTreatment){\n        const alarmsGrouped = [alert, ...relatedAlarms];\n        const alarmsUpdated = await this.setReadAlarm(alarmsGrouped);\n        const relatedIdsAudit = new Set<number>(relatedAlarms.map(a => a.id));\n        const relatedAlarmsChecked = alarmsUpdated.filter(alarm => relatedIdsAudit.has(alarm.id));\n        const updatedAuditEntries: [number, Alarm][] = alarmsUpdated.map((a): [number, Alarm] => [a.id, a]);\n        const updatedMapAudit = new Map<number, Alarm>(updatedAuditEntries);\n        alarmsGrouped.forEach(alarm => {\n            const checkCurAlarm = updatedMapAudit.get(alarm.id);\n            if (checkCurAlarm) {\n                if (checkCurAlarm.datetimestampFormatted != null) alarm.datetimestampFormatted = checkCurAlarm.datetimestampFormatted;\n                if (checkCurAlarm.availableMediaAtTimestampFormatted != null) alarm.availableMediaAtTimestampFormatted = checkCurAlarm.availableMediaAtTimestampFormatted;\n            }\n        });\n        this.treatmentFlowService.setAlarms(alarmsGrouped);\n\n        this.showTreatmentModal(actionModal, alert, relatedAlarmsChecked, showTreatment);\n    }\n\n    closeTreatmentModal() {\n        this.actionModal.hide();\n    }\n\n    closeTreatmentModalToAudit(actionModal) {\n        actionModal.hide();\n    }\n\n    onHideActionTreatmentModal() {\n        this.selectedAction = undefined;\n        this.relatedAlarms = undefined;\n        this.showTreatment = false;\n        this.treatmentFlowService.reset();\n    }\n\n    private showTreatmentModal(actionModal: ModalDirective, alert: Alarm, relatedAlarmsChecked: Alarm[], showTreatment: boolean): void {\n        this.selectedAction = undefined;\n        this.relatedAlarms = undefined;\n        this.showTreatment = false;\n\n        this.selectedAction = alert;\n        this.relatedAlarms = relatedAlarmsChecked;\n        this.showTreatment = showTreatment;\n\n        setTimeout(() => {\n            actionModal.show();\n        });\n    }\n\n    removeAlarmsByIdList(ids: string[]) {\n        const batchSelectedSet = new Set<number>(this.alarmIdsBatchTreatmentList);\n        const idsSet = new Set<number>(ids.map((id) => Number.parseInt(id, 10)));\n        let alertsNotAudited = this.dataService.getFilteredAlarmDtoList().reduce((acumAlarms: Alarm[], alarm: Alarm) => {\n\n            if (batchSelectedSet.has(alarm.id)) {\n                alarm.isSelected = true;\n            }\n\n            if (!idsSet.has(alarm.id)) {\n                acumAlarms.push(alarm);\n            }\n            return acumAlarms;\n        }, []);\n\n        this.dataService.clearAlarms();\n        this.dataService.registerAlarms(alertsNotAudited);\n\n        this.getLocalAlarmData(this.alerts);\n    }\n\n    applyTypeAlertDescriptionInAll(alerts: Alarm[]): void {\n        for (const element of alerts) {\n            const alarmType = this.getAlarmType(element.typeAlarm);\n            if (!alarmType) continue;\n            element.typeAlarmDescription = this.translateService.instant(alarmType.label);\n            element.iconPath = alarmType.icon;\n        }\n    }\n\n    async fetchLastHeartbeat(selectedCustomersChild: number[], haveRefresh: boolean) {\n        this.loadingEquipInfos = true;\n        let listHeartbeat: LastHeartbeat[] = await this.heartbeatService.fetchLastHeartbeatByCustomersChild(selectedCustomersChild);\n\n        const COMUNICATING = this.checkCommunicatingImeisInDays(listHeartbeat, 1);\n        const comunicatingIds = new Set<number>(COMUNICATING.map(h => h.vehicle_id));\n        const notComunicatingWithStatus: LastHeartbeat[] = [];\n        for (const heartbeat of listHeartbeat) {\n            if (comunicatingIds.has(heartbeat.vehicle_id)) {\n                continue;\n            }\n            if (heartbeat.vehicle_status !== 1 && heartbeat.vehicle_status !== 2) {\n                continue;\n            }\n            if (heartbeat.datetime) {\n                heartbeat.datetime = new Date(heartbeat.datetime);\n            }\n            notComunicatingWithStatus.push(heartbeat);\n        }\n        this.heartbeatNotComunication = notComunicatingWithStatus;\n        const MAINTENANCE_STANDBY = listHeartbeat.filter(result => result.vehicle_status == 3 || result.vehicle_status == 4);\n        this.heartbeatMaintenanceStandby = this.convertTimeStampToDate(MAINTENANCE_STANDBY);\n        this.heartbeatComunication = COMUNICATING;\n        this.heartBeatAll = listHeartbeat;\n\n        this.loadingEquipInfos = false;\n\n        if(haveRefresh) this.refreshlastHeartbeat();\n    }\n\n    satelliteNotificationsList() {\n        this.satelliteNotificationsService.getSatNotificationsList(this.buildFilter(this.filterSelectedData))\n            .then((res) => {\n                this.satelliteNotification = res;\n            });\n    }\n\n    refreshlastHeartbeat(){\n        this.clearHeartbeatRefreshTimeout();\n        this.heartbeatRefreshTimeoutId = setTimeout(() => {\n            this.heartbeatRefreshTimeoutId = null;\n            this.fetchLastHeartbeat(this.filterSelectedData.selectedCustomers, true)\n        }, FatigueV3Component.HEARTBEAT_REFRESH_DELAY_MS)\n    }\n\n    checkNotCommunicationgImeis(heartbeats: LastHeartbeat[], comunicating: LastHeartbeat[]): LastHeartbeat[] {\n        const comunicatingIds = new Set<number>(comunicating.map(h => h.vehicle_id));\n        return heartbeats.filter((heartbeat) => !comunicatingIds.has(heartbeat.vehicle_id));\n    }\n\n    checkCommunicatingImeisInDays(heartbeats: LastHeartbeat[], days: number) {\n        const maxTimeMs = Date.now() - (days * 86400000);\n        return heartbeats.filter(heartbeat => new Date(heartbeat.inserted_on).getTime() >= maxTimeMs);\n    }\n\n    convertTimeStampToDate(heartbeats: LastHeartbeat[]): LastHeartbeat[] {\n        return heartbeats.map(heartbeat => {\n            if(heartbeat.datetime) {\n                heartbeat.datetime = new Date(heartbeat.datetime);\n            }              \n            return heartbeat;\n        });        \n    }\n\n\n    public notifyCountAlarmPending() {\n        const filteredAlarms = this.dataService.getFilteredAlarmList();\n        const count = filteredAlarms ? filteredAlarms.reduce((total: number, alarm: Alarm) => alarm.alarmRead ? total : total + 1, 0) : 0;\n\n        this._state.notifyDataChanged('painel.setCountPendingValue', count);\n    }\n\n    public speak(message: string) : void {\n        const speechSynthesis = window.speechSynthesis;\n        if (!speechSynthesis) {\n            return;\n        }\n\n        const speechMessage = new SpeechSynthesisUtterance(message);\n        speechMessage.lang = localStorage.getItem('lang') || '';\n        speechSynthesis.speak(speechMessage);\n    }\n\n    public async setReadAlarm(alarms: Alarm[]) : Promise<Alarm[]> {\n        if (alarms != null && alarms.length > 0) {\n\n            const alarmIds = alarms.map(alarm => alarm.id);\n            const timezone = this.dataService.getBrowserTimezoneOffset();\n            try {\n                const readAlarms = await this.alarmService.setReadAlarm(alarmIds, timezone).toPromise();\n                const rowEntries: [number, Alarm][] = this.tableDataAlerts && this.tableDataAlerts.length > 0\n                    ? this.tableDataAlerts.map((r): [number, Alarm] => [r.id, r])\n                    : [];\n                const tableRowById = rowEntries.length > 0 ? new Map<number, Alarm>(rowEntries) : null;\n                readAlarms.forEach(alarm => {\n                    this.dataService.setReadFilteredAlarmList(alarm.id);\n                    const row = tableRowById ? tableRowById.get(alarm.id) : null;\n                    if (row) {\n                        if (alarm.datetimestampFormatted != null) row.datetimestampFormatted = alarm.datetimestampFormatted;\n                        if (alarm.availableMediaAtTimestampFormatted != null) row.availableMediaAtTimestampFormatted = alarm.availableMediaAtTimestampFormatted;\n                    }\n                });\n                return readAlarms;\n            } catch (error) {\n                console.warn('Failed to set read alarm:', error);\n                alarms.forEach(alarm => {\n                    alarm.urlPictures = [];\n                });\n                return alarms;\n            }\n        }\n\n        return alarms || [];\n    }\n\n    showAndHideSearchInput(){\n        if(this.showSearchInput){\n            this.showSearchInput = false;\n            this.dt.filterGlobal('', 'contains');\n        }else {\n            this.showSearchInput = true;\n        }\n    }\n\n    public onSpaceKeydownNoScroll(event: KeyboardEvent): void {\n        const ke: any = event;\n        if (ke.key === ' ' || ke.key === 'Spacebar' || ke.which === 32) {\n            event.preventDefault();\n        }\n    }\n\n    verifyNewAlerts(oldAlerts: Alarm[], newAlerts: Alarm[]): void {\n        if (!oldAlerts.length || !newAlerts.length) return;\n\n        const oldIds = new Set<number>(oldAlerts.map(a => a.id));\n        \n        let notificatedAlerts: number[] = [];\n        const storedNotificated = window.localStorage.getItem('notificatedAlerts');\n        if (storedNotificated) {\n            try {\n                notificatedAlerts = JSON.parse(storedNotificated) as number[] || [];\n            } catch (e) {\n                console.warn('Failed to parse notificatedAlerts from localStorage:', e);\n            }\n        }\n        \n        const notificatedSet = new Set<number>(notificatedAlerts);\n        let hasNewNotificated = false;\n\n        for (const alert of newAlerts) {\n            if (!oldIds.has(alert.id)) {\n                // Alarme novo — verificar exibição de toast usando o set já carregado\n                if (!notificatedSet.has(alert.id)) {\n                    const risk = alert.groupRisk;\n                    if (\n                        (risk === 0 && !this.notificationCenterService.getHideLowAlertToast()) ||\n                        (risk === 1 && !this.notificationCenterService.getHideMediumAlertToast()) ||\n                        (risk === 2 && !this.notificationCenterService.getHideHighAlertToast())\n                    ) {\n                        this.showToast(alert);\n                    }\n                    notificatedSet.add(alert.id);\n                    notificatedAlerts.push(alert.id);\n                    hasNewNotificated = true;\n                }\n            }\n        }\n\n        // Escrita única de localStorage ao final do ciclo\n        if (hasNewNotificated) {\n            window.localStorage.setItem('notificatedAlerts', JSON.stringify(notificatedAlerts));\n        }\n    }\n\n    showToast(alert: Alarm) {\n        let summary = '';\n        let detail = '';\n        const groupRisks = (alert.groupRisk) ? alert.groupRisk : 0;\n        let severity = 'info';\n\n        switch(groupRisks){\n            case 0:\n                summary = this.translateJsonService.getTranslateSubs('RISK-RATING.low_risk') || '';\n                severity = \"success\";\n                break;\n            case 1:\n                summary = this.translateJsonService.getTranslateSubs('RISK-RATING.medium_risk') || '';\n                severity = \"info\";\n                break;\n            case 2:\n                summary = this.translateJsonService.getTranslateSubs('RISK-RATING.high_risk') || '';\n                severity = \"error\";\n                break;\n        }\n\n        if(alert.driver_firstname){\n            detail = `${this.translateJsonService.getTranslateSubs('GLOBAL.alert_1')} | ${this.translateJsonService.getTranslateSubs(alert.typeAlarmDescription)} - ${this.translateJsonService.getTranslateSubs('GLOBAL.vehicle')}: ${alert.vehicle_plates} ${this.translateJsonService.getTranslateSubs('GLOBAL.driver')}: ${alert.driver_firstname}`;\n        }else{\n            detail = `${this.translateJsonService.getTranslateSubs('GLOBAL.alert_1')} | ${this.translateJsonService.getTranslateSubs(alert.typeAlarmDescription)} - ${this.translateJsonService.getTranslateSubs('GLOBAL.vehicle')}: ${alert.vehicle_plates}`;\n        }\n\n\n        this.idLastNewAlert = alert.id;\n        this.messageService.add({severity: severity, summary: summary, detail: detail, sticky: !this.notificationCenterService.getAutoCloseAlertToast()});\n\n        if(this.notificationCenterService.getSoundVoice()) this.speak(detail);\n    }\n\n    public displayCamsNotComunication(): void {\n        this.displayModalNotComuniting = (this.heartbeatNotComunication && this.heartbeatNotComunication.length > 0)\n\n    }\n\n    public displayCamsMaintenanceStandby(): void {\n        this.displayMaintenanceStandby = (this.heartbeatMaintenanceStandby && this.heartbeatMaintenanceStandby.length > 0)\n    }\n\n    public displaySatelliteNotifications(): void {\n        this.displaySatelliteNotific = true;\n    }\n\n    private loadTreatmentAlarmsCount() {\n        this.totalTreatmentLoading = true;     \n        const _filter = this.filterSelectedData;\n        this.normalizeSelectedCustomers(_filter);\n        this.alarmService.countAuditGroupDisk(this.buildFilter(this.filterSelectedData)).subscribe(result => {\n            this.totalTreatment[0] = result.lowRiskCount;\n            this.totalTreatment[1] = result.mediumRiskCount;\n            this.totalTreatment[2] = result.highRiskCount;\n            this.totalTreatmentLoading = false;\n        }, () => {\n            this.totalTreatmentLoading = false;\n        })\n    }\n\n    private resolveCheckboxChecked(eventOrChecked: any): boolean {\n        if (typeof eventOrChecked === 'boolean') {\n            return eventOrChecked;\n        }\n\n        return this.isCheckboxInputChecked(eventOrChecked);\n    }\n\n    private isCheckboxInputChecked(eventOrChecked: any): boolean {\n        if (!eventOrChecked) {\n            return false;\n        }\n        return !!eventOrChecked.checked;\n    }\n\n    public toggleCheckUncheckAllAlarms(eventOrChecked: any) {\n        const isChecked = this.resolveCheckboxChecked(eventOrChecked);\n        this.clearAlarmIdsBatchTreatmentList();\n\n        for (const alert of this.alerts) {\n            alert.isSelected = isChecked;\n            if (isChecked && alert.groupRisk === 0 && (this.groupSelected.length === 0 || this.groupSelected.includes(alert.groupRisk))) {\n                this.alarmIdsBatchTreatmentList.push(alert.id);\n            }\n        }\n    }\n\n    public toggleCheckUncheckAlarms(isChecked: boolean, relatedAlarms: Array<Alarm>) {\n        const resolvedIsChecked = this.resolveCheckboxChecked(isChecked);\n        const relatedAlarmIds = (relatedAlarms || []).map(alarm => alarm.id)\n\n        if (resolvedIsChecked) {\n            this.alarmIdsBatchTreatmentList = [...new Set([\n                ...this.alarmIdsBatchTreatmentList,\n                ...relatedAlarmIds\n            ])];\n        } else {\n            const relatedSet = new Set<number>(relatedAlarmIds);\n            this.alarmIdsBatchTreatmentList = this.alarmIdsBatchTreatmentList.filter(id => !relatedSet.has(id));\n        }\n    }\n\n    public showDialog() {\n\n        if (!this.alarmIdsBatchTreatmentList || this.alarmIdsBatchTreatmentList.length > this.maxSelectedAlarmsInBatchExceeded) {\n            const maxAlarmsKey = 'TREATMENT-ALARMS-IN-BATCH.max-selected-alarms-in-batch-exceeded';\n            const invalidFieldKey = 'TREATMENT-ALARMS-IN-BATCH.invalid-field';\n            const maxAlarmsMessage = this.translateJsonService.getTranslateSubs(maxAlarmsKey) || `Maximum of ${this.maxSelectedAlarmsInBatchExceeded} alarms exceeded`;\n            const invalidFieldSummary = this.translateJsonService.getTranslateSubs(invalidFieldKey) || 'Invalid';\n            \n            const detail = maxAlarmsMessage.replace(\"##MAX##\", String(this.maxSelectedAlarmsInBatchExceeded));\n            \n            this.messageService.add(\n                {\n                    severity: 'error',\n                    summary: invalidFieldSummary,\n                    detail: detail,\n                    key: 'toastTreatmentInBatch'\n                })\n            return\n        }\n\n        this.display = true\n\n        const alarmsToTreatmentInBatch = this.getAlarmsToTreatmentInBatch()\n\n        this.alarmsInformationGroupedByRisk = this.groupItemsByFields(alarmsToTreatmentInBatch, ['groupRisk'])\n    }\n\n    public treatmentAlarmsInBatch(alarms: Array<Alarm>) {\n        this.commentTreatmentInBatch = this.commentTreatmentInBatch.trim();\n\n        if (!this.commentTreatmentInBatch || this.commentTreatmentInBatch.length < this.minSizecommentTreatmentInBatch\n            || this.commentTreatmentInBatch.length > this.maxSizecommentTreatmentInBatch) {\n            const invalidFieldSummary = this.translateJsonService.getTranslateSubs('TREATMENT-ALARMS-IN-BATCH.invalid-field') || 'Invalid';\n            const commentsMessage = this.translateJsonService.getTranslateSubs('TREATMENT-ALARMS-IN-BATCH.invalid-comments-field') || 'Comment must be between ##MIN## and ##MAX## characters';\n            \n            const detail = commentsMessage\n                .replace(\"##MIN##\", String(this.minSizecommentTreatmentInBatch))\n                .replace(\"##MAX##\", String(this.maxSizecommentTreatmentInBatch));\n\n            this.messageService.add(\n                {\n                    severity: 'info',\n                    summary: invalidFieldSummary,\n                    detail: detail,\n                    key: 'toastDialogTreatmentInBatch'\n                })\n            return\n        }\n\n        this.isLoadingTreatmentInBatch = true\n\n        const alarmsByGroups = this.groupItemsByFields(this.getAlarmsToTreatmentInBatch(), ['vehicle_plates', 'vehicle_prefix', 'type', 'groupRisk'])\n\n        const audits: Array<Audit> = []\n\n        for (const vehiclePlates in alarmsByGroups) {\n            const byVehiclePlates = alarmsByGroups[vehiclePlates]\n            for (const vehiclePrefix in byVehiclePlates) {\n                const byVehiclePrefix = byVehiclePlates[vehiclePrefix]\n                for (const type in byVehiclePrefix) {\n                    const byType = byVehiclePrefix[type]\n                    for (const groupRisk in byType) {\n                        const alarms: Array<Alarm> = byType[groupRisk]\n                        const audit = new Audit()\n                        audit.alarms = alarms\n                        audit.groupRisk = Number.parseInt(groupRisk, 10)\n                        audit.createDate = new Date()\n                        audit.createDateLocal = new Date().toISOString()\n                        audit.timeZoneTreatment = this.getTimezoneTreatment()\n                        audits.push(audit)\n                    }\n                }\n            }\n        }\n\n        this.treatmentFlowService.createAuditsInBatch(audits, this.commentTreatmentInBatch)\n            .then(savedAudit => {\n                this.display = false\n                this.messageService.add(\n                    {\n                        severity: 'success',\n                        summary: this.translateJsonService.getTranslateSubs('TREATMENT-ALARMS-IN-BATCH.success'),\n                        detail: this.translateJsonService.getTranslateSubs('TREATMENT-ALARMS-IN-BATCH.success-treatment'),\n                        key: 'toastTreatmentInBatch',\n                        sticky: true\n                    })\n                this.clearAlarmIdsBatchTreatmentList()\n                this.closeModalTreatmentInBatch()\n                this.requestAlarmData(true)\n            })\n            .catch(err => {\n                this.messageService.add(\n                    {\n                        severity: 'error',\n                        summary: this.translateJsonService.getTranslateSubs('TREATMENT-ALARMS-IN-BATCH.error'),\n                        detail: this.translateJsonService.getTranslateSubs('TREATMENT-ALARMS-IN-BATCH.error-treatment'),\n                        key: 'toastDialogTreatmentInBatch',\n                        sticky: true\n                    })\n\n                this.isLoadingTreatmentInBatch = false\n            })\n\n    }\n\n    private groupItemsByFields(array: Array<any>, groupBy: Array<string>) {\n\n        const groupedItems: any = {}\n\n        array.forEach((item) => {\n            groupBy.reduce((previousValue, currentValue, currentIndex) => {\n                previousValue[item[currentValue]] = previousValue[item[currentValue]] || (currentIndex + 1 === groupBy.length ? [] : {})\n                return previousValue[item[currentValue]]\n            }, groupedItems).push(item)\n        });\n\n        return groupedItems\n    }\n\n    private getAlarmsToTreatmentInBatch(): Alarm[] {\n        const batchSet = new Set<number>(this.alarmIdsBatchTreatmentList);\n        return this.alerts.filter(alert => batchSet.has(alert.id));\n    }\n\n    private closeModalTreatmentInBatch() {\n        this.display = false\n        this.commentTreatmentInBatch = ''\n        this.isLoadingTreatmentInBatch = false\n    }\n\n    private clearAlarmIdsBatchTreatmentList() {\n        this.alarmIdsBatchTreatmentList = []\n    }\n\n    private getTimezoneTreatment(): string {\n        try {\n            return this.dataService.getBrowserTimezoneOffset() || \"-03:00\";\n        } catch {\n            return \"-03:00\";\n        }\n    }\n\n    private changeOnlineState() {\n        this.workspaceService.getBotaoOnline$()\n            .pipe(takeUntil(this.destroy$))\n            .subscribe((isOnline) => {\n                this.isOnlineChecked = isOnline;\n            });\n    }\n\n    public changeOnline(online: boolean = false) {\n        this.isOnlineChecked = online;\n        this.workspaceService.setBotaoOnline(online);\n        this.clearRetryRequestTimeout();\n\n        if(online) {\n            this.requestAlarmData(true);\n        }\n\n        if(!online) {\n            this.unsubscribeData();\n        }\n    }\n\n    private getCustomerIdUser() {\n        const ws = this.workspaceRef || this.dataService.getWorkspace();\n        if (!ws) {\n            return;\n        }\n        this.customerIdByWorkspace = ws.customerProfileId;\n        this.childIdByWorkspace = (ws.currentUser) ? ws.currentUser.customerChild : null;\n    }\n\n    private updateRequestInProgress(value: boolean) {\n        this.requestInProgress.emit(value);\n        this.disableOnlineButton = value;\n    }\n\n    private clearRetryRequestTimeout(): void {\n        if (this.retryRequestTimeoutId) {\n            clearTimeout(this.retryRequestTimeoutId);\n            this.retryRequestTimeoutId = null;\n        }\n    }\n\n    private clearHeartbeatRefreshTimeout(): void {\n        if (this.heartbeatRefreshTimeoutId) {\n            clearTimeout(this.heartbeatRefreshTimeoutId);\n            this.heartbeatRefreshTimeoutId = null;\n        }\n    }\n\n    private clearPendingTimeouts(): void {\n        this.clearRetryRequestTimeout();\n        this.clearHeartbeatRefreshTimeout();\n    }\n\n    private workspaceHasSelectedFilterAlarms(kp: Workspace): boolean {\n        return kp != null && kp.selectedFilterAlams != null; // NOSONAR S6582 — alvo ES5 sem optional chaining\n    }\n\n    private formatRequestErrorMessage(error: any): string {\n        if (error && error.message) { // NOSONAR S6582 — alvo ES5 sem optional chaining\n            return error.message;\n        }\n        return 'request failed';\n    }\n\n    private hasTableDataAlerts(): boolean {\n        return this.tableDataAlerts != null && this.tableDataAlerts.length > 0; // NOSONAR S6582 — alvo ES5 sem optional chaining\n    }\n\n    private workspaceHasCentralPermission(ws: Workspace): boolean {\n        const desc = ws && ws.accessControlDesc; // NOSONAR S6582 — alvo ES5 sem optional chaining\n        return !!(desc && desc.some(permission => permission.permissions === 31)); // NOSONAR S6582\n    }\n\n    private parseTimestampNonIsoBranch(trimmed: string, timeZone?: string): Date | null {\n        const withSpace = new RegExp(FatigueV3Component.REGEX_TIMESTAMP_WITH_SPACE).exec(trimmed);\n        const noSpace = new RegExp(FatigueV3Component.REGEX_TIMESTAMP_NO_SPACE).exec(trimmed);\n        const match = withSpace || noSpace;\n        let d: Date = null;\n        if (match) {\n            const [, datePart, timePart, sign, hh, mm] = match;\n            d = new Date(`${datePart}T${timePart}${sign}${hh}:${mm}`);\n        } else {\n            const noOffset = new RegExp(FatigueV3Component.REGEX_TIMESTAMP_NO_OFFSET).exec(trimmed);\n            if (noOffset && timeZone) {\n                const [, datePart, timePart] = noOffset;\n                const normalized = this.dataService.normalizeTimezone(timeZone);\n                if (new RegExp(/^[+-]\\d{2}:\\d{2}$/).exec(normalized)) {\n                    d = new Date(`${datePart}T${timePart}${normalized}`);\n                }\n            }\n            if (d == null || Number.isNaN(d.getTime())) {\n                d = new Date(trimmed);\n            }\n        }\n        return d != null && !Number.isNaN(d.getTime()) ? d : null;\n    }\n\n    private parseTimestampToDate(value: string, timeZone?: string): Date | null {\n        if (!value || typeof value !== 'string') {\n            return null;\n        }\n        const trimmed = value.trim();\n        if (trimmed.includes('T') || trimmed.includes('Z')) {\n            const dIso = new Date(trimmed);\n            return dIso != null && !Number.isNaN(dIso.getTime()) ? dIso : null;\n        }\n        return this.parseTimestampNonIsoBranch(trimmed, timeZone);\n    }\n\n    private getStringValue(obj: Record<string, any>, primaryKey: string, fallbackKey: string): string | null {\n        const primary = obj[primaryKey];\n        if (typeof primary === 'string') {\n            return primary;\n        }\n        const fallback = obj[fallbackKey];\n        if (fallback != null && typeof fallback === 'string') {\n            return fallback;\n        }\n        return null;\n    }\n\n    private applyAlarmDatetimeFieldsForTimezone(alarm: Alarm, isDifferentFromMicroserviceOffset: boolean): void {\n        if (isDifferentFromMicroserviceOffset) {\n            if (alarm.datetime) {\n                alarm.datetime = this.dataService.undoMicroserviceGmt3(alarm.datetime.toString());\n            }\n            if (alarm.availableMediaAt) {\n                alarm.availableMediaAt = this.dataService.undoMicroserviceGmt3(alarm.availableMediaAt.toString());\n            }\n            return;\n        }\n        if (alarm.datetime && alarm.timeZone) {\n            alarm.datetime = this.dataService.convertToAlarmTimezone(alarm.datetime.toString(), alarm.timeZone);\n        }\n        if (alarm.availableMediaAt && alarm.timeZone) {\n            alarm.availableMediaAt = this.dataService.convertToAlarmTimezone(\n                alarm.availableMediaAt.toString(),\n                alarm.timeZone\n            );\n        }\n    }\n\n    private applyAlarmTimezoneTooltipFields(\n        alarm: Alarm,\n        browserDifferentFromMinus3: boolean,\n        rawDatetimeStr: string,