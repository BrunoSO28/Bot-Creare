lectedCustomers();\n        }else{\n            let csc = ++this.changingSelectedCustomers;\n            setTimeout(() => {\n                if(this.changingSelectedCustomers == csc){\n                    this.selectedCustomers = event;\n                    this.applySelectedCustomers();\n\n                    this.loadVehicles(event, true);\n\n                    this.changingSelectedCustomers = 0;\n\n                    this.lockingVehicles();                    \n                }\n            },2000);\n        } \n    }\n\n    /**\n     * Aplica os Filtros no FilterSelectedData e registra.\n     */\n    private applySelectedCustomers(){\n        this.filterSelectedData.selectedCustomers = this.selectedCustomers;\n        this.filterSelectedData.selectedVehicles = this.selectedVehicles;    \n        \n        this.availableFiltering();\n    }\n\n\n    private lockingFilterBtn(){\n        if(this.selectedVehicles.length > 0){\n            this.pendingBtnFilter = false;\n        }else{\n            this.pendingBtnFilter = true;\n        }\n    }\n\n    /**\n     * Tranca e Destranca o Input de Vehicles\n     */\n    private lockingVehicles(){\n        if(this.selectedCustomers.length > 0){\n            this.pendingVehicles = false;\n        }else{\n            this.pendingVehicles = true;\n        }\n    }\n\n\n\n    /**\n     * Resposta sempre que um Vehicle é selecionado\n     * na Árvore\n     * @param event Lista de IDs\n     */\n    public changedVehicles(event){\n        console.log(event);\n        this.selectedVehicles = event;\n        this.applySelectedCustomers();        \n    }\n\n    public onChangeDates(){\n        this.availableFiltering();\n    }\n\n    public availableFiltering() {\n        if(!this.filterSelectedData.selectedCustomers || this.filterSelectedData.selectedCustomers.length < 1) {\n            this.pendingBtnFilter = true;\n            return false;\n        }\n\n        if(!this.filterSelectedData.selectedVehicles || this.filterSelectedData.selectedVehicles.length < 1){\n            this.pendingBtnFilter = true;\n            return false;\n        }\n\n        this.pendingBtnFilter = false;\n    }\n\n    public search() {\n        const vehicles = this.vehicles.filter(vehicle => this.filterSelectedData.selectedVehicles.includes(vehicle.id));\n        this.submitFilter.emit({ ...this.filterSelectedData, selectedVehicles: vehicles.map(vehicle => ({ imei: vehicle.imei, name: vehicle.name })) });\n    }\n}","import { NgModule } from \"@angular/core\";\nimport { CommonModule } from '@angular/common';\n\n// Components\nimport { TelemetryFilterComponent } from \"./telemetry-filter.component\";\n\n// Modules\nimport { CalendarModule } from 'primeng/calendar';\nimport { FormsModule } from '@angular/forms';\nimport { ThemeModule } from \"../../theme.module\";\n\n@NgModule({\n    imports: [\n        CommonModule,\n        CalendarModule,\n        FormsModule,\n        ThemeModule\n    ],\n    declarations: [\n        TelemetryFilterComponent\n    ],\n    providers: [    \n    ],\n    entryComponents: [],\n    exports: [\n        TelemetryFilterComponent\n    ]\n})\nexport class TelemetryFilterModule { }","import { Injectable } from \"@angular/core\";\nimport { BehaviorSubject } from \"rxjs\";\nimport { ConfigService } from \"app/@core/config/config.service\";\nimport { Http, Headers } from \"@angular/http\";\nimport { map, catchError } from \"rxjs/operators\";\nimport {throwError as observableThrowError, of as observableOf,  Observable } from 'rxjs';\nimport { AuthenticationService } from \"app/pages/login/authentication.service\";\nimport { FaceMatches } from \"./faceMatches.entity\";\nimport { HttpClient, HttpErrorResponse, HttpHeaders } from \"@angular/common/http\";\n\n@Injectable()\nexport class FaceRecogState {\n\n  protected updating$: BehaviorSubject<boolean> = new BehaviorSubject<boolean>(false);\n\n  constructor(\n    private configService: ConfigService,\n    private http: HttpClient,\n    priva