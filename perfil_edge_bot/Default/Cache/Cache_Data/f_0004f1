    ]\n\n    genericTripCols = [\n        {field: 'title', header: ''},\n        {field: 'data', header: 'TRIPS-PAGE.general_info'}\n    ]\n\n    infoDataCols = [\n        {field: 'title', header: ''},\n        {field: 'data', header: ''}\n    ]\n\n    infoCheckpointDetails = [\n        {field: 'datetime', header: 'Data' },\n        {field: 'checkpoint_name', header: 'Nome' }\n    ]\n    \n    // Customers\n    public selectedCustomers: number[] = [];\n    public selectedFullInfoCustomers: CustomerChild[] = [];\n    public customers: TreeInputModel[] = [];\n    public loadedCustomers: boolean;\n    public changingSelectedCustomers: number = 0;\n    public preselectedCustomers: number [] = []\n\n    // Subscriptions\n    private subsworkspace: Subscription;\n    private subscustomers: Subscription;\n    private subsvehicles: Subscription;\n\n    // Filters e Workspace\n    private workspace: Workspace;\n    public filterSelectedData: FilterAlarms = new FilterAlarms();\n\n    // Veiculos\n    public selectedVehicles: number[] = [];\n    public selectedFullInfoVehicles: Asset[] = [];\n    public vehicles: TreeInputModel[] = [];\n    public loadedVehicles: boolean = false;\n    public pendingVehicles: boolean = true;\n    public selectedVehicleList: Asset[] = [];\n    public vehicleList = []\n\n    // Botoes\n    public pendingBtnFilter: boolean = true;\n    public selectedAssetType: number = 3;\n\n    showCustomerChildDropdown: boolean = false\n\n    public isNullUrlFencesApi = environment.fenceApiUrl == \"undefined\" ? true : false;\n\n\n    constructor(\n        private tripsService: TripsService,\n        public messageService: MessageService,\n        private exportFilesService: ExportFilesService,\n        private translateJsonService: TranslateJsonService,\n        private router: Router ,\n        private dataService: DataService,\n        private customerService: CustomerService,\n        private assetService: AssetService,\n        private fencesService: FencesService\n    ) {\n        this.formatDate(this.defaultDate)\n        this.calendarTranslation()\n    }\n\n    ngOnInit() {\n        this.loadPreSelectedCustomer\n        this.validateUserPermission()\n        this.getFilterAlarms()\n    }\n\n    ngOnDestroy() {\n        clearInterval(this.currentIntervalPointer)\n    }\n\n    loadPreSelectedCustomer(customerFiltered) {\n        this.preselectedCustomers = customerFiltered\n    }\n\n/*\n* Busca os filtros selecionados, caso existam, utiliza-os.\n*/\n    private getFilterAlarms(): void {\n        let kp: Workspace = this.dataService.getWorkspace();\n        this.workspace = kp;\n\n        if (kp) {\n            if (kp.selectedFilterAlams) {\n                this.filterSelectedData = kp.selectedFilterAlams;\n            }\n\n            this.filterSelectedData.selectedCustomers = this.preselectedCustomers\n\n            if (this.filterSelectedData.selectedVehicles && this.filterSelectedData.selectedVehicles.length > 0) {\n                this.selectedVehicles = this.filterSelectedData.selectedVehicles;\n            }\n\n            if (this.filterSelectedData.selectedAlarmTypes.length == 0) {\n                this.filterSelectedData.selectedAlarmTypes = [1, 2, 3, 4, 6, 7, 8, 9, 10, 11, 12, 13, 14];\n            }\n        }\n        this.loadedFilter.emit(true);\n        this.loadCustomers();\n    }\n\n/*\n* Carrega as Filiais para o Filtro\n*/\n    private loadCustomers(): void {\n        let customerChildsUser: number[] = [];\n        let customerChildIdList = []\n        this.workspace.userCustomerChildIds.forEach((customerChildsPermissions: customerChildsPermissions) => {\n            customerChildsUser.push(customerChildsPermissions.customer);\n        })\n        this.subscustomers = this.customerService.getCustomerChildsByIds(customerChildsUser).subscribe((_customers: CustomerChild[]) => {\n            this.customers = this.customerService.convertCustomerChildsToTreeInputModel(_customers);\n            this.loadedCustomers = true;\n            this.dataService.registerCustomerChilds(_customers);\n            if(this.showCustomerChildDropdown) {\n                customerChildIdList = this.customers.map(customer => customer.id)\n                this.loadVehicles(customerChildIdList, true)\n            } else {\n                this.loadVehicles(this.vehicleList, true)\n            }\n        })\n    }\n    \n    private loadVehicles(selectedNumbers: number[], reload: boolean): void {\n        this.listVehicles = []\n        if ((this.filterSelectedData && selectedNumbers.length > 0) || !this.showCustomerChildDropdown ) {\n            if (reload) {\n                clearInterval(this.currentIntervalPointer)\n                this.subsvehicles = this.assetService.getAssetsByManyCustomerChildAndAssetType(selectedNumbers, this.selectedAssetType, true, false)\n                    .subscribe((asset: Asset[]) => {\n                        this.dataService.clearVehicles();\n                        this.vehicles = this.assetService.convertAssetToTreeInputModel(asset);\n                        this.dataService.registerVehicles(asset);\n                        this.pendingVehicles = false\n                        this.loadedVehicles = true\n                        this.pendingBtnFilter = false\n                        this.vehicles.forEach(vehicle => this.listVehicles.push(vehicle.id))\n                        this.loadCurrentData(this.listVehicles)\n                        this.currentIntervalPointer = setInterval(() => this.loadCurrentData(this.listVehicles), 15000)\n                    },\n                        error => {\n                            console.info(\"Falha na leitura do cadastro de Vehicles.\", error);\n                        })\n            } else {\n                clearInterval(this.currentIntervalPointer)\n                this.vehicles = this.assetService.convertAssetToTreeInputModel(this.dataService.getAllVehicles());\n                this.loadedVehicles = true;\n            }\n        }\n    }\n\n    buildRequestBody(assetIds: number[], getTripOrderWithoutAsset: boolean, date: string, withPassengers: boolean, isFull: boolean) {\n        return {\n            asset_ids: assetIds,\n            current_customer: this.CUSTOMER_ID,\n            get_trip_order_without_asset: getTripOrderWithoutAsset,\n            date: date,\n            with_passengers: withPassengers,\n            is_full: isFull\n        }\n    }\n\n    selectDefaultTab() {\n\n        const CURRENT_TAB_INDEX = 2\n        \n        for( let i = 0; i < this.currentView.tabs.length; i ++) {\n            if(i != CURRENT_TAB_INDEX) {\n                this.currentView.tabs[i]._selected = false\n            } else {\n                this.currentView.tabs[i]._selected = true\n            }\n        }\n    }\n    \n    public changedCustomers(event) {\n        this.selectDefaultTab() \n        this.pendingBtnFilter = true\n        this.loadedVehicles = false\n        this.pendingVehicles = false\n        this.vehicles = []\n        this.selectedVehicleList = [];\n    \n        let csc = ++this.changingSelectedCustomers;\n        setTimeout(() => {\n            if (this.changingSelectedCustomers == csc) {\n                \n                this.selectedVehicles = [];\n                this.selectedCustomers = event;\n                this.applySelectedCustomers();\n                this.loadVehicles(event, true);\n                this.changingSelectedCustomers = 0;\n                }\n            }, 2000);\n    }\n\n/*\n * Aplica os Filtros no FilterSelectedData e registra.\n */\n    private applySelectedCustomers() {\n        this.filterSelectedData.selectedCustomers = this.selectedCustomers;\n        this.filterSelectedData.selectedVehicles = this.selectedVehicles;\n        this.registerFilterInWorkspace();\n    }\n\n    /*\n * Registra no Workspace as opções no Filtro.\n */\n    public registerFilterInWorkspace() {\n        let kp: Workspace = this.dataService.getWorkspace();\n        if (kp) {\n            let _filter: FilterAlarms = kp.selectedFilterAlams;\n            if (!_filter) {\n                kp.selectedFilterAlams = this.filterSelectedData;\n            }\n        }\n    }\n\n    validateUserPermission() {\n        let ws = localStorage.getItem('userWorkspace')\n        this.CUSTOMER_ID = JSON.parse(ws).customerProfileId\n        this.checkOnlyOneCustomerChild(ws)\n        let permissionsDescList = JSON.parse(ws).accessControlDesc\n        if(!permissionsDescList.find(p => p.permissionDesc === \"ROLE_CONTROLPANEL_TOTAL\")) this.router.navigate(['/pages/ui-alarms/fatigue-v2'])\n    }\n\n    checkOnlyOneCustomerChild(ws) {\n\n        let userCustomerChild = JSON.parse(ws).currentUser.customerChild\n        let customerChildList = JSON.parse(ws).userCustomerChildIds\n        let listWithoutUserCustomerChild  = customerChildList.filter(customerChild => customerChild.customer != userCustomerChild)\n\n        if(listWithoutUserCustomerChild.length > 1) {\n            this.showCustomerChildDropdown = true\n        } else {\n            customerChildList.forEach(customerChild => {\n                this.vehicleList.push(customerChild.customer)\n            })\n        }\n    }\n\n    loadErrorMessages(error): {} {\n        let errorObject = {}\n        switch (error) {\n            case 404:\n                errorObject = { summary: this.translateJsonService.getTranslateSubs('TRIPS-MESSAGES.warning_summary'), detail: this.translateJsonService.getTranslateSubs('TRIPS-MESSAGES.not_found_detail'), code: 404 }\n                break\n            case 400:\n                errorObject = { summary: this.translateJsonService.getTranslateSubs('TRIPS-MESSAGES.warning_summary'), detail: this.translateJsonService.getTranslateSubs('TRIPS-MESSAGES.timeout_detail'), code: 400 }\n                break\n            default:\n                errorObject = { summary: this.translateJsonService.getTranslateSubs('TRIPS-MESSAGES.error_summary'), detail: this.translateJsonService.getTranslateSubs('TRIPS-MESSAGES.internal_server_error_detail'), code: 500 }\n        }\n        return errorObject\n    }\n\n    formatDate(date) {\n        return moment(date).format('DD-MM-YYYY').toString()\n    }\n\n    loadScheduleData(assetIds, date?) {\n        this.scheduleData = []\n        this.clearDataBeforeLoad()\n        this.hasScheduleData = false\n        let dateFilter = date ? date : this.defaultDate\n\n        this.tripsService.getScheduledOrPendingTrips(this.buildRequestBody(assetIds, false, this.formatDate(dateFilter), false, true)).subscribe(\n            result => {\n            this.scheduleData = result\n            this.scheduleData.forEach(schedule =>{\n                if(schedule.scheduled_datetime) {\n                    schedule.scheduled_formatted_datetime = moment(schedule.scheduled_datetime).format(\"DD/MM/YYYY HH:mm:ss\")\n                    schedule.scheduled_timestamp = new Date(schedule.scheduled_datetime).getTime()\n                } \n            })\n            this.totalRecords = this.loadTotalRecords(this.scheduleData)\n            this.hasScheduleData = true\n            },\n            err => {\n                this.errorMessage = this.loadErrorMessages(err)\n                this.scheduleData = []\n                this.totalRecords = 0\n                this.hasScheduleData = false\n                this.loading = false\n                this.showErrorMessage = true\n            },\n            () => {\n                this.loading = false\n            })\n    }\n\n    loadPendingData(assetIds, date?) {\n            this.pendingData = []\n                this.clearDataBeforeLoad()        \n                this.hasPendingData = false\n                let dateFilter = date ? date : this.defaultDate\n        \n                this.tripsService.getScheduledOrPendingTrips(this.buildRequestBody(assetIds, false, this.formatDate(dateFilter), false, false)).subscribe(\n                    result => {\n                    this.pendingData = result\n                    this.pendingData.forEach(pending =>{\n                        if(pending.scheduled_datetime) {\n                            pending.scheduled_formatted_datetime = moment(pending.scheduled_datetime).format(\"DD/MM/YYYY HH:mm:ss\")\n                            pending.scheduled_timestamp = new Date(pending.scheduled_datetime).getTime()\n                        } \n                    })\n                    this.totalRecords = this.loadTotalRecords(this.pendingData)\n                    this.hasPendingData = true\n                    },\n                    err => {\n                        this.errorMessage = this.loadErrorMessages(err)\n                        this.pendingData = []\n                        this.totalRecords = 0\n                        this.hasPendingData = false\n                        this.loading = false\n                        this.showErrorMessage = true\n                    },\n                    () => {\n                        this.loading = false\n                    })\n            }\n\n    loadCurrentData(assetIds) {\n        let newTripControl = this.currentData\n        this.hideNullInfo = true\n        this.clearDataBeforeLoad()\n        this.hasCurrentData = false\n\n        this.tripsService.getCurrentTrips(this.buildRequestBody(assetIds, false, moment(new Date()).format(\"DD-MM-YYYY\"), false, false)).subscribe(\n            result => {\n                this.currentData = result\n                this.currentData.forEach(current =>{\n                    if(newTripControl && !newTripControl.find(newTrip => newTrip.trip_id == current.trip_id)) current.is_new_trip = true\n\n                    if(current.scheduled_datetime) {\n                        current.scheduled_formatted_datetime = moment(current.scheduled_datetime).format(\"DD/MM/YYYY HH:mm:ss\")\n                        current.scheduled_timestamp = new Date(current.scheduled_datetime).getTime()\n                    }\n                    if(current.departure_datetime) {\n                        current.departure_formatted_datetime = moment(current.departure_datetime).format(\"DD/MM/YYYY HH:mm:ss\")\n                        current.departure_timestamp = new Date(current.departure_datetime).getTime()\n                    }\n                    if(!current.trip_order) current.trip_order = '-' \n                })\n                this.totalRecords = this.loadTotalRecords(this.currentData)\n                this.hasCurrentData = true\n            },\n            err => {\n                this.errorMessage = this.loadErrorMessages(err)\n                this.currentData = []\n                this.totalRecords = 0\n                this.hasCurrentData = false\n                this.loading = false\n                this.showErrorMessage = true\n            },\n            () => {\n                this.loading = false\n        })\n    }\n\n    loadRealizedData(assetIds, date?) {\n        let newTripControl = this.realizedData\n        this.hideNullInfo = false\n        this.clearDataBeforeLoad()\n        this.hasRealizedData = false\n        let dateFilter = date ? date : this.defaultDate\n\n        this.tripsService.getRealizedTrips(this.buildRequestBody(assetIds, false, this.formatDate(dateFilter), false, false)).subscribe(\n            result => {\n                this.realizedData = result\n                this.realizedData.forEach(realized => {\n                    if(newTripControl && !newTripControl.find(newTrip => newTrip.trip_id == realized.trip_id)) realized.is_new_trip = true\n\n                    if(realized.scheduled_departure_datetime) {\n                        realized.scheduled_departure_formatted_datetime = moment(realized.scheduled_departure_datetime).format(\"DD/MM/YYYY HH:mm:ss\")\n                        realized.scheduled_departure_timestamp = new Date(realized.scheduled_departure_datetime).getTime()\n                    }\n                    if(realized.real_departure_datetime) {\n                        realized.real_departure_formatted_datetime = moment(realized.real_departure_datetime).format(\"DD/MM/YYYY HH:mm:ss\")\n                        realized.real_departure_timestamp = new Date(realized.real_departure_datetime).getTime()\n                    }\n                    if(realized.real_arrival_datetime) {\n                        realized.real_darrival_formatted_datetime = moment(realized.real_arrival_datetime).format(\"DD/MM/YYYY HH:mm:ss\")\n                        realized.real_arrival_timestamp = new Date(realized.real_arrival_datetime).getTime()\n                    }\n                    if(!realized.trip_order) realized.trip_order = '-'  \n                })\n                this.totalRecords = this.loadTotalRecords(this.realizedData)\n                this.hasRealizedData = true\n            },\n            err => {\n                this.errorMessage = this.loadErrorMessages(err)\n                this.realizedData = []\n                this.totalRecords = 0\n                this.hasRealizedData = false\n                this.loading = false\n                this.showErrorMessage = true\n            },\n            () => {\n                this.loading = false\n            })\n    }\n\n    loadTotalRecords(dataList) {\n        return dataList.length\n    }\n\n    loadScheduledBySelectedDate(date) {\n        this.loadScheduleData(this.listVehicles, date)\n    }\n\n    loadRealizedBySelectedDate() {\n        if(this.formatDate(this.selectedRealizedDate) != this.formatDate(this.defaultDate)) {\n            clearInterval(this.realizedIntervalPointer)\n            this.disableSwitchButton = true\n            this.realizedChecked = false\n            this.loadRealizedData( this.listVehicles, this.selectedRealizedDate)\n        } else {\n            this.loadRealizedData(this.listVehicles, this.defaultDate)\n            this.selectedRealizedDate = null\n            this.disableSwitchButton = false\n            this.realizedChecked = true\n            this.realizedIntervalPointer = setInterval(() => this.loadRealizedData(this.listVehicles, this.defaultDate), 60000)\n        }\n    }\n\n    disableOrEnablePendingAutoRefresh(event) {\n        if(!event.checked) {\n            clearInterval(this.pendingIntervalPointer)\n        } else {\n            this.pendingIntervalPointer = setInterval(() => this.loadPendingData(this.listVehicles), 60000)\n        }\n    }\n\n    disableOrEnableRealizedAutoRefresh(event) {\n        if(!event.checked) {\n            clearInterval(this.realizedIntervalPointer)\n        } else {\n            this.realizedIntervalPointer = setInterval(() => this.loadRealizedData(this.listVehicles), 60000)\n        }\n    }\n\n    changeTab(event) {\n        this.loading = true\n\n        clearInterval(this.pendingIntervalPointer)\n        clearInterval(this.currentIntervalPointer)\n        clearInterval(this.realizedIntervalPointer)\n\n        const SCHEDULED_TAB_INDEX = 0\n        const PENDING_TAB_INDEX = 1\n        const CURRENT_TAB_INDEX = 2\n        const REALIZED_TAB_INDEX = 3\n        \n        switch (event.index) {\n            case SCHEDULED_TAB_INDEX:\n                this.totalRecords = 0\n                this.loadScheduleData(this.listVehicles, this.selectedScheduleDate)\n                break\n            case PENDING_TAB_INDEX:\n                this.totalRecords = 0\n                this.pendingChecked = true\n                this.loadPendingData(this.listVehicles)\n                this.pendingIntervalPointer = setInterval(() => this.loadPendingData(this.listVehicles), 60000)\n                break\n            case CURRENT_TAB_INDEX:\n                this.totalRecords = 0\n                this.loadCurrentData(this.listVehicles)\n                this.currentIntervalPointer = setInterval(() => this.loadCurrentData(this.listVehicles), 15000)\n                break\n            case REALIZED_TAB_INDEX:\n                this.totalRecords = 0\n                this.disableSwitchButton = false\n                this.realizedChecked = true\n\n                if(!this.selectedRealizedDate || (this.selectedRealizedDate && this.selectedRealizedDate === this.defaultDate)) {\n                    this.loadRealizedData(this.listVehicles)\n                    this.realizedIntervalPointer = setInterval(() => this.loadRealizedData(this.listVehicles), 60000)\n                } else {\n                    this.loadRealizedData(this.listVehicles, this.selectedRealizedDate)\n                    this.disableSwitchButton = true\n                    this.realizedChecked = false\n                }\n                break\n            default:\n                this.loadCurrentData(this.listVehicles)\n        }\n\n    }\n\n    public calendarTranslation() {\n        let selectedLang = localStorage.getItem('lang')\n\n        const BRAZILIAN_PORTUGUESE_CALENDAR = {\n            firstDayOfWeek: 0,\n            dayNames: [\"Domingo\", \"Segunda\", \"Terça\", \"Quarta\", \"Quinta\", \"Sexta\", \"Sábado\"],\n            dayNamesShort: [\"Dom\", \"Seg\", \"Ter\", \"Qua\", \"Qui\", \"Sex\", \"Sab\"],\n            dayNamesMin: [\"Do\", \"Sg\", \"Te\", \"Qa\", \"Qi\", \"Sx\", \"Sa\"],\n            monthNames: [\"Janeiro\", \"Fevereiro\", \"Março\", \"Abril\", \"Maio\", \"Junho\", \"Julho\", \"Agosto\", \"Setembro\", \"Outubro\", \"Novembro\", \"Dezembro\"],\n            monthNamesShort: [\"Jan\", \"Fev\", \"Mar\", \"Abr\", \"Mai\", \"Jun\", \"Jul\", \"Ago\", \"Set\", \"Out\", \"Nov\", \"Dez\"],\n            today: 'Hoje',\n            clear: 'Limpar'\n        }\n\n        const ENGLISH_CALENDAR = {\n            firstDayOfWeek: 0,\n            dayNames: [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"],\n            dayNamesShort: [\"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"],\n            dayNamesMin: [\"Su\", \"Mo\", \"Tu\", \"We\", \"Th\", \"Fr\", \"Sa\"],\n            monthNames: [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"],\n            monthNamesShort: [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"],\n            today: 'Today',\n            clear: 'Clear'\n        }\n\n        const SPANISH_CALENDAR = {\n            firstDayOfWeek: 0,\n            dayNames: [\"Domingo\",\"Lunes\", \"Martes\", \"Miércoles\", \"Jueves\", \"Viernes\", \"Sábado\"],\n            dayNamesShort: [\"Dom\",\"Lun\", \"Mar\", \"Mié\", \"Jue\", \"Vie\", \"Sáb\"],\n            dayNamesMin: [\"D\", \"L\", \"Ma\", \"Mi\", \"J\", \"V\", \"S\"],\n            monthNames: [\"Enero\", \"Febrero\", \"Marzo\", \"Abril\", \"Mayo\", \"Junio\", \"Julio\", \"Agosto\", \"Septiembre\", \"Octubre\", \"Noviembre\", \"Diciembre\"],\n            monthNamesShort: [\"En\", \"Feb\", \"Mar\", \"Abr\", \"May\", \"Jun\", \"Jul\", \"Ago\", \"Sep\", \"Oct\", \"Nov\", \"Dic\"],\n            today: 'Hoy',\n            clear: 'Limpiar'\n        }\n\n        switch (selectedLang) {\n            case 'en':\n                this.localeCalendar = ENGLISH_CALENDAR\n                break\n            case 'ptBr':\n                this.localeCalendar = BRAZILIAN_PORTUGUESE_CALENDAR\n                break\n            case 'es':\n                this.localeCalendar = SPANISH_CALENDAR\n                break\n            default:\n                this.localeCalendar = ENGLISH_CALENDAR\n        }\n    }\n\n    getRowDataStyle() {\n        return {\n            'padding': '3px',\n            'font-size': '12px',\n            'text-align': 'center'}\n    }\n\n    getTripDetailsRowDataStyle() {\n        return {\n            'padding': '3px',\n            'font-size': '11px',\n            'text-align': 'center'}\n    }\n\n    sortBoardingListByDate(itemList) {\n        itemList.sort((a, b) => {\n            if(a.boarding_datetime > b.boarding_datetime) {\n                return 1\n            }\n            if(a.boarding_datetime < b.boarding_datetime) {\n                return -1\n            }\n            return 0\n        })\n    }\n\n    loadPassengerList(tripId) {\n        this.passengerList = []\n        this.tripsService.getPassengerList(tripId, this.CURRENT_CUSTOMER_ID).subscribe(\n        result => {\n            this.passengerList = result\n            let boardingWithPoint = []\n            let boardingWithoutPoint = []\n            let boundsArray = []\n            this.WITH_POINT_BG_COLOR = \"#673d91\"\n            this.WITHOUT_POINT_BG_COLOR = \"red\"\n\n            this.sortBoardingListByDate(this.passengerList)\n\n            setTimeout(()=> {\n                this.loadBoardingPointsMarkers(this.passengerList)\n\n                this.passengerList.forEach((passenger, index) => {\n                    if(passenger.boarding_point != null) {\n                        boardingWithPoint.push(passenger)\n                    } else {\n                        boardingWithoutPoint.push(passenger)\n                    }\n\n                    boundsArray.push(L.latLng(passenger.boarding_latitude, passenger.boarding_longitude))\n                    passenger.boarding_order = index + 1\n                })\n\n                this.buildAllBoardingMarkers(boardingWithPoint, this.WITH_POINT_BG_COLOR, \"with-boarding-point\", true)\n                this.buildAllBoardingMarkers(boardingWithoutPoint, this.WITHOUT_POINT_BG_COLOR, \"without-boarding-point\", true)\n\n                const bounds = L.latLngBounds(boundsArray.map((m: any) => { return m }))\n                this.map.fitBounds(bounds)\n            }, 1000)\n                \n            this.loadingPassengerList = false\n        },\n        err => {\n                this.loadingPassengerList = false\n        })        \n    }\n    \n    buildAllBoardingMarkers(boardingList, clusterColor, classNameGroup, isBoardingDialog: boolean){\n        let boardingMarkerList = []\n        boardingList.forEach(boarding =>{\n            let popupContent = \"\"\n\n            let streetView =       \n                \"http://maps.google.com/maps?q=&layer=c&cbll=\" +\n                boarding.boarding_latitude +\n                \",\" +\n                boarding.boarding_longitude +\n                \"&cbp=11,0,0,0,0\"\n\n            if(isBoardingDialog) {\n                popupContent = \n                `<strong>${this.translateJsonService.getTranslateSubs('TRIPS-PAGE.passenger_name')}: </strong><span>${boarding.passenger_name}</span></br>\n                <a href=\"${streetView}\" target=\"_blank\" class=\"street-view-popup\" style=\"\n                    font-size: 1em;\n                    text-align: center;\n                    width: 100%;\n                    display: block;\n                    padding: 5px 15px;\n                    border-radius: 5px;\n                    margin-top: 5px;\n                    background-color: #fbd246;\n                    color: #796210;\n                    text-decoration: none\"><i class=\"fa fa-street-view\"></i> <span>Street View</span></a>`\n            } else {\n                popupContent = `<strong>${this.translateJsonService.getTranslateSubs('TRIPS-PAGE.passenger_name')}: </strong><span>${boarding.passenger_name}</span></br>\n                <strong>${this.translateJsonService.getTranslateSubs('TRIPS-PAGE.driver_badge')}: </strong><span>${boarding.passenger_badge}</span></br>\n                <strong>${this.translateJsonService.getTranslateSubs('TRIPS-PAGE.boarding')}: </strong><span>${moment(boarding.boarding_datetime).format(\"DD/MM/YYYY HH:mm:ss\")}</span></br>\n                <strong>${this.translateJsonService.getTranslateSubs('TRIPS-PAGE.boarding_point_name')}: </strong><span>${(boarding.boarding_point_name) ? boarding.boarding_point_name : \"-\"}</span></br>`\n            }\n\n\n            let passengerBoardingPointMarker = null\n\n            let passengerBoardingPointIcon = L.divIcon({\n                className: 'custom-icon',\n                html: `<div\n                        style=\"height:23px;\n                        width:23px;\n                        border: 1px solid #FFFFFF;\n                        border-radius:50%;\n                        color:#FFFFFF;\n                        background: ${clusterColor};\n                        display: flex;\n                        justify-content:center;\n                        align-items:center;\n                        font-size: 10px;\n                        font-weight:bold;\">\n                        <span>${boarding.boarding_order}º</span>\n                    </div>`,\n                iconSize:[23,23]\n            })\n\n            passengerBoardingPointMarker = L.marker([boarding.boarding_latitude, boarding.boarding_longitude], {icon: passengerBoardingPointIcon})\n            .bindPopup(popupContent, {closeButton: true, autoClose: true, closeOnClick: false})\n            .on('click', () => passengerBoardingPointMarker.openPopup())\n\n            boardingMarkerList.push(passengerBoardingPointMarker)\n        })\n\n        const BOARDING_CLUSTER_GROUP = this.buildBoardingsMarkerClusterGroup(classNameGroup)\n        BOARDING_CLUSTER_GROUP.addLayers(boardingMarkerList)\n        this.map.addLayer(BOARDING_CLUSTER_GROUP)\n    }\n\n    buildBoardingsMarkerClusterGroup(classNameGroup: string) {\n        return L.markerClusterGroup({iconCreateFunction: function (cluster) {\n            var markers = cluster.getAllChildMarkers();\n            var html = `<div class=\"boarding ${classNameGroup}\">` + markers.length + '</div>';\n            return L.divIcon({ html: html, className: 'mycluster', iconSize: L.point(30, 30) })\n        }})\n    }\n\n    openPassengerListModal(tripInfo) {\n        this.boardingPointsLayer.clearLayers()\n        this.dataMapLoading()\n        this.passengerInfo = null\n        this.loadingPassengerList = true\n        this.passengerTripOrderTitleValue = tripInfo.trip_order\n        this.loadPassengerList(tripInfo.trip_id)\n        this.displayPassengerList = true\n    }\n\n    openSelectedRouteModal(scheduledRoute) {\n        this.boardingPointsLayer.clearLayers()\n        this.dataMapLoading()\n        this.loadScheduleRoute(scheduledRoute)\n        this.loadBoardingPointsMarkersByRoute(scheduledRoute)\n    }\n\n    private loadScheduleRoute(scheduledRoute: string) {\n        let locationList = []\n\n        this.tripsService.getScheduledRouteData(scheduledRoute, this.CURRENT_CUSTOMER_ID).subscribe(\n            result => {\n                this.displayRouteDialog = true \n                this.routeData = result\n                result.geometry.coordinates.forEach(coord => {\n                    locationList.push({ location: {lat: coord[1], lng: coord[0]}} )\n                })\n                let scheduled_route = { positions: locationList }\n                setTimeout(()=> {this.renderScheduledRoutesPolyline(scheduled_route)}, 200)\n            },\n            err => {\n                this.messageService.add({\n                    severity: 'warn',\n                    summary: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.warning_summary'),\n                    detail: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.route_not_found')\n                })\n            }\n        )\n    }\n\n    loadFullTripInfo(tripId) {\n        this.driverDetails = []\n        this.resetFullTripData()\n        this.tripsService.getFullTripDataInfo(tripId, this.CURRENT_CUSTOMER_ID).subscribe(\n            result => {\n                this.loadTripPolylines(tripId, this.CURRENT_CUSTOMER_ID, result)\n                this.loadfullTripDataInfo(result)\n                this.loadfullGenericInfoObj(result)\n                this.driverData = JSON.parse(result.driver_data)\n                this.driverDetails = this.loadInfo(JSON.parse(result.driver_data))\n                this.loadingFullTripInfo = false\n            } ,\n            err => console.log(\"err\", err)\n        )\n    }\n\n    waitForElementToExist() {\n        return new Promise((resolve, reject) => {\n            const interval = setInterval(() => {\n            const element = document.querySelector(\"#map\")\n                if (element) {\n                    clearInterval(interval)\n                    resolve(element)\n                }\n            }, 100);\n\n            setTimeout(() => {\n                clearInterval(interval);\n                reject(new Error(`Timeout: Elemento '#map' não foi encontrado.`));\n            }, 10000);\n        });\n    }\n\n    showMap() {\n        this.waitForElementToExist().then((element) => {\n            this.initMap(-29.8873545, -51.1590298)\n        })\n    }\n\n    private initViewControl() {\n        L.control.layers((this.IS_NULL_GOOGLE_MAPS_KEY ? this.layersControl.baseLayers : this.googleLayersControl.baseLayers), {\n            'Checkpoints': this.checkpointsLayer, \n            [this.translateJsonService.getLayerControlTranslate()]: this.coreFenceLayers, \n            [this.translateJsonService.getBoardingPointsLayerControlTranslate()]: this.boardingPointsLayer\n        }).addTo(this.map)\n    }\n\n    private initViewControlRoute() {\n        L.control.layers((this.IS_NULL_GOOGLE_MAPS_KEY ? this.layersControl.baseLayers : this.googleLayersControl.baseLayers), {\n            [this.translateJsonService.getBoardingPointsLayerControlTranslate()]: this.boardingPointsLayer\n        }).addTo(this.map)\n    }\n\n    insertOrRemoveMarkers() {\n        this.showTripDirectionMarkers = !this.showTripDirectionMarkers\n\n        if(this.showTripDirectionMarkers) { \n            \n            this.toggledPositions.forEach((realPosition, index) => {\n\n                if(index > 0) {\n\n                    let popupContent = `<strong style=\"color:#4B4B4D\">${this.translateJsonService.getTranslateSubs('POSITIONS-BY-FENCES.popup_asset')}: </strong><span style=\"color: #4B4B4D\">${realPosition.asset}</span></br> \n                    <strong style=\"color: #4B4B4D\">${this.translateJsonService.getTranslateSubs('POSITIONS-BY-FENCES.popup_speed')}: </strong><span style=\"color: #4B4B4D\">${realPosition.speed}Km/h</span></br>\n                    <strong style=\"color: #4B4B4D\">${this.translateJsonService.getTranslateSubs('POSITIONS-BY-FENCES.popup_datetime')}: </strong><span style=\"color: #4B4B4D\">${realPosition.datetime}</span></br>`\n\n                    let realArrowIcon = L.divIcon({\n                        className: 'custom-icon',\n                        html: `<div \n                                style=\"background-color:#FFFFFF; \n                                transform: rotate(${realPosition.direction}deg); \n                                transform-origin: center!important;\n                                height: 17px; \n                                clip-path: polygon(50% 0%, 100% 100%, 50% 85%, 0% 100%);\">\n                                <div \n                                style=\"background-color: #673d91!important; \n                                height: 17px; \n                                clip-path: polygon(50% 15%, 90% 95%, 55% 80%, 10% 90%);\">\n                                </div>\n                                </div>`,\n                        iconSize: [17,17]\n                    })\n\n                    let zeroSpeedIcon = L.divIcon({\n                        className: 'custom-icon',\n                        html:`<div\n                                style=\"height: 12px;\n                                width: 12px;\">\n                                    <div\n                                        style=\"height:100%;\n                                        width:100%;\n                                        background: #673d91;\n                                        border: 1px solid #FFFFFF;\n                                        border-radius:2px;\n                                        filter: brightness(1.2)\">\n                                    </div>\n                                </div>`,\n                        iconSize:[12,12],\n                    })\n\n                    let realMarker\n\n                    if(realPosition.speed == 0) {\n                        realMarker = L.marker(realPosition.latlngs, {icon: zeroSpeedIcon}).addTo(this.map)\n                        .bindPopup(popupContent, {closeButton: true, autoClose: false, closeOnClick: false})\n                        .on('click', () => realMarker.openPopup()).setZIndexOffset(1000) \n\n                    } else {\n                        realMarker = L.marker(realPosition.latlngs, {icon: realArrowIcon}).addTo(this.map)\n                        .bindPopup(popupContent, {closeButton: true, autoClose: false, closeOnClick: false})\n                        .on('click', () => realMarker.openPopup())\n                    }\n\n                    this.tripToggledMarkers.push(realMarker)\n                }\n            })            \n        } else {\n            this.tripToggledMarkers.forEach(marker => {\n                this.map.removeLayer(marker)\n            })\n        }\n    }\n\n    renderScheduledRoutesPolyline(scheduled_route) {\n        let scheduledLatLngs = []\n        const START_ICON = `<i class=\"ion-android-bus\" style=\"font-size: 13px;color: #FFFFFF;\"></i>`\n        const FINISH_ICON = `<i class=\"fa fa-flag-checkered\" style=\"font-size: 10px; color: #FFFFFF\"></i>`\n        const SCHEDULED_POLYLINE_COLOR = '#f05b32'\n\n        scheduled_route.positions.forEach(position => {\n            scheduledLatLngs.push([position.location.lat, position.location.lng])\n        })\n        let scheduled_polyline = L.polyline(scheduledLatLngs,  {\n            color: \"#f05b32\",\n            weight: 7,\n            lineCap: 'round',\n            lineJoin: 'round'\n        }).addTo(this.map)\n\n        let startMarker = null\n        let startIcon = this.buildDivIcon(START_ICON, SCHEDULED_POLYLINE_COLOR)\n\n        startMarker = L.marker(scheduledLatLngs[0], {icon: startIcon}).addTo(this.map).setZIndexOffset(500)\n\n        let finishMarker = null\n        let finishIcon = this.buildDivIcon(FINISH_ICON, SCHEDULED_POLYLINE_COLOR)\n\n        finishMarker = L.marker(scheduledLatLngs[scheduledLatLngs.length -1], {icon: finishIcon}).addTo(this.map).setZIndexOffset(500) \n        this.map.fitBounds(scheduled_polyline.getBounds())\n    }\n\n    renderRealRoutesPolyline(responseResult, tripResponse) {\n        let realInHeadboarLatLngs = []\n        let realOutStartHeadboardLatLngs = []\n        let realOutEndHeadboardLatLngs = []\n        let realDepartureHeadboardExit = [];\n        let polylineArray = []\n\n        const ICON_START = `<i class=\"ion-android-bus\" style=\"font-size: 13px; color: #FFFFFF \"></i>`\n        const ICON_FINISH = `<i class=\"fa fa-flag-checkered\" style=\"font-size: 10px; color: #FFFFFF\"></i>`\n        const IN_HEADBOARD_BACKGROUND_COLOR = '#673d91'\n        const OUT_HEADBOARD_BACKGROUND_COLOR = '#666666'\n        const ICON_HEADBOARD_EXIT = `<i class=\"ion-android-time\" style=\"font-size: 13px; color: #FFFFFF; padding-top: 2px \"></i>`;\n        const OUT_HEADBOARD_EXIT_BACKGROUND_COLOR = '#37B423';\n\n        let departureDateRef = tripResponse.real_departure_zone_datetime ? \n                                    new Date(tripResponse.real_departure_zone_datetime).getTime() : \n                                    new Date(tripResponse.real_departure_datetime).getTime()\n\n        let arrivalDateRef = tripResponse.real_arrival_zone_datetime ? \n                                    new Date(tripResponse.real_arrival_zone_datetime).getTime() : \n                                    new Date(tripResponse.real_arrival_datetime).getTime()\n\n        let departureZoneExitDateRef = tripResponse.real_departure_zone_exit_datetime ?\n                                        new Date(tripResponse.real_departure_zone_exit_datetime).getTime() :\n                                        new Date(tripResponse.real_departure_datetime).getTime()\n\n        if(arrivalDateRef == 0) arrivalDateRef = parseInt(responseResult.real_route.positions[responseResult.real_route.positions.length - 1].datetime)\n\n        responseResult.real_route.positions.forEach((position) => {\n\n\n                if(parseInt(position.datetime) <= departureDateRef) {\n                    realOutStartHeadboardLatLngs.push([position.location.lat, position.location.lng])\n                }\n    \n                if(parseInt(position.datetime) >= departureDateRef && parseInt(position.datetime) <= arrivalDateRef) {\n                    realInHeadboarLatLngs.push([position.location.lat, position.location.lng])\n                    this.toggledPositions.push({\n                        latlngs: [position.location.lat, position.location.lng],\n                        direction: position.location.direction,\n                        speed: position.telemetry.speed ? position.telemetry.speed : position.telemetry.gps_speed,\n                        asset: `${responseResult.real_route.asset.asset_identification} - ${responseResult.real_route.asset.asset_name}`,\n                        datetime: moment(parseInt(position.datetime)).format('DD/MM/YYYY HH:mm:ss')\n                    })\n                }\n    \n                if(parseInt(position.datetime) >= arrivalDateRef) {\n                    realOutEndHeadboardLatLngs.push([position.location.lat, position.location.lng])\n                }\n\n                if(parseInt(position.datetime) == departureZoneExitDateRef) {\n                    realDepartureHeadboardExit.push([position.location.lat, position.location.lng])\n                }\n        })\n\n        if(realOutStartHeadboardLatLngs.length > 1) {\n            let start_out_polyline = L.polyline(realOutStartHeadboardLatLngs, {\n                color: \"#666666\",\n                dashArray: '6, 10',\n                weight: 4,\n                lineCap: 'round',\n                lineJoin: 'round'\n            }).addTo(this.map)\n\n            polylineArray.push(start_out_polyline)\n    \n            let startOutMarker = null\n            let startOutIcon = this.buildDivIcon(ICON_START, OUT_HEADBOARD_BACKGROUND_COLOR)\n    \n            startOutMarker =L.marker(realOutStartHeadboardLatLngs[0], {icon: startOutIcon}).addTo(this.map)\n        }\n\n        if(realDepartureHeadboardExit.length > 0) {\n            console.log(realDepartureHeadboardExit)\n            let start_headboard_exit_polyline = L.polyline(realDepartureHeadboardExit, {\n                color: \"#666666\",\n                dashArray: '6, 10',\n                weight: 4,\n                lineCap: 'round',\n                lineJoin: 'round'\n            }).addTo(this.map)\n\n            polylineArray.push(start_headboard_exit_polyline)\n\n            let startHeadboardExitMarker = null\n            let startHeadboardExitIcon = this.buildDivIcon(ICON_HEADBOARD_EXIT, OUT_HEADBOARD_EXIT_BACKGROUND_COLOR)\n\n            startHeadboardExitMarker = L.marker(realDepartureHeadboardExit[0], {icon: startHeadboardExitIcon}).addTo(this.map)\n        }\n\n        if(realInHeadboarLatLngs.length > 1) {\n            let real_polyline = L.polyline(realInHeadboarLatLngs, {\n                color: \"#673d91\",\n                weight: 4,\n                lineCap: 'round',\n                lineJoin: 'round'\n            }).addTo(this.map)\n    \n            polylineArray.push(real_polyline)\n    \n            let realStartMarker = null\n            let startRealStartIcon = this.buildDivIcon(ICON_START, IN_HEADBOARD_BACKGROUND_COLOR)\n    \n            realStartMarker = L.marker(realInHeadboarLatLngs[0], {icon: startRealStartIcon}).addTo(this.map).setZIndexOffset(1000) \n    \n            let realFinishMarker = null\n            let realFinishIcon = this.buildDivIcon(ICON_FINISH, IN_HEADBOARD_BACKGROUND_COLOR)\n\n            let realArrowIcon = L.divIcon({\n            className: 'custom-icon',\n            html: `<div \n                    style=\"background-color:#FFFFFF; \n                    transform: rotate(${responseResult.real_route.positions[responseResult.real_route.positions.length - 1].location.direction}deg); \n                    transform-origin: center!important;\n                    height: 17px; \n                    clip-path: polygon(50% 0%, 100% 100%, 50% 85%, 0% 100%);\">\n                    <div \n                    style=\"background-color: #673d91!important; \n                    height: 17px; \n                    clip-path: polygon(50% 15%, 90% 95%, 55% 80%, 10% 90%);\">\n                    </div>\n                    </div>`,\n            iconSize: [17,17]\n        })\n    \n            realFinishMarker = L.marker(realInHeadboarLatLngs[realInHeadboarLatLngs.length -1], {icon: (tripResponse.real_arrival_zone_datetime || tripResponse.real_arrival_datetime) ? realFinishIcon : realArrowIcon}).addTo(this.map).setZIndexOffset(1000)\n        }\n\n        if(realOutEndHeadboardLatLngs.length > 1 && realOutEndHeadboardLatLngs.some((elem) => JSON.stringify(elem) != JSON.stringify(realOutEndHeadboardLatLngs[0]))) {\n            let end_out_polyline = L.polyline(realOutEndHeadboardLatLngs, {\n                color: \"#666666\",\n                dashArray: '6, 10',\n                weight: 4,\n                lineCap: 'round',\n                lineJoin: 'round'\n            }).addTo(this.map)\n\n            polylineArray.push(end_out_polyline)\n    \n            let endOutMarker = null\n            let endOutIcon = this.buildDivIcon(ICON_FINISH, OUT_HEADBOARD_BACKGROUND_COLOR)\n\n            let realOutArrowIcon = L.divIcon({\n                className: 'custom-icon',\n                html: `<div \n                        style=\"background-color:#FFFFFF; \n                        transform: rotate(${responseResult.real_route.positions[responseResult.real_route.positions.length - 1].location.direction}deg); \n                        transform-origin: center!important;\n                        height: 17px; \n                        clip-path: polygon(50% 0%, 100% 100%, 50% 85%, 0% 100%);\">\n                        <div \n                        style=\"background-color: #666666!important; \n                        height: 17px; \n                        clip-path: polygon(50% 15%, 90% 95%, 55% 80%, 10% 90%);\">\n                        </div>\n                        </div>`,\n                iconSize: [17,17]\n            })\n            endOutMarker = L.marker(realOutEndHeadboardLatLngs[realOutEndHeadboardLatLngs.length -1], {icon: (tripResponse.real_arrival_zone_datetime || tripResponse.real_arrival_datetime) ? endOutIcon: realOutArrowIcon}).addTo(this.map).setZIndexOffset(200)\n        }\n\n        if (responseResult.real_route && !responseResult.scheduled_route && polylineArray.length > 0) {\n            let bounds: L.LatLngBounds = new L.LatLngBounds([]);\n\n            polylineArray.forEach(polyline => {\n                polyline.getLatLngs().forEach(latlng => {\n                    bounds.extend(latlng);\n                });\n            });\n            this.map.fitBounds(bounds);\n        }\n    }\n\n    buildDivIcon(icon: string, background: string) {\n        return L.divIcon({\n            className: 'custom-icon',\n            html: `<div\n                    style=\"height: 22px;\n                    width: 22px;\n                    border: 2px solid #FFFFFF;\n                    border-radius: 50%;\n                    background: ${background};\n                    display: flex;\n                    justify-content: center;\n                    align-items: center\">\n                    ${icon}\n                    </div>`,\n            iconSize:[22,22]\n        })\n    }\n\n    renderPassengersMarkers(tripId) {\n        this.tripsService.getPassengerList(tripId, this.CURRENT_CUSTOMER_ID).subscribe(\n            result => {\n                let passengerList = result\n                let boardingWithPoint = []\n                let boardingWithoutPoint = []\n                this.WITH_POINT_BG_COLOR = \"#673d91\"\n                this.WITHOUT_POINT_BG_COLOR = \"red\"\n\n                this.sortBoardingListByDate(passengerList)\n                this.loadBoardingPointsMarkers(passengerList)\n\n                passengerList.forEach((passenger, index) => {\n                    this.passengerCount ++\n\n                    if(passenger.boarding_point != null) {\n                        boardingWithPoint.push(passenger)\n                    } else {\n                        boardingWithoutPoint.push(passenger)\n                    }\n                    passenger.boarding_order = index + 1\n                })\n\n                this.buildAllBoardingMarkers(boardingWithPoint, this.WITH_POINT_BG_COLOR, \"with-boarding-point\", false)\n                this.buildAllBoardingMarkers(boardingWithoutPoint, this.WITHOUT_POINT_BG_COLOR, \"without-boarding-point\", false)\n\n            }, err => this.passengerCount = '0'\n        )\n    }\n\n    loadCheckPointMarkers(tripId) {\n        this.checkPointDetails = []\n        const CHECKPOINT_COLOR = '#b21898'\n        const CHECKPOINT_ICON = `<i class=\"ion-flag\" style=\"font-size: 13px;color: #FFFFFF;\"></i>`\n\n        this.tripsService.getRealizedCheckpoints(tripId, this.CURRENT_CUSTOMER_ID).subscribe(\n            result => {\n\n                let filteredCheckpointList = result\n                filteredCheckpointList = filteredCheckpointList.filter(res => res.interaction_type == \"ARRIVAL\")\n\n                this.checkPointDetails = result\n                this.checkPointDetails.forEach(checkpoint =>{\n                    checkpoint.datetime = moment(checkpoint.datetime).format('DD/MM/YYYY HH:mm:ss')\n                    checkpoint.interaction_type = checkpoint.interaction_type.toLowerCase()\n                })\n                this.showCheckpointsInfo = false\n                let checkPointIcon = this.buildDivIcon(CHECKPOINT_ICON, CHECKPOINT_COLOR)\n\n                filteredCheckpointList.forEach((res => {\n\n                    let popupContent = `<strong style=\"color: #b21898\">${res.checkpoint_name}</strong></br>\n                                        <strong style=\"color: #b21898\">${this.translateJsonService.getTranslateSubs('POSITIONS-BY-FENCES.popup_datetime')}</strong>: <span style=\"color: #b21898\">${res.datetime}</span>`\n\n                    let checkPointmarker = L.marker([res.location.lat, res.location.lng], {icon: checkPointIcon})\n                    .bindPopup(popupContent, {closeButton: true, autoClose: false, closeOnClick: false})\n                    .on('click', () => checkPointmarker.openPopup()).setZIndexOffset(1000)\n\n                    this.checkpointsLayer.addLayer(checkPointmarker)\n                }))\n\n            },\n            err => this.checkpointsLayer.clearLayers()\n        )\n    }\n\n    loadBoardingPointsMarkers(passengerList) {\n        let boardingPointList = []\n\n        passengerList.forEach(passenger => {\n            if(passenger.boarding_point && !boardingPointList.find(boardingPoint => boardingPoint.name == passenger.boarding_point.name)) {\n                boardingPointList.push(passenger.boarding_point)\n            }\n        })\n\n        boardingPointList.forEach(boardingPoint => {\n\n            let popup = boardingPoint.name + \" - \" + boardingPoint.description\n            let boardingPointMarker = null\n\n            let boardinPointsIcon = L.icon({\n                iconUrl: \"assets/images/map-markers/marker-boarding-point.png\",\n                iconSize: [40,45],\n                iconAnchor: [20, 44]\n            })\n            \n            boardingPointMarker = L.marker([boardingPoint.latitude, boardingPoint.longitude], {icon: boardinPointsIcon}).bindPopup(popup)\n    \n            this.boardingPointsLayer.addLayer(boardingPointMarker)\n        })\n    }\n\n    private loadBoardingPointsMarkersByRoute(scheduledRoute: string) {\n\n        let boardingPontsList = []\n\n        this.tripsService.getBoardingPointsByRoute(scheduledRoute).subscribe(\n            result => {\n                boardingPontsList = result\n                boardingPontsList.forEach(boardingPoint => {\n                    let popup = boardingPoint.name + \" - \" + boardingPoint.description\n                    let boardingPointMarker = null\n\n                    let boardinPointsIcon = L.icon({\n                        iconUrl: \"assets/images/map-markers/marker-boarding-point.png\",\n                        iconSize: [40,45],\n                        iconAnchor: [20, 44]\n                    })\n                    \n                    boardingPointMarker = L.marker([boardingPoint.latitude, boardingPoint.longitude], {icon: boardinPointsIcon}).bindPopup(popup)\n            \n                    this.boardingPointsLayer.addLayer(boardingPointMarker)\n                })\n            },\n            err => {\n                console.error(`Error loadBoardingPointsMarkersByRouteId: ${err}`)\n                this.boardingPointsLayer.clearLayers()\n            }\n        )\n\n    }\n\n    loadTripPolylines(tripId, currentCustomer, tripResponse) {\n        this.tripsService.getTripPolylines(tripId, currentCustomer).subscribe(\n            result => {\n                if(result.scheduled_route){\n                    setTimeout(() => {this.renderScheduledRoutesPolyline(result.scheduled_route)}, 200)\n                }\n\n                if(result.real_route) {\n                    setTimeout(() => {this.renderRealRoutesPolyline(result, tripResponse)}, 200)\n                }\n                \n                this.renderPassengersMarkers(tripId)\n            },\n            err => {console.log(\"err\", err)}   \n            \n        )\n    }\n\n    loadfullTripDataInfo(res) {\n        this.progVsRealDetails = []\n\n        this.progVsRealDetails.push({\n            title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.asset_name'),\n            scheduled: res.scheduled_asset_name,\n            realized: res.real_asset_name\n        })\n        this.progVsRealDetails.push({\n            title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.driver_name'),\n            scheduled: res.scheduled_driver_name,\n            realized: res.real_driver_name\n        })\n        this.progVsRealDetails.push({\n            title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.driver_badge'),\n            scheduled: res.scheduled_driver_badge,\n            realized: res.real_driver_badge\n        })\n        this.progVsRealDetails.push({\n            title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.route_id'),\n            scheduled: res.scheduled_route_id,\n            realized: null\n        })\n        this.progVsRealDetails.push({\n            title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.departure_datetime'),\n            scheduled: res.scheduled_departure_datetime ? moment(res.scheduled_departure_datetime).format(\"DD/MM/YYYY HH:mm:ss\") : null,\n            realized: res.real_departure_zone_exit_datetime ? moment(res.real_departure_zone_exit_datetime).format(\"DD/MM/YYYY HH:mm:ss\") : res.real_departure_datetime ? moment(res.real_departure_datetime).format(\"DD/MM/YYYY HH:mm:ss\") : null\n        })\n        this.progVsRealDetails.push({\n            title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.arrival_datetime'),\n            scheduled: res.scheduled_arrival_datetime ? moment(res.scheduled_arrival_datetime).format(\"DD/MM/YYYY HH:mm:ss\") : null,\n            realized: res.real_arrival_zone_datetime ? moment(res.real_arrival_zone_datetime).format(\"DD/MM/YYYY HH:mm:ss\") : res.real_arrival_datetime ? moment(res.real_arrival_datetime).format(\"DD/MM/YYYY HH:mm:ss\") : null\n        })\n        this.progVsRealDetails.push({\n            title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.distance_km'),\n            scheduled: res.route_distance_km ? `${res.route_distance_km} km` : null,\n            realized: res.real_distance_km ? `${res.real_distance_km} km` : null \n        })\n    }\n\n    loadfullGenericInfoObj(res) {\n        this.genericTripDetails = []\n\n        this.genericTripDetails.push({\n            title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.driver_data'),\n            data: 'icon'\n        }),\n        this.genericTripDetails.push({\n            title: 'Checkpoints',\n            data: 'checkpoint'\n        })\n        this.genericTripDetails.push({\n            title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.trip_order'),\n            data: res.trip_order\n        })\n        this.genericTripDetails.push({\n            title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.real_departure_datetime'),\n            data: res.real_departure_datetime ? moment(res.real_departure_datetime).format('DD/MM/YYYY HH:mm:ss') : null\n        })\n        this.genericTripDetails.push({\n            title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.real_departure_zone_datetime'),\n            data: res.real_departure_zone_datetime ? moment(res.real_departure_zone_datetime).format('DD/MM/YYYY HH:mm:ss') : null\n        })\n        this.genericTripDetails.push({\n            title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.real_arrival_datetime'),\n            data: res.real_arrival_datetime ? moment(res.real_arrival_datetime).format('DD/MM/YYYY HH:mm:ss') : null\n        })\n        this.genericTripDetails.push({\n            title: this.translateJsonService.getTranslateSubs('TRIPS-PAGE.opened_by'),\n            data: res.opened_by ? this.translateJsonService.getTranslateSubs(`TRIPS-PAGE.${res.opened_by.toLowerCase()}`) : null\n        })\n        if(!this.hideNullInfo) {\n            this.genericTripDetails.push({\n                title: this.translateJsonService.getTranslateSubs('TRIPS-PAGE.closed_by'),\n                data: res.closed_by ? this.translateJsonService.getTranslateSubs(`TRIPS-PAGE.${res.closed_by.toLowerCase()}`) : null\n            })\n            if(res.closed_by != 'SERVICE_ENDING') {\n                this.genericTripDetails.push({\n                    title: this.translateJsonService.getTranslateSubs('TRIPS-PAGE.closure_data_source'),\n                    data: res.closure_data_source ? this.translateJsonService.getTranslateSubs(`TRIPS-PAGE.${res.closure_data_source.toLowerCase()}`) : null\n                })\n            }\n            this.genericTripDetails.push({\n                title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.real_total_distance_km'),\n                data: `${res.real_total_distance_km != null ? res.real_total_distance_km : '-'} km`\n            })\n            this.genericTripDetails.push({\n                title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.average_service_fraction'),\n                data: `${res.real_total_distance_km != null ? res.real_total_distance_km : '-'} / ${res.real_total_points != null ? res.real_total_points : '-'} (${res.real_total_distance_avg_km != null ? res.real_total_distance_avg_km : '-'} km)`\n            })\n            this.genericTripDetails.push({\n                title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.average_trip_fraction'),\n                data: `${res.real_distance_km != null ? res.real_distance_km: '-'} / ${res.real_trip_points != null ? res.real_trip_points : '-'} (${res.real_trip_distance_avg_km != null ? res.real_trip_distance_avg_km : '-'} km)`\n            })\n            this.genericTripDetails.push({\n                title: `${this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.real_adherence_distance_km')} (km)`,\n                data: `${res.real_adherence_distance_km != null ? res.real_adherence_distance_km : '-'} km`\n            })\n            this.genericTripDetails.push({\n                title: `${this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.real_adherence_distance_km')} (%)`,\n                data: `${res.real_adherence_points != null ? res.real_adherence_points: '-'} / ${res.real_trip_points != null ? res.real_trip_points : '-'} (${res.real_adherence_points_percent != null ? res.real_adherence_points_percent : '-'}%)`\n            })\n            this.genericTripDetails.push({\n                title: `${this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.adherence_during_boaring')} (%)`,\n                data: `${res.real_boarding_adherence_points != null ? res.real_boarding_adherence_points : '-'} / ${res.real_boarding_trip_points != null ? res.real_boarding_trip_points : '-'} (${res.real_boarding_adherence_points_percent != null ? res.real_boarding_adherence_points_percent : '-' }%)`\n            })\n        }\n        this.genericTripDetails.push({\n            title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.scheduled_source_place'),\n            data: res.scheduled_source_place\n        })\n        this.genericTripDetails.push({\n            title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.scheduled_destination_place'),\n            data: res.scheduled_destination_place\n        })\n        this.genericTripDetails.push({\n            title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.scheduled_passenger_capacity'),\n            data: res.scheduled_passenger_capacity\n        })\n        this.genericTripDetails.push({\n            title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.real_passenger_count'),\n            data: 'passengerCount'\n        })\n        this.genericTripDetails.push({\n            title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.departure_location'),\n            data: res.real_departure_latitude + \" \" + res.real_departure_longitude\n        })\n        if(!this.hideNullInfo) {\n            this.genericTripDetails.push({\n                title: this.translateJsonService.getTranslateSubs('TRIP-INFO-DETAIL.arrival_location'),\n                data: res.real_arrival_latitude + \" \" + res.real_arrival_longitude\n            })\n        }\n    }\n\n    loadInfo(infoData) {\n        let dataList = []\n        for(let prop in infoData) {\n            dataList.push({\n                title: prop,\n                data: infoData[prop]\n            })\n        }\n        return dataList\n    }\n\n    resetFullTripData() {\n        this.showDriverInfo = false\n        this.fullScheduledInfo = []\n        this.fullRealizedInfo = []\n        this.fullGenericInfo= []\n        this.fullHeadersInfo = []\n        this.fullGenericHeadersInfo = []\n        this.driverData = []\n        this.fullGenericInfoObj  = null\n        this.fullTripInfo = null\n    }\n\n    closeDriverDatais() {\n        this.showDriverInfo = false\n    }\n\n    closeCheckpointDetails() {\n        this.showCheckpointsInfo = false\n    }\n\n    mapDestroyer() {\n        if (this.checkpointsLayer) this.checkpointsLayer.clearLayers()\n        if (this.coreFenceLayers) this.coreFenceLayers.clearLayers()\n        if (this.map) this.map.remove();\n    }\n\n    openFullTripInfoModal(tripInfo) {\n        this.boardingPointsLayer.clearLayers()\n        this.dataMapLoading()\n        this.showCheckpointsInfo = false\n        this.passengerCount = null\n        this.showTripDirectionMarkers = false\n        this.toggledPositions = []\n        this.tripToggledMarkers = []\n        this.fullTripInfo = null\n        this.loadingFullTripInfo = true\n        this.passengerTripOrderTitleValue = tripInfo.trip_order\n        this.loadFullTripInfo(tripInfo.trip_id)\n        this.loadCheckPointMarkers(tripInfo.trip_id)\n        this.displayFullTripDetail = true\n    }\n\n    openDriverDetails() {\n        this.showCheckpointsInfo = false\n        if(this.driverDetails.length)  this.showDriverInfo = true\n    }\n\n    openCheckPointDetails() {\n        this.showDriverInfo = false\n        if(this.checkPointDetails.length) this.showCheckpointsInfo = true\n    }\n\n    openExportModal() {\n        this.displayExportDialog = true\n    }\n\n    clearDataBeforeLoad() {\n        this.showErrorMessage = false\n        this.loading = true\n    }\n\n    showPassengerBoardingLocation(passenger) {\n        this.map.setView([passenger.boarding_latitude, passenger.boarding_longitude], 18)\n        if(this.showPassengerData) {\n            this.passengerInfo = null\n            this.showPassengerData = false\n        }\n    }\n\n    private initMap(lat: number, long: number): void {\n        this.map = L.map('map', {\n            center: [lat, long],\n            zoom: 13,\n            fullscreenControl: true,\n            fullscreenControlOptions: {\n                position: 'topleft',\n                content: '<i class=\"ion-arrow-expand\" style=\"font-size: 22px\"></i>',\n            }\n        })\n        this.IS_NULL_GOOGLE_MAPS_KEY ? this.openStreetMapTiles.addTo(this.map) : this.googleTiles.addTo(this.map)\n        \n        if(this.displayRouteDialog) {\n            this.initViewControlRoute() \n        } else {\n            this.initViewControl()\n        }\n    }\n\n    private dataMapLoading() {\n\n        if(this.isNullUrlFencesApi ) return\n\n        this.fencesService.getAllActives().subscribe(fences => {\n            fences.forEach(fence => {\n                let latlgnArray = []\n\n                fence.coords.forEach(coord => {\n                    latlgnArray.push({lat: coord.lat, lng: coord.lng}) \n                })\n\n                this.coordinates.push({\n                    coords: latlgnArray,\n                    name: fence.name,\n                    maxSpeed: fence.maxSpeed,\n                    rotogram: fence.rotogram\n                })\n            })\n\n            this.coordinates.forEach(coord => {\n                let popup =\n                \"<strong>\" + this.translateJsonService.getTranslateSubs('POSITIONS-BY-FENCES.core_fence_name') + \"</strong>\" + coord.name + \"<br>\" +\n                \"<strong>\" + this.translateJsonService.getTranslateSubs('POSITIONS-BY-FENCES.core_fence_max_speed') + \"</strong>\" + coord.maxSpeed + \"<br>\" +\n                \"<strong>\" + this.translateJsonService.getTranslateSubs('POSITIONS-BY-FENCES.core_fence_rotogram') + \"</strong>\" + coord.rotogram + \"<br>\";\n                \n                let polygon: any = L.polygon(coord.coords, {\n                    color: \"gray\",\n                    dashArray: '4 6'\n                }).bindPopup(popup);\n\n                this.coreFenceLayers.addLayer(polygon)\n            })\n        })\n    }\n\n    showPassengerInfo(passenger) {\n        this.passengerDetails = []\n        this.showPassengerData = false\n        this.passengerInfo = JSON.parse(passenger.passenger_data)\n        this.passengerDetails = this.loadInfo(JSON.parse(passenger.passenger_data))\n        this.showPassengerData = true\n    }\n\n    closePassengerInfoData() {\n        this.showPassengerData = false\n    }\n\n    loadTrip(trip) {\n        this.tripToFinish = trip\n    }\n\n    openConfirmationDialog() {\n        clearInterval(this.currentIntervalPointer)\n        this.displayConfirmation = true\n    }\n\n    closeConfirmationDialog() {\n        this.displayConfirmation = false\n        this.currentIntervalPointer = setInterval(() => this.loadCurrentData(this.listVehicles), 15000)\n    }\n\n    closeTrip() {\n        this.tripsService.finishTrip(this.tripToFinish.trip_id).subscribe(\n            result => {\n                this.loadCurrentData(this.listVehicles)\n                this.closeConfirmationDialog()\n            }, \n            err => {\n                th