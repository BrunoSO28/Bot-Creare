 \"../../../@core/data/customer.service\";\nimport { DataService } from \"../../../@core/data/data.service\";\nimport { FilterAlarms } from \"../../../@core/models\";\nimport { CustomerChild } from \"../../../@core/models/customerChild.entity\";\nimport { TreeInputModel } from \"../../../@core/models/treeInputModel.entity\";\nimport { customerChildsPermissions, Workspace } from \"../../../@core/models/workspace.data.entity\";\nimport { EquipamentFeatures } from \"app/@core/enum/equipament-features.enum\";\nimport { EquipamentType } from \"app/@core/enum/equipament.type.enum\";\n\n@Component({\n    selector: 'voice-message-filter',\n    styleUrls: ['./voice-message-filter.component.scss'],\n    templateUrl: './voice-message-filter.component.html',\n})\n\nexport class VoiceMessageFilterComponent implements OnInit {\n\n    private subsworkspace: Subscription;\n    private subsonline: Subscription;\n    private subscustomers: Subscription;\n    private subsvehicles: Subscription;\n    private subsMessages: Subscription;\n    public filterSelectedData: FilterAlarms = new FilterAlarms();\n    private workspace: Workspace;\n    public selectedCustomers: number[];\n    public customers : TreeInputModel[] = [];\n    public loadedCustomers : boolean;\n    public changingSelectedCustomers: number = 0;\n    public selectedVehicles: number[];\n    public vehicles: TreeInputModel[] = [];\n    public loadedVehicles: boolean = false;\n    public pendingVehicles: boolean = true;\n    public pendingBtnFilter: boolean = true;\n    public messages: TreeInputModel[] = [];\n    public allMessages: TreeInputModel[] = [];\n    public loadedMessages: boolean = false;\n    public pendingMessages: boolean = true;\n    public selectedMessages: number[];\n\n    @Output('submitFilter') submitFilter: EventEmitter<any> = new EventEmitter();\n    @Output('loadedFilter') loadedFilter: EventEmitter<boolean> = new EventEmitter();\n    @Output('filterChatBox') filterChatBox: EventEmitter<any> = new EventEmitter();\n    @Input('isSaving') isSaving: boolean;\n\n    constructor(private dataService: DataService,\n                private customerService: CustomerService,\n                private assetService: AssetService,\n                private playbackOldService: PlaybackOldService,\n                private commandVoiceService: CommandVoiceService) {\n\n    }\n\n    ngOnInit() {\n        this.getFilterAlarms();\n    }\n\n    ngOnDestroy() {\n        if (this.subsonline) this.subsonline.unsubscribe();\n        if (this.subsworkspace) this.subsworkspace.unsubscribe();\n        if (this.subscustomers) this.subscustomers.unsubscribe();\n        if (this.subsvehicles) this.subsvehicles.unsubscribe();\n        if (this.subsMessages) this.subsMessages.unsubscribe();\n    }\n\n    private getFilterAlarms(): void {\n        let kp: Workspace  = this.dataService.getWorkspace();\n        this.workspace = kp;\n        this.loadedFilter.emit(true); \n        this.loadCustomers();\n    }\n\n    private loadCustomers(): void {\n        let customerChildsUser: number[] = [];\n        this.workspace.userCustomerChildIds.forEach((customerChildsPermissions : customerChildsPermissions ) => {\n          customerChildsUser.push(customerChildsPermissions.customer);\n        });\n\n        if (!this.dataService.getAllCustomerChilds() || this.dataService.getAllCustomerChilds().length < 1) {\n            if(customerChildsUser.length > 0) {\n                this.subscustomers = this.customerService.getCustomerChildsByIds(customerChildsUser).subscribe((_customers: CustomerChild[]) => {\n                    this.customers = this.customerService.convertCustomerChildsToTreeInputModel(_customers);\n                    this.loadedCustomers = true;\n                    this.dataService.registerCustomerChilds(_customers);\n                })\n            }\n        } else {\n            this.customers = this.customerService.convertCustomerChildsToTreeInputModel(this.dataService.getAllCustomerChilds());\n            this.loadedCustomers = true;\n            this.loadVehicles();\n            this.loadMessages();\n        }\n    }\n\n    private loadVehicles(): void {\n        if (this.filterSelectedData && this.filterSelectedData.selectedCustomers.length > 0) {\n            const custIds = this.filterSelectedData.selectedCustomers\n            this.subsvehicles = this.playbackOldService.getVehiclesON({\n                custIds,\n                equipamentFeatures: [EquipamentFeatures.VOICE_MESSAGE]\n            }).subscribe((heartbeats: LastHeartbeat[]) => {\n                this.vehicles = this.assetService.convertAssetToTreeInputModel(heartbeats.map(h => ({ id: h.vehicle_id, name: h.vehicle_plate, customerChildId: h.customer_child_id, identification: h.vehicle_prefix, imei: h.imei, equipmentType: h.equipamentType })));\n                this.loadedVehicles = true;\n            }, error => {\n                console.info(\"Falha na leitura do cadastro de Vehicles.\", error);\n            })\n        }\n    }\n\n    private loadMessages(): void {\n        if (this.filterSelectedData && this.filterSelectedData.selectedCustomers.length > 0) {\n            this.subsMessages = this.commandVoiceService.loadCommandsVoiceFiltered(this.filterSelectedData.selectedCustomers, true).subscribe((commandVoice: CommandVoice[]) => {\n                this.allMessages = this.commandVoiceService.convertMessageToTreeInputModel(commandVoice);\n                this.messages = [...this.allMessages];\n                this.loadedMessages = true;\n            }, error => {\n                console.info(\"Erro ao consultar mensagens de voz.\", error);\n            })\n        }\n    }\n\n    public changedCustomers(event) {\n        if (event.length == 0) {\n            this.changingSelectedCustomers = 0;\n            this.selectedCustomers = event;\n            this.selectedVehicles = [];\n            this.selectedMessages = [];\n            this.messages = [];\n            this.allMessages = [];\n            this.lockingVehicles();\n            this.applySelectedCustomers();\n        } else {\n            let csc = ++this.changingSelectedCustomers;\n            setTimeout(() => {\n                if(this.changingSelectedCustomers == csc) {\n                    this.selectedCustomers = event;\n                    this.selectedVehicles = [];\n                    this.selectedMessages = [];\n                    this.applySelectedCustomers();\n                    this.loadVehicles();\n                    this.loadMessages();\n                    this.changingSelectedCustomers = 0;\n                    this.lockingVehicles();                    \n                }\n            }, 2000);\n        } \n    }\n\n    private applySelectedCustomers() {\n        this.filterSelectedData.selectedCustomers = this.selectedCustomers;\n        this.filterSelectedData.selectedVehicles = this.selectedVehicles;      \n        this.filterSelectedData.selectedMessages = this.selectedMessages;      \n        this.availableFiltering();\n    }\n\n    private lockingVehicles() {\n        if (this.selectedCustomers.length > 0) {\n            this.pendingVehicles = false;\n            this.pendingMessages = false;\n        } else {\n            this.pendingVehicles = true;\n            this.pendingMessages = true;\n        }\n    }\n\n    public changedVehicles(event) {\n        this.selectedVehicles = event;\n        this.selectedMessages = [];\n        this.filterMessagesByEquipmentType();\n        this.applySelectedCustomers();        \n    }\n\n    private filterMessagesByEquipmentType(): void {\n        if (this.selectedVehicles.length === 0) {\n            this.messages = [...this.allMessages];\n            return;\n        }\n\n        const selectedVehicle = this.vehicles.find(v => v.id === this.selectedVehicles[0]);\n        \n        if (!selectedVehicle || !selectedVehicle.equipmentType) {\n            this.messages = [...this.allMessages];\n            return;\n        }\n\n        const equipmentType = selectedVehicle.equipmentType;\n        let allowedFormats: string[] = [];\n\n        if (this.isMp3FormatForEquipment(equipmentType)) {\n            allowedFormats = ['mp3'];\n        } else if (this.isWavFormatForEquipment(equipmentType)) {\n            allowedFormats = ['wav'];\n        } else {\n            allowedFormats = ['mp3', 'wav'];\n        }\n\n        this.messages = this.allMessages.filter(message => \n            allowedFormats.includes(message.fileFormat.toLowerCase())\n        );\n    }\n\n    private isMp3FormatForEquipment(equipmentType: number): boolean {\n        return [\n            EquipamentType.JIMI,\n            EquipamentType.JIMI_V6,\n            EquipamentType.JIMI_G5_PLUS,\n            EquipamentType.JIMI_JC400AD_ID,\n            EquipamentType.JIMI_JC400D_R,\n        ].includes(equipmentType);\n    }\n\n    private isWavFormatForEquipment(equipmentType: number): boolean {\n        return [\n            EquipamentType.STONKAM,\n            EquipamentType.STONKAM_K1_PLUS,\n        ].includes(equipmentType);\n    }\n\n    public changedMessages(event) {\n        this.selectedMessages = event;\n        this.applySelectedCustomers();\n    }\n\n    public filterChatBoxMessages() {\n        const vehicle = this.vehicles.find(vehicle => vehicle.id == this.filterSelectedData.selectedVehicles[0]);\n        this.filterChatBox.emit({...this.filterSelectedData, selectedImei: vehicle.imei, selectedEquipmentType: vehicle.equipmentType, selectedPlate: vehicle.name});\n    }\n\n    public availableFiltering() {\n        if (!this.filterSelectedData.selectedCustomers || this.filterSelectedData.selectedCustomers.length < 1) {\n            this.pendingBtnFilter = true;\n            return false;\n        }\n\n        if (!this.filterSelectedData.selectedVehicles || this.filterSelectedData.selectedVehicles.length < 1) {\n            this.pendingBtnFilter = true;\n            return false;\n        }\n\n        if (