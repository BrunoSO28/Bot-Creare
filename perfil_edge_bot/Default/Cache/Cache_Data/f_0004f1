put(\"alarm\")\n    public alarm: Alarm;\n\n    constructor(\n        public translateJsonService: TranslateJsonService,\n        protected translateService: TranslateService,\n    ) {\n    }\n}\n","import { Injector, Type, InjectionToken, InjectFlags } from '@angular/core'\n\nexport class DialogInjector implements Injector {\n  constructor(\n    private _parentInjector: Injector,\n    private _additionalTokens: WeakMap<any, any>\n  ) {}\n\n  get<T>(\n    token: Type<T> | InjectionToken<T>,\n    notFoundValue?: T,\n    flags?: InjectFlags\n  ): T\n  get(token: any, notFoundValue?: any)\n  get(token: any, notFoundValue?: any, flags?: any) {\n    const value = this._additionalTokens.get(token)\n\n    if (value) return value\n\n    return this._parentInjector.get<any>(token, notFoundValue)\n  }\n}","import { ApplicationRef, ComponentFactoryResolver, ComponentRef, EmbeddedViewRef, Injectable, Injector, Type } from '@angular/core';\nimport { DialogConfig } from './dialog-config';\nimport { DialogInjector } from './dialog-injector';\nimport { DialogRef } from './dialog-ref';\nimport { DialogComponent } from './dialog.component';\nimport { DialogModule } from './dialog.module';\n\n@Injectable({\n  providedIn: DialogModule\n})\nexport class DialogService {\n  dialogComponentRef: ComponentRef<DialogComponent>\n\n  constructor(\n    private componentFactoryResolver: ComponentFactoryResolver,\n    private appRef: ApplicationRef,\n    private injector: Injector\n  ) {}\n\n  private appendDialogComponentToBody(config: DialogConfig) {\n    const map = new WeakMap();\n    map.set(DialogConfig, config);\n\n    const dialogRef = new DialogRef();\n    map.set(DialogRef, dialogRef);\n\n    const sub = dialogRef.afterClosed.subscribe(() => {\n      this.removeDialogComponentFromBody();\n      sub.unsubscribe();\n    });\n\n    const componentFactory = this.componentFactoryResolver.resolveComponentFactory(DialogComponent);\n    const componentRef = componentFactory.create(new DialogInjector(this.injector, map));\n\n    this.appRef.attachView(componentRef.hostView);\n\n    const domElem = (componentRef.hostView as EmbeddedViewRef<any>).rootNodes[0] as HTMLElement;\n    document.body.appendChild(domElem);\n\n    this.dialogComponentRef = componentRef;\n\n    this.dialogComponentRef.instance.onClose.subscribe(() => {\n      this.removeDialogComponentFromBody();\n    });\n\n    // return the dialogRef\n    return dialogRef;\n  }\n\n  private removeDialogComponentFromBody() {\n    this.appRef.detachView(this.dialogComponentRef.hostView);\n    this.dialogComponentRef.destroy();\n  }\n\n  public open(componentType: Type<any>, config: DialogConfig) {\n    const dialogRef = this.appendDialogComponentToBody(config);\n\n    this.dialogComponentRef.instance.childComponentType = componentType;\n\n    return dialogRef;\n  }\n}\n","import { Component, ViewChild, ElementRef, Input, SimpleChanges } from \"@angular/core\";\n\n@Component({\n    selector: 'focus-donut-chart',\n    styles: [''],\n    template: `<canvas class=\"donut\" #donutChart></canvas>`\n})\n\nexport class DonutChart {\n    @ViewChild('donutChart') donutChart: ElementRef;\n    \n    @Input('size') donutChartSize: number = 120;\n    @Input('value') value: number = 0;\n    @Input('totalValues') totalValues: number = 0;\n    @Input('colors') colors: string[] = ['#99cb77', '#ececec'];\n    @Input('label') donutLabel: string[] = ['ALERTAS'];\n\n\n    ngOnInit(){        \n        this.createDonutChart(this.donutChartSize, this.calcPercentageRisk(this.value), this.colors, this.donutLabel, 0, this.donutChart, this.value);\n    }\n\n    lessValueChart(atualValue:number, valueMin:number){\n        if(atualValue >= 0){          \n            this.createDonutChart(this.donutChartSize, this.calcPercentageRisk(atualValue), this.colors, this.donutLabel, 0, this.donutChart, atualValue);\n        }\n    \n        if(atualValue > valueMin) {this.lessValueChart(atualValue-1, valueMin)};\n    }\n    \n    moreValueChart(atualValue:number, maxValue:number){\n        this.createDonutChart(this.donutChartSize, this.calcPercentageRisk(atualValue), this.colors, this.donutLabel, 0, this.donutChart, atualValue);\n\n        if(atualValue < maxValue) {this.moreValueChart(atualValue+1, maxValue)};\n    }\n\n    createDonutChart(sizes,percValue,colors,labels,selectedValue,elemRef,value){              \n        const cxy = (sizes*50)/100;\n        const radius = (sizes*45)/100\n        const arcwidth = 6;    \n        const values = [percValue, 100-percValue];  \n        \n        let ctx: CanvasRenderingContext2D = (elemRef.nativeElement as HTMLCanvasElement).getContext('2d');\n        ctx.canvas.width = sizes;\n        ctx.canvas.height = sizes;\n    \n        let tot=0;\n        let accum=0;\n        let PI=Math.PI;\n        let PI2=PI*2;\n        let offset=-PI/2;\n        ctx.lineWidth=arcwidth;\n        for(var i=0;i<values.length;i++){tot+=values[i];}\n        for(var i=0;i<values.length;i++){\n            ctx.beginPath();\n            ctx.arc(cxy,cxy,radius,\n                offset+PI2*(accum/tot),\n                offset+PI2*((accum+values[i])/tot)\n            );\n            ctx.strokeStyle=colors[i];\n            ctx.stroke();\n            accum+=values[i];\n        }\n        var innerRadius=radius-arcwidth;\n    \n        ctx.beginPath();\n        ctx.arc(cxy,cxy,innerRadius,0,PI2);\n        ctx.fillStyle='white';\n        \n        ctx.fill();\n        ctx.textAlign='center';\n        ctx.textBaseline='bottom';\n        ctx.fillStyle=colors[0];\n        ctx.font='bold '+(2.5)+'em roboto';    \n        ctx.fillText(value,cxy,cxy+innerRadius*.3);\n        ctx.fillStyle='#8892a0';\n        ctx.font=(14)+'px roboto';\n        ctx.fillText(labels[selectedValue],cxy,cxy+innerRadius*.6);\n    }\n\n    private calcPercentageRisk(riskValue : number): number {  \n        return (riskValue == 0) ? 0 : (riskValue * 100) / this.totalValues;        \n    }\n\n    ngOnChanges(changes : SimpleChanges){              \n        if(changes['value']) {\n            let change = changes['value'];\n            \n            if(change.currentValue > change.previousValue) {\n                this.moreValueChart(change.previousValue, change.currentValue);                \n            }else{\n                this.lessValueChart(change.previousValue, change.currentValue);                \n            }\n        }\n    }\n}","module.exports = \".pane{padding:1.5em;width:90%;height:100%;float:left;background-color:#FFFFFF}\\n\"","import { Component, Input } from '@angular/core';\n\n@Component({\n  selector: 'tab',\n  styleUrls: ['tab.component.scss'],\n  template: `\n    <div [hidden]=\"!active\" class=\"pane\">\n      <ng-content></ng-content>\n    </div>\n  `\n})\nexport class TabComponent {\n  @Input('tabTitle') title: string;\n  @Input('tabIcon') icon: string;\n  @Input() active = false;\n}","module.exports = \".treatNav{width:10%;float:left;padding:0px !important}.treatNav li{width:100%;float:left;list-style-type:none;height:80px;cursor:pointer}.treatNav li a{padding:0px !important;width:100%;height:100%;text-align:center;color:#b9b9b9}.treatNav li a.active{background-color:#ffffff;color:#2173af}.treatNav li a.active:hover{color:#1f699e;background-color:#ffffff}.treatNav li a:hover{background-color:#e2e1e1;color:#ababab}.treatNavIcon{font-size:35px;margin:15px auto 5px}.treatNavTitle{font-size:10px;width:100%;float:left}\\n\"","import { Component, ContentChildren, QueryList, AfterContentInit } from '@angular/core';\nimport { TabComponent } from './tab.component';\n\n@Component({\n  selector: 'tabs',\n  styleUrls: ['./tabs.component.scss'],\n  template:`\n    <ul class=\"treatNav\">\n      <li class=\"nav-item\" *ngFor=\"let tab of tabs\" (click)=\"selectTab(tab)\">\n        <a class=\"nav-link\" tabindex [class.active]=\"tab.active\">\n          <i class='fa {{tab.icon}} treatNavIcon' aria-hidden='true'></i>\n          <span class='treatNavTitle'>{{tab.title}}<