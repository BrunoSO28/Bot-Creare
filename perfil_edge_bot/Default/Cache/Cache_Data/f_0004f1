n: `&copy ${environment.creareName}` })],\n    zoom: 5,\n    center: latLng([ -29.8873545, -51.1590298 ])\n  };\n  \n  public AlertData: Alarm[];\n\n  public loadingMap = true;\n  public allMarkers: ModelMarkers[] = [];\n\n  public isSingleClick: boolean = true;\n  public countSelectedAlarm = 0;\n\n  public selectedPicture: string;\n  public selectedMovie: string[];\n\n  private workspace: Workspace;\n  public errorVideoNotFound = false;\n  public allSelected: boolean = false;\n  private loadedTreatment: boolean = false;\n  public isFromDevicesWithoutMedia: boolean = false;\n  public devicesWithoutMedia:number[] = environment.equipmentsTypeIdWithoutMedia.split(',').map(a => Number(a));\n  public isProcessingAlarmValidation: boolean = false;\n  public displayMapModal: boolean = false;\n  public selectedAlarms: Alarm[];\n  public showChartLastVelocitiesAndAlarms: boolean;\n  public aiAlarmValidations: AiAlarmValidation[];\n  public invalidAlarmType = AlarmTypeCodeEnum.INVALID_ALARM;\n  public currentAlarmType: number;\n\n  public displayInvalidationModal: boolean = false;\n  public invalidationComments: string = '';\n\n  private readonly ValidationPurpose = {\n    VALIDATION: 1,\n    INVALIDATION: 2\n  };\n\n  @Output() eventInvalidateAlarm = new EventEmitter();\n  columnsWearable: { field: string; header: string; }[];\n  @Output('eventCloseModal') eventCloseModal: EventEmitter<boolean> = new EventEmitter();\n\n  constructor(\n      protected dataService: DataService,\n      private treatmentFlowService: TreatmentFlowService,\n      private notificationUtilService: NotificationUtilService,\n      private dialogService: DialogService,\n      public treatmentFlowState: TreatmentFlowState,\n      public translateJsonService: TranslateJsonService,\n      protected translateService: TranslateService,\n      public alarmService: AlarmService,\n  ){\n    this.alarms$ = this.treatmentFlowState.getAlarms$()\n        .pipe(\n            distinctUntilChanged((a, b) => JSON.stringify(a) === JSON.stringify(b))\n        );\n\n    this.workspace = this.dataService.getWorkspace();\n    this.columnsWearable = [\n      {field: 'speed', header: 'GLOBAL.speed'},\n      {field: 'datetime', header: 'GLOBAL.datetime'},\n      {field: 'vehicle_plates', header: 'GLOBAL.driver'}\n    ];\n    this.alarms$.subscribe(alarms => {\n      this.selectedAlarms = alarms;\n      this.showChartLastVelocitiesAndAlarms = true;\n      }\n    );\n  }\n\n  ngOnInit(){\n    this.alarms$.subscribe(alarms => {\n      if (alarms[0] && !this.loadedTreatment) {\n        this.loadedTreatment = true\n        this.treatmentFlowService.loadTreatments(this.treatmentFlowState.getAlarms()[0].customer_profile_id);\n        this.isFromDevicesWithoutMedia = this.devicesWithoutMedia.includes(alarms[0].equipmentTypeId);\n      }\n\n      setTimeout(() => {\n        this.allMarkers = [];\n        alarms.forEach(alarm => {\n          let mrkr: ModelMarkers = new ModelMarkers;\n          mrkr.id = alarm.id;\n          mrkr.name = alarm.driver_firstname;\n          mrkr.category = alarm.typeAlarm;\n          mrkr.enabled = true;\n          mrkr.latitude = alarm.latitude;\n          mrkr.longitude = alarm.longitude;\n\n          this.allMarkers.push(mrkr);\n        });\n        this.loadingMap = false;\n      }, 2000);\n    });\n\n    this.countSelectedAlarm = this.treatmentFlowState.countSelectedAlarm();\n    this.treatmentFlowState.getInfos$().subscribe(infos => {\n      if (infos && infos.alarmType !== undefined) {\n        this.currentAlarmType = infos.alarmType;\n      }\n    });\n  }\n\n  selectAlarm(alarmId: number) {\n    this.isSingleClick = true;\n    setTimeout(()=>{\n      if(this.isSingleClick && this.isClickable){\n        this.treatmentFlowState.selectedAlarm(alarmId);\n        this.countSelectedAlarms();\n      }\n    }, 250)\n\n    this.treatmentFlowState.getAiAlarmValidations$().subscribe(aiAlarmValidations => {this.aiAlarmValidations = aiAlarmValidations});\n  }\n\n  zoomAlarmImage(event, urlPictures, urlMovies, container, alarm, aiAlarmValidations = this.aiAlarmValidations) {\n    if(urlPictures[0]=='NO_PICTURE') return;\n    this.isSingleClick = false;\n    this.dialogService.open(ZoomMediasComponent, { data: { urlPictures, urlMovies, alarm, aiAlarmValidations }});\n  }\n\n  countSelectedAlarms(){\n    this.countSelectedAlarm = this.treatmentFlowState.countSelectedAlarm();\n  }\n\n  removeAlarms(){\n    this.displayInvalidationModal = true;\n  }\n  cancelInvalidation() {\n    this.displayInvalidationModal = false;\n    this.invalidationComments = '';\n  }\n  confirmInvalidation() {\n    this.isProcessingAlarmValidation = true;\n    const alarms = this.treatmentFlowState.getSelectedAlarms();\n    const purpose = this.currentAlarmType === this.invalidAlarmType\n        ? this.ValidationPurpose.INVALIDATION\n        : this.ValidationPurpose.VALIDATION;\n    this.treatmentFlowService.processAlarmValidation(alarms, purpose, this.invalidationComments).then(result => {\n      this.treatmentFlowState.removeAlarmsById(result.success);\n      this.countSelectedAlarms();\n\n      this.reloadAlarmsAfterInvalidate(!!result.success[0]);\n\n      this.notificationUtilService.printSuccessMessage(\n        `${this.translateJsonService.getTranslateSubsParam('TREATMENT-MODAL.finished_alert', { alerts_count: result.success.length })}\n         ${(result.failed.length > 0) ? this.translateJsonService.getTranslateSubsParam('TREATMENT-MODAL.finished_error', { alerts_count: result.failed.length }) : ''}`\n      );\n      if (purpose === this.ValidationPurpose.VALIDATION && result.auditIds && result.auditIds.length) {\n        this.alarmService.getUpdatedAlarmsDataAfterCompletion(result.auditIds)\n      }\n      this.displayInvalidationModal = false;\n      this.invalidationComments = '';\n      this.isProcessingAlarmValidation = false;\n      if(this.treatmentFlowState.getAlarms().length == 0){\n        setTimeout(() => {\n            this.eventCloseModal.