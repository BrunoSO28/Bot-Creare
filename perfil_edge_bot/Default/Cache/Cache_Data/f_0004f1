\n\nexport class EquipmentCamListComponent {\n    @ViewChild('actionModal') public actionModal: ModalDirective;\n\n    @Output('addedEquipmentStreaming') public addedEquipmentStreaming: EventEmitter<EquipmentStreamingDto> = new EventEmitter<EquipmentStreamingDto>();\n    @Output('removedEquipmentStreaming') public removedEquipmentStreaming: EventEmitter<EquipmentStreamingDto> = new EventEmitter<EquipmentStreamingDto>();\n    @Input('isStreamingPage') public isStreamingPage: boolean\n\n    private selectedVehicles: number[] = [];\n    public selectedAssets: Asset[] = [];\n\n    columns = [\n        { field: 'vehiclePlate', header: 'Placa' },\n        { field: 'vehiclePrefix', header: 'Prefixo' },\n    ]\n\n    public selectedEquipments: TreeNode[] = [];\n    public equipmentStreamingList: TreeNode[] = [];\n\n    constructor(\n        private streamingFacade: StreamingFacade,\n        private notificationUtilService: NotificationUtilService,\n        public translateJsonService: TranslateJsonService,\n    ){\n        this.streamingFacade\n            .get$()\n            .subscribe((receivedEquipmentStreamingList: EquipmentStreamingDto[]) => {\n                this.equipmentStreamingList = [];\n\n                receivedEquipmentStreamingList.forEach(equip => {\n                    let treeNode: TreeNode = {};\n\n                    treeNode.label = `${equip.vehiclePlate} - ${equip.vehiclePrefix}`;\n                    treeNode.data = equip;                    \n                    treeNode.children = [];\n\n                    if(equip.streamingUrls) {\n                        equip.streamingUrls.forEach((url, i) => {\n                            if(i < 5 || environment.companyName == 'Vecchtelligence') {\n                                treeNode.children.push({ label: this.mostraNomeCorreto(i), data: { url, i }, type: 'channel' })\n                            }  \n                        })\n                    }else{\n                        treeNode.selectable = false;\n                    }\n\n                    this.equipmentStreamingList.push(treeNode);      \n                })             \n            })\n    }\n\n    mostraNomeCorreto(i: number) {\n        if(i == 0) {\n            return this.translateJsonService.getTranslateSubs('EQUIPMENT-CAM-LIST.fatigue_camera');\n        }\n\n        if(i == 1) {\n            return this.translateJsonService.getTranslateSubs('EQUIPMENT-CAM-LIST.front_camera');\n        }\n\n        if(i == 2 || i == 3) {\n            return this.translateJsonService.getTranslateSubs('EQUIPMENT-CAM-LIST.side_camera');\n        }\n\n        if(i == 4) {\n            return this.translateJsonService.getTranslateSubs('EQUIPMENT-CAM-LIST.internal_camera');\n        }\n\n        if(i == 5) {\n            return this.translateJsonService.getTranslateSubs('EQUIPMENT-CAM-LIST.cabin_camera');\n        }\n\n        if(i == 6) {\n            return this.translateJsonService.getTranslateSubs('EQUIPMENT-CAM-LIST.door_camera');\n        }\n\n    }\n\n    public searchVehicles(): void {\n        this.selectedVehicles = []\n        this.actionModal.show();\n    }\n\n    public newSelectedVehicles(vehicles: Asset[]): void {\n        this.selectedAssets = vehicles;\n        vehicles.forEach(vehicle => {\n            const exists = this.selectedVehicles.find(sv => sv == vehicle.id);\n            if(!exists) {\n                this.selectedVehicles.push(vehicle.id);\n            }\n        })\n        this.streamingFacade.load(vehicles);\n        this.actionModal.hide();\n    }\n    \n\n    public eventAddedOrRemove($event, add: boolean) {\n        const maxGridContainers = 16;\n        const node: TreeNode = $event.node;\n        let simultaneousMax = false;\n        let maxSelected = false;\n\n        if(add) {            \n            if(this.selectedEquipments.filter(s => !s.children).length > maxGridContainers) {                               \n                let addCount = 0;\n                if(node.children) {                    \n                    addCount = node.children.length+1;\n                    this.selectedEquipments.splice(this.selectedEquipments.length-addCount, addCount);\n                }else{\n                    this.selectedEquipments.pop();                    \n                }\n                maxSelected = true;\n            }\n            if(node.children) {\n                \n                if(node.data.simultaneousChannels < 2 && node.children.length > 1) {    \n                    const total = node.children.length - 1;                   \n                    this.selectedEquipments.splice(this.selectedEquipments.length-total, total);\n                }\n            }else{\n                const pai = node.parent;\n                const jaTemSelecionado = this.selectedEquipments.filter(e => {\n                    if(e.parent) {\n                        return e.parent.data.vehicleId == pai.data.vehicleId;\n                    }                    \n                });                \n                if(jaTemSelecionado.length > node.parent.data.simultaneousChannels) {                 \n                    this.selectedEquipments.pop(); \n                    maxSelected = true;\n                    simultaneousMax = true;\n                }                \n            }\n        }\n        \n        if(!maxSelected){\n            if(node.children) {\n                node.children.forEach((children, i) => {\n                    let equip: EquipmentStreamingDto = new EquipmentStreamingDto();\n                    equip.vehiclePlate = node.data.vehiclePlate;\n                    equip.vehiclePrefix = node.data.vehiclePrefix;\n                    equip.devid = node.parent ? node.parent.data.devid : node.data.devid;\n\n                    equip.vehicleId = node.data.vehicleId;\n                    equip.streamingUrl = children.data.url;\n                    equip.currentChannel = children.data.i;\n                    \n\n                    if(node.data.simultaneousChannels > i) {\n                        (add) ? this.addedEquipmentStreaming.emit(equip) : this.removedEquipmentStreaming.emit(equip);  \n                    }\n                })\n            }else{\n                let equip: EquipmentStreamingDto = new EquipmentStreamingDto();\n                equip.vehiclePlate = node.parent.data.vehiclePlate;\n                equip.vehiclePrefix = node.parent.data.vehiclePrefix;\n                equip.devid = node.parent ? node.parent.data.devid : node.data.devid;\n                equip.vehicleId = node.parent.data.vehicleId;\n                equip.streamingUrl = node.data.url;\n                equip.currentChannel = node.data.i;\n    \n                (add) ? this.addedEquipmentStreaming.emit(equip) : this.removedEquipmentStreaming.emit(equip);\n            }\n        }else{\n            if(simultaneousMax) {\n                \n                this.notificationUtilService.printErrorMessage(\"Este veículo permite abrir apenas 1 câmera por vez\");\n            }else{\n                this.notificationUtilService.printErrorMessage(\"Limite de câmeras selecionadas\");\n            }            \n        }\n    }\n\n}","module.exports = \"<div class=\\\"main_div\\\">\\n\\n    <div *ngIf=\\\"selItemAlarmTypes.length > 1\\\" class=\\\"d-flex position-relative alarm-position\\\">\\n        <div class=\\\"flex-grow-1\\\">\\n            <div *ngIf=\\\"showAlertTypeFilter\\\" class=\\\"alarm-filters-wrapper\\\">\\n                <div \\n                    *ngFor=\\\"let alarmType of selItemAlarmTypes\\\" \\n                    class=\\\"alarm-type-filter\\\" \\n                    [ngClass]=\\\"{'with-description': showAlertTypeFilterDescription}\\\"\\n                    (click)=\\\"onChangeAlarmType(alarmType.value)\\\"\\n                    (mouseenter)=\\\"onMouseEnterAlarmFilter($event)\\\"\\n                    (mouseleave)=\\\"onMouseLeaveAlarmFilter($event)\\\"\\n                    [style.width]=\\\"get