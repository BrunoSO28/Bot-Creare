map((filter) => ({\n          ...filter,\n          name: filter.default\n            ? `(${this.translateJsonService.getTranslateSubs(\"FILTER-GLOBAL.user_filter_select_default\")}) ${filter.name}`\n            : filter.name,\n        }));\n        this.loading = false;\n      })\n      .catch(console.error);\n  }\n\n  create(): void {\n    this.resetForm();\n    this.creating = !this.creating;\n  }\n\n  changeSelectedFilter({ value }) {\n    this.userFilterSelected = value;\n  }\n\n  changeFilter() {\n    if (this.userFilterSelected) {\n      this.service.setUserFilterCustomerIdsList(this.userFilterSelected.id);\n    }\n  }\n\n  deleteFilter() {\n    if (this.userFilterSelected) {\n      this.loading = true;\n      this.service\n        .deleteUserFilter(this.userFilterSelected.id)\n        .then(() => {\n          this.loading = false;\n          this.listFilters();\n        })\n        .catch(() => {\n          this.loading = false;\n        });\n    }\n  }\n\n  filterAsDefault() {\n    if (this.userFilterSelected) {\n      this.service\n        .setUserFilterAsDefault(this.userFilterSelected.id)\n        .then(() => {\n          this.listFilters();\n        })\n        .catch(() => {\n          this.loading = false;\n        });\n    }\n  }\n\n  private resetForm() {\n    this.form = { name: \"\", default: false };\n    this.creating = false;\n  }\n\n  saveNewFilter() {\n    const {\n      selectedFilterAlams: { selectedCustomers },\n    } = this.dataService.getWorkspace();\n\n    this.loading = true;\n    this.service\n      .saveUserCustomerFilters(\n        this.form.name,\n        selectedCustomers,\n        this.form.default\n      )\n      .then(() => {\n        this.loading = false;\n        this.resetForm();\n        this.listFilters();\n      })\n      .catch(() => {\n        this.loading = false;\n        this.resetForm();\n      });\n  }\n}\n\ninterface NewFilterForm {\n  name: string;\n  default: boolean;\n}\n","import { ThemeModule } from 'app/@the