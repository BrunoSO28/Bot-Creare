omMinus3 = this.dataService.getBrowserTimezoneOffset() !== '-03:00';\n        const dateNow = new Date();\n\n        return alarms.map(alarm => {\n            if (alarm.timeZone === '0') {\n                alarm.timeZone = '+00:00';\n            }\n            const normalizedTimezone = this.dataService.normalizeTimezone(alarm.timeZone || '-03:00');\n            const isDifferentFromMicroserviceOffset = normalizedTimezone !== '-03:00';\n\n            const rawDatetimeStr = this.getStringValue(alarm as Record<string, any>, 'datetime', 'datetimestamp');\n            const rawAvailableMediaAtStr = this.getStringValue(\n                alarm as Record<string, any>,\n                'availableMediaAt',\n                'availableMediaAtTimestamp'\n            );\n\n            this.applyAlarmDatetimeFieldsForTimezone(alarm, isDifferentFromMicroserviceOffset);\n            this.applyAlarmTimezoneTooltipFields(\n                alarm,\n                browserDifferentFromMinus3,\n                rawDatetimeStr || '',\n                rawAvailableMediaAtStr || '',\n                normalizedTimezone\n            );\n\n            return this.buildAlarmWithDelayAndRead(alarm, dateNow);\n        });\n    }\n\n    trackByAlarmId(_index: number, alarm: Alarm): number { return alarm.id; }\n    trackByAssetId(_index: number, asset: any): number { return asset ? asset.id : _index; }\n    trackByColField(_index: number, col: any): string { return col ? col.field : String(_index); }\n\n    private static readonly DATE_FIELDS = new Set(['datetime', 'alarmReadAt', 'insertDate']);\n    private static readonly CONFIRMED_STATUS = 'CONFIRMED';\n\n    private compareValues(valueA: any, valueB: any, isDateField: boolean, order: number): number {\n        if (isDateField) {\n            valueA = this.normalizeDateValue(valueA);\n            valueB = this.normalizeDateValue(valueB);\n        }\n\n        // Nullish coalescing for cleaner null/undefined handling\n        if (valueA == null && 