any[] = [];\n  public tryRecognize = false;\n  public aiAlarmValidations: AiAlarmValidation[] = [];\n\n  constructor(\n    public treatmentFlowState: TreatmentFlowState,\n    public driverFacade: DriverFacade,\n    private dataService: DataService,\n    public faceRecogState: FaceRecogState,\n    public translateJsonService: TranslateJsonService,\n    private notificationService: NotificationUtilService,\n    private dialogService: DialogService,\n    private assetService: AssetService\n  ){\n    this.alarms$ = this.treatmentFlowState.getSelectedAlarms$();\n    this.alarms$.subscribe(result => {\n      if(result[0]){\n        this.hasFaceRecog = result[0].hasFaceRecog;\n        this.hasDriver = (result[0].driver_firstname)? true : false ;\n        this.alarmCustomerChild = result[0].customer_child_id\n      }\n    })\n\n    this.workspace = this.dataService.getWorkspace();\n    this.tryRecognize = false;\n    this.searchSubject.pipe(\n      debounceTime(this.debounceTimeMs)\n    ).subscribe(searchTerm => {\n      if (searchTerm.length > 3 || searchTerm == '') {\n        this.loadDrivers(searchTerm);\n      }\n    });\n  }\n\n  ngOnInit() {\n    this.countSelectedAlarm = this.treatmentFlowState.countSelectedAlarm();\n    this.alarms$.subscribe(alarms => {\n      this.customerChildId = alarms[0].customer_child_id\n    })\n    this.loadDrivers(this.searchTerm,this.currentPage)\n    this.treatmentFlowState.getAiAlarmValidations$().subscribe(aiAlarmValidations => {this.aiAlarmValidations = aiAlarmValidations});\n  }\n\n  onDropdownClick(): void {\n    setTimeout(() => {\n        const dropdownPanel = this.dropdownRef.nativeElement.querySelector('.ui-dropdown-items-wrapper');\n\n        if (dropdownPanel) {\n            dropdownPanel.addEventListener('scroll', this.onScroll.bind(this));\n        }\n      }, 500)\n    }\n\n    onScroll(event: any): void {\n      const panel = event.target;\n    \n      const scrollTop = panel.scrollTop;\n      const clientHeight = panel.clientHeight;\n      const scrollHeight = panel.scrollHeight;\n      const tolerance = 5; \n      const reachedBottom = scrollTop + clientHeight >= scrollHeight - tolerance;\n      if (reachedBottom && !this.isLoading && this.hasMoreDrivers) {\n        this.loadMoreDrivers(this.searchTerm);\n      }\n    }\n\n\n  setupSearchIcon(): void {\n    const filterInput = this.dropdownRef.nativeElement.querySelector('.ui-dropdown-filter');\n\n    if (filterInput) {\n      filterInput.addEventListener('input', () => {\n      this.searchTerm = filterInput.value\n      this.searchSubject.next(this.searchTerm)\n      })\n    };\n  }\n\n  zoomAlarmImage(event, urlPictures, urlMovies, container, alarm, aiAlarmValidations = this.aiAlarmValidations) {\n    if(urlPictures[0]=='NO_PICTURE') return;\n    this.dialogService.open(ZoomMediasComponent, { data: { urlPictures, urlMovies, alarm, aiAlarmValidations }});\n  }\n\n  previousStep(){\n    this.treatmentFlowState.previousStep();\n  }\n\n  loadDrivers(searchTerm: string = '', page: number = 0): void {\n    if(this.isLoading) return\n\n    this.hasMoreDrivers = true\n    this.currentPage = 0\n\n    this.isLoading = true;\n\n    this.assetService.getPaginatedAssetListByCustomer(this.customerChildId, this.assetType, page, searchTerm).subscribe(\n      response => {\n        this.drivers = response.assets.map(asset => ({\n          id: asset.id,\n          name: asset.name,\n          customerChildId: asset.customerChildId,\n          identification: asset.identification,\n          integration: asset.integration,\n          status: asset.status\n        }));\n        this.totalDrivers = response.totalItems\n      },\n      error => console.error(error),\n      () => this.isLoading = false\n    );\n  }\n\n  loadMoreDrivers(searchTerm: string = ''): void {\n  \n    if (this.isLoading || !this.hasMoreDrivers) return;\n\n    this.isLoading = true;\n    this.currentPage += 1;\n    \n    const dropdownPanel = this.dropdownRef.nativeElement.querySelector('.ui-dropdown-items-wrapper');\n\n    this.assetService.getPaginatedAssetListByCustomer(this.customerChildId, this.assetType, this.currentPage, searchTerm)\n      .subscribe(\n        response => {\n          const newDrivers = response.assets.map(asset => ({\n            id: asset.id,\n            name: asset.name,\n            customerChildId: asset.customerChildId,\n            identification: asset.identification,\n            integration: asset.integration,\n            status: asset.status\n          }));\n\n          this.drivers = [...this.drivers, ...newDrivers];\n\n          if (newDrivers.length < this.rowsPerPage) {\n            this.hasMoreDrivers = false;\n          }\n\n          this.totalDrivers = response.totalItems;\n\n          setTimeout(() => {\n            dropdownPanel.scrollTop = 0\n          }, 0)\n\n        },\n        error => console.error(error),\n        () => {\n          this.isLoading = false;\n        }\n      );\n    }\n  \n\n  faceRecogSelect(faceRecogId: number, selected: number){\n    this.faceRecogOptions.forEach(faceRecog => {\n      if(faceRecog.metaId == faceRecogId){\n        faceRecog.selected = selected;\n      }else{\n        if(selected){\n          faceRecog.selected = false;\n        }\n      }\n    })\n  }\n\n  updateDriverAlerts (alarmsWithouthDrivers: any){\n    this.alertsSelectStep = this.treatmentFlowState.getSelectedAlarms();\n    let alarmsWithDrivers = this.alertsSelectStep.filter(driver => driver.driverId != undefined);\n    \n    if (alarmsWithDrivers.length > 0){\n      this.notificationService.openConfirmationDialog(\n        this.translateJsonService.getTranslateSubs('SET-DRIVER.confirmation'), \n          this.translateJsonService.getTranslateSubs('SET-DRIVER.confirmation_driver')\n          +`${alarmsWithDrivers[0].driver_firstname}`\n          + this.translateJsonService.getTranslateSubs('SET-DRIVER.driver_alerts'),\n        () => {\n          alarmsWithouthDrivers.forEach( alarm => {\n    