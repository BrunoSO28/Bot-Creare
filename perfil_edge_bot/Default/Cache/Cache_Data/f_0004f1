his.translateJsonService.getTranslateSubs(newAlarmItem.label)\n    });\n    this.itensAlarmTypesDMS.sort((itemA: any, itemB: any) => {\n      return JSON.stringify(itemA.label).localeCompare(JSON.stringify(itemB.label))\n    })\n\n    if (this.infos.treatmentStartedAt) {\n      this.changeTreatment(true);\n      this.treatmentStartedDate = this.infos.treatmentStartedAt;\n      this.treatmentStarted = true;\n    } else {\n      const user = this.dataService.currentUser();      \n      const userLastName = user.name.split(\" \").pop();\n      const isUserTreatment = environment.userTypeTreatment.includes(userLastName);\n      \n      const ws = this.dataService.getWorkspace();\n      const hasCentralPermission = ws.accessControlDesc.some(permission => permission.permissions === 31);\n\n      if (isUserTreatment || hasCentralPermission) this.changeTreatment(true);      \n    }\n  }\n\n  onChangeAlarmType(){\n    this.changedAlarmType.emit(this.infos.alarmType);\n  }\n\n  public changeMask($event): void {\n    this.tretmentFlowState.setMaskCOVID($event);\n  }\n  public changeNoSeatbelt($event): void {\n    this.tretmentFlowState.setNoSeatbelt($event);\n  }\n\n  public changeTreatment($event: boolean) {\n    this.treatmentStarted = $event;\n    this.treatmentStartedDate = $event ? moment(new Date()).format(): null;\n    this.alarmService.setTreatmentStarted(this.infos.alarmIds, $event).subscribe(() => {});\n    this.eventChangeTreatment.emit({alertIds: this.infos.alarmIds, treatmentStarted: $event});\n  }\n  \n  ngAfterViewInit(){\n    this.customerParents.onShown.subscribe(() => {\n      this.isCustomerParentsModalRendering = false;\n    });\n  }\n\n  public loadCustomerParents(){\n    this.isCustomerParentsModalRendering = true;\n    if (!this.loadedCustomerParents) {\n      this.loadedCustomerParents = true;\n      let custIds: number[] = [this.customerChildId];\n      this.customerService.getCustomerParentsByIds({custIds: custIds}).subscribe(result => {\n        this