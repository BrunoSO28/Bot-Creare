eturn date <= end && date >= start\n            })\n\n            trip.infractions.forEach(infraction => {\n                trip.tripEvents.push({ type: TripEventsType.INFRACTION, datetime: new Date(infraction.deviceDatetime).getTime(), data: infraction },)\n            })\n        }\n    }\n\n    enrichTripAlarms(trip: any, alarms: any, start: Date, end: Date) {\n        if(alarms){\n            trip.alarms = alarms.filter(a => {\n                const date = new Date(a.datetime); \n                if(a.driver_firstname) {\n                    trip.driverName = a.driver_firstname\n                }\n                return date <= end && date >= start\n            })\n\n            trip.alarms.forEach(alarms => {\n                trip.tripEvents.push({ type: TripEventsType.ALARM, datetime: new Date(alarms.datetime).getTime(), data: alarms },)\n            })\n        }\n    }\n\n    enrichTripDuration(trip: any, start: Date, end: Date) {\n\n        var a = moment(end);\n        var b = moment(start);\n\n        var duration = moment.duration(a.diff(b));\n        let durationHours = parseInt(duration.asHours().toString());\n        let durationMinutes = parseInt((duration.asMinutes()%60).toString());\n        let durationSeconds = parseInt(duration.asSeconds().toString());\n\n        const labelDuration = [];\n\n        if(durationHours != 0) {\n            if(durationHours == 1){\n                labelDuration.push(`${durationHours} ${this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.hour')}`);\n            }else{\n                labelDuration.push(`${durationHours} ${this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.hours')}`);\n            }               \n        }\n\n        if(durationMinutes != 0) {\n            if(durationMinutes == 1) {\n                labelDuration.push(`${durationMinutes} ${this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.minute')}`);\n            }else{\n                labelDuration.push(`${durationMinutes} ${this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.minutes')}`);\n            }\n        }\n\n        if(labelDuration.length == 0) {\n            if(durationSeconds == 1) {                \n                labelDuration.push(`${durationSeconds} ${this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.second')}`);\n            }else{\n                labelDuration.push(`${durationSeconds} ${this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.seconds')}`);\n            }            \n        }\n        trip['duration'] = labelDuration.join(` ${this.translateJsonService.getTranslateSubs('GLOBAL.and')} `);\n        \n    }\n    \n    exportTrip(): void {\n        this.tripReport = this.tripReport.map(trip => {\n            const dateTime = new Date(trip.time * 1000);\n            return {\n              ...trip,\n              company: this.selectedAsset.telemetry.customer_name,\n              vehiclePlate: this.selectedAsset.name,\n              vehiclePrefix: this.selectedAsset.identification,\n              branch: this.selectedAsset.customerChildName,\n              driverName: this.selectedTrip.driverName,\n              date: dateTime.toLocaleDateString('pt-BR'),\n              time: dateTime.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }),\n            };\n          });\n\n\n        const customerProfileHeader = this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.company');\n        const customerChildHeader = this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.customer_child'); \n        const vehiclePlateHeader = this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.plate');\n        const vehiclePrefixHeader = this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.prefix');\n        const driverHeader = this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.driver');\n        const dateHeader = this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.date');\n        const timeHeader = this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.hour');\n        const speedHeader = this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.vehicle_speed');\n        const latitudeHeader = this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.latitude');\n        const longitudeHeader = this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.longitude');\n\n        this.exportReport = this.tripReport.map(trip => {\n            return {\n                [customerProfileHeader]: trip.company,\n                [customerChildHeader]: trip.branch,\n                [vehiclePlateHeader]: trip.vehiclePlate,\n                [vehiclePrefixHeader]: trip.vehiclePrefix,\n                [driverHeader]: trip.driverName,\n                [dateHeader]: trip.date,\n                [timeHeader]: trip.time,\n                [speedHeader]: trip.speed,\n                [latitudeHeader]: trip.lat,\n                [longitudeHeader]: trip.lng,\n            }\n        })\n        this.exportFilesService.exportToXLSX(this.exportReport, 'trip-report');\n    }\n\n    public convertAlarmsMarker(alarmList : Alarm[]) : ModelMarkers[] {\n\n        let modelMakerList: ModelMarkers[] = [];\n\n        alarmList.forEach((alarm : any) => {\n\n            let mrkr: ModelMarkers = new ModelMarkers;\n            mrkr.id = alarm.id;\n            mrkr.name = alarm.driver_firstname;\n            mrkr.category = alarm.typeAlarm;\n            mrkr.enabled = true;\n            mrkr.latitude = alarm.latitude;\n            mrkr.longitude = alarm.longitude;\n\n            modelMakerList.push(mrkr);\n        })\n\n        return modelMakerList;\n    }\n\n    public convertInfractionsMarker(infractions : Infraction[]) : ModelMarkers[] {\n\n        let modelMakerList: ModelMarkers[] = [];\n\n        infractions.forEach((infraction : any) => {\n\n            let mrkr: ModelMarkers = new ModelMarkers;\n            mrkr.id = infraction.id;\n            mrkr.name = 