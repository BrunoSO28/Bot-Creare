pp/@core/data/template.service\";\nimport { TranslateJsonService } from \"app/@core/data/translate-json.service\";\nimport { EmailMessage } from \"app/@core/interfaces/EmailMessage\";\nimport { Alarm } from \"app/@core/models\";\nimport { TemplateExportable } from \"app/@core/models/templateExportable.entity\";\nimport { TreatmentBuild } from \"app/@core/models/treatment.entity\";\nimport { NotificationUtilService } from \"app/@core/utils/notification.util.service\";\nimport { TreatmentFlowState } from \"app/@theme/components/treatment-flow/treatment-flow.state\";\nimport { ModalDirective } from \"ngx-bootstrap/modal\";\nimport { environment } from 'environments/environment';\nimport { AlarmService } from \"app/@core/data/alarm.service\";\nimport { CustomerContactService } from \"app/@core/data/customer-contact.service\";\nimport { DriverService } from \"app/@core/data/driver.service\";\nimport { TranslateService } from \"@ngx-translate/core\";\n\n\n@Component({\n  selector: 'focus-treatment-template',\n  styleUrls: ['./treatment-template.component.scss'],\n  templateUrl: './treatment-template.component.html',\n})\nexport class TreatmentTemplateComponent {\n  @Input('alarmlist') alarmList: Alarm[];\n  @Input('treatment') treatment: TreatmentBuild;\n  @Input('map') mapRef;\n  @Input('driverSignature') imgSignature: string;\n  @Input('signatureInfo') signatureInfo: string;\n  @Input('sourceChartLastVelocitiesAndAlarms') sourceChartLastVelocitiesAndAlarms: string;\n  @Input('sendByEmail') sendByEmail: boolean = false;\n  @Input('isPrintAlarmNotification') isPrintAlarmNotification: boolean = false;\n  @Input('auditId') auditId: number;\n\n  @Output('close') close: EventEmitter<any> = new EventEmitter<any>();\n\n  @ViewChild('modalSendPdfByEmail') modalSendPdfByEmail: ModalDirective;\n\n  public inputEmail = '';\n  public emailAddressList = [];\n  public isLoading: boolean = false\n  public selectedLanguage: string = '';\n  public languageOptions: Array<{ value: string, label: string }> = [];\n  public availableTemplates: TemplateExportable[] = [];\n  public userLang: string = localStorage.getItem(\"lang\") || \"ptbr\";\n\n  body;\n  variablesDynamic;\n  buildingPdf: boolean = false;\n\n  constructor(\n    public treatmentFlowState: TreatmentFlowState,\n    public translateJsonService: TranslateJsonService,\n    private templateService: TemplateService,\n    private notificationService: NotificationUtilService,\n    private alarmService: AlarmService,\n    private driverService: DriverService,\n    private customerContactService: CustomerContactService,\n    private translateService: TranslateService\n  ) { }\n\n  ngOnInit() {\n    this.resetEmailList();\n  }\n\n  async ngOnChanges(changes: SimpleChanges) {\n    if (this.sendByEmail) {\n      await this.openModalSendAlarmNotificationByEmail();\n    } else if (this.isPrintAlarmNotification) {\n      await this.printAlarmNotification();\n    }\n  }\n\n  private async printAlarmNotification() {\n    const templateCustomerProfileId = this.getCustomerProfileForEmail();\n    const mappedLang = this.mapLanguageCode(this.userLang);\n    const langToUse = mappedLang === 'pt_br' ? 'ptbr' : mappedLang;\n    \n    const [alarmNotificationTemplate, translations] = await Promise.all([\n      this.getTemplateByCustomerProfile(templateCustomerProfileId, this.userLang),\n      this.translateService.getTranslation(langToUse).toPromise()\n    ]);\n    \n    const alarmNotificationTags = this.getAlarmNotificationTags(this.alarmList, this.auditId, this.treatment, translations);\n    const htmlAlarmNotification = this.parserVariablesInTemplate(alarmNotificationTemplate, alarmNotificationTags);\n\n    const win = window.open('', '', 'height=1150,width=900');\n    win.document.write(htmlAlarmNotification);\n    win.document.close();\n    setTimeout(() => {\n      win.print();\n    }, 1000);\n  }\n\n  getEmailListByAssetId() {\n    let vehicleId = this.alarmList[0].vehicleId\n    let emailList: string[] = [];\n    this.customerContactService.getCustomerContactsByAssetId(vehicleId)\n      .subscribe((contacts) => {\n        emailList = contacts\n        .reduce((acc, c) => {\n          if (c.customerContacts) {\n            acc.push(...c.customerContacts.filter((contact) => contact && contact.email).map((contact) => contact.email));\n          }\n          return acc;\n        }, []);\n        if (emailList.length > 0) {\n          emailList.forEach((email) => {\n            this.emailAddressList.push(email);\n          });\n        }\n      });\n  }\n\n\n  async getTemplateByCustomerProfile(customerProfile: number, language?: string): Promise<TemplateExportable> {\n    const templates = await this.templateService.getByCustomerProfileId(customerProfile);\n    return this.findTemplateByLanguage(templates, language);\n  }\n\n  async getEmailTemplateByCustomerProfile(customerProfile: number, language?: string): Promise<TemplateExportable> {\n    const templates = await this.templateService.getEmailTemplateByCustomerProfileId(customerProfile);\n    return this.findTemplateByLanguage(templates, language);\n  }\n\n  private findTemplateByLanguage(templates: TemplateExportable, language?: string): TemplateExportable {\n    if (!Array.isArray(templates)) {\n      return templates;\n    }\n\n    if (!language) {\n      return templates[0];\n    }\n\n    const mappedLang = this.mapLanguageCode(language);\n    const templateByLang = templates.find(template => \n      this.mapLanguageCode(template.language.toLowerCase()) === mappedLang\n    );\n    \n    return templateByLang || templates[0];\n  }\n  \n  private mapLanguageCode(lang: string): string {\n    const languageMap: { [key: string]: string } = {\n      \"ptbr\": \"pt_br\",\n      \"pt_br\": \"pt_br\",\n      \"en\": \"en\",\n      \"es\": \"es\"\n    };\n    return languageMap[lang.toLowerCase()] || \"pt_br\";\n  }\n\n  private getLanguageLabel(langCode: string): string {\n    const mappedCode = this.mapLanguageCode(langCode);\n    const labelMap: { [key: string]: string } = {\n      \"pt\": \"PT-BR\",\n      \"en\": \"EN\",\n      \"es\": \"ES\"\n    };\n    return labelMap[mappedCode] || langCode.toUpperCase();\n  }\n\n  private async loadAvailableLanguages(customerProfile: number) {\n    try {\n      const templates = await this.templateService.getEmailTemplateByCustomerProfileId(customerProfile);\n      \n      if (!Array.isArray(templates)) {\n        this.setDefaultLanguageOption(this.userLang);\n        return;\n      }\n\n      this.availableTemplates = templates;\n      this.languageOptions = this.extractLanguageOptions(templates);\n      this.selectedLanguage = this.selectDefaultLanguage();\n        \n    } catch (error) {\n      this.setDefaultLanguageOption(this.userLang);\n    }\n  }\n\n  private extractLanguageOptions(templates: TemplateExportable[]): Array<{ value: string, label: string }> {\n    const uniqueLanguages = new Set<string>();\n    \n    templates.forEach(template => {\n      const mappedLang = this.mapLanguageCode(template.language.toLowerCase());\n      uniqueLanguages.add(mappedLang);\n    });\n    \n    return Array.from(uniqueLanguages)\n      .map(lang => ({\n        value: lang === 'pt' ? 'ptbr' : lang,\n        label: this.getLanguageLabel(lang)\n      }))\n      .sort((a, b) => a.label.localeCompare(b.label));\n  }\n\n  private selectDefaultLanguage(): string {\n    const mappedUserLang = this.mapLanguageCode(this.userLang);\n    const userLangOption = this.languageOptions.find(opt => \n      this.mapLanguageCode(opt.value) === mappedUserLang\n    );\n    \n    return userLangOption.value || this.languageOptions[0].value || this.userLang;\n  }\n\n  private setDefaultLanguageOption(lang: string) {\n    this.languageOptions = [{ value: lang, label: this.getLanguageLabel(lang) }];\n    this.selectedLanguage = lang;\n  }\n\n  parserVariablesInTemplate(template: TemplateExportable, replaceTags: Record<string, string | number>) {\n    let body = template.body\n\n    template.templateVariables.forEach((variable) => {\n      if (variable.show) {\n        let tagValueToReplace = replaceTags[variable.canonicalTag]\n        if (tagValueToReplace) {\n          variable.value = String(tagValueToReplace)\n        } \n        let regex = new RegExp(`\\\\$\\\\[${variable.canonicalTag}\\\\]`, 'g');\n        body = body.replace(regex, variable.value);\n      } else {\n        let pattern = new RegExp(\"<div id=\\\"\" + variable.canonicalTag + \"\\\".*?</div>\", 'gmis');\n        body = body.replace(pattern, '');\n      }\n    })\n\n    return body;\n  }\n\n  public async openModalSendAlarmNotificationByEmail() {\n    this.getEmailListByAssetId();\n    await this.loadAvailableLanguages(this.getCustomerProfileForEmail());\n    \n    this.modalSendPdfByEmail.show();\n  }\n\n  private getCustomerProfileForEmail(): number {\n      return this.alarmList[0].customer_profile_id\n  }\n\n  addEmailToList() {\n    const regexPattern = /^(([^<>()[\\]\\\\.,;:\\s@\"]+(\\.[^<>()[\\]\\\\.,;:\\s@\"]+)*)|(\".+\"))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\])|(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,}))$/;\n    const emailList = this.inputEmail.split(';').map(e => e.trim().toString());\n\n    emailList.forEach(email => {\n      const isValidEmailAddress = regexPattern.test(email);\n      if (isValidEmailAddress && !this.emailAddressList.includes(email)) {\n        this.emailAddressList.push(email)\n      }\n      this.inputEmail = '';\n    })\n  }\n\n  removeEmailFromList(item) {\n    this.emailAddressList.splice(this.emailAddressList.indexOf(item), 1);\n  }\n\n  cancel() {\n    this.inputEmail = '';\n    this.resetEmailList();\n  }\n\n  resetEmailList() {\n    this.emailAddressList = [];\n  }\n\n  clearEmailList() {\n    this.emailAddressList = [];\n  }\n\n  public async sendPdfByEmail() {\n    this.isLoading = true;\n    \n    try {\n      const alarmData = this.alarmList[0];\n      const customerProfile = this.getCustomerProfileForEmail();\n      \n      const mappedLang = this.mapLanguageCode(this.selectedLanguage);\n      const langToUse = mappedLang === 'pt_br' ? 'ptbr' : mappedLang;\n      \n      const [htmlEmailTemplate, alarmNotificationTemplate, driverRegistration, emailTranslations] = await Promise.all([\n        this.getEmailTemplateByCustomerProfile(customerProfile, this.selectedLanguage),\n        this.getTemplateByCustomerProfile(customerProfile, this.selectedLanguage),\n        this.getDriverRegistration(alarmData.driverId),\n        this.translateService.getTranslation(langToUse).toPromise()\n      ]);\n      \n      const emailBody = this.buildEmailBody(\n        htmlEmailTemplate,\n        alarmNotificationTemplate,\n        alarmData,\n        driverRegistration,\n        emailTranslations\n      );\n      \n      await this.templateService.sendAlarmAuditNotificationByEmail(emailBody, this.auditId);\n      this.handleEmailSuccess();\n      \n    } catch (error) {\n      this.handleEmailError();\n    }\n  }\n\n  private async getDriverRegistration(driverId: number): Promise<string> {\n    if (!driverId) return '';\n    \n    try {\n      const driver = await this.driverService.findById(driverId).toPromise();\n      return driver.registration;\n    } catch (error) {\n      return '';\n    }\n  }\n\n  private buildEmailTemplateTags(alarmData: Alarm, driverRegistration: string, translations: any) {\n    return {\n      \"ALARM_TYPE\": this.getTranslationFromObject(translations, alarmData.typeAlarmDescription),\n      \"VEHICLE_PLATE\": alarmData.vehicle_plates,\n      \"DRIVER_NAME\": this.getTranslatedDriverNameFromObject(alarmData.driver_firstname, translations),\n      \"DRIVER_REGISTRATION\": driverRegistration || this.getTranslationFromObject(translations, 'TEMPLATE.register_not_found'),\n      \"ALARM_DATE\": this.translateJsonService.transformDataFormat(alarmData.datetime),\n      \"TREAT_DESCRIPTION\": this.getTranslatedTreatmentNameFromObject(alarmData.auditTreatmentName, translations) || this.getTranslatedTreatmentNameFromObject(this.treatment.treatmentName, translations),\n      \"AUDIT_ID\": this.auditId,\n      \"TREAT_OBS\": this.validateTreatObservationFromObject(this.treatment.treatmentObs, translations),\n      \"BASE_URL\": environment.baseUrl\n    };\n  }\n\n  private buildEmailSubject(alarmData: Alarm, translations: any): string {\n    const riskRating = this.getTranslatedRiskRatingFromObject(alarmData.groupRisk, translations);\n    const alarmOf = this.getTranslationFromObject(translations, 'TREATMENT-FLOW.alarm_of');\n    const alarmType = this.getTranslationFromObject(translations, alarmData.typeAlarmDescription);\n    \n    return `${alarmData.customer_child_name} - ${alarmOf} ${riskRating} (${alarmType}) - ${alarmData.vehicle_plates}`;\n  }\n\n  private buildEmailBody(\n    htmlEmailTemplate: TemplateExportable,\n    alarmNotificationTemplate: TemplateExportable,\n    alarmData: Alarm,\n    driverRegistration: string,\n    translations: any\n  ): EmailMessage {\n    const emailTemplateTags = this.buildEmailTemplateTags(alarmData, driverRegistration, translations);\n    const alarmNotificationTags = this.getAlarmNotificationTags(this.alarmList, this.auditId, this.treatment, translations);\n    \n    const parsedEmailTemplate = this.parserVariablesInTemplate(htmlEmailTemplate, emailTemplateTags);\n    const htmlAlarmNotification = this.parserVariablesInTemplate(alarmNotificationTemplate, alarmNotificationTags);\n    \n    return {\n      to: this.emailAddressList,\n      subject: this.buildEmailSubject(alarmData, translations),\n      html: parsedEmailTemplate,\n      attachments: [{\n        fileName: this.getTranslationFromObject(translations, 'TREATMENT-FLOW.attachment_file_name'),\n        extension: 'pdf',\n        content: htmlAlarmNotification\n      }]\n    };\n  }\n\n  private handleEmailSuccess(): void {\n    this.notificationService.printSuccessMessage(\n      this.translateJsonService.getTranslateSubs('TREATMENT-FLOW.sent_success')\n    );\n    this.cancel();\n    this.isLoading = false;\n    this.modalSendPdfByEmail.hide();\n    this.alarmService.emailsLogs.next(true);\n  }\n\n  private handleEmailError(): void {\n    this.notificationService.printErrorMessage(\n      this.translateJsonService.getTranslateSubs('TREATMENT-FLOW.email_sent_not_success')\n    );\n    this.isLoading = false;\n  }\n\n  public getImageAlarmList(alarmList: Alarm[]) {\n      const itensPerRow = 5;\n      const htmlAlarmsList = alarmList.map((alarm, index) => {\n\n        const itemPosition = index + 1\n\n        let htmlItem: string = '';\n\n        if (itemPosition == 1) {\n          htmlItem = '<tr>'\n        }\n\n        const compressedImage = this.compress(alarm.picture, 80, 300);\n\n        htmlItem += `<td style=\"max-width:178px;max-height:145.63px;width:20%;align-items:center;font-size:11px;background-color:#797777;color:#FFF;text-align:center; margin: 2px;max-width:178px\"><img src=\"${compressedImage}\" style=\"max-height:100%; max-width:98%\" /> ${alarm.id} </td>`\n\n        const leftValue = itemPosition % itensPerRow;\n\n        if (alarmList.length == itemPosition) {\n\n          if (leftValue != 0) {\n            htmlItem += '<td style=\"max-width:178px;max-height:145.63px;width:20%;align-items:center;font-size:11px;7;color:#FFF;text-align:center; margin: 2px;max-width:178px\"></td>'.repeat(itensPerRow - leftValue);\n          }\n\n          htmlItem += '</tr>'\n\n        } else if (leftValue == 0) {\n          htmlItem += '</tr><tr>'\n        }\n\n        return htmlItem;\n      });\n      return `<table cellspacing=\"1\" cellpadding=\"1\" style=\"width:100%\"> ${htmlAlarmsList.join(' ')} </table>`;\n  }\n\n  compress(imageDataUrl: string, quality: number, maxWidth: number = 300): string {\n    const imgAsSource = new Image();\n    imgAsSource.src = imageDataUrl;\n\n    const mimeType = \"image/jpeg\";\n\n    const cvs = document.createElement('canvas');\n\n    const ratio = imgAsSource.naturalHeight / imgAsSource.naturalWidth;\n    cvs.width = imgAsSource.naturalWidth > maxWidth ? maxWidth : imgAsSource.naturalWidth;;\n    cvs.height = imgAsSource.naturalHeight > maxWidth ? ratio * maxWidth : imgAsSource.naturalHeight;\n\n    cvs.getContext(\"2d\").drawImage(imgAsSource, 0, 0, cvs.width, cvs.height);\n\n    const newImageData = cvs.toDataURL(mimeType, quality / 100);\n\n    return newImageData;\n  }\n\n  public getTranslatedRiskRating(riskCode: number) {\n    let translatedRiskRating: string;\n    switch (riskCode) {\n      case 0:\n        translatedRiskRating = this.translateJsonService.getTranslateSubs('RISK-RATING.low_risk')\n        break;\n      case 1:\n        translatedRiskRating = this.translateJsonService.getTranslateSubs('RISK-RATING.medium_risk')\n        break;\n      case 2:\n        translatedRiskRating = this.translateJsonService.getTranslateSubs('RISK-RATING.high_risk')\n        break;\n      default:\n        throw Error(`Risk rating code ${riskCode} is not a valid code`)\n    }\n    return translatedRiskRating;\n  }\n\n  public getAlarmNotificationTags(alarmList: Alarm[], auditId: number, treatment: TreatmentBuild, translations?: any) {\n\n    let alarmData = alarmList[0];\n    let auditIdTagValue = auditId ? this.auditId.toString() : 'Ainda não auditado'\n    let speedTagValue = alarmData.speed != 0 ? this.translateJsonService.transformNumberToString(alarmData.speed, 2) : this.getTranslationFromObject(translations, 'GLOBAL.not_applicable')\n    let covidMaskValue = ''\n    let noSeatbeltValue = ''\n    let observation = treatment.treatmentObs || ''\n\n    if (observation.includes(\"#[MOTORISTA COM MÁSCARA]\")) {\n      covidMaskValue = \"MOTORISTA COM MÁSCARA\";\n    }\n    if (observation.includes(\"#[MOTORISTA SEM MÁSCARA]\")) {\n      covidMaskValue = \"MOTORISTA SEM MÁSCARA\";\n    }\n\n    if (observation.includes(\"#[MOTORISTA COM CINTO]\")) {\n      noSeatbeltValue = this.getTranslationFromObject(translations, 'GLOBAL.no');\n    }\n    if (observation.includes(\"#[MOTORISTA SEM CINTO]\")) {\n      noSeatbeltValue = this.getTranslationFromObject(translations, 'GLOBAL.yes');\n    }\n\n    if (observation) {\n      observation = observation\n        .replace('#[MOTORISTA COM MÁSCARA]', '')\n        .replace('#[MOTORISTA SEM MÁSCARA]', '')\n        .replace('#[MOTORISTA COM CINTO]', '')\n        .replace('#[MOTORISTA SEM CINTO]', '')\n    }\n\n    if (!observation) {\n      observation = this.getTranslationFromObject(translations, 'TREATMENT-MODAL.empty_observation')\n    }\n\n    let translatedAlarmType = alarmData.typeAlarmDescription;\n    if (alarmData.typeAlarm) {\n      const alarmTypeKey = this.translateJsonService.getAlarmTypesTranslate(alarmData.typeAlarm);\n      translatedAlarmType = this.getTranslationFromObject(translations, alarmTypeKey);\n    }\n\n    return {\n      'DRIVER_NAME': this.getTranslatedDriverName(translations, alarmData.driver_firstname),\n      'ALARM_TYPE': translatedAlarmType,\n      'ALARM_DATE': this.translateJsonService.transformDataFormat(alarmData.datetime),\n      'AUDIT_ID': auditIdTagValue,\n      'INSERT_ALARM_DATE': this.translateJsonService.transformDataFormat(alarmData.availableMediaAt),\n      'VEHICLE_PLATE': alarmData.vehicle_plates,\n      'VEHICLE_PREFIX': alarmData.vehicle_prefix,\n      'TREAT_AUTHOR': treatment.treatmentByUser,\n      'TREAT_DESCRIPTION': treatment.treatmentName === this.translateJsonService.getTranslateSubs(\"TREATMENT-FLOW.valid_alarm\") ? this.getTranslationFromObject(translations, 'TREATMENT-FLOW.valid_alarm') : treatment.treatmentName,\n      'TREAT_OBS': observation,\n      'TREAT_DATE': treatment.treatmentDate,\n      'ALERT_LIST': this.getImageAlarmList(alarmList),\n      'MAPA': `<img src=\"${this.mapRef}\" width=\"100%\" />`,\n      'CHART_LAST_VELOCITIES_AND_ALARMS': `<img src=\"${this.sourceChartLastVelocitiesAndAlarms}\" width=\"100%\" />`,\n      'SPEED': speedTagValue,\n      'COVID_MASK': covidMaskValue,\n      'NO_SEATBELT': noSeatbeltValue,\n      'DRIVER_SIGNATURE': \n      `<div>`\n          + (this.imgSignature ? `<div style=\"text-align:center; margin-top:1.80rem; margin-bottom:1.80rem; position:relative;\">\n          <img src=${this.imgSignature} width=\"100%\" style=\"border-style:solid; border-width:thin;\"/>\n          <p style=\"font-size:0.75rem; margin:0; padding-top:0.625rem;\">${this.signatureInfo}</p>\n          </div> ` : ``) +\n      `</div>`,\n    }\n  }\n\n  private validateTreatObservation(observation) {\n    return observation ?\n      observation\n        .replace('#[MOTORISTA COM MÁSCARA]', '')\n        .replace('#[MOTORISTA SEM MÁSCARA]', '')\n        .replace('#[MOTORISTA COM CINTO]', '')\n        .replace('#[MOTORISTA SEM CINTO]', '') :\n      this.translateJsonService.getTranslateSubs('TREATMENT-MODAL.empty_observation')\n  }\n\n  private getTranslatedDriverName(translations: any, driverFirstname: string): string {\n    const driverNotIdentifiedValues = [\n      'Motorista não identificado',\n      'Driver Not Identified', \n      'Conductor no Identificado'\n    ];\n    \n    if (!driverFirstname || driverNotIdentifiedValues.some(value => \n      value.toLowerCase() === driverFirstname.toLowerCase()\n    )) {\n      return this.getTranslationFromObject(translations, 'TREATMENT-FLOW.not_driver');\n    }\n    \n    return driverFirstname;\n  }\n\n  private getTranslationFromObject(translations: any, key: string): string {\n    if (!key || !translations) return '';\n    \n    const keys = key.split('.');\n    let result = translations;\n    \n    for (const k of keys) {\n      if (result && typeof result === 'object' && k in result) {\n        result = result[k];\n      } else {\n        return key;\n      }\n    }\n    \n    return typeof result === 'string' ? result : key;\n  }\n\n  private getTranslatedRiskRatingFromObject(riskCode: number, translations: any): string {\n    switch (riskCode) {\n      case 0:\n        return this.getTranslationFromObject(translations, 'RISK-RATING.low_risk');\n      case 1:\n        return this.getTranslationFromObject(translations, 'RISK-RATING.medium_risk');\n      case 2:\n        return this.getTranslationFromObject(translations, 'RISK-RATING.high_risk');\n      default:\n        throw Error(`Risk rating code ${riskCode} is not a valid code`);\n    }\n  }\n\n  private getTranslatedDriverNameFromObject(driverFirstname: string, translations: any): string {\n    const driverNotIdentifiedValues = [\n      'Motorista não identificado',\n      'Driver Not Identified', \n      'Conductor no Identificado'\n    ];\n    \n    if (!driverFirstname || driverNotIdentifiedValues.some(value => \n      value.toLowerCase() === driverFirstname.toLowerCase()\n    )) {\n      return this.getTranslationFromObject(translations, 'TREATMENT-FLOW.not_driver');\n    }\n    \n    return driverFirstname;\n  }\n\n  private getTranslatedTreatmentNameFromObject(treatmentName: string, translations: any): string {\n    if (!treatmentName) return '';\n    \n    const treatmentTranslations: { [key: string]: string } = {\n      'Alerta invalidado': 'TREATMENT-FLOW.invalidated_alert',\n      'Invalidated Alert': 'TREATMENT-FLOW.invalidated_alert',\n      'Alerta Invalidada': 'TREATMENT-FLOW.invalidated_alert',\n      'Alarme Válido': 'TREATMENT-FLOW.valid_alarm',\n      'Alerta validado': 'TREATMENT-FLOW.valid_alarm',\n      'Alerta Válida': 'TREATMENT-FLOW.valid_alarm'\n    };\n\n    const translationKey = treatmentTranslations[treatmentName];\n    if (translationKey) {\n      return this.getTranslationFromObject(translations, translationKey);\n    }\n    \n    return treatmentName;\n  }\n\n  private validateTreatObservationFromObject(observation: string, translations: any): string {\n    observation = observation ? \n      observation\n        .replace('#[MOTORISTA COM MÁSCARA]', '')\n        .replace('#[MOTORISTA SEM MÁSCARA]', '')\n        .replace('#[MOTORISTA COM CINTO]', '')\n        .replace('#[MOTORISTA SEM CINTO]', '').trim() :\n      this.getTranslationFromObject(translations, 'TREATMENT-MODAL.empty_observation');\n\n    const observationTranslations: { [key: string]: string } = {\n      'Validação de Alerta': 'TREATMENT-FLOW.alert_validation',\n      'Alert Validation': 'TREATMENT-FLOW.alert_validation',\n      'Validación de Alerta': 'TREATMENT-FLOW.alert_validation'\n    };\n\n    const translationKey = observationTranslations[observation];\n    if (translationKey) {\n      return this.getTranslationFromObject(translations, translationKey);\n    }\n\n    if (!observation || observation.trim() === '') {\n      return this.getTranslationFromObject(translations, 'TREATMENT-MODAL.empty_observation');\n    }\n    \n    return observation;\n  }\n}","module.exports = \"<div class=\\\"row\\\">\\n    <div class=\\\"col-md-6 pl-1\\\">\\n        <div class=\\\"deleteAllBtn\\\" *ngIf=\\\"checkAlarms.length > 0\\\" (click)=\\\"validationAlarm(false,false)\\\">\\n            <i class=\\\"fa fa-trash-o\\\"></i> {{ 'TREATMENT-MODAL.remove_alert' | translate }}\\n        </div>\\n\\n        <p-scrollPanel [style]=\\\"{width: '100%', height: '470px'}\\\">\\n            <ul class=\\\"alarmsContent\\\" style=\\\"background-color: #414141; padding: 3px\\\">\\n                <li class=\\\"alarmBox\\\" *ngFor=\\\"let related of relatedsCams\\\">\\n                    <p-checkbox value=\\\"{{related.id}}\\\" [(ngModel)]=\\\"checkAlarms\\\" styleClass=\\\"alarm-checkbox\\\" (click)=\\\"mapaLoadedRefresh();\\\"></p-checkbox>\\n                    <img [ngClass]=\\\"{'camSelected':related.id === selectedAlarmId}\\\" (click)=\\\"selectRelatedCamera(related)\\\"\\n                        *ngIf=\\\"related.picture\\\" [src]=\\\"related.picture\\\" width=\\\"100%\\\" height=\\\"auto\\\"\\n                        title=\\\"{{ 'GLOBAL.alert_1 | translate'}}: {{related.id}}\\\"/>\\n\\n                        <span *ngIf=\\\"!related.picture\\\" style=\\\"float:left; width: 100%; height: 80px; text-align: center; padding-top: 15px; color: rgb(109, 109, 109);\\\">\\n                            <div class=\\\"spinner\\\"></div>\\n                        </span>\\n                    <i (click)=\\\"op.toggle($event);previewCamPicture=related.picture\\\" class=\\\"fa fa-search icon-absolute icon-zoom-absolute\\\"\\n                        aria-hidden=\\\"true\\\" title=\\\"{{ 'TREATMENT-MODAL.zoom_image' | translate }}\\\"></i>\\n                    <i (click)=\\\"viewMovie.toggle($event);previewCamMovie=related.movie;reloadMovie()\\\" *ngIf=\\\"related.movie\\\" class=\\\"fa fa-play-circle icon-absolute icon-movie-absolute\\\"\\n                        aria-hidden=\\\"true\\\" title=\\\"{{ 'TREATMENT-MODAL.play_movie' | translate }}\\\"></i>\\n                    <div *ngIf=\\\"related.validation\\\" class=\\\"alarm-validation\\\" title=\\\"{{ 'TREATMENT-MODAL.valid_validated_alert' | translate }}\\\"></div>\\n                </li>\\n            </ul>\\n        </p-scrollPanel>\\n\\n        <p-overlayPanel #op [showCloseIcon]=\\\"true\\\">\\n            <img [src]=\\\"previewCamPicture\\\" *ngIf=\\\"previewCamPicture\\\" width=\\\"auto\\\" height=\\\"400\\\" />\\n        </p-overlayPanel>\\n\\n        <p-overlayPanel #viewMovie [showCloseIcon]=\\\"true\\\">\\n            <video controls autoplay #moviePlayer>\\n                <source type=\\\"video/mp4\\\" *ngIf=\\\"previewCamMovie\\\" [src]=\\\"previewCamMovie\\\">\\n            </video>\\n        </p-overlayPanel>\\n\\n        <div style=\\\"min-height: 250px; width: 100%; display: block;\\\">\\n            <div id=\\\"alarmMap\\\" class=\\\"alarms-map\\\" *ngIf=\\\"mapaLoaded\\\">\\n                <leaflet-map #alarmMap [generatePDF]=\\\"false\\\" [clusted]=false [mapMarkers]=\\\"allMarkers\\\" [mapOptions]=\\\"options\\\" [mapCenter]=\\\"center\\\" [mapZoom]=\\\"zoom\\\" [loadingMap]=\\\"loadingMap\\\">\\n                </leaflet-map>\\n            </div>\\n        </di