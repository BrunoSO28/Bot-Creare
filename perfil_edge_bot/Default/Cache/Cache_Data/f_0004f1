s.translateJsonService.getTranslateSubs(\"TELEMETRY-PAGE.unidentified\")}\n                <br/>\n                ${this.translateJsonService.getTranslateSubs(\n                        \"TELEMETRY-PAGE.date\"\n                    )}: ${moment(event.datetime).format(\"DD/MM/YYYY HH:mm:ss\")} <br/>\n            </div>`;\n\n            markers.push(mrkr);\n        });\n\n        return markers;\n    }\n\n    public convertTagMarker(tags: Tag[]): ModelMarkers[] {\n\n        let markers = [];\n\n        tags.forEach((tag) => {\n\n            if(tag.tag_type_id == TagType.PASSENGER) {\n                    \n                markers.push(this.createPassengerMarker(tag, 3001));\n                    \n                if (tag.device_datetime_end) {\n                    markers.push(this.createPassengerMarker(tag, 3002));\n                }\n            }\n        });\n\n        return markers;\n    }\n\n    public createPassengerMarker(tag: Tag, category: number): ModelMarkers {\n\n        let mrkr: ModelMarkers = new ModelMarkers();\n        mrkr.id = Date.parse(tag.device_datetime);\n        mrkr.name = tag.tag_name\n        mrkr.category = category;\n        mrkr.type = 2;\n        mrkr.enabled = true;\n        mrkr.latitude = category == 3002 ? tag.latitude_end : tag.latitude;\n        mrkr.longitude = category == 3002 ? tag.longitude_end : tag.longitude;\n        mrkr.datetime = moment(tag.device_datetime).format(\"DD/MM/YYYY HH:mm:ss\");\n        mrkr.description = `<div style=\"width: 200px;\">\n        <b>${category == 3001 ?\n                this.translateJsonService.getTranslateSubs(\"TELEMETRY-PAGE.passenger_embark\") :\n                this.translateJsonService.getTranslateSubs(\"TELEMETRY-PAGE.passenger_disembark\")}\n            </b> \n        <br/>\n                ${this.translateJsonService.getTranslateSubs(\n                    \"TELEMETRY-PAGE.name\"\n                )}: ${tag.tag_name} <br/>\n                ${this.translateJsonService.getTranslateSubs(\n                    \"TELEMETRY-PAGE.company\"\n                )}:${tag.data.tag.additionalInfo.company}\n        <br/>\n                ${this.translateJsonService.getTranslateSubs(\n                    \"TELEMETRY-PAGE.registration\"\n                )}:${tag.data.tag.additionalInfo.registration}\n        <br/>\n                ${this.translateJsonService.getTranslateSubs(\n                    \"TELEMETRY-PAGE.date\"\n                )}: ${moment(tag.device_datetime).format(\"DD/MM/YYYY HH:mm:ss\")} <br/>\n            </div>`;\n\n        return mrkr;\n    }\n}","module.exports = \"<loading-animate></loading-animate>\\n\\n<div [ngClass]=\\\" \\n        menuDisplay \\n        ? 'container-telemetry padding-default container-opened' \\n        : 'container-telemetry padding-default container-closed'\\n    \\\"\\n>\\n    <!-- Loading -->\\n    <span class=\\\"loader\\\" *ngIf=\\\"loading\\\">\\n        {{\\\"TELEMETRY-PAGE.loading\\\" | translate}}\\n    </span>\\n\\n    <!-- container de indicadores de risco minimizada (mapa) -->\\n    <div class=\\\"indicators-min\\\" [hidden]=\\\"indicatorMinDisplayed\\\">\\n        <alarm-indicators \\n            style=\\\"width: 100%\\\"\\n            [minimized]=\\\"true\\\" \\n            [alerts]=\\\"allAlarmsAndInfractions\\\" \\n            (selectedGroup)=\\\"selectedGroup($event)\\\"\\n        >\\n        </alarm-indicators>\\n    </div> \\n\\n    <!-- Botão para maximizar menu tela de rastreamento -->\\n    <div class=\\\"menu-min\\\" [hidden]=\\\"menuDisplay\\\">\\n        <menu-telemetry \\n            [opened]=\\\"menuDisplay\\\" \\n            (openChange)=\\\"changeOpenOrClose($event)\\\" \\n            (selectId)=\\\"selectIdToMap($event)\\\"\\n        >\\n        </menu-telemetry>\\n    </div>\\n\\n    <!-- Menu tela de rastreamento -->\\n    <div class=\\\"menu-max\\\" [hidden]=\\\"!menuDisplay\\\">\\n        <menu-telemetry\\n            [alerts]=\\\"allAlarmsAndInfractions\\\"\\n            [vehicleListCounterStatus]=\\\"vehicleListCounterStatus\\\"   \\n            [opened]=\\\"menuDisplay\\\" \\n            (displayAssetTrack)=\\\"displayAssetTrack($event)\\\" \\n            (displayAssetEvent)=\\\"displayAssetEvent($event)\\\" \\n            (displayAssetPosition)=\\\"displayAssetPosition($event)\\\" \\n            (openChange)=\\\"changeOpenOrClose($event)\\\" \\n            (submitFilter)=\\\"submitFilter(true)\\\" \\n            (showAllEvents)=\\\"showAllEvents($event)\\\"\\n            (filterChange)=\\\"handleFilterChange($event)\\\"\\n            (selectId)=\\\"selectIdToMap($event)\\\"\\n        >\\n        </menu-telemetry>\\n    </div>\\n    \\n    <!-- Container Mapa e submenu de eventos -->\\n    <span style=\\\"width: 100%; position: relative;\\\">\\n\\n        <div class=\\\"ungroup-envelope\\\">\\n            <button class=\\\"ungroup-button\\\" (click)=\\\"ungroupVehicles()\\\" [disabled]=\\\"!allMarkers.length\\\">\\n                <div *ngIf=\\\"clusted; else notClusted\\\">\\n                    <i class=\\\"fa fa-object-ungroup\\\" aria-hidden=\\\"true\\\" title=\\\"{{ 'MAP.ungroup' | translate }}\\\"></i>\\n                </div>\\n                <ng-template #notClusted>\\n                    <i class=\\\"fa fa-object-group\\\" aria-hidden=\\\"true\\\" title=\\\"{{ 'MAP.group' | translate }}\\\"></i>\\n                </ng-template>\\n            </button>\\n        </div>\\n\\n        <!-- Mapa tela de rastreamento -->\\n        <leaflet-map \\n            [mapZoom]=\\\"zoom\\\" \\n            [mapCenter]=\\\"center\\\" \\n            [hideHeat]=\\\"hideHeat\\\" \\n            [clusted]=\\\"clusted\\\"\\n            [hideIcons]=\\\"false\\\"\\n            [mapMarkers]=\\\"allMarkers\\\" \\n            [loadingMap]=\\\"loadingMap\\\" \\n            [fitBounding]=\\\"fitBounding\\\" \\n            [tracking]=\\\"telemetryState.getTracking() | async\\\" \\n            [trackingPlay]=\\\"telemetryState.getTrackPlayed() | async\\\" \\n            [tr