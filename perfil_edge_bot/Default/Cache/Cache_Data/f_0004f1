data.service';\nimport * as moment from 'moment';\n\n@Component({\n  selector: 'treatment-step-three',\n  templateUrl: './step-three.component.html',\n  styleUrls: ['./step-three.component.scss']\n})\nexport class TreatmentStepThreeComponent implements OnInit {\n\n  public alarms$: Observable<Alarm[]> = new Observable<Alarm[]>();\n  public treatments$: Observable<TreatmentData[]> = new Observable<TreatmentData[]>();\n  public treatmentContacts$: Observable<TreatmentContact[]> = new Observable<TreatmentContact[]>();\n\n  public selectedPicture: string;\n  public selectedMovie: string;\n  public countSelectedAlarm = 0;\n\n  public selectedTreatment;\n  public errorVideoNotFound = false;\n\n  public audit: Audit;\n  public auditId: number;\n\n  public auditStatusEnum: AuditStatusEnum;\n  public selectedAlarms: Alarm[];\n  public selectedAlarmsCols: any;\n  public isFromDevicesWithoutMedia:boolean =false;\n  public devicesWithoutMedia:number[] = environment.equipmentsTypeIdWithoutMedia.split(',').map(a => Number(a));\n\n  public alertsSelectStep: any;\n  public alarmWithoutMediasColumns: { field: string; header: string; }[];\n  public aiAlarmValidations: AiAlarmValidation[] = [];\n\n  constructor(\n    public treatmentFlowState: TreatmentFlowState,\n    public treatmentFlowService: TreatmentFlowService,\n    public notificationUtilService: NotificationUtilService,\n    public driverService: DriverService,\n    public translateJsonService: TranslateJsonService,\n    private dialogService: DialogService,\n    private alarmService: AlarmService,\n    private dataService: DataService,\n  ) {\n    this.alarms$ = this.treatmentFlowState.getSelectedAlarms$();\n    this.treatments$ = this.treatmentFlowState.getTreatments$();\n    this.treatmentContacts$ = this.treatmentFlowState.getTreatmentContacts$()\n      .pipe(map(result => result.filter(res => res.phones.length )));\n      this.alarmWithoutMediasColumns = [\n        {field: 'speed', header: 'GLOBAL.speed'},\n        {field: 'datetime', header: 'GLOBAL.datetime'},\n        { field: 'driver_firstname', header: 'GLOBAL.driver'}\n      ];\n  }\n\n  ngOnInit() {\n    this.countSelectedAlarm = this.treatmentFlowState.countSelectedAlarm();\n    this.audit = new Audit();\n\n    const alarms = this.treatmentFlowState.getAlarms()\n\n    const firstAlarm = alarms[0];\n    this.isFromDevicesWithoutMedia = this.devicesWithoutMedia.includes(firstAlarm.equipmentTypeId);\n    this.treatmentFlowService.loadTreatmentContacts(firstAlarm.vehicleId, firstAlarm.customer_child_id);\n    this.selectedAlarms = alarms.filter(item => item.selected === true);\n    this.selectedAlarmsCols = [\n      {field: 'id', header: 'id'},\n      {field: 'datetime', header: 'datetime'},\n      {field: 'speed', header: 'speed'}\n    ];    \n    this.treatmentFlowState.getAiAlarmValidations$().subscribe(aiAlarmValidations => {this.aiAlarmValidations = aiAlarmValidations});\n  }\n\n  zoomAlarmImage(event, urlPictures, urlMovies, container, alarm, aiAlarmValidations = this.aiAlarmValidations) {\n    if (urlPictures[0] == 'NO_PICTURE') return;\n    this.dialogService.open(ZoomMediasComponent, { data: { urlPictures, urlMovies, alarm, aiAlarmValidations }})\n  }\n\n  revertUpdateDrivers() {\n    this.alertsSelectStep = this.treatmentFlowState.getSelectedAlarms();\n\n    for (let i = 0; i <= this.alertsSelectStep.length - 1; i++) {\n      if(this.alertsSelectStep[i].validationDriver == true){\n        this.alertsSelectStep[i].driverId = null;\n        this.alertsSelectStep[i].driver_firstname = null;\n        this.alertsSelectStep[i].validationDriver = false;\n      };\n    };\n  }\n\n  setUpdateDriver(){\n    this.alertsSelectStep = this.treatmentFlowState.getSelectedAlarms();\n\n    let nameDriver: string;\n    this.alertsSelectStep.find(name => nameDriver = name.driver_firstname);\n\n    let idDriver: number;\n    this.alertsSelectStep.find(id =>idDriver = id.driverId);\n\n    let hasFaceRecog: boolean = false;\n\n    let dataDriver: Driver = new Driver();\n\n    dataDriver.name = nameDriver; \n    dataDriver.id = idDriver;\n    dataDriver.hasFaceRecog = hasFaceRecog;\n\n    this.alertsSelectStep.forEach(alerts => {\n      if(alerts.validationDriver == true){\n        this.treatmentFlowState.updateDriver(dataDriver);\n      };\n    });\n  }\n\n  previousStep(){\n    this.revertUpdateDrivers();\n\n    const currentStep = this.treatmentFlowState.getStep();\n    this.treatmentFlowState.previousStep();\n\n  }\n  toStep(step: number){\n    this.revertUpdateDrivers();\n    const currentStep = this.treatmentFlowState.getStep();\n    this.treatmentFlowState.toStep(step);\n  }\n  finishAudit(finaliza: boolean) {\n    this.treatmentFlowState.setUpdating(true);\n    //this.auditDrivers();\n\n    this.setUpdateDriver();\n\n    this.audit.treatment = this.selectedTreatment.id;\n    this.audit.alarms = this.treatmentFlowState.getFinishedAlarms();\n    this.audit.auditStatus = (finaliza) ? AuditStatusEnum.FINALIZADO : AuditStatusEnum.PENDENTE;\n    this.audit.createDate = new Date();\n    this.audit.createDateLocal = moment().format('YYYY-MM-DDTHH:mm:ss.SSS');\n    this.audit.timeZoneTreatment = this.getTimezoneTreatment();\n    this.audit.driverFromFaceRecog = this.audit.alarms[0].driverHasFaceRecog;\n    this.audit.maskCOVID = this.treatmentFlowState.getMaskCOVID();\n    this.audit.noSeatbelt = this.treatmentFlowState.getNoSeatbelt();\n    this.audit.groupRisk = this.audit.alarms[0].groupRisk;\n    this.treatmentFlowService.createAudit(this.audit)\n      .then(savedAudit => {\n        const auditory = {\n          id: savedAudit.id,\n          comments: savedAudit.comments,\n          datetime: this.audit.alarms[0].datetime,\n          create_date: savedAudit.create_date,\n          ownserUsername: savedAudit.ownserUsername,\n          treatmentname: savedAudit.treatmentname,\n        };\n\n        this.treatmentFlowState.setAudit(auditory);\n        this.auditId = auditory.id;\n\n        return this.alarmService.getUpdatedAlarmsDataAfterCompletion([this.auditId]);\n      })\n      .then((alarmsWithRisksUpdated: Alarm[]) => {\n        const updatedAlarmsGrouped = {}\n\n        alarmsWithRisksUpdated.forEach(alarm => updatedAlarmsGrouped[alarm.id] = alarm)\n\n        const updatedAlarms = this.treatmentFlowState.getAlarms().map(alarm => {\n          const updatedAlarm = updatedAlarmsGrouped[alarm.id]\n          return {\n            ...alarm,\n            ...(updatedAlarm ? updatedAlarm : {}),\n            datetime: alarm.datetime,\n            auditAlarm: this.auditId,\n          }\n        });\n        \n        this.treatmentFlowState.setAlarms(updatedAlarms)\n        this.audit.groupRisk = updatedAlarms[0].groupRisk;\n\n        this.treatmentFlowState.setUpdating(false);\n        if (finaliza) {\n          this.treatmentFlowState.nextStep(1);\n        } else {\n          this.notificationUtilService.printSuccessMessage(this.translateJsonService.getTranslateSubs('TREATMENT-FLOW.dealt_success'));\n          this.treatmentFlowState.goToStep(10);\n        };\n\n      }).then(() => {\n        const signatureId = this.selectedAlarms[0].signatureId\n\n        if (signatureId!=null){\n          this.alarmService.deleteImgSignature(signatureId).subscribe((_) => {\n          })\n        }\n      })\n      .catch(err => {\n        this.treatmentFlowState.setUpdating(false);\n        this.notificationUtilService.printErrorMessage(err);\n      })\n  }\n\n  auditDrivers() {\n    let notUploadedImage = true;\n\n    this.treatmentFlowState.getSelectedAlarms().map((_alarm, i) => {\n      if(_alarm.selected && _alarm.hasFaceRecog && _alarm.updatedDriver){\n        if(notUploadedImage){\n          notUploadedImage = false;\n\n          this.driverService.uploadImageToDriver(\n            _alarm.driverId,\n            this.treatmentFlowService.dataURLtoFile(_alarm.picture, 'png'),\n            _alarm.typeAlarm,\n            _alarm.driverHasFaceRecog\n          ).subscribe(result => console.log(result), error => console.log(error));\n        }\n      }\n    });\n  }\n\n  private getTimezoneTreatment(): string {\n    try {\n      return this.dataService.getBrowserTimezoneOffset() || \"-03:00\";\n    } catch (error) {\n      console.warn('Erro ao obter timezone, usando padrão -03:00', error);\n      return \"-03:00\";\n    }\n  }\n\n  formatPhoneNumber(phoneNumber: string): string {\n    let newVal = phoneNumber.replace(/\\D/g, '');\n    \n    if (newVal.length == 10) {\n      newVal = newVal.replace(/^(\\d{2})(\\d{4})(\\d{4})/, '($1) $2-$3');\n    } else if (newVal.length == 11) {\n      newVal = newVal.replace(/^(\\d{2})(\\d{1})(\\d{4})(\\d{4})/, '($1) $2 $3-$4');\n    } else if (newVal.length >= 2) {\n      newVal = newVal.replace(/^(\\d{2})(\\d+)/, '($1) $2');\n    }\n    return newVal;\n  }\n\n}","module.exports = \"<div class=\\\"row step\\\">\\n  <div class=\\\"col-md-12\\\">\\n    <div class=\\\"row\\\"  style=\\\"min-height: 250px;padding-top: 40px;\\\">\\n      <div class=\\\"col-md-4 step-one__list-pictures p-0\\\">\\n        <p-scrollPanel [style]=\\\"{ width: '100%', height: '100%' }\\\" styleClass=\\\"scrollBg\\\">\\n          <ul style=\\\"margin-bottom: 20px;\\\">\\n            <li *ngFor=\\\"let alarm of (alarms$ | async)\\\" (click)=\\\"zoomAlarmImage($event, alarm.urlPictures, alarm.urlMovies, picture, alarm)\\\">\\n              <div class=\\\"picture\\\" #picture>\\n                    <ng-container *ngIf=\\\"alarm?.picture!='NO_PICTURE';else alarmWithoutMedia\\\">\\n                      <div *ngIf=\\\"alarm.picture\\\" width=\\\"100%\\\" height=\\\"100%\\\" #imageS>\\n                        <img *ngIf=\\\"alarm.picture\\\" (contextmenu)=\\\"$event.preventDefault()\\\" [src]=\\\"alarm.picture\\\" width=\\\"100%\\\" height=\\\"100%\\\" #imageS/>\\n                      </div>\\n                      <div class=\\\"playMovie\\\" *ngIf=\\\"alarm.movie\\\"></div>\\n                    </ng-container>\\n                    <