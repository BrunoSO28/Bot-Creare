 });\n                }\n            }\n        }\n    }\n\n    /* \n    * Analisa a quantidade de Alertas em cada nível de risco\n    */\n    private getLenghtRiskGroups(alerts : Alarm[], chartsValues) {\n        chartsValues[\"low-risk\"] = 0;\n        chartsValues[\"medium-risk\"] = 0;\n        chartsValues[\"high-risk\"] = 0;\n\n        alerts.forEach((alert) => {\n            switch(alert.groupRisk){\n                case 0:\n                    chartsValues[\"low-risk\"]++;\n                    break;\n                case 1:\n                    chartsValues[\"medium-risk\"]++;\n                    break;\n                case 2:\n                    chartsValues[\"high-risk\"]++;\n                    break;\n            }\n        })\n\n        return chartsValues;\n    }\n\n    /*  \n    * Insere o Nivel de Risco em cada Alerta\n    */\n    private insertGroupLowRiskInAlerts(alerts : Alarm[]): Alarm[] {\n        return alerts.map((a) => {\n            if(a.groupRisk != 2 && a.groupRisk != 1){\n                a.groupRisk = 0;\n                a.groupAlarm = 0;\n            };\n            a.groupAlarmsChild = [];\n\n            return a;\n        })\n    }\n\n    /* \n    * Coloca os Alertas agrupados por nivel de risco, tipo de alerta e veiculo\n    */\n    private groupingAlertsByRiskGroup(alerts : Alarm[]): Alarm[] {\n        let groupedAlerts: Alarm[] = [];\n\n        alerts.forEach((a) => {\n            let gAlerts: Alarm = groupedAlerts.find(ga => ga.groupAlarm == a.groupAlarm && ga.vehicleId == a.vehicleId &&\n                                                    ga.typeAlarm == a.typeAlarm && ga.driverId == a.driverId);\n\n            if(gAlerts) {\n                if(!gAlerts.groupAlarmsChild){\n                    gAlerts.groupAlarmsChild = [];\n                }\n                gAlerts.groupAlarmsChild.push(a);\n            }else{\n                groupedAlerts.push(a);\n            }\n        })\n\n        return groupedAlerts;\n    }\n\n    filterGroupRisk(risk: number) {\n        if(this.groupSelected.includes(risk)) {\n            this.groupSelected = this.groupSelected.filter(s => s != risk);\n        }else{\n            this.groupSelected.push(risk);\n        }\n\n        this.selectedGroup.emit(this.groupSelected);\n    }\n\n}","module.exports = \"<!-- Abrir ou Fechar menu de Ativos! Icon: << ou >> -->\\n<div class=\\\"menu-container\\\" [hidden]=\\\"opened\\\">\\n    <span (click)=\\\"changeOpenOrClose()\\\" class=\\\"menu-btn\\\">\\n        <i class=\\\"fa fa-angle-double-right\\\"></i>\\n    </span>\\n</div>\\n\\n<!-- Menu de Ativos quando aberto -->\\n<div class=\\\"menu-container-opened\\\" [hidden]=\\\"!opened\\\">\\n\\n    <!-- Header menu de Ativos (h1-Ativos, i-Filtro) -->\\n    <div class=\\\"menu-header\\\">\\n        <h1>{{ \\\"TELEMETRY-PAGE.assets\\\" | translate }}</h1>\\n\\n        <i \\n            class=\\\"fa fa-sliders\\\"\\n            aria-hidden=\\\"true\\\" \\n            (click)=\\\"filterDisplay = !filterDisplay\\\" \\n            placement=\\\"bottom\\\"\\n            ngbTooltip=\\\"Filtros\\\" \\n            tooltipClass=\\\"tool-tip\\\"\\n        >\\n        </i>\\n    </div>\\n\\n    <!-- Filtros menu de Ativos -->\\n    <div class=\\\"menu-filters\\\" *ngIf=\\\"filterDisplay\\\">\\n        \\n        \\n        <!-- Filtro Empresas (dropdown) -->\\n        <focus-tree-input \\n            [selectOnlyfromOneCustomer]=\\\"true\\\"\\n            [pendingContent]=false \\n            [contentNodes]=\\\"customers\\\" \\n            [loadedContent]=\\\"loadedCustomers\\\" \\n            [selectedNodes]=\\\"selectedCustomers\\\" \\n            [checkBox]=true \\n            [triStateChk]=true\\n            [multChk]=true \\n            [contentName]=\\\"'GLOBAL.customers' | translate\\\" \\n            [overlayPanelWidth]=\\\"'450px'\\\" \\n            (changedNodes)=\\\"changedCustomers($event)\\\">\\n        </focus-tree-input>\\n        \\n        <!-- Filtro Tipo de Ativo (