e=\\\"width: 800px; height: 390px;\\\"\\n                                                                class=\\\"ag-fresh\\\"\\n                                                                [gridOptions]=\\\"gridOptionsAlarms[0]\\\"\\n                                \\n                                                                (rowClicked)=\\\"onRowClicked($event)\\\"         \\n                                                                suppressRowClickSelection\\n                                                                toolPanelSuppressGroups\\n                                                                toolPanelSuppressValues\\n                                                                enableFilter\\n                                                                groupHeaders\\n                                                                enableCellChangeFlash=true\\n                                                                enableSorting\\n                                                                enableColResize>\\n                                                                </ag-grid-angular>     \\n                                                        </nb-card-body>\\n                                                      </nb-card>\\n                                                  </div>\\n\\n                                                  <div class=\\\"col-lg-6\\\">\\n                                                      <nb-card>\\n                                                        <nb-card-header>Ranking</nb-card-header>\\n                                                        <nb-card-body>\\n                                                           <ag-grid-angular\\n                                                                style=\\\"width: 800px; height: 390px;\\\"\\n                                                                class=\\\"ag-fresh\\\"\\n                                   