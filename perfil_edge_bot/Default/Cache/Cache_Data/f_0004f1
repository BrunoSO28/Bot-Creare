udit-id\\\">{{alarm.linkedAlarm.auditDriver?alarm.linkedAlarm.auditDriver:alarm.linkedAlarm.id}}</span>\\n          </div>\\n        </div>\\n      </div>    \\n    </ng-container>\\n\\n    <ng-container *ngIf=\\\"(step$ | async)==1 && isConfirmationType\\\">\\n      <div class=\\\"linked-alarms\\\">\\n        <div *ngFor=\\\"let alarm of linkedDrowsinessAlarmList\\\">\\n          <div *ngIf=\\\"alarm.linkedAlarm; else noLinkedAlarm\\\" class=\\\"confirmation-box\\\">\\n            <div>\\n              <b>⚠️ {{'TREATMENT-MODAL.attention' | translate}}: </b> {{'TREATMENT-MODAL.alarm_of' |\\n              translate}}<b> {{alarm.linkedAlarm.typeAlarmDescription | translate}}</b> {{'TREATMENT-MODAL.linked' | translate}} <strong>{{alarm.alarmId}}</strong>\\n            </div>\\n            <div>\\n              <span (click)=\\\"openConfirmationAuditInfo(alarm.linkedAlarm)\\\" class=\\\"confirmation-audit-id\\\">{{alarm.linkedAlarm.auditDriver?alarm.linkedAlarm.auditDriver:alarm.linkedAlarm.id}}\\n              </span>\\n            </div>\\n          </div>\\n          <ng-template #noLinkedAlarm>\\n            <div class=\\\"confirmation-box\\\">\\n              <b>⚠️ {{'TREATMENT-MODAL.no_linked_alarm' | translate: {value: alarm.alarmId} }}</b>\\n            </div>\\n          </ng-template>\\n        </div>\\n      </div>    \\n    </ng-container>\\n\\n      <div class=\\\"row\\\">\\n        <div class=\\\"col-md-12\\\">\\n          <step-infos [ticketInfo]=\\\"ticket\\\" [ticketLoaded]=\\\"ticketLoaded\\\" [auditId]=\\\"auditId\\\" [infos]=\\\"commonDetails | async\\\" [editAlarmType]=\\\"(step$ | async) < 2\\\" (changedAlarmType)=\\\"changeAlarmType($event)\\\" (eventChangeTreatment)=\\\"eventChangeTreatment.emit($event)\\\"></step-infos>\\n        </div>\\n      </div>\\n      <ng-container *ngIf=\\\"!devicesWithoutMedia.includes((alarms$ | async)[0]?.equipmentTypeId); else noMidiaAlarms\\\">\\n        <div [ngSwitch]=\\\"step$ | async\\\">\\n          <treatment-step-one [isClickable]=\\\"isClickable\\\" *ngSwitchCase=\\\"1\\\"\\n            (eventInvalidateAlarm)=\\\"reload.emit(true)\\\" (eventCloseModal)=\\\"close.emit()\\\"></treatment-step-one>\\n          <treatment-step-two *ngSwitchCase=\\\"2\\\"></treatment-step-two>\\n          <treatment-step-three *ngSwitchCase=\\\"3\\\"></treatment-step-three>\\n          <treatment-step-four [customerProfileName]=\\\"customerProfileName\\\" *ngSwitchCase=\\\"4\\\" (eventCloseModal)=\\\"close.emit()\\\"\\n            [isShowSendNotificationTools]=\\\"true\\\"></treatment-step-four>\\n        </div>\\n      </ng-container>\\n      <ng-template #noMidiaAlarms>\\n        <div [ngSwitch]=\\\"step$ | async\\\">\\n          <treatment-step-one [isClickable]=\\\"isClickable\\\" *ngSwitchCase=\\\"1\\\"\\n            (eventInvalidateAlarm)=\\\"reload.emit(true)\\\" (eventCloseModal)=\\\"close.emit()\\\"></treatment-step-one>\\n          <treatment-step-three *ngSwitchCase=\\\"3\\\"></treatment-step-three>\\n          <treatment-step-four [customerProfileName]=\\\"customerProfileName\\\" *ngSwitchCase=\\\"4\\\" (eventCloseModal)=\\\"close.emit()\\\"\\n            [isShowSendNotificationTools]=\\\"true\\\"></treatment-step-four>\\n        </div>\\n      </ng-template>\\n    </div>\\n  </div>\\n</div>\\n\\n  <p-dialog [(visible)]=\\\"showAlarmConfirmationAuditInfo\\\" class=\\\"audit-info-dialog\\\">\\n    <p-header>\\n      {{'TREATMENT-MODAL.linked_alarm' | translate}}\\n    </p-header>\\n    <audit-details *ngIf=\\\"selectedConfirmationAlarm\\\" [alarm]=\\\"selectedConfirmationAlarm\\\"></audit-details>\\n  </p-dialog>\\n\\n\"","module.exports = \".treat .treat__header{display:flex;flex-direction:row;justify-content:center;margin-bottom:8px;align-items:center;position:relative}.treat .treat__header h1{font-size:18px;font-weight:bold;font-family:'Roboto', sans-serif;color:#4B4B4D}.treat .treat__header h2{font-size:14px;font-weight:bold;font-family:'Roboto', sans-serif;color:#4B4B4D;position:absolute;right:25px}.treat .treat__steps{display:flex;flex-direction:row;justify-content:center;font-family:'Roboto'}.treat .treat__steps ul{position:relative;display:flex;flex-direction:row;justify-content:space-between;width:50%;margin:0}.treat .treat__steps ul li{list-style-type:none;display:flex;flex-direction:column;align-items:center;z-index:2}.treat .treat__steps ul li span.icon{border-radius:50%;border:2px solid #D4CFCF;background-color:#FFF;width:20px;height:20px;padding:15px;display:flex;flex-direction:row;justify-content:center;align-items:center;margin-bottom:6px}.treat .treat__steps ul li p{font-size:12px;color:#B5B5B5;margin:0}.treat .treat__steps ul li.actived span.icon{border:2px solid #4B4B4D;background-color:#4B4B4D}.treat .treat__steps ul li.actived span.icon img{-webkit-filter:grayscale(100%) brightness(5);filter:grayscale(100%) brightness(5)}.treat .treat__steps ul li.actived p{font-weight:bold}.treat .treat__steps ul li.disabled span.icon{border:2px solid #ebebeb;background-color:#ebebeb}.treat .treat__steps ul li.disabled span.icon img{-webkit-filter:brightness(0.7);filter:brightness(0.7)}.treat .treat__steps ul::before{content:'';width:95%;height:3px;background-color:#ebebeb;position:absolute;top:40%;left:2%}.treat .treat__content{background-color:#F5F3F3;border-radius:5px;margin:15px;padding:15px}.treat .linked-alarms{margin:0 auto;display:flex;flex-direction:column;gap:12px;width:-webkit-fit-content;width:-moz-fit-content;width:fit-content;margin-bottom:30px}.treat .linked-alarms .confirmation-box{width:100%;display:flex;gap:10px 50px;border:1px solid #FFA4A9;align-items:center;border-radius:5px;justify-content:space-between;padding:10px 15px;flex-wrap:wrap}.treat .linked-alarms .confirmation-box b{font-weight:500}.treat .linked-alarms .confirmation-box .confirmation-audit-id{text-decoration:underline;color:#007AD9;cursor:pointer}::ng-deep .audit-info-dialog .ui-dialog{width:60% !important}\\n\"","import {AfterViewInit, Component, EventEmitter, Input, OnInit, Output} from \"@angular/core\";\nimport {Alarm} from \"app/@core/models\";\nimport {Observable} from \"rxjs\";\nimport {StepInfosModel} from \"./step-infos.model\";\nimport {TreatmentFlowState} from \"./treatment-flow.state\";\nimport {TranslateJsonService} from \"app/@core/data/translate-json.service\";\nimport {CustomerProfile} from \"app/@core/models/customerProfile.entity\";\nimport {TreeInputModel} from \"app/@core/models/treeInputModel.entity\";\nimport {CustomerService} from \"app/@core/data/customer.service\";\nimport {TicketService} from 'app/@core/data/ticket.service';\nimport {TicketStatus} from \"app/@core/enum/ticket-status.enum\";\nimport {Ticket} from 'app/@core/models/ticket';\nimport {EquipamentType} from 'app/@core/enum/equipament.type.enum';\nimport {environment} from 'environments/environment';\nimport {AlarmTypeEnum} from 'app/@core/enum/alarm-type.enum';\nimport {AlarmService} from 'app/@core/data/alarm.service';\nimport {LinkedAlarms} from 'app/@core/models/linkedAlarms.entity';\nimport { NotificationUtilService } from 'app/@core/utils/notification.util.service';\nimport { AlarmTypeCodeEnum } from 'app/@core/enum/alarm-type-codes';\n\n@Component({\n  selector: 'treatment-flow',\n  styleUrls: ['./treatment-flow.component.scss'],\n  templateUrl: './treatment-flow.component.html'\n})\nexport class TreatmentFlowComponent implements OnInit, AfterViewInit {\n  @Input('alarms') alarms: Alarm[] = [];\n\n  @Output('close') close: EventEmitter<boolean> = new EventEmitter<boolean>();\n  @Output('reload') reload: EventEmitter<boolean> = new EventEmitter<boolean>();\n  @Output() eventChangeTreatment: EventEmitter<{alertIds: number[], treatmentStarted: boolean}> = new EventEmitter<{alertIds: number[], treatmentStarted: boolean}>();\n\n  @Input() isClickable: boolean = true;\n\n  public alarmReadByUsername?: string;\n  public ticketLoaded:boolean = false;\n  public selectedConfirmationAlarm:Alarm;\n  public showAlarmConfirmationAuditInfo:boolean = false;\n  alarmVehicleId: number;\n\n  alarms$: Observable<Alarm[]>;\n  commonDetails: Observable<StepInfosModel>;\n  public ticket: Ticket;\n\n  step$: Observable<number>;\n\n  customerProfileList: TreeInputModel[] = [];\n  public customerProfileName: string;\n  public equipmentType = EquipamentType;\n  public devicesWithoutMedia:number[] = environment.equipmentsTypeIdWithoutMedia.split(',').map(a => Number(a));\n  public auditId: number;\n  public isConfirmationType: boolean = false;\n  public linkedConfirmationAlarmList:LinkedAlarms[]= [];\n  public linkedDrowsinessAlarmList:LinkedAlarms[]= [];\n  public originalAlarmType: number;\n\n  constructor(\n    private tretmentFlowState: TreatmentFlowState,\n    private translateJsonService: TranslateJsonService,\n    private customerService: CustomerService,\n    private ticketService: TicketService,\n    private alarmService: AlarmService,\n    private notificationUtilService: NotificationUtilService,\n  ){\n    this.tretmentFlowState.firstStep();\n\n    this.tretmentFlowState.closingModal$().subscribe(close => (close) ? this.close.emit(true) : '');\n  }\n\n   ngOnInit(){\n    this.alarms$ = this.tretmentFlowState.getAlarms$();\n    this.commonDetails = this.tretmentFlowState.getInfos$();\n    this.getLinkedAlarms();\n    this.getAiAlarmValidationsByAlarmIds();\n\n    this.loadCustomersProfile().then( result =>{      \n          this.customerProfileList.forEach( customerProfile => {\n        this.commonDetails.subscribe( detail => { \n          this.alarms$.subscribe( alarms => {\n            alarms.filter(alarm => {\n              if( alarm.customer_profile_id == customerProfile.id) {\n                detail.customerProfileName = customerProfile.name;\n                this.customerProfileName = detail.customerProfileName;\n              }\n\n            })        \n            const alarmWithReadByUser = alarms.find(alarm => alarm.alarmReadByUsername != null);\n            this.alarmReadByUsername = alarmWithReadByUser ? alarmWithReadByUser.alarmReadByUsername : null;\n\n        });\n        });\n      });\n    });\n\n    this.step$ = this.tretmentFlowState.getStep$();\n    this.step$.subscribe(step => {\n      if (step === 4) {\n        this.reload.emit(true);\n      }\n      if(step == 10){\n        this.close.emit(true);\n      }\n    })\n  }\n \n  ngAfterViewInit(){ \n    this.tretmentFlowState.getAlarms$().subscribe(alarms=>{\n      if (alarms.length > 0) {\n        this.alarmVehicleId = alarms[0].vehicleId;\n        if (alarms[0].auditAlarm || alarms[0].auditDriver) {\n          this.auditId = alarms[0].auditAlarm ? alarms[0].auditAlarm : alarms[0].auditDriver;\n        }\n      }\n    })\n    this.getLastTicket(this.alarmVehicleId); \n  }\n\n  loadCustomersProfile(): Promise<any> {\n    return new Promise ((resolve, reject) => {\n      this.customerService.getCustomerProfiles(true).subscribe((result) => {            \n        result.forEach((cusProf : CustomerProfile) => {\n            this.customerProfileList.push({id: cusProf.id, name: cusProf.name, parentId: null});\n        });\n        resolve(true);\n      });\n    });    \n  }\n\n  private updateAlarmType(type: number) {\n    this.tretmentFlowState.updateAlarmTypes(\n      type,\n      this.translateJsonService.getAlarmTypesTranslate(type)\n    );\n  }\n\n  changeAlarmType(alarmType: number) {\n    if (alarmType === AlarmTypeCodeEnum.INVALID_ALARM) {\n      this.notificationUtilService.openConfirmationDialog(\n        '',\n        this.translateJsonService.getTranslateSubs('TREATMENT-MODAL.invalid_alert_confirmation'),\n        () => this.updateAlarmType(alarmType),\n        () => {\n          const sub = this.alarms$.subscribe(alarms => {\n            if (alarms && alarms[0]) {\n              this.updateAlarmType(alarms[0].typeAlarm);\n            }\n            sub.unsubscribe(); \n          });\n        }\n      );\n    } else {\n      this.updateAlarmType(alarmType);\n    }\n  }\n  private getLinkedAlarms() {\n    const alarms = this.tretmentFlowState.getAlarms();\n    const categorizedAlarms = this.categorizeAlarms(alarms);\n    \n    if (categorizedAlarms.confirmationIds && categorizedAlarms.confirmationIds.length > 0) {\n      this.isConfirmationType = true;\n      this.fetchAndAppendLinkedAlarms(categorizedAlarms.confirmationIds, this.linkedDrowsinessAlarmList, alarms);\n    }\n    \n    if (categorizedAlarms.drowsinessIds && categorizedAlarms.drowsinessIds.length > 0) {\n      this.fetchAndAppendLinkedAlarms(categorizedAlarms.drowsinessIds, this.linkedConfirmationAlarmList);\n    }\n  }\n  \n  private categorizeAlarms(alarms: Alarm[]): { confirmationIds: number[], drowsinessIds: number[] } {\n    const confirmationIds = [];\n    const drowsinessIds = [];\n    \n    alarms.forEach(alarm => {\n      if ([AlarmTypeEnum['TYPES-ALERT.tired'], AlarmTypeEnum['TYPES-ALERT.atten_warning'], AlarmTypeEnum['TYPES-ALERT.accumulated_drowsiness']].includes(alarm.typeAlarm)) {\n        drowsinessIds.push(alarm.id);\n      }\n      if ([AlarmTypeEnum['TYPES-ALERT.drowsiness_l1_confirmation'], AlarmTypeEnum['TYPES-ALERT.drowsiness_l2_confirmation']].includes(alarm.typeAlarm)) {\n        confirmationIds.push(alarm.id);\n      }\n    });\n    return { confirmationIds, drowsinessIds };\n  }\n  \n  private fetchAndAppendLinkedAlarms(ids: number[], targetList: LinkedAlarms[], alarms?: Alarm[]): void {\n    this.alarmService.getLinkedAlarms(ids).subscribe(linkedAlarms => {\n      targetList.push(...linkedAlarms);\n      if(alarms){\n        this.handleUnlinkedAlarms(alarms, linkedAlarms);\n      }\n    }\n    );\n  }\n\n  private handleUnlinkedAlarms(alarms: Alarm[], linkedAlarmsList: LinkedAlarms[]): void {\n    const unlinkedAlarms = alarms.filter(alarm => \n      !linkedAlarmsList.some(linkedAlarm => linkedAlarm.alarmId === alarm.id)\n    );\n    unlinkedAlarms.forEach(alarm => {\n      this.linkedDrowsinessAlarmList.push({ alarmId: alarm.id, linkedAlarm: null });\n    });\n  }\n\n  private async getLastTicket(vehicleId: number){\n    \n    const openedTicketStatusList= [     \n      TicketStatus.OPEN,\n      TicketStatus.SCHEDULE,\n      TicketStatus.AWAITING_CUSTOMER,\n      TicketStatus.REMOTE_PROCEDURE,\n      TicketStatus.WAITING_FOR_CREATE\n    ]\n    let vehicleIdList: number[] = [vehicleId]\n    this.ticketService.getTickets(vehicleIdList, openedTicketStatusList).then(\n      ticketList=>{\n        this.ticket = ticketList[0];\n        this.ticketLoaded= true;\n      }\n    ).catch(()=>{\n      this.ticketLoaded= true;\n    })\n  \n  }\n  openConfirmationAuditInfo(alarmConfirmation:Alarm){\n    this.selectedConfirmationAlarm= alarmConfirmation;\n    this.showAlarmConfirmationAuditInfo = true;\n  }\n\n  getAiAlarmValidationsByAlarmIds() {\n    const alarms = this.tretmentFlowState.getAlarms();\n    const alarmIds = alarms.map(alarm => alarm.id);\n    \n    this.alarmService.getAiAlarmValidationsByAlarmIds(alarmIds).subscribe(aiAlarmValidations => {\n      this.tretmentFlowState.setAiAlarmValidations(aiAlarmValidations);\n      const aiValidationsByAlarmId = new Map<number, any[]>();\n      \n      aiAlarmValidations.forEach(aiVal => {\n        if (!aiValidationsByAlarmId.has(aiVal.alarmId)) {\n          aiValidationsByAlarmId.set(aiVal.alarmId, []);\n        }\n        aiValidationsByAlarmId.get(aiVal.alarmId)!.push(aiVal);\n      });\n      \n      const updatedAlarms = alarms.map(alarm => {\n        const validations = aiValidationsByAlarmId.get(alarm.id) || [];\n        const filteredValidations = validations.filter(aiVal =>\n          aiVal.origin === \"DMS_DEEPLEARNING\" || aiVal.channel === 0\n        );\n        if (filteredValidations.length === 0) {\n          return alarm;\n        }\n        return alarm;\n      });\n      \n      this.tretmentFlowState.setAlarms(updatedAlarms);\n    });\n}\n}","import { Injectable } from \"@angular/core\";\nimport { TVIEW } from \"@angular/core/src/render3/interfaces/view\";\nimport { AlarmService } from \"app/@core/data/alarm.service\";\nimport { CustomerContactService } from \"app/@core/data/customer-contact.service\";\nimport { DataService } from \"app/@core/data/data.service\";\nimport { TreatmentService } from \"app/@core/data/treatment.service\";\nimport { Alarm, AlarmType, Audit } from \"app/@core/models\";\nimport { AssetCustomerContact } from \"app/@core/models/assetCustomerContact.entity\";\nimport { PictureAndMovie } from \"app/@core/models/pictureAndMovie.entity\";\nimport { TreatmentContact } from \"app/@core/models/treatmentContact.entity\";\nimport { ValidationHistory } from \"app/@core/models/validationHistory.entity\";\nimport { Workspace } from \"app/@core/models/workspace.data.entity\";\nimport { environment } from \"environments/environment\";\nimport { Observable, Observer  } from \"rxjs\";\nimport { TreatmentFlowState } from \"./treatment-flow.state\";\nimport { map, catchError, tap } from 'rxjs/operators';\nimport { EquipamentType } from \"app/@core/enum/equipament.type.enum\";\n\n@Injectable()\nexport class TreatmentFlowService {\n\n  private workspace: Workspace;\n  private readonly ValidationPurpose = {\n    VALIDATION: 1,\n    INVALIDATION: 2\n  };\n\n  constructor(\n    private treatmentFlowState: TreatmentFlowState,\n    private alarmService: AlarmService,\n    private treatmentService: TreatmentService,\n    private customerContactService: CustomerContactService,\n    private dataService: DataService,\n  ){\n    this.workspace = dataService.getWorkspace();\n  }\n\n\n  public loadImages(alarmList : Alarm[]): Promise<Alarm[]> {\n    return new Promise((resolve, reject) => {\n      this.treatmentFlowState.setUpdating(true);\n\n      for(const alarm of alarmList){\n        if (alarm.urlPictures[0] == 'NO_PICTURE') {\n          alarm.picture = 'NO_PICTURE'\n        } else if (alarm.picture == null) {\n          this.alarmService.getPictureByAlarm(alarm.id).subscribe((pictureAndMovie: PictureAndMovie) => {\n            if (alarm.equipmentTypeId == EquipamentType.JIMI_G7){\n              const originalChannel = pictureAndMovie.urlPictures[this.whatsChannel(alarm.originalTypeAlarm ? alarm.originalTypeAlarm : alarm.typeAlarm)];\n              const alternativeChannel = pictureAndMovie.urlPictures[4];\n              this.getBase64ImageFromURL(originalChannel).pipe(\n                  catchError((error) => {\n                    return this.getBase64ImageFromURL(alternativeChannel);\n                  })\n              ).subscribe(result => {\n                alarm.picture = result;\n                alarm.urlPictures = pictureAndMovie.urlPictures;\n\n                if (pictureAndMovie.urlMovies && pictureAndMovie.urlMovies.length > 0) {\n                  alarm.movie = pictureAndMovie.urlMovies[this.whatsChannel(alarm.originalTypeAlarm ? alarm.originalTypeAlarm : alarm.typeAlarm)];\n                  alarm.urlMovies = pictureAndMovie.urlMovies;\n                }\n              }, error => {\n                this.getBase64ImageFromURL(this.dataService.notFoundImage).subscribe(_result => {\n                  alarm.picture = _result;\n                })\n              });\n            }else{\n              this.getBase64ImageFromURL(pictureAndMovie.urlPictures[this.whatsChannel(alarm.originalTypeAlarm ? alarm.originalTypeAlarm: alarm.typeAlarm)]).subscribe(result => {\n                alarm.picture = result;\n                alarm.urlPictures = pictureAndMovie.urlPictures;\n\n                if(pictureAndMovie.urlMovies && pictureAndMovie.urlMovies.length > 0){\n                  alarm.movie = pictureAndMovie.urlMovies[this.whatsChannel(alarm.originalTypeAlarm ? alarm.originalTypeAlarm: alarm.typeAlarm)];\n                  alarm.urlMovies = pictureAndMovie.urlMovies;\n                }\n              }, error => {\n                this.getBase64ImageFromURL(this.dataService.notFoundImage).subscribe(_result => {\n                  alarm.picture = _result;\n                })\n              })\n            }\n          });\n        }\n      }\n\n      resolve(alarmList);\n      this.treatmentFlowState.setUpdating(false);\n    })\n\n  }\n\n  private whatsChannel(typeAlarm) {\n    const fatigueChannel = 0; \n    const adasChannel = 1;\n    const riderDetectionChannel = 4;\n\n    const ALARM_TYPES_REQUIRED_FATIGUE_MEDIAS = environment.alarmTypesRequiredFatigueMedias.split(',').map(a => Number(a));\n\n    if (typeAlarm === 24) {\n      return riderDetectionChannel;\n    }\n\n    return ALARM_TYPES_REQUIRED_FATIGUE_MEDIAS.includes(typeAlarm) ? fatigueChannel : adasChannel  \n  }\n\n  public setAlarms(alarm: Alarm[]){\n    this.loadImages(alarm)\n      .then(alarms => {\n        this.treatmentFlowState.setAlarms(alarms);\n      });\n  }\n\n  reset(){\n    this.treatmentFlowState.setAlarms([]);\n  }\n\n  processAlarmValidation(alarms: Alarm[], purpose: number, comments?: string): Promise<{ success: number[], failed: number[], auditIds?: number[] }> {\n    return new Promise((resolve, reject) => {\n\n      let validationList: ValidationHistory[] = [];\n\n      alarms.forEach(alarm => {\n        let validation: ValidationHistory = new ValidationHistory;\n\n        validation.level = alarm.level;\n        validation.type = alarm.typeAlarm.toString();\n        validation.driver = alarm.driverId;\n        validation.vehicle = alarm.vehicleId;\n        validation.alarm = alarm.id;\n        validation.purpose = purpose;\n        validation.ownerUser = this.workspace.currentUserId;\n        validation.maskCOVID = this.treatmentFlowState.getMaskCOVID();\n        validation.noSeatbelt = this.treatmentFlowState.getNoSeatbelt();\n        validation.groupRisk = purpose === this.ValidationPurpose.VALIDATION ? alarm.groupRisk : 0;\n        validation.timeZoneTreatment = this.dataService.getBrowserTimezoneOffset() || \"-03:00\";\n\n        if (comments) {\n          validation.comments = comments;\n        }\n\n        if (alarm.updateFirstTreatmentDate) {\n          validation.updateFirstTreatmentDate = true;\n        }\n\n        validationList.push(validation);\n      })\n\n      this.treatmentService.validationAlarms(validationList)\n        .then(results => {\n          resolve({\n            success: results.filter(r => r.success).map(r => r.id), \n            failed: results.filter(r => !r.success).map(r => r.id), \n            auditIds: results.filter(r => r.success).map(r => r.auditId) });\n        });\n    })\n  }\n\n  getBase64ImageFromURL(url: string) {\n    return Observable.create((observer: Observer<string>) => {\n      let img = new Image();\n\n      img.crossOrigin = 'Anonymous';\n      img.src = url;\n\n      if (!img.complete) {\n          img.onload = () => {\n          observer.next(this.getBase64Image(img));\n          observer.complete();\n        };\n        img.onerror = (err) => {\n           observer.error(err);\n        };\n      } else {\n          observer.next(this.getBase64Image(img));\n          observer.complete();\n      }\n    });\n  }\n\n  getBase64Image(img: HTMLImageElement) {\n    var canvas = document.createElement(\"canvas\");\n    canvas.width = img.width;\n    canvas.height = img.height;\n\n    var ctx = canvas.getContext(\"2d\");\n    ctx.drawImage(img, 0, 0);\n\n    var dataURL = canvas.toDataURL(\"image/png\");\n    return dataURL //.replace(/^data:image\\/(png|jpg);base64,/, \"\");\n  }\n\n  dataURLtoFile(dataurl, format: string) {\n    var result           = '';\n    var characters       = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';\n    var charactersLength = characters.length;\n\n    for ( var i = 0; i < 25; i++ ) {\n        result += characters.charAt(Math.floor(Math.random() * charactersLength));\n    }\n\n    var arr = dataurl.split(','),\n        mime = arr[0].match(/:(.*?);/)[1],\n        bstr = atob(arr[1]),\n        n = bstr.length,\n        u8arr = new Uint8Array(n);\n\n    while(n--){\n        u8arr[n] = bstr.charCodeAt(n);\n    }\n\n    return new File([u8arr], `${result}.${format}`, {type:mime});\n  }\n\n  loadTreatments(customerProfile: number) {\n    this.treatmentFlowState.setUpdating(true);\n\n    this.treatmentService\n      .getTreatmentsByCustomerProfile(customerProfile)\n      .subscribe(\n        treatments => {\n          this.treatmentFlowState.setTreatments(treatments)\n        },\n        error => { this.treatmentFlowState.setUpdating(false); },\n        () => this.treatmentFlowState.setUpdating(false)\n      )\n  }\n\n  loadTreatmentContacts(assetId: number, customerChildId: number) {\n    this.treatmentFlowState.setTreatmentContactsLoaded(false);\n    this.customerContactService\n      .getCustomerContactsByAssetId(assetId)\n      .subscribe(\n        assetCustomerContacts => {\n          this.treatmentFlowState.setTreatmentContacts( this.mapTreatmentContact(assetCustomerContacts) );\n          this.treatmentFlowState.setTreatmentContactsLoaded(true);\n        },\n        error => {\n          console.log(\"Erro assetCustomerContacts\", error);\n          this.treatmentFlowState.setTreatmentContacts([]);\n          this.treatmentFlowState.setTreatmentContactsLoaded(true);\n        }\n        )\n  }\n\n  mapTreatmentContact(assetCustomerContacts: AssetCustomerContact[]): TreatmentContact[] {\n    \n    //assetCustomerContacts to TreatmentContact\n    const treatmentContacts :TreatmentContact[] =  assetCustomerContacts\n      .filter( c => {\n        return c.customerContacts && c.customerContacts.length > 0\n      })\n      .reduce( (flatList, current) => {\n        return flatList.concat(current.customerContacts);\n      }, [])\n      .map( cc => {\n        return new TreatmentContact(cc.name, cc.email, cc.phones);            \n      });\n    \n    return treatmentContacts;\n  } \n  \n\n  createAudit(audit: Audit): Promise<any> {\n    return new Promise((resolve, reject) => {\n      this.treatmentService.createAudit(audit)\n        .subscribe(\n          result => resolve(result),\n          error => reject(error)\n        )\n    });\n  }\n\n  createAuditsInBatch(audits: Array<Audit>, comments: string): Promise<Array<Audit>> {\n    return new Promise((resolve, reject) => {\n      this.treatmentService.createAuditsInBatch(audits, comments)\n        .subscribe(\n          result => resolve(result),\n          error => reject(error)\n        )\n    });\n  }\n}\n","import { Injectable } from \"@angular/core\";\nimport { Alarm, Audit, Driver } from \"app/@core/models\";\nimport { TreatmentData } from \"app/@core/models/treatment.entity\";\nimport { TreatmentContact } from \"app/@core/models/treatmentContact.entity\";\nimport { BehaviorSubject, Observable } from \"rxjs\";\nimport { map } from \"rxjs/operators\";\nimport { StepInfosModel } from \"./step-infos.model\";\nimport { EquipamentType } from \"app/@core/enum/equipament.type.enum\";\nimport { AiAlarmValidation } from \"app/@core/models/aiAlarmValidation.entity\";\n\n@Injectable({\n  providedIn: 'root'\n})\nexport class TreatmentFlowState {\n  \n  protected alarms$: BehaviorSubject<Alarm[]> = new BehaviorSubject<Alarm[]>([]);\n  protected updating$: BehaviorSubject<boolean> = new BehaviorSubject<boolean>(false);\n  protected infos$: BehaviorSubject<StepInfosModel> = new BehaviorSubject<StepInfosModel>({});\n  protected step$: BehaviorSubject<number> = new BehaviorSubject<number>(1);\n  protected treatments$: BehaviorSubject<TreatmentData[]> = new BehaviorSubject<TreatmentData[]>([]);\n  protected audit$: BehaviorSubject<Audit> = new BehaviorSubject<Audit>({ id: 0, comments: ''});\n  protected treatmentContacts$: BehaviorSubject<TreatmentContact[]> = new BehaviorSubject<TreatmentContact[]>([]);\n  protected treatmentContactsLoaded$: BehaviorSubject<boolean> = new BehaviorSubject<boolean>(false);\n\n  protected closeModal$: BehaviorSubject<Boolean> = new BehaviorSubject<Boolean>(false);\n  protected aiAlarmValidations$: BehaviorSubject<AiAlarmValidation[]> = new BehaviorSubject<AiAlarmValidation[]>([]);\n\n  // Temp\n  protected maskCOVID$: BehaviorSubject<boolean> = new BehaviorSubject<boolean>(null);\n  protected noSeatbelt$: BehaviorSubject<boolean> = new BehaviorSubject<boolean>(null);\n\n  setMaskCOVID(value: boolean): void {\n    this.maskCOVID$.next(value);\n  }\n\n  getMaskCOVID(): boolean {\n    return this.maskCOVID$.getValue();\n  }\n  setNoSeatbelt(value: boolean): void {\n    this.noSeatbelt$.next(value);\n  }\n\n  getNoSeatbelt(): boolean {\n    return this.noSeatbelt$.getValue();\n  }\n\n  closingModal$(){\n    return this.closeModal$.asObservable();\n  }\n\n  setCloseModal(close: boolean){\n    this.closeModal$.next(close);\n  }\n\n  getStep$(){\n    return this.step$.asObservable();\n  }\n\n  getStep(){\n    return this.step$.getValue();\n  }\n\n  nextStep(number){\n    const atualStep = this.step$.getValue();\n\n    this.step$.next(atualStep+number);\n  }\n\n  goToStep(step: number){\n    this.step$.next(step);\n  }\n\n  getTreatments$(): Observable<TreatmentData[]> {\n    return this.treatments$.asObservable();\n  }\n\n  setTreatments(treatments: TreatmentData[]) {\n    this.treatments$.next(treatments);\n  }\n\n  getTreatmentContacts$(): Observable<TreatmentContact[]> {\n    return this.treatmentContacts$.asObservable();\n  }\n\n  setTreatmentContacts(treatmentContacts: TreatmentContact[]) {\n    this.treatmentContacts$.next(treatmentContacts);\n  }\n\n\n  firstStep(){\n    this.step$.next(1);\n  }\n\n  toStep(step: number){\n    this.step$.next(step);\n  }\n\n  previousStep(){\n    const atualStep = this.step$.getValue();\n\n    if(atualStep != 1){\n      this.step$.next(atualStep-1);\n    }\n  }\n\n  isUpdating$(){\n    return this.updating$.asObservable();\n  }\n\n  setUpdating(updating: boolean){\n    this.updating$.next(updating);\n  }\n\n  isTreatmentContactsLoaded$(){\n    return this.treatmentContactsLoaded$.asObservable();\n  }\n\n  setTreatmentContactsLoaded(treatmentContactsLoaded: boolean){\n    this.treatmentContactsLoaded$.next(treatmentContactsLoaded);\n  }\n\n  getAlarms$(){\n    return this.alarms$.asObservable();\n  }\n\n  getAlarms(){\n    return this.alarms$.getValue();\n  }\n\n  getFinishedAlarms(): Alarm[] {\n    return this.alarms$.getValue()\n      .filter(alarm => alarm.selected)\n      .map(alarm => {\n        let _alarm = new Alarm();\n\n        _alarm.id = alarm.id;\n\n        if(alarm.updatedDriver){\n          _alarm.driverId = alarm.driverId;\n        }\n\n        if(alarm.updatedAlarmType){\n          _alarm.typeAlarm = alarm.typeAlarm;\n        }\n        \n        _alarm.updatedAlarmType = alarm.updatedAlarmType;\n        _alarm.updatedDriver = alarm.updatedDriver;\n        _alarm.selected = alarm.selected;\n        _alarm.hasFaceRecog = alarm.hasFaceRecog;\n        _alarm.driverHasFaceRecog = alarm.driverHasFaceRecog;\n        _alarm.groupRisk = alarm.groupRisk;\n        _alarm.recalcRiskByRecurrence = alarm.recalcRiskByRecurrence;\n        _alarm.datetime = alarm.datetime;\n        _alarm.previousRecurrentAlarmIDs = alarm.previousRecurrentAlarmIDs;\n        _alarm.updateFirstTreatmentDate = alarm.updateFirstTreatmentDate;\n        return _alarm;\n      })\n  }\n\n  setAlarms(alarms: Alarm[]){\n    this.alarms$.next(alarms);\n    if (alarms.length !== 0) {\n      this.setInfos(this.getCommonDetails(alarms));\n    }\n    else{\n      this.setInfos(null);\n    }\n  }\n\n  addAlarm(alarm: Alarm){\n    const alarms = this.alarms$.getValue();\n\n    this.setAlarms([...alarms, alarm]);\n  }\n\n  getInfos$(){\n    return this.infos$.asObservable();\n  }\n\n  setInfos(info: StepInfosModel){\n    this.infos$.next(info);\n  }\n\n\n  selectedAlarm(alarmId: number){\n    const alarms = this.alarms$.getValue();\n    const alarm = alarms.find(alarm => alarm.id == alarmId);\n\n    if(alarm){\n      alarm.selected = !alarm.selected;\n    }\n  }\n\n  updateAlarmTypes(alarmType: number, alarmTypeDescription: string){\n    const alarms = this.alarms$.getValue();\n\n    alarms.forEach(alarm => {\n      alarm.typeAlarm = alarmType;\n      alarm.typeAlarmDescription = alarmTypeDescription;\n      alarm.updatedAlarmType = true;\n    })\n\n    this.setInfos(this.getCommonDetails(alarms));\n  }\n\n  updateDriver(driver: Driver){\n    const alarms = this.alarms$.getValue();\n\n    alarms.forEach(alarm => {\n      alarm.driverId = driver.id;\n      alarm.driver_firstname = driver.name;\n      alarm.updatedDriver = true;\n      alarm.driverHasFaceRecog = driver.hasFaceRecog;\n    });\n\n    this.setInfos(this.getCommonDetails(alarms));\n  }\n\n  countSelectedAlarm(){\n    return this.alarms$.getValue().filter(alarm => alarm.selected == true).length;\n  }\n\n  getSelectedAlarms$(){\n    return this.alarms$.pipe(map(alarms => alarms.filter(alarm => alarm.selected == true)));\n  }\n\n  getSelectedAlarms(){\n    return this.alarms$.getValue().filter(alarm => alarm.selected == true);\n  }\n\n  removeAlarmsById(alarmIds: number[]){\n    this.setAlarms(\n      this.alarms$.getValue().filter(alarm => !alarmIds.includes(alarm.id))\n    )\n  }\n\n  getAudit$(){\n    return this.audit$.asObservable();\n  }\n\n  setAudit(audit: Audit){\n    this.audit$.next(audit);\n  }\n\n  /* UTILS */\n  getCommonDetails(alarms: Alarm[]): StepInfosModel {\n    const alarm = alarms.find((alarm, index) => index == 0);\n    if (alarm){\n      return {\n        alarmType: alarm.typeAlarm, vehicleDetails: `${alarm.vehicle_plates} ${alarm.vehicle_prefix ? (' / ' + alarm.vehicle_prefix) : ''}`, \n               driverDetails: alarm.driver_firstname, customerChild: alarm.customer_child_name, alarmId: alarm.id,\n               treatmentStartedAt: alarm.treatmentStartedAt, recalcRiskByRecurrence: alarm.recalcRiskByRecurrence,\n               alarmIds: alarms.map(alarm => alarm.id),\n               equipmentTypeId: alarm.equipmentTypeId,\n              };\n    }\n  }\n\n  getAiAlarmValidations$(){\n    return this.aiAlarmValidations$.asObservable();\n  }\n\n  setAiAlarmValidations(aiAlarmValidations: AiAlarmValidation[]){\n    this.aiAlarmValidations$.next(aiAlarmValidations);\n  }\n}\n","module.exports = \"<div class=\\\"filter-container\\\">\\n  <div class=\\\"filter-config\\\">\\n    <span>{{'FILTER-GLOBAL.user_filter_select' | translate}}</span>\\n    <p-dropdown\\n      [options]=\\\"userFiltersAvailable\\\"\\n      [(ngModel)]=\\\"userFilterSelected\\\"\\n      optionLabel=\\\"name\\\"\\n      optionValue=\\\"id\\\"\\n      placeholder=\\\"{{'FILTER-GLOBAL.user_filter_select_placeholder' | translate}}\\\"\\n      name=\\\"user-filter\\\"\\n      (onChange)=\\\"changeSelectedFilter($event)\\\"\\n      [disabled]=\\\"!userFiltersAvailable.length\\\"\\n    ></p-dropdown>\\n  </div>\\n  <div class=\\\"filter-config-buttons\\\">\\n    <button\\n      (click)=\\\"changeFilter()\\\"\\n      [disabled]=\\\"!userFilterSelected\\\"\\n      class=\\\"filter-btn\\\"\\n    >\\n      <span style=\\\"color: white !important\\\"> {{'FILTER-GLOBAL.user_filter_select_apply' | translate}} </span>\\n    </button>\\n    <button\\n      (click)=\\\"filterAsDefault()\\\"\\n      [disabled]=\\\"!userFilterSelected\\\"\\n      class=\\\"filter-btn\\\"\\n      pTooltip=\\\"{{'FILTER-GLOBAL.user_filter_select_define_default' | translate}}\\\"\\n      tooltipPosition=\\\"left\\\"\\n    >\\n      <i class=\\\"ion-checkmark\\\" style=\\\"color: white !important\\\"></i>\\n    </button>\\n    <button\\n      (click)=\\\"deleteFilter()\\\"\\n      [disabled]=\\\"!userFilterSelected\\\"\\n      class=\\\"filter-btn\\\"\\n      tooltipPosition=\\\"left\\\"\\n      pTooltip=\\\"{{'FILTER-GLOBAL.user_filter_select_remove' | translate}}\\\"\\n    >\\n      <i class=\\\"ion-trash-a\\\" style=\\\"color: white !important\\\"></i>\\n    </button>\\n    <button\\n      (click)=\\\"create()\\\"\\n      class=\\\"filter-btn\\\"\\n      tooltipPosition=\\\"left\\\"\\n      pTooltip=\\\"{{'FILTER-GLOBAL.user_filter_select_create' | translate}}\\\"\\n    >\\n      <i\\n        class=\\\"{{ creating ? '