\n\nimport { Camera, PlaybackRoute, PlaybackVideo } from \"../../types\";\nimport { CameraOption } from \"./types\";\n\nimport { TranslateJsonService } from \"app/@core/data/translate-json.service\";\nimport { Subscription, combineLatest, of } from \"rxjs\";\nimport { switchMap } from \"rxjs/operators\";\nimport { PlaybackState } from \"../../shared/playback.state\";\nimport { Asset } from \"app/@core/models\";\n\n@Component({\n  selector: 'camera-selector',\n  templateUrl: './camera-selector.component.html',\n  styleUrls: [ './camera-selector.component.scss' ]\n})\nexport class CameraSelector implements OnInit, OnDestroy {\n  constructor(\n    private playbackState: PlaybackState,\n    private translateJsonService: TranslateJsonService,\n  ) {}\n\n  public options: CameraOption[] = [];\n  public videos: PlaybackVideo[];\n  private equipmentTypeId : number\n  private allChannels: string = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.all_channels') as string\n  private subsPlaybackData: Subscription;\n  private subsTimeIncrement: Subscription;\n  public isPlaybackScheduled: boolean = false;\n\n  public ngOnInit(): void {\n    this.initOptions();\n    this.initSubscriptions();\n  }\n\n  public ngOnDestroy(): void {\n    this.destroySubscriptions();\n  }\n\n  public onClickOption(option: CameraOption): void {\n    this.handleMultiSelection(option);\n}\n\nprivate handleMultiSelection(option: CameraOption): void {\n  option.isSelected = !option.isSelected;\n  \n  const selectedCameras = this.options\n    .filter(opt => opt.isSelected && !opt.isDisabled)\n    .map(opt => opt.value);\n  \n  this.playbackState.setSelectedCameras(selectedCameras);\n  this.playbackState.setMessage(\"PLAYBACK-PAGE.playback_routes_found\");\n\n  this.handleVideoSelection(selectedCameras);\n}\n\nprivate handleVideoSelection(selectedCameras: Camera[]): void {\n  if(this.playbackState.isUsingBaseIncrement(this.equipmentTypeId)) {\n    this.handleSinglePlayback(selectedCameras);\n  } else {\n    this.handleMultiplePlaybacks(selectedCameras);\n  }\n}\n\nprivate handleSinglePlayback(selectedCameras: Camera[]): void {\n  const closestPlayback = this.playbackState.getClosestPlayback();\n  if (!closestPlayback) return;\n  \n  const availableVideos = closestPlayback.videos\n      .filter(video => selectedCameras.some(camera => \n          camera.trim().toUpperCase() === video.channel.trim().toUpperCase()\n      ))\n      .slice(0, 5);\n\n  this.playbackState.setCurrentVideos(availableVideos);\n  this.playbackState.setCurrentPlayback(closestPlayback);\n}\n\nprivate handleMultiplePlaybacks(selectedCameras: Camera[]): void {\n  const closestPlayback = this.playbackState.getClosestPlayback();\n  if (!closestPlayback) return;\n\n  const availableVideos = closestPlayback.videos\n      .filter(video => selectedCameras.some(camera => \n          camera.trim().toUpperCase() === video.channel.trim().toUpperCase()\n      ))\n      .slice(0, 5);\n\n  this.playbackState.setCurrentVideos(availableVideos);\n  this.playbackState.setCurrentPlayback(closestPlayback);\n  this.playbackState.setDownloadAllVideos(true);\n}\n\nprivate updateOptionsSelection(predicate: (opt: CameraOption) => boolean): void {\n    this.options = this.options.map(opt => {\n        opt.isSelected = predicate(opt);\n        return opt;\n    });\n}\n\n\n\nprivate initOptions(): void {\n  \n  const allOptions = [\n    {\n      label: this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.opt_channel_1') as string,\n      value: \"FATIGUE\" as Camera,\n      icon: \"assets/videocam_off.png\",\n      isDisabled: true,\n      isSelected: true,\n    },\n    {\n      label: this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.opt_channel_2') as string,\n      value: \"FRONT\" as Camera,\n      icon: \"assets/videocam_off.png\",\n      isDisabled: true,\n      isSelected: false,\n    },\n    {\n      label: this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.opt_channel_5') as string,\n      value: \"INTERNAL\" as Camera,\n      icon: \"assets/videocam_off.png\",\n      isDisabled: true,\n      isSelected: false,\n    },\n    {\n      label: this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.opt_channel_3') as string,\n      value: \"SIDE-1\" as Camera,\n      icon: \"assets/videocam_off.png\",\n      isDisabled: true,\n      isSelected: false,\n    },\n    {\n      label: this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.opt_channel_4') as string,\n      value: \"SIDE-2\" as Camera,\n      icon: \"assets/videocam_off.png\",\n      isDisabled: true,\n      isSelected: false,\n    },\n  ];\n  this.options = allOptions;\n  \n  const selectedCameras = allOptions\n    .filter(option => option.isSelected === true)\n    .map(option => option.value);\n  \n  this.playbackState.setSelectedCameras(selectedCameras);\n}\n\n\n  private getAvailableCameras(equipmentType: number, playbackVideos: PlaybackVideo[]): CameraOption[] {\n    const options = [ ...this.options ];\n    const deviceCameras = this.getAvailableCamerasByDevice(equipmentType);\n\n    options.forEach(option => {\n      const isAvailable = deviceCameras.includes(option.value);\n      const hasVideo = this.isPlaybackScheduled ? true : !!playbackVideos.find(playback => playback.channel === option.value);\n\n      if (option.label === this.allChannels) {\n        const availableChannels = options\n          .filter(opt => deviceCameras.includes(opt.value) && !!playbackVideos.find(playback => playback.channel === opt.value))\n          .map(opt => opt.value);\n\n        option.isDisabled = availableChannels.length === 0;\n        option.icon = availableChannels.length > 0 ? \"assets/videocam.png\" : \"assets/videocam_off.png\";\n        option.value = availableChannels.join(\", \") as Camera;\n      } else {\n        if (isAvailable && hasVideo) {\n          option.isDisabled = false;\n          option.icon = \"assets/videocam.png\";\n        } else {\n          option.isDisabled = true;\n          option.icon = \"assets/videocam_off.png\";\n        }\n      }\n    });\n    \n    return options;\n}\n\n\n  private initSubscriptions(): void {\n\n    this.subsPlaybackData = combineLatest([\n      this.playbackState.getAsset(),\n      this.playbackState.getCurrentPlayback(),\n    ]).pipe(\n      switchMap(([ asset, playback ]: [Asset, PlaybackRoute]) => {\n        this.equipmentTypeId = asset.equipmentTypeId;\n        \n        if (!asset || !asset.equipmentTypeId) {\n          return of({ asset: asset, playback: playback, isScheduled: false });\n        }\n        return combineLatest([\n          of(asset),\n          of(playback),\n          this.playbackState.getEnablePlaybackScheduled(this.equipmentTypeId)\n        ]).pipe(\n          switchMap(([a, p, scheduled]) => {\n            return of({ asset: a, playback: p, isScheduled: scheduled });\n          })\n        );\n      })\n    ).subscribe((result: { asset: Asset, playback: PlaybackRoute, isScheduled: boolean }) => {\n      const asset = result.asset;\n      const playback = result.playback;\n      const isScheduled = result.isScheduled;\n      \n      if (!asset || !asset.equipmentTypeId) {\n        return;\n      }\n      this.isPlaybackScheduled = isScheduled;\n      \n      if (playback && playback.videos) {\n        this.videos = playback.videos;\n      } else {\n        this.videos = [];\n      }\n\n      this.options = this.getAvailableCameras(asset.equipmentTypeId, this.videos);\n      const selectedCameras = this.options\n        .filter(option => option.isSelected === true)\n        .map(option => option.value);\n      \n      if (selectedCameras.length > 0) {\n        this.playbackState.setSelectedCameras(selectedCameras);\n      } else {\n        const fatigueCamera = this.options.find(opt => opt.value === 'FATIGUE');\n        if (fatigueCamera && !fatigueCamera.isDisabled) {\n          fatigueCamera.isSelected = true;\n          this.playbackState.setSelectedCameras(['FATIGUE']);\n        }\n      }\n    });\n    \n    this.subsTimeIncrement = this.playbackState.getSelectedTimeIncrement().subscribe((newTimeIncrement) => {\n      const cursorDate = this.playbackState.getCursorDate();\n      if (!cursorDate) return;\n      \n      const selectedCameras = this.playbackState.getSelectedCamerasValue();\n      if (selectedCameras.length === 0) return;\n      \n      this.handleVideoSelection(selectedCameras);\n    });\n  }\n\n  private destroySubscriptions(): void {\n    if (this.subsPlaybackData) this.subsPlaybackData.unsubscribe();\n    if (this.subsTimeIncrement) this.subsTimeIncrement.unsubscribe();\n  }\n\n  private getAvailableCamerasByDevice(equipmentType: number): Camera[] {\n    switch(equipmentType) {\n      case EquipamentType.STONKAM: \n      case EquipamentType.STONKAM_K1_PLUS:\n      case EquipamentType.STONKAM_K4: \n        return this.getStonkamCameras();\n\n      case EquipamentType.JIMI:\n      case EquipamentType.JIMI_V6:\n        return this.getJimi400Cameras();\n\n      case EquipamentType.JIMI_G5_PLUS:\n      case EquipamentType.JIMI_JC400AD_ID:\n      case EquipamentType.JIMI_JC400D_R:\n        return this.getJimi400PlusCameras();\n\n      case EquipamentType.JIMI_G7: \n        return this.getJimi450Cameras();\n    }\n\n    return [];\n  }\n\n  private getStonkamCameras(): Camera[] {\n    return [ 'FATIGUE', 'FRONT', 'INTERNAL', 'SIDE-1', 'SIDE-2' ];\n  }\n\n  private getJimi400Cameras(): Camera[] {\n    return [ 'FRONT' ];\n  }\n\n  private getJimi400PlusCameras(): Camera[] {\n    return [ 'FATIGUE', 'FRONT' ];\n  }\n\n  private getJimi450Cameras(): Camera[] {\n    return [ 'FATIGUE', 'FRONT', 'INTERNAL', 'SIDE-1', 'SIDE-2' ];\n  }\n}","module.exports = \"<nb-card class=\\\"padding-default\\\">\\n    <div style=\\\"\\n      display: flex;\\n      flex-direction: row;\\n      justify-content: space-between;\\n      margin-bottom: 1%;\\n    \\\">\\n        <nb-card-header>\\n            <h1>{{ \\\"PLAYBACK-PAGE.event_mosaic\\