ilteredCount = currentCount;\n\n        this.dt1.filteredValue = this.addTableVehiclesWithBlankData(this.dt1.filteredValue)\n      }\n    }\n  }\n\n  private addTableVehiclesWithBlankData(vehicles?: Asset[]): Asset[] {\n    let filled = Array.isArray(vehicles) && vehicles.length > 0 ? [...vehicles] : [...this.allVehicles];\n\n    const total = filled.length;\n    const rowsPerPage = this.rowsPerPage; \n\n    const resto = total % rowsPerPage;\n\n    let placeholdersToAdd = total === 0 \n      ? this.rowsPerPage \n      : resto === 0 ? 0 : rowsPerPage - resto;\n\n    const placeholders = Array.from({ length: placeholdersToAdd }, (_, i) => ({\n      id: 0, name: '', identification: '', imei: '', equipmentType: '', isOnline: false, \n    }));\n\n    return [...filled, ...placeholders];\n  }\n\n\n  private loadCustomers(): void {\n    this.setLoading(\"customersInput\", true);\n\n    let customersIdPermissions =\n      this.dataService.getCustomersIdFromPermissions();\n\n    this.customerShared\n      .loadCustomersToTreeInput(customersIdPermissions)\n      .then((result) => {\n        this.customers = result;\n        this.setLoading(\"customersInput\", false);\n      })\n      .catch((err) => {\n        this.setLoading(\"customersInput\", false);\n      });\n  }\n\n  public changedCustomers(selectedCustomers: number[]) {\n    this.dt1.reset();\n    this.selectCustomers = selectedCustomers;\n\n    if (selectedCustomers.length === 0) {\n      this.allVehicles = [];\n      this.cleanCheckboxes();\n    } else {\n      this.setLoading(\"vehiclesTable\", true);\n      this.getVehicles();\n    }\n\n    this.allVehicles = this.addTableVehiclesWithBlankData()\n  }\n\n  public getVehicles() {\n    this.setLoading(\"vehiclesTable\", true);\n\n    if (this.selectCustomers && this.selectCustomers.length > 0) {\n      this.loadVehicles(this.selectCustomers)\n        .then((result) => {\n          this.allVehicles = result\n            .sort((x, y) => (x.isOnline ? -1 : 1));\n\n          if (this.isStreamingPage) {\n            this.allVehicles = this.allVehicles.filter(vehicle => vehicle.equipmentType != \"G3\")\n          }\n\n           this.allVehicles = this.addTableVehiclesWithBlankData()\n\n          this.setLoading(\"vehiclesTable\", false);\n        })\n        .catch((error) => {\n          this.setLoading(\"vehiclesTable\", false);\n        });\n    } else {\n      this.setLoading(\"vehiclesTable\", false);\n    }\n  }\n\n  public cleanCheckboxes() {\n    this.selectedVehicles = [];\n  }\n\n  public openCams(): void {\n    this.vehicles.emit(this.selectedVehicles);\n  }\n\n  private async loadVehicles(selectedCustomers: number[]): Promise<Asset[]> {\n    return this.vehicleShared.fetchAssetOnlineStatusByCustomersChildIdAndAssetType(\n      selectedCustomers, [EquipamentFeatures.STREAMING]\n    );\n  }\n\n  private setLoading(element: string, loading: boolean): void {\n    let loader = this.loaders.find((loader) => loader.element == element);\n\n    if (loader) {\n      loader.loading = loading;\n    }\n  }\n\n  public getLoading(element: string): boolean {\n    let loader = this.loaders.find((loader) => loader.element == element);\n\n    return loader ? loader.loading : true;\n  }\n\n\n  public onVehicleSelected(event: any): void {\n    const selected = event.data;\n    const selectedId = selected.id;\n    const alreadyChecked = this.selectedVehicles.some(\n      v => v.id === selectedId && v.imei !== selected.imei\n    );\n  \n    if (alreadyChecked) {\n      this.selectedVehicles = this.selectedVehicles.filter(\n        v => v.id !== selectedId || v.imei === selected.imei\n      );\n      setTimeout(() => {\n        this.dt1.selection = this.selectedVehicles;\n      }, 0);\n    }\n  }\n  \n  \n  \n  public onVehicleUnselected(event: any): void {\n    const unselected = event.data;\n    this.selectedVehicles = this.selectedVehicles.filter(v => v.imei !== unselected.imei);\n  }\n  \n  public isOtherSelected(vehicle: Asset): boolean 