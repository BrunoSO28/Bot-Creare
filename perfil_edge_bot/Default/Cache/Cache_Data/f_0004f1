e].mapObjects[_objId];\n      if(_mapObj !== undefined) {\n        if(_visible === true) {\n          if(!this.layerDict[_layerName].drawnItems.hasLayer(_mapObj)) {\n            this.layerDict[_layerName].drawnItems.addLayer(_mapObj);\n          }\n        } else {\n          if(this.layerDict[_layerName].drawnItems.hasLayer(_mapObj)) {\n            this.layerDict[_layerName].drawnItems.removeLayer(_mapObj);\n          }\n        }\n      }\n    };\n\n  public clearRoute()  {\n    //this.setVisibilityOfAllObjectsInLayer('MAP_ROUTE_LAYER', false);\n    this.destroyLayer('MAP_ROUTE_LAYER');\n  }\n\n  public clearHeat()  {\n    this.destroyLayer('MAP_HEAT_LAYER');\n  }\n\n\n  public checkInterval() {\n    let today: Date = new Date()\n      , today24hLast: Date = new Date();\n\n    \n      today24hLast.setHours(today.getHours() - 10*24);    \n\n     if (!this.filterSelectedData.selectedDateEnd || !this.filterSelectedData.selectedDateStart) {\n        this.filterSelectedData.selectedDateStart = today24hLast;\n        this.filterSelectedData.selectedDateEnd = today;\n     }\n\n  }\n\n  public getFilterAlarms(): FilterAlarms {\n    let today: Date = new Date()\n      , today24hLast: Date = new Date();\n      today24hLast.setHours(today.getHours() - 10*24);    \n\n    let _filterData: FilterAlarms = new FilterAlarms();    \n    _filterData.selectedDateStart = today24hLast;\n    _filterData.selectedDateEnd = today;\n\n    let kp: Workspace  = this.dataService.getWorkspace();\n    if (kp) {\n      //_filterData.selectedCustomers = kp.userCustomerChildIds;  \n    }\n    \n    \n    return _filterData;\n  }\n\n  private buildFilter(filter: FilterAlarms): DefaultFilter {\n    let defaultFilter = new DefaultFilter();\n    defaultFilter.custIds = filter.selectedCustomers;\n    defaultFilter.date1 = this.configService.convertDateToIsoString(filter.selectedDateStart);\n    defaultFilter.date2 = this.configService.convertDateToIsoString(filter.selectedDateEnd);\n    defaultFilter.al