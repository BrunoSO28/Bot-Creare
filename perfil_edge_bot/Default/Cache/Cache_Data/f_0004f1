,\n          hasVideo: true,\n        }, {\n          seekType: 'param',\n        });\n  \n        newPlayer.on(FlvJs.Events.ERROR, (errorType, errorDetail, errorInfo) => {\n          this.playbackState.setIsLoading(false);\n          this.playbackState.setMessage('PLAYBACK-PAGE.loading_playback_error');\n        });\n  \n        newPlayer.on(FlvJs.Events.METADATA_ARRIVED, () => {\n          this.playbackState.setMessage(null);\n          this.playbackState.setIsLoading(false);\n          this.addWatermark(index)\n        })\n        newPlayer.attachMediaElement(videoElement);\n        newPlayer.load();\n        const playPromise = videoElement.play();\n        \n        if (playPromise !== undefined) {\n          playPromise.then(() => {\n          }).catch((error) => {\n          });\n        }\n  \n        this.videoPlayersFlv.push(newPlayer);\n      } else {\n      }\n    }\n  }\n\n\nprivate addWatermark(index: number) {\n  const factory = this.componentFactoryResolver.resolveComponentFactory(MediaWatermarkComponent);\n  this.watermarkComponentRef = this.watermarkContainer.createComponent(factory);\n  this.watermarkComponentRef.instance.isFullscreen = this.isFullScreen;\n  this.watermarkComponentRef.instance.isPicture = false;\n  this.watermarkComponentRef.instance.mediaPlates = this.asset.name\n  this.watermarkComponentRef.instance.mediaPrefix = this.asset.identification\n  const videoContainer = document.getElementById(`video-container-${index}`);\n  if (videoContainer) {\n  const watermarkEl = this.watermarkComponentRef.location.nativeElement;\n  videoContainer.appendChild(watermarkEl);\n  } \n}\n  private updateChannelTag(camera?: Camera): void {\n    if (camera === undefined) {\n      this.channelTag = \"\";\n\n      return;\n    }\n\n    const translationKey = {\n      'FATIGUE': 'channel_1',\n      'FRONT': 'channel_2',\n      'INTERNAL': 'channel_5',\n      'SIDE-1': 'channel_3',\n      'SIDE-2': 'channel_4',\n    }[camera];\n\n    this.channelTag = this