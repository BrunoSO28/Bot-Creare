ts/warn.png',\n      error: 'assets/error.png',\n      info: 'assets/loader.png',\n    }[status];\n\n    this.messageService.add({\n      key: 'video',\n      severity: status,\n      summary: this.translateJsonService.getTranslateSubs(title),\n      detail: this.translateJsonService.getTranslateSubs(message),\n      life: 5000,\n      closable: false,\n      data: {\n        icon,\n        isLoading: status === 'info'\n      }\n    });\n  }\n\n  public cancelDownload(task) {\n    const button = (event.target as HTMLElement).closest('button'); \n    if (button) {\n      button.classList.add('clicked');\n      setTimeout(() => {\n        button.classList.remove('clicked');\n        this.playbackService.cancelRemoteTasksRequest(task.taskId).subscribe(_ => { \n          task.taskStatusId = TaskStatus.Cancelada; \n        });\n      }, 1000); \n    }\n  }\n\n  private buildExpirationLimitOptions(){\n    this.playbackState.getAsset().subscribe(value => this.selectedAsset = value);\n    this.playbackState.getSelectedCustomerChilds().subscribe(value => this.selectedCustomerChild = value.find((item) => item.id == this.selectedAsset.customerChildId))\n    \n    this.expirationOptions = [\n      { label: '1h', value: 1 },\n      { label: '6h', value: 6 },\n      { label: this.translateJsonService.getTranslateSubs(\"PLAYBACK-PAGE.no_expiration\"), value: 0 }\n    ];\n    \n    const configurations = this.selectedCustomerChild.configurations ? this.selectedCustomerChild.configurations : null;\n    if (configurations && \n      'playbackTaskDefaultExpirationLimit' in configurations && \n      configurations.playbackTaskDefaultExpirationLimit !== null) {\n        this.selectedExpirationLimit = configurations.playbackTaskDefaultExpirationLimit;\n    } else {\n        this.selectedExpirationLimit = 1; \n    }\n  }\n\n  private getExpirationLimit() {\n    const currentDatetime = new Date();\n    const expirationDatetime = new Date(currentDatetime);\n    expirationDatetime.setHours(e