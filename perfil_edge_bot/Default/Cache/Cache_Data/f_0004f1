e() - 3000000), endDate: now };\n\n        return period;\n    }\n\n    private startVerifyAssetStatus(assetId: number) {\n        clearInterval(this.checkerAssetStatus);\n        this.checkerAssetStatus = setInterval(() => this.verifyAssetStatus(assetId), 30000);\n        this.verifyAssetStatus(assetId);\n    }\n\n    private verifyAssetStatus(assetId: number): void {\n        this.assetService.checkOnlineStatusByAssetId(assetId, this.deviceId).subscribe((asset)=>{\n            this.pageLoading = false;\n            this.deviceIsOnline= asset.isOnline;\n            this.asset = asset;\n        },(e)=>{\n            this.pageLoading = false;\n        })\n    }\n\n    private startVerifyPlaybackFiles(deviceId: string, startDate: Date, endDate: Date, deviceTypeId: number): void {\n        clearInterval(this.checkerPlaybackFiles);\n        this.checkerPlaybackFiles = setInterval(() => this.getPlaybackFiles(deviceId, startDate, endDate, deviceTypeId), 30000)\n        this.getPlaybackFiles(deviceId, startDate, endDate, deviceTypeId);\n    }\n\n    private getPlaybackFiles(deviceId: string, startDate: Date, endDate: Date, deviceTypeId: number): void {\n        this.playbackService\n            .getFileList(deviceId, startDate, endDate, deviceTypeId)\n            .then(result => {\n                const tasks = result.availablePlaybackTasks || []\n                const filteredTasks = tasks.filter(\n                    (task: any) => ![2, 3, 4].includes(task.taskStatusId)\n                );\n                this.pendingPlaybackTasks = filteredTasks.length;\n                this.playback_media = result.availablePlaybackTasks;\n                this.setColumn();\n                this.formatColumns(); \n            })\n            .catch(err => {\n                console.log(err);\n                this.notificationService.printErrorMessage(this.translateJsonService.getTranslateSubs('PLAYBACK-PAG.error_consult'));\n            })\n    }\n\n    private setColumn() {\n        if ((this.deviceTypeId === EquipamentType.STONKAM || this.deviceTypeId === EquipamentType.STONKAM_K1_PLUS || this.deviceTypeId === EquipamentType.STONKAM_K4) && !this.cols.find(col => col.field === \"alarmNames\")) {\n            if (this.cols.find(col => {return col.field === \"fileName\"})) {\n                this.cols.splice(2, 1);\n            }\n            this.cols.splice(2, 0, { field: 'alarmNames', header: this.translateJsonService.getTranslateSubs('GLOBAL.alert_1'), width: '190px'});\n        }\n    }\n\n    private formatColumns() {\n        if (this.deviceTypeId === EquipamentType.STONKAM || this.deviceTypeId === EquipamentType.STONKAM_K1_PLUS || this.deviceTypeId === EquipamentType.STONKAM_K4) {\n            this.playback_media.forEach(p =>  {\n                p.channelName = this.deviceTypeId === EquipamentType.STONKAM_K4\n                ? this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_' + this.playbackService.getKdashCorrectChannel(p.channelId))\n                : this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_' + p.channelId);\n                p.alarmNames = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.alarm_type_'+ p.alarmType);\n                p.fileSize = this.playbackService.formatMediaSize(p.fileSize) + \" MB\";\n                p.duration = this.playbackService.formatDuration(p.duration);\n                p.playbackMode = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.' + p.playbackMode);\n            });\n        } else if (this.deviceTypeId === EquipamentType.JIMI || this.deviceTypeId === EquipamentType.JIMI_V6) {\n            this.playback_media.forEach(p =>  {\n                p.channelName = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_2');\n                p.playbackMode = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.' + p.playbackMode);\n                p.duration = this.playbackService.formatDuration(\"59000\");\n\n                if (p.fileSize) {\n                    p.fileSize = this.playbackService.formatMediaSize(p.fileSize) + \" MB\";\n                }\n            });\n        } else if (this.deviceTypeId === EquipamentType.JIMI_G5_PLUS || this.deviceTypeId === EquipamentType.JIMI_JC400AD_ID || this.deviceTypeId === EquipamentType.JIMI_JC400D_R) {\n            this.playback_media.forEach(p =>  {\n                p.channelName = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_'+ this.playbackService.getG5PlusCorrectChannel(p.channelId));\n                p.playbackMode = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.' + p.playbackMode);\n                p.duration = this.playbackService.formatDuration(\"59000\");\n\n                if (p.fileSize) {\n                    p.fileSize = this.playbackService.formatMediaSize(p.fileSize) + \" MB\";\n                }\n            });\n        } else if (this.deviceTypeId === EquipamentType.JIMI_G7) {\n            this.playback_media.forEach(p =>  {\n                p.channelName = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_' + this.playbackService.getG7CorrectChannel(p.channelId));\n                p.playbackMode = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.' + p.playbackMode);\n                p.duration = this.playbackService.formatDuration(\"59000\");\n\n                if (p.fileSize) {\n                    p.fileSize = this.playbackService.formatMediaSize(p.fileSize) + \" MB\";\n                }\n            });\n        }\n    }\n\n    search() {\n        this.startVerifyPlaybackFiles(this.deviceId, this.startDate, this.endDate, this.deviceTypeId);\n\n        localStorage.setItem(`PLBPERDEV${this.deviceId}`, JSON.stringify({ startDate: this.filterSelectedData.selectedDateStart, endDate: this.filterSelectedData.selectedDateEnd }));\n    }\n\n    private setStatusChange(playback: Playback) {\n        this.playback_media.forEach(media => {\n            if (media.playbackModeId === p