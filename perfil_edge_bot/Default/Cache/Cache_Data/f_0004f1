ength > 0){\n            faceMatches.forEach(faceMatch => {\n\n              this.faceRecogOptions.push({\n                metaId: faceMatch.face.people.peopleMetaId,\n                driverName: faceMatch.face.people.peopleName,\n                image: faceMatch.face.image.imageURL,\n                similarity: faceMatch.face.similarity,\n                selected: false,\n              });\n\n            })\n          }\n\n          this.tryRecognize = true;\n          this.faceRecogState.setUpdating(false);\n        }, err => {\n          this.notificationService.printErrorMessage(err);\n          this.faceRecogState.setUpdating(false);\n        })\n    });\n  }\n\n\n  dataURItoBlob(dataURI) {\n    var imageData = dataURI.toString();\n    var byteCharacters = atob(imageData.replace(/^data:image\\/(png|jpeg|jpg);base64,/, ''));\n    var byteNumbers = new Array(byteCharacters.length);\n\n    for (var i = 0; i < byteCharacters.length; i++) {\n      byteNumbers[i] = byteCharacters.charCodeAt(i);\n    }\n\n    var byteArray = new Uint8Array(byteNumbers);\n    return new Blob([ byteArray ], {\n      type : 'png'\n    });\n  }\n}\n","module.exports = \"<div class=\\\"row\\\">\\n  <div class=\\\"col-md-12 treat\\\">\\n    <div class=\\\"treat__header\\\">\\n      <h1>{{ 'TREATMENT-MODAL.header_treatment' | translate }}</h1>\\n      <h2 *ngIf=\\\"alarmReadByUsername\\\"> [ {{ 'PAGE-PORTAL.seen_by' | translate }} {{ alarmReadByUsername }} ]</h2>\\n    </div>\\n    <div class=\\\"treat__steps\\\" *ngIf=\\\"(step$ | async) !== 4\\\">\\n      <ul>\\n        <li [ngClass]=\\\"{'actived': (step$ | async) == 1, 'disabled': (step$ | async) > 1}\\\">\\n          <span class=\\\"icon\\\">\\n            <img src=\\\"assets/icon-alarm.svg\\\" />\\n          </span>\\n          <p>{{ 'GLOBAL.alert' | translate }}</p>\\n        </li>\\n        <li *ngIf=\\\"!devicesWithoutMedia.includes((alarms$ | async)[0]?.equipmentTypeId)\\\"\\n          [ngClass]=\\\"{'actived': (step$ | async) == 2