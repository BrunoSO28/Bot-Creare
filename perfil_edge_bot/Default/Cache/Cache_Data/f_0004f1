tInBatch()\n\n        this.alarmsInformationGroupedByRisk = this.groupItemsByFields(alarmsToTreatmentInBatch, ['groupRisk'])\n    }\n\n    public treatmentAlarmsInBatch(alarms: Array<Alarm>) {\n        this.commentTreatmentInBatch = this.commentTreatmentInBatch.trim();\n\n        if (!this.commentTreatmentInBatch || this.commentTreatmentInBatch.length < this.minSizecommentTreatmentInBatch\n            || this.commentTreatmentInBatch.length > this.maxSizecommentTreatmentInBatch) {\n            this.messageService.add(\n                {\n                    severity: 'info',\n                    summary: this.translateJsonService.getTranslateSubs('TREATMENT-ALARMS-IN-BATCH.invalid-field'),\n                    detail: this.translateJsonService.getTranslateSubs('TREATMENT-ALARMS-IN-BATCH.invalid-comments-field')\n                        .replace(\"##MIN##\", this.minSizecommentTreatmentInBatch)\n                        .replace(\"##MAX##\", this.maxSizecommentTreatmentInBatch),\n                    key: 'toastDialogTreatmentInBatch'\n                })\n            return\n        }\n\n        this.isLoadingTreatmentInBatch = true\n\n        const alarmsByGroups = this.groupItemsByFields(this.getAlarmsToTreatmentInBatch(), ['vehicle_plates', 'vehicle_prefix', 'type', 'groupRisk'])\n\n        let audits: Array<Audit> = []\n\n        for (let vehiclePlates in alarmsByGroups) {\n            let byVehiclePlates = alarmsByGroups[vehiclePlates]\n            for (let vehiclePrefix in byVehiclePlates) {\n                let byVehiclePrefix = byVehiclePlates[vehiclePrefix]\n                for (let type in byVehiclePrefix) {\n                    let byType = byVehiclePrefix[type]\n                    for (let groupRisk in byType) {\n                        let alarms: Array<Alarm> = byType[groupRisk]\n                        let audit = new Audit()\n                        audit.alarms = alarms\n                        audit.groupRisk = parseInt(groupRisk)\n                        audit.createDate = new Date()\n                        audit.createDateLocal = moment().format('YYYY-MM-DDTHH:mm:ss.SSS')\n                        audit.timeZoneTreatment = this.getTimezoneTreatment()\n                        audits.push(audit)\n                    }\n                }\n            }\n        }\n\n        this.treatmentFlowService.createAuditsInBatch(audits, this.commentTreatmentInBatch)\n            .then(savedAudit => {\n                this.display = false\n                this.messageService.add(\n                    {\n                        severity: 'success',\n                        summary: this.translateJsonService.getTranslateSubs('TREATMENT-ALARMS-IN-BATCH.success'),\n                        detail: this.translateJsonService.getTranslateSubs('TREATMENT-ALARMS-IN-BATCH.success-treatment'),\n                        key: 'toastTreatmentInBatch',\n                        sticky: true\n                    })\n                this.clearAlarmIdsBatchTreatmentList()\n                this.closeModalTreatmentInBatch()\n                this.requestAlarmData(true)\n            })\n            .catch(err => {\n                this.messageService.add(\n                    {\n                        severity: 'error',\n                        summary: this.translateJsonService.getTranslateSubs('TREATMENT-ALARMS-IN-BATCH.error'),\n                        detail: this.translateJsonService.getTranslateSubs('TREATMENT-ALARMS-IN-BATCH.error-treatment'),\n                        key: 'toastDialogTreatmentInBatch',\n                        sticky: true\n                    })\n\n                this.isLoadingTreatmentInBatch = false\n            })\n\n    }\n\n    private groupItemsByFields(array: Array<any>, groupBy: Array<string>) {\n\n        let groupedItems: any = {}\n\n        array.forEach((item) => {\n            groupBy.reduce((previousValue, currentValue, currentIndex) => {\n                previousValue[item[currentValue]] = previousValue[item[currentValue]] || (currentIndex + 1 === groupBy.length ? [] : {})\n                return previousValue[item[currentValue]]\n            }, groupedItems).push(item)\n        });\n\n        return groupedItems\n    }\n\n    private getAlarmsToTreatmentInBatch() {\n        return this.alerts.filter(\n            (alert) => this.alarmIdsBatchTreatmentList.find((alarmIdBatchTreatment) => alarmIdBatchTreatment == alert.id)\n        )\n    }\n\n    private closeModalTreatmentInBatch() {\n        this.commentTreatmentInBatch = ''\n        this.isLoadingTreatmentInBatch = false\n    }\n\n    private clearAlarmIdsBatchTreatmentList() {\n        this.alarmIdsBatchTreatmentList = []\n    }\n\n    private getTimezoneTreatment(): string {\n        try {\n            return this.dataService.getBrowserTimezoneOffset() || \"-03:00\";\n        } catch (error) {\n            console.warn('Erro ao obter timezone, usando padrão -03:00', error);\n            return \"-03:00\";\n        }\n    }\n\n    private calcDateParameter(alarmDate: Date): string {\n        return moment(alarmDate).subtract(5, \"minutes\").format();\n    }\n\n    private changeOnlineState() {\n        this.workspaceService.getBotaoOnline$()\n            .subscribe((isOnline) => {\n                this.isOnlineChecked = isOnline;\n            });\n    }\n\n    public changeOnline(online: boolean = false) {\n        this.isOnlineChecked = online;\n\n        if (online) {\n            this.requestAlarmData(true);\n        }\n\n        if (!online) {\n            this.unsubscribeData();\n        }\n    }\n\n    private getCustomerIdUser() {\n        this.customerIdByWorkspace = this.dataService.getWorkspace().customerProfileId;\n\n        this.childIdByWorkspace = this.dataService.getWorkspace().currentUser.customerChild;\n    }\n\n    private updateRequestInProgress(value: boolean) {\n        this.requestInProgress.emit(value);\n        this.disableOnlineButton = value;\n    }\n\n\n    private parseTimestampToDate(value: string, timeZone?: string): Date | null {\n        if (!value || typeof value !== 'string') return null;\n        const trimmed = value.trim();\n        let d: Date = null;\n        if (trimmed.indexOf('T') >= 0 || trimmed.indexOf('Z') >= 0) {\n            d = new Date(trimmed);\n        } else {\n            const withSpace = trimmed.match(/^(\\d{4}-\\d{2}-\\d{2})\\s+(\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?)\\s+([+-])(\\d{2})(\\d{2})$/);\n            const noSpace = trimmed.match(/^(\\d{4}-\\d{2}-\\d{2})\\s+(\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?)([+-])(\\d{2})(\\d{2})$/);\n            const match = withSpace || noSpace;\n            if (match) {\n                const [, datePart, timePart, sign, hh, mm] = match;\n                const isoString = `${datePart}T${timePart}${sign}${hh}:${mm}`;\n                d = new Date(isoString);\n            } else {\n                const noOffset = trimmed.match(/^(\\d{4}-\\d{2}-\\d{2})\\s+(\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?)$/);\n                if (noOffset && timeZone) {\n                    const [, datePart, timePart] = noOffset;\n                    const normalized = this.dataService.normalizeTimezone(timeZone);\n                    if (normalized && normalized.match(/^[+-]\\d{2}:\\d{2}$/)) {\n                        const isoString = `${datePart}T${timePart}${normalized}`;\n                        d = new Date(isoString);\n                    }\n                }\n                if (d == null || isNaN(d.getTime())) {\n                    d = new Date(trimmed);\n                }\n            }\n        }\n        return d != null && !isNaN(d.getTime()) ? d : null;\n    }\n\n    private updateAlarmsWithDelayAndTimeRead(alarms: Alarm[]): Alarm[] {\n        const browserDifferentFromMinus3 = this.dataService.getBrowserTimezoneOffset() !== '-03:00';\n\n        return alarms.map(alarm => {\n            if (alarm.timeZone === '0') {\n                alarm.timeZone = '+00:00';\n            }\n            const normalizedTimezone = this.dataService.normalizeTimezone(alarm.timeZone || '-03:00');\n            const isDifferentFromMicroserviceOffset = normalizedTimezone !== '-03:00';\n\n            const rawDatetimeStr = typeof alarm.datetime === 'string' ? alarm.datetime : ((alarm as any).datetimestamp != null && typeof (alarm as any).datetimestamp === 'string' ? (alarm as any).datetimestamp : null);\n            const rawAvailableMediaAtStr = typeof alarm.availableMediaAt === 'string' ? alarm.availableMediaAt : ((alarm as any).availableMediaAtTimestamp != null && typeof (alarm as any).availableMediaAtTimestamp === 'string' ? (alarm as any).availableMediaAtTimestamp : null);\n\n            if (isDifferentFromMicroserviceOffset) {\n                if (alarm.datetime) {\n                    alarm.datetime = this.dataService.undoMicroserviceGmt3(alarm.datetime.toString());\n                }\n                if (alarm.availableMediaAt) {\n                    alarm.availableMediaAt = this.dataService.undoMicroserviceGmt3(alarm.availableMediaAt.toString());\n                }\n            } else {\n                if (alarm.datetime && alarm.timeZone) {\n                    alarm.datetime = this.dataService.convertToAlarmTimezone(alarm.datetime.toString(), alarm.timeZone);\n                }\n                if (alarm.availableMediaAt && alarm.timeZone) {\n                    alarm.availableMediaAt = this.dataService.convertToAlarmTimezone(alarm.availableMediaAt.toString(), alarm.timeZone);\n                }\n            }\n\n            alarm['_timezoneDifferent'] = this.dataService.isTimezoneDifferent(alarm.timeZone);\n            alarm['_showAvailableMediaAtTooltip'] = browserDifferentFromMinus3;\n\n            let tooltipDatetimeStr: string = null;\n            if (rawDatetimeStr && alarm['_timezoneDifferent']) {\n                tooltipDatetimeStr = this.dataService.formatRawDateTimeForTooltip(rawDatetimeStr);\n                if (tooltipDatetimeStr) (alarm as any)._tooltipDatetime = `${tooltipDatetimeStr} (${normalizedTimezone})`;\n            }\n\n            let tooltipAvailableMediaAtStr: string = null;\n            if (rawAvailableMediaAtStr && browserDifferentFromMinus3) {\n                tooltipAvailableMediaAtStr = this.dataService.formatRawDateTimeForTooltip(rawAvailableMediaAtStr);\n                if (tooltipAvailableMediaAtStr) (alarm as any)._tooltipAvailableMediaAt = `${tooltipAvailableMediaAtStr} (-03:00)`;\n            }\n\n            const dateNow = new Date();\n            const dateAlarm = new Date(alarm.datetime);\n            const availableMediaAt = new Date(alarm.availableMediaAt ? alarm.availableMediaAt : alarm.insertDate);\n            const timeRead = this.dataService.diff(availableMediaAt, dateNow);\n            const delayDate = (this.dataService.diff(dateAlarm, availableMediaAt)).includes('-') ? \"0h 00m 00s\" : this.dataService.diff(dateAlarm, availableMediaAt);\n            return {\n                ...alarm,\n                timeZone: alarm.timeZone,\n                delayDate: delayDate,\n                timeRead: timeRead\n            };\n        });\n    }\n\n    private applyFastPathAlarmDates(alarm: Alarm, datetimestampFormatted: string, availableMediaAtFormatted: string): Alarm {\n        if (alarm.timeZone === '0') {\n            alarm.timeZone = '+00:00';\n        }\n        const normalizedTimezone = this.dataService.normalizeTimezone(alarm.timeZone || '-03:00');\n        alarm['_timezoneDifferent'] = this.dataService.isTimezoneDifferent(alarm.timeZone);\n\n        const tooltipDatetimeStr = this.formatBackendFormattedDate(datetimestampFormatted);\n        if (tooltipDatetimeStr && normalizedTimezone && alarm['_timezoneDifferent']) alarm._tooltipDatetime = `${tooltipDatetimeStr} (${normalizedTimezone})`;\n        const tooltipAvailableMediaAtStr = this.formatBackendFormattedDate(availableMediaAtFormatted);\n        if (tooltipAvailableMediaAtStr && normalizedTimezone) alarm._tooltipAvailableMediaAt = `${tooltipAvailableMediaAtStr} (${normalizedTimezone})`;\n\n        const datetimestamp = alarm.datetimestamp != null ? alarm.datetimestamp : (alarm as any)['datetimestamp'];\n        const availableMediaAtTimestamp = alarm.availableMediaAtTimestamp != null ? alarm.availableMediaAtTimestamp : (alarm as any)['available_media_at_timestamp'];\n\n        alarm.datetime = this.epochOrDateToDate(datetimestamp) || alarm.datetime;\n        alarm.availableMediaAt = this.epochOrDateToDate(availableMediaAtTimestamp) || alarm.availableMediaAt || alarm.insertDate;\n\n        const dateNow = new Date();\n        const dateAlarm = new Date(alarm.datetime);\n        const availableMediaAt = new Date(alarm.availableMediaAt ? alarm.availableMediaAt : alarm.insertDate);\n        const timeRead = this.dataService.diff(availableMediaAt, dateNow);\n        const delayDate = (this.dataService.diff(dateAlarm, availableMediaAt)).includes('-') ? \"0h 00m 00s\" : this.dataService.diff(dateAlarm, availableMediaAt);\n\n        const result = { ...alarm, timeZone: alarm.timeZone, delayDate, timeRead };\n        if (datetimestamp != null) result.datetimestamp = datetimestamp;\n        if (availableMediaAtTimestamp != null) result.availableMediaAtTimestamp = availableMediaAtTimestamp;\n        return result;\n    }\n\n    private epochOrDateToDate(value: number | Date | string | null | undefined): Date | null {\n        if (value == null) return null;\n        if (value instanceof Date) return isNaN(value.getTime()) ? null : value;\n        if (typeof value === 'number') {\n            const d = new Date(value);\n            return isNaN(d.getTime()) ? null : d;\n        }\n        const d = new Date(value as string);\n        return isNaN(d.getTime()) ? null : d;\n    }\n\n    private applyHeavyPathAlarmDates(alarm: Alarm): Alarm {\n        if (alarm.timeZone === '0') {\n            alarm.timeZone = '+00:00';\n        }\n        const normalizedTimezone = this.dataService.normalizeTimezone(alarm.timeZone ||