ode) {\n            if (_mode == 'off') {\n              this.layerDict[_layerName].drawnItems.disableClustering();\n            } else {\n              this.layerDict[_layerName].drawnItems.enableClustering();\n            }\n          };\n          \n          if (!_options.clusterInitialState) {\n            _clusterInitialState = 'off';\n            this.layerDict[_layerName].drawnItems.disableClustering();\n          } \n          var buttonOptions = {onText: 'Desagrupar', offText: 'Agrupar', initialState: _clusterInitialState, buttonAction: changeClustering};\n          this.mapControlLayer.addOverlayWithButton(this.layerDict[_layerName].drawnItems, _options.title, buttonOptions);\n          \n        } else {\n          this.mapControlLayer.addOverlay(this.layerDict[_layerName].drawnItems, _options.title);\n          this.layerDict[_layerName].visibleCallBack = _options.visibleCallBack;\n        }\n      }\n    };  \n\n\n}\n","import { Component } from \"@angular/core\";\n\n@Component({\n    selector: 'bi-mosaic',\n    template: `\n    <div style=\"margin:0px; padding:0px; width: 100%; height:120%; min-height: 800px; position: relative; z-index: 1;\">\n        <iframe src=\"https://app.powerbi.com/view?r=eyJrIjoiYzMzNjE1OTAtODZkZC00MTMyLWJmNDItNTFhN2I4ZGRiOGJiIiwidCI6ImYwNDE4MGM5LWY4YmQtNGQyOC05N2RkLThkMDBjYWNjZjYyZSJ9\" frameborder=\"0\" style=\"overflow:hidden;overflow-x:hidden;overflow-y:hidden;height:100%;width:100%;position:absolute;top:0px;left:0px;right:0px;bottom:0px\" height=\"100%\" width=\"100%\"></iframe>\n    </div>    \n    `    \n})\nexport class BiMosaicComponent {\n        \n}","module.exports = \"<div class=\\\"wrapper\\\">\\n  <ng-container *ngFor=\\\"let option of options\\\">\\n    <button \\n      (click)=\\\"onClickOption(option, $event)\\\" \\n      class=\\\"camera-option\\\" \\n      [ngClass]=\\\"{ 'selected': option.isSelected }\\\"\\n      title=\\\"{{ option.label }}\\\" \\n      [disabled]=\\\"option.isDisabled\\\">\\n      <img