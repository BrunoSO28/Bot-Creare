atmentName;\n            alarms_export[translations['AUDIT-XLSX-EXPORT.action_author']] = alarm.auditAutor;\n            alarms_export[translations['AUDIT-XLSX-EXPORT.speed']] = alarm.speed ? alarm.speed.toFixed(2).toString() + \" km/h\" : '';\n            alarms_export[translations['AUDIT-XLSX-EXPORT.obs']] =\n                (alarm.auditComment) ?\n                    alarm.auditComment\n                        .replace('#[MOTORISTA COM MÁSCARA]', '')\n                        .replace('#[MOTORISTA SEM MÁSCARA]', '')\n                        .replace('#[MOTORISTA COM CINTO]', '')\n                        .replace('#[MOTORISTA SEM CINTO]', '')\n                    : '';\n            alarms_export[translations['AUDIT-XLSX-EXPORT.lat']] = alarm.latitude ? alarm.latitude.toString() : '';\n            alarms_export[translations['AUDIT-XLSX-EXPORT.long']] = alarm.longitude ? alarm.longitude.toString() : '';\n\n            if (alarm.auditComment) {\n              if (alarm.auditComment.includes(\"#[MOTORISTA COM MÁSCARA]\")) {\n                alarms_export[translations['AUDIT-XLSX-EXPORT.extra']] = \"MOTORISTA COM MÁSCARA\";\n              }\n              if (alarm.auditComment.includes(\"#[MOTORISTA SEM MÁSCARA]\")) {\n                alarms_export[translations['AUDIT-XLSX-EXPORT.extra']] = \"MOTORISTA SEM MÁSCARA\";\n              }\n              if (alarm.auditComment.includes(\"#[MOTORISTA COM CINTO]\")) {\n                alarms_export[translations['AUDIT-XLSX-EXPORT.extra']] = \"MOTORISTA COM CINTO\";\n              }\n              if (alarm.auditComment.includes(\"#[MOTORISTA SEM CINTO]\")) {\n                alarms_export[translations['AUDIT-XLSX-EXPORT.extra']] = \"MOTORISTA SEM CINTO\";\n              }\n            }\n\n            alarms_export[\"Assinado\"] = alarm.signatureDriverName ? \"condutor: \" + alarm.signatureDriverName : '';\n\n            if (alarm.alarmEmailsSentDate && alarm.alarmEmailsSentHour && alarm.alarmEmailsSentRecipients) {\n              alarms_export[translations['AUDIT-XLSX-EXPORT.send_date']] = alarm.alarmEmailsSentDate ? alarm.alarmEmailsSentDate : '';\n              alarms_export[translations['AUDIT-XLSX-EXPORT.send_hour']] = alarm.alarmEmailsSentHour ? alarm.alarmEmailsSentHour : '';\n              alarms_export[translations['AUDIT-XLSX-EXPORT.recipients']] = alarm.alarmEmailsSentRecipients ? alarm.alarmEmailsSentRecipients : '';\n            }\n            if (alarm.auditWorkflowDtoList) {\n              const audits = alarm.auditWorkflowDtoList.find(a => a.statusId == 3 || a.statusId == 4);\n              if (audits) {\n                alarms_export[translations['AUDIT-XLSX-EXPORT.review']] = `${audits.statusLabel}: ${audits.obs} - ${translations['AUDIT-XLSX-EXPORT.reviewed_by']} ${audits.userName}`;\n              }\n            }\n            batchResult.push(alarms_export);\n          });\n          resolveBatch(batchResult);\n        });\n      });\n    };\n\n\n    for (let i = 0; i < total; i += BATCH_SIZE) {\n      const batch = alarmList.slice(i, i + BATCH_SIZE);\n      const batchResult = await processBatch(batch);\n      finalAlarms = finalAlarms.concat(batchResult);\n      this.progressPercentage = Math.round(((i + BATCH_SIZE) / total) * 100);\n    }\n\n    return finalAlarms;\n  }\n\n  private getDatePartFromFormattedDate(formattedDate: string, type: \"DATE\" | \"TIME\") {\n    return formattedDate && formattedDate.match(type === \"DATE\" ? /[0-9]{2}\\/[0-9]{2}\\/[0-9]{2,4}/g : /[0-9]{2}:[0-9]{2}:[0-9]{2}/g)[0];\n  }\n\n  private getRiskRatingTranslation(risk: number): string {\n    switch (risk) {\n      case 0 : \n        return this.translateJsonService.getTranslateSubs('RISK-RATING.low_risk');\n      case 1:\n        return this.translateJsonService.getTranslateSubs('RISK-RATING.medium_risk');\n      case 2:\n        return this.translateJsonService.getTranslateSubs('RISK-RATING.high_risk');\n      default: return null;\n    }\n  }\n\n\n  \n  public revisarAuditoria() {\n    this.actionModalAudit.hide();\n    this.hideActionModal();\n    this.revisarAuditoriaModal.show();\n  }\n\n  public closeRevisarAuditoriaModal(){\n    this.revisarAuditoriaModal.hide();\n    this.actionModalAudit.show();\n  }\n\n  public excluirAssinatura() {\n    this.actionModalAudit.hide();\n    this.excluirAssinaturaModal.show();\n  }\n  \n  public concluirRevisao(aproved: boolean) {\n    this.revisandoLoading = true;\n\n    this.alarmService\n    .novaRevisaoAuditoria(this.selectedAuditId, this.revisaoObs, aproved)\n    .subscribe(\n        result => {\n          this.notificationService.printSuccessMessage(this.translateJsonService.getTranslateSubs('AUDIT.review_included_success'));\n          this.revisandoLoading = false;\n\n          if(!aproved){\n            this.alarmService.deleteImgSignature(this.selectedSignatureId).subscribe((_) => {\n              this.selectedSignatureId = null\n            })\n          }\n\n          setTimeout(() => {\n            this.actionModalAudit.hide();\n            this.revisarAuditoriaModal.hide();\n            this.podeRevisar = false;\n            this.refreshRankingData();\n          }, 2000);\n        },\n        err => {\n          this.revisandoLoading = false;\n          this.notificationService.printErrorMessage(this.translateJsonService.getTranslateSubs('AUDIT.review_included_error'));\n        }\n      )\n  }\n\n\n  public excludeSignature (aproved: boolean) {\n    this.inExecution = true;\n    if(!aproved){\n      this.excluirAssinaturaModal.hide();\n      this.actionModalAudit.show();\n      this.inExecution = false;\n      return;\n    }\n\n    this.alarmService.deleteImgSignature(this.selectedSignatureId)\n    .subscribe((_) => {\n        this.notificationService.printSuccessMessage(this.translateJsonService.getTranslateSubs('AUDIT.exclude_signature_sucess'));\n        this.imgSignature = '';\n        this.dateSignature = '';\n        this.imgSignature = '';\n        this.driverName = '';\n        \n\n        setTimeout(() => {\n          this.signatureInfo = '';\n          this.selectedSignatureId = null\n          this.refreshRankingData();\n          this.onHideActionTreatmentEditModal();\n          this.excluirAssinaturaModal.hide();\n          this.inExecution = false;\n          \n        }, 2000);\n      },\n      err => {\n        this.notificationService.printErrorMessage(this.translateJsonService.getTranslateSubs('AUDIT.no_alterations'));\n        this.actionModalAudit.show();\n        this.inExecution = false;\n      }\n    )\n  }\n\n  openEditModal() {  \n    this.hideActionModal();\n    this.isClickable = false;\n    this.selectedAlarmsToEdit = this.allAlarms.filter((alarm: Alarm) => (alarm.auditDriver == this.selectedAuditId || alarm.auditAlarm == this.selectedAuditId));\n    let selectedAlarm = this.selectedAlarmsToEdit[0]\n    selectedAlarm.updateFirstTreatmentDate = true;\n    this.selectedAlarmsToEdit = this.selectedAlarmsToEdit.slice(1);  \n    this.selectedAlarmsToEdit.forEach(item => {\n      item.updateFirstTreatmentDate = true;\n    });\n    this.showTreatment = true;\n    this.fatigueV2Component.openTreatmentModalToAudit(selectedAlarm, this.selectedAlarmsToEdit, this.actionModal, this.showTreatment);\n  }\n\n  onHideActionTreatmentEditModal() {    \n    this.refreshAuditTableWithFilter();\n    this.showTreatment = false;\n  }\n\n  closeTreatmentEditModal() {\n    this.fatigueV2Component.closeTreatmentModalToAudit(this.actionModal);\n    this.refreshAuditTableWithFilter();\n  }\n\n  refreshAuditTableWithFilter() {\n    let filterElement = document.querySelector(\"#filter\") as HTMLElement;\n    filterElement.click();\n  }\n  \n  getEmailLog(alarm: Alarm){\n    this.alarmSelectedRow = alarm\n    this.emailsAuditList = []\n    this.alarmService.getEmailLog(alarm.id).subscribe((response) => {\n      response.forEach((alarmEmail: EmailLog) => {\n        this.emailsAuditList.push({\n          auditId: alarmEmail.auditId,\n          submitter: alarmEmail.senderUsername,\n          alarmTypeName: this.translateJsonService.getTranslateSubs(this.translateJsonService.getAlarmTypesTranslate(alarmEmail.alarmType)),\n          shippingId: alarmEmail.id,\n          shippingDate: this.translateJsonService.transformDataFormat(alarmEmail.emailSentDate),\n          recipients: alarmEmail.recipients,\n          alarmId: alarmEmail.alarmId,\n        })\n      })\n    })\n  }\n\n  receipientsDetail(rowData){\n    this.receipientsList = rowData.recipients.map(email => { return { email: email } });\n    this.destinatariosModal.show();\n    this.actionModalAudit.hide();\n  }\n\n  alertsDetail(rowData){\n    this.alarmsByEmail$ = this.alarmService.getAlarmByEmail(rowData.shippingId).pipe(\n      map((alarms) => {\n        return alarms.map((alarm) => {\n          if (alarm.urlPictures && alarm.urlPictures[0] == 'NO_PICTURE') {\n            alarm.picture = 'NO_PICTURE'\n          } else if (alarm.picture == null) {\n            this.alarmService.getPictureByAlarm(alarm.id).subscribe((pictureAndMovie: PictureAndMovie) => {  \n              this.getBase64ImageFromURL(pictureAndMovie.urlPictures[this.whatsChannel(alarm.originalTypeAlarm ? alarm.originalTypeAlarm: alarm.typeAlarm)]).subscribe(result => {\n                alarm.picture = result;\n                alarm.urlPictures = pictureAndMovie.urlPictures;\n                if(pictureAndMovie.urlMovies && pictureAndMovie.urlMovies.length > 0){\n                  alarm.movie = pictureAndMovie.urlMovies[this.whatsChannel(alarm.originalTypeAlarm ? alarm.originalTypeAlarm: alarm.typeAlarm)];\n                  alarm.urlMovies = pictureAndMovie.urlMovies;\n                }\n              }, error => {\n                this.getBase64ImageFromURL(this.dataService.notFoundImage).subscribe(_result => {\n                  alarm.picture = _result;\n                })\n              })\n    \n          });\n          }\n          return alarm;\n        });\n      })\n    );\n    this.alarmService.getAlarmByEmail(rowData.shippingId).subscribe((response) => {\n      this.alarmsByEmail = response\n      this.alertsModal.show();\n      this.actionModalAudit.hide();\n    })\n  }\n\n  hideRecipientModal(){\n    this.destinatariosModal.hide();\n    this.actionModalAudit.show();\n  }\n\n  hideAlertsModal(){\n    this.alertsModal.hide();\n    this.actionModalAudit.show();\n  }\n\n  zoomAlarmImage(event, urlPictures, urlMovies, container, alarm) {\n    this.dialogService.open(ZoomMediasComponent, { data: { urlPictures, urlMovies, alarm }});\n  }\n  \n  getTitleText(rowData): string {\n    if (rowData['revisado']) {\n      return this.translateJsonService.getTranslateSubs('AUDIT.reviewed');\n    } else if (rowData['readByCustomer']) {\n      return this.translateJsonService.getTranslateSubs('AUDIT.checked');\n    } else {\n      return this.translateJsonService.getTranslateSubs('AUDIT.not_reviewed');\n    }\n  }\n\n  getBase64ImageFromURL(url: string) {\n    return Observable.create((observer: Observer<string>) => {\n      let img = new Image();\n\n      img.crossOrigin = 'Anonymous';\n      img.src = url;\n\n      if (!img.complete) {\n          img.onload = () => {\n          observer.next(this.getBase64Image(img));\n          observer.complete();\n        };\n        img.onerror = (err) => {\n           observer.error(err);\n        };\n      } else {\n          observer.next(this.getBase64Image(img));\n          observer.complete();\n      }\n    });\n  }\n\n  getBase64Image(img: HTMLImageElement) {\n    var canvas = document.createElement(\"canvas\");\n    canvas.width = img.width;\n    canvas.height = img.height;\n\n    var ctx = canvas.getContext(\"2d\");\n    ctx.drawImage(img, 0, 0);\n\n    var dataURL = canvas.toDataURL(\"image/png\");\n    return dataURL //.replace(/^data:image\\/(png|jpg);base64,/, \"\");\n  }\n  \n  public onChangeAlarmType(alarmTypeId: number, alarmValueArray): void {\n    if (!alarmValueArray) {\n      if (!this.alarmTypesActived.includes(alarmTypeId)) {\n        alarmValueArray = [...this.alarmTypesActived, alarmTypeId];\n      } else {\n        alarmValueArray = this.alarmTypesActived.filter(alarmType => {\n          return alarmType !== alarmTypeId\n        })\n      }\n    }\n\n    this.alarmTypesActived = this.selItemAlarmTypes.filter(alarmType => {\n      return alarmValueArray.includes(alarmType.value)\n    }).map(alarmType => alarmType.value);\n\n    this.selItemAlarmTypes = this.selItemAlarmTypes.map(alarmType => {\n        return {...alarmType, switch: alarmValueArray.includes(alarmType.value)}\n    });\n\n    if(this.alarmTypesMultiSelect) {\n      this.alarmTypesMultiSelect.value = this.alarmTypesActived;\n      this.alarmTypesMultiSelect.updateLabel();\n      this.alarmTypesMultiSelect.updateFilledState();\n    }\n\n\n    this.table.filter(this.alarmTypesActived, 'typeAlarm', 'in');\n  }\n\n  public onMouseEnterAlarmFilter(e: MouseEvent) {\n    const element = e.target as HTMLDivElement;\n\n    const { nextElementSibling, previousElementSibling } = element;\n    \n    if(nextElementSibling) {\n      nextElementSibling.classList.add('secondary-hover');\n    }\n\n    if(previousElementSibling) {\n      previousElementSibling.classList.add('secondary-hover');\n    }\n  }\n\n  public onMouseLeaveAlarmFilter(e: MouseEvent) {\n    const element = e.target as HTMLDivElement;\n\n    const { nextElementSibling, previousElementSibling } = element;\n    \n    if(nextElementSibling) {\n      nextElementSibling.classList.remove('secondary-hover');\n    }\n\n    if(previousElementSibling) {\n      previousElementSibling.classList.remove('secondary-hover');\n    }\n  }\n\n  public getFilterWidth() {\n    return `${1 / this.dataService.alarmTypesNumber.length * 100}%`;\n  }\n\n  private whatsChannel(typeAlarm) {\n    const fatigueChannel = 0;\n    const adasChannel = 1;\n\n    const ALARM_TYPES_REQUIRED_FATIGUE_MEDIAS = environment.alarmTypesRequiredFatigueMedias.split(',').map(a => Number(a));\n\n    return ALARM_TYPES_REQUIRED_FATIGUE_MEDIAS.includes(typeAlarm) ? fatigueChannel : adasChannel\n  }\n\n  private getAvailableAlarmTypes(alarms: Alarm[]): void {\n      const alarmTypes = [];\n      const originalAlarmTypes = [];\n  \n      alarms.forEach(alarm => {\n        const { typeAlarm, originalTypeAlarm } = alarm;\n\n        const hasAlarmType = alarmTypes.indexOf(typeAlarm) >= 0;\n        const hasOriginalAlarmType = originalAlarmTypes.indexOf(originalTypeAlarm) >= 0;\n\n        if (!hasAlarmType && !!typeAlarm) {\n          alarmTypes.push(typeAlarm);\n        }\n\n        if (!hasOriginalAlarmType && !!originalTypeAlarm) {\n          originalAlarmTypes.push(originalTypeAlarm);\n        }\n      });\n  \n      this.selItemAlarmTypes = this.dataService.alarmTypesNumber\n        .filter((alarmType) => {\n          return alarmTypes.includes(alarmType.value);\n        }).map(alarmType => {\n          return {\n            ...alarmType,\n            label: this.translateJsonService.getTranslateSubs(alarmType.label),\n            switch: false\n          }\n        });\n        this.selItemOriginalAlarmTypes = this.dataService.alarmTypesNumber\n        .filter((alarmType) => {\n          return originalAlarmTypes.includes(alarmType.value);\n        }).map(alarmType => {\n          return {\n            ...alarmType,\n            label: this.translateJsonService.getTranslateSubs(alarmType.label),\n            switch: false\n          }\n        });\n  }\n  getEquipamentTypeName(id: number): string {\n    if(environment.companyName === 'Foco na Via'){\n      return FNVEquipmentTypeLabels[id] || 'Unknown';\n    }\n    return EquipmentTypeLabels[id] || 'Unknown';\n  }\n\n  getUniqueEquipmentTypesFromAlarms(alarms: Alarm[]): any[] {\n    const uniqueEquipmentTypes = {};\n    alarms.forEach(alarm => {\n        if (alarm.equipmentTypeId) {\n            uniqueEquipmentTypes[alarm.equipmentTypeId] = {\n                label: this.getEquipamentTypeName(alarm.equipmentTypeId),\n                value: alarm.equipmentTypeId,\n            };\n        }\n    });\n    return Object.keys(uniqueEquipmentTypes).map(key => uniqueEquipmentTypes[key]);\n  }\n\n  /**\n   * Converte string de timestamp do backend (ex: \"2026-01-06 12:22:21.800 -0300\") em Date.\n   */\n  private parseTimestampToDate(value: string): Date | null {\n    if (!value || typeof value !== 'string') return null;\n    const trimmed = value.trim();\n    const match = trimmed.match(/^(\\d{4}-\\d{2}-\\d{2})\\s+(\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?)\\s+([+-])(\\d{2})(\\d{2})$/);\n    if (!match) return null;\n    const [, datePart, timePart, sign, hh, mm] = match;\n    const isoString = `${datePart}T${timePart}${sign}${hh}:${mm}`;\n    const d = new Date(isoString);\n    return isNaN(d.getTime()) ? null : d;\n  }\n\n  /**\n   * Obtém o tooltip para exibir quando o timezone do alarme é diferente do navegador\n   * Mostra a hora original do banco de dados no timezone do alarme\n   * @param alarm Alarme com timezone\n   * @param date Data que representa o momento correto\n   * @returns String com o tooltip ou null se não necessário\n   */\n  getTimezoneTooltip(alarm: any, date: Date): string {\n    if (!alarm || !alarm['_timezoneDifferent'] || !date) {\n      return null;\n    }\n\n    // Formatar a data no timezone do alarme (hora original do banco)\n    const originalTime = this.dataService.formatDateInAlarmTimezone(date, alarm.timeZone);\n    // Normalizar o timezone para exibição (garantir formato ±HH:MM)\n    const normalizedTimezone = this.dataService.normalizeTimezone(alarm.timeZone || '-03:00');\n    const label = this.translateJsonService.getTranslateSubs('GLOBAL.date_time_local');\n    return `${label}: ${originalTime} (${normalizedTimezone})`;\n  }\n\n  getGridAvailableMediaAtDisplay(rowData: any): string {\n    if (!rowData) return '';\n    if (rowData['availableMediaAtTimestamp'] != null) {\n      return this.translateJsonService.transformDataFormat(rowData['avai