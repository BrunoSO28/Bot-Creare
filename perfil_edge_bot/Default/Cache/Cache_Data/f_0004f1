false);\n        this.satelliteNotificationsList();\n\n        if (this.filterSelectedData.isValidFilter()) {\n            _filter = this.filterSelectedData;\n\n            if (!_filter.selectedCustomers || _filter.selectedCustomers.length === 0) {\n                const ws = this.dataService.getWorkspace();\n\n                _filter.selectedCustomers = ws.userCustomerChildIds.map((customerChildsPermissions: customerChildsPermissions) => customerChildsPermissions.customer)\n            }\n\n            this.updateRequestInProgress(true);\n\n            this.alarmService.getAlarmsByFilterDefault(this.buildFilter(_filter))\n                .pipe(\n                    finalize(() => {\n                        this.isLoadingAlarms = false;\n                        this.loadingTable = false;\n                        this.isSubscribed = false;\n                        this.updateRequestInProgress(false);\n                    })\n                )\n                .subscribe(\n                    (_alarms: Array<Alarm>) => {\n\n                        if (_alarms.length < 1) {\n                            if (!subscribe) {\n                                this.notificationService.printWarningMessage(this.getTranslateSubs('PAGE-PORTAL.msg_no_results'));\n                            }\n                            this.getLocalAlarmData([]);\n                            this.loadingTable = false;\n                            this.isLoadingAlarms = false;\n                        } else {\n                            this.getLocalAlarmData(this.updateAlarmsWithDelayAndTimeRead(_alarms));\n                        }\n\n                        if (subscribe) {\n                            this.subscribeToData();\n                        }\n                    },\n                    error => {\n                        if (subscribe) {\n                            setTimeout(() => this.requestAlarmData(true), 60000);\n                        } else {\n                            this.notificationService.printErrorMessage(this.getTranslateSubs('FILTER-GLOBAL.msg_notresult'));\n                        }\n                        this.loadingTable = false;\n                        this.isLoadingAlarms = false;\n                    }\n                );\n        } else {\n            this.notificationService.printWarningMessage(this.getTranslateSubs('FILTER-GLOBAL.msg_notfilter'));\n        }\n    }\n\n\n    public subscribeToData(): void {\n        if (this.isSubscribed) return;\n\n        this.isSubscribed = true;\n\n        this.alarmSubscription = observableTimer(30000).pipe(takeUntil(this.destroy$)).subscribe(() => this.requestLoadAlarms());\n    }\n\n    public unsubscribeData(): void {\n        if (this.alarmSubscription) {\n            this.alarmSubscription.unsubscribe();\n            this.alarmSubscription = null;\n        }\n        this.isSubscribed = false;\n        this.updateRequestInProgress(false);\n    }\n\n    private requestLoadAlarms(): void {\n        if (!this.isOnlineChecked) {\n            this.unsubscribeData();\n            return;\n        }\n\n        if (this.isLoadingAlarms) return;\n        this.isLoadingAlarms = true;\n        this.changeOnlineInterval();\n        this.requestAlarmData(true);\n    }\n\n    public changeOnlineInterval(interval?: number) {\n        if (!interval) {\n            interval = interval = this.dataService.getWorkspace().onlineTimeInterval;\n        }\n\n        let today: Date = new Date(),\n            todayLast: Date = new Date(),\n            todayForward: Date = new Date();\n\n        todayLast.setHours(today.getHours() - 1 * interval);\n        todayForward.setHours(today.getHours());\n\n        this.filterSelectedData.selectedDateStart = todayLast;\n        this.filterSelectedData.selectedDateEnd = todayForward;\n    }\n\n    private async getLocalAlarmData(alertList: Alarm[]) {\n\n        this.alerts = this.insertGroupLowRiskInAlerts(alertList);\n\n        this.alerts = this.removeAlarmType(0, this.alerts);\n\n        this.applyTypeAlertDescriptionInAll(this.alerts);\n\n        let oldAlerts = this.dataService.getAlarmList();\n\n        this.verifyNewAlerts(oldAlerts, this.alerts);\n\n        this.dataService.setAlarmList([...this.alerts])\n\n        const imeisWithFatigueAlarms = this.setUniqueAssetsWithFatigueAlarms(this.alerts);\n\n        try {\n            await this.getMovimentStatus(imeisWithFatigueAlarms, this.alerts);\n        } catch (err) {\n            console.error(`Ocorreu um erro ao buscar o Status de movimento dos veiculos. #${err.message}`)\n        }\n\n        this.dataService.registerAlarms(this.alerts);\n\n        this.allMarkers = this.convertAlarmInMarker(this.alerts);\n\n        this.groupedAlerts = this.groupingAlertsByRiskGroup(JSON.parse(JSON.stringify(this.alerts)));\n\n        this.chartsValues = this.getLenghtRiskGroups(this.alerts, JSON.parse(JSON.stringify(this.chartsValues)));\n\n        this.groupingDistinctVehiclesAndDriversByRiskGroup();\n\n        this.tableDataAlerts = this.groupOrUngroupAlerts(this.alertsGrouped);\n\n        this.loadingTable = false;\n        this.loadingMap = false;\n        this.updateIsCheckAllDisabled();\n    }\n\n    private async getMovimentStatus(imeis: string[], alerts: Alarm[]): Promise<any> {\n        return new Promise((resolve, reject) => {\n            this.movimentStatusService.getMovimentStatus(imeis)\n                .then(result => {\n                    this.movimentStatus = result;\n\n                    alerts.forEach(alert => {\n                        const finded = this.movimentStatus.find(m => m.device_id == alert.imei);\n\n                        if (finded) {\n                            const initialDate = new Date(finded.initial_date);\n                            const dateNow = new Date();\n                            const duration = this.dataService.diff(initialDate, dateNow);\n\n                            alert.assetMovimentStatus = {\n                                inMoviment: finded.status == 'EM_MOVIMENTO',\n                                status: finded.status,\n                                initialDate: initialDate,\n                                duration: duration\n                            }\n                        }\n                    })\n\n                    resolve(true);\n                }).catch(err => reject(false));\n        })\n    }\n\n    public displayMovimentStatusLabel(inMoviment: boolean): string {\n        return (inMoviment) ? this.translateJsonService.getTranslateSubs('GLOBAL.in_motion') : this.translateJsonService.getTranslateSubs('GLOBAL.stopped')\n    }\n\n    private setUniqueAssetsWithFatigueAlarms(alarms: Alarm[]): string[] {\n        const list: string[] = alarms.filter(a => a.typeAlarm == AlarmTypeEnum[\"TYPES-ALERT.atten_warning\"] || a.typeAlarm == AlarmTypeEnum[\"TYPES-ALERT.tired\"]\n            || a.typeAlarm == AlarmTypeEnum[\"TYPES-ALERT.accumulated_drowsiness\"]\n            || a.typeAlarm == AlarmTypeEnum[\"TYPES-ALERT.incompatible_glasses\"]).map(a => a.imei);\n\n        let unique = new Set<string>(list);\n\n        return [...unique];\n    }\n\n    removeAlarmType(alarmType: number, alerts: Alarm[]): Alarm[] {\n        return alerts.filter(a => a.typeAlarm != alarmType);\n    };\n\n    groupOrUngroupAlerts(agroupAlerts: boolean): Alarm[] {\n        return (agroupAlerts) ? this.groupedAlerts : this.alerts;\n    }\n\n    insertGroupLowRiskInAlerts(alerts: Alarm[]): Alarm[] {\n        return alerts.map((a) => {\n            if (a.groupRisk != 2 && a.groupRisk != 1) {\n                a.groupRisk = 0;\n                a.groupAlarm = 0;\n            };\n            a.groupAlarmsChild = [];\n\n            // Garantir que timeZone seja preservado\n            return {\n                ...a,\n                timeZone: a.timeZone\n            };\n        })\n    }\n\n    groupingAlertsByRiskGroup(alerts: Alarm[]): Alarm[] {\n        let groupedAlerts: Alarm[] = [];\n        const sortedAlarmsByDatetimeDesc: Alarm[] = alerts.sort((compA: any, compB: any) => {\n            return compB.datetime.localeCompare(compA.datetime);\n        });\n        sortedAlarmsByDatetimeDesc.forEach((a) => {\n            let gAlerts: Alarm = groupedAlerts.find(ga => (\n                ga.groupAlarm == a.groupAlarm\n                && ga.typeAlarm == a.typeAlarm\n                && ga.vehicleId == a.vehicleId\n                && ga.groupRisk == a.groupRisk\n                && (ga.driverId == a.driverId || a.driverId == undefined || ga.driverId == undefined)))\n\n            if (gAlerts) {\n                if (!gAlerts.groupAlarmsChild) {\n                    gAlerts.groupAlarmsChild = [];\n                }\n                // Preservar timeZone explicitamente ao adicionar em groupAlarmsChild\n                gAlerts.groupAlarmsChild.push({\n                    ...a,\n                    timeZone: a.timeZone\n                });\n            } else {\n                // Preservar timeZone explicitamente ao adicionar em groupedAlerts\n                groupedAlerts.push({\n                    ...a,\n                    timeZone: a.timeZone\n                });\n            }\n        });\n        return groupedAlerts;\n    }\n\n    isDrowsinesL1OrConfirmation(typeAlarm: number) {\n        return [AlarmTypeEnum[\"TYPES-ALERT.drowsiness_l1_confirmation\"], AlarmTypeEnum[\"TYPES-ALERT.atten_warning\"]].includes(typeAlarm);\n    }\n\n    isDrowsinesL2OrConfirmation(typeAlarm: number) {\n        return [AlarmTypeEnum[\"TYPES-ALERT.drowsiness_l2_confirmation\"], AlarmTypeEnum[\"TYPES-ALERT.tired\"]].includes(typeAlarm);\n    }\n\n    getLenghtRiskGroups(alerts: Alarm[], chartsValues) {\n        chartsValues[\"low-risk\"] = 0;\n        chartsValues[\"medium-risk\"] = 0;\n        chartsValues[\"high-risk\"] = 0;\n\n        alerts.forEach((alert) => {\n            switch (alert.groupRisk) {\n                case 0:\n                    chartsValues[\"low-risk\"]++;\n                    break;\n                case 1:\n                    chartsValues[\"medium-risk\"]++;\n                    break;\n                case 2:\n                    chartsValues[\"high-risk\"]++;\n                    break;\n            }\n        })\n\n        return chartsValues;\n    }\n\n    groupingDistinctVehiclesAndDriversByRiskGroup() {\n        this.groupedUniqueVehiclesAndDriversByRisk = [\n            { 'risk': 0, 'vehicles': [], 'drivers': [] },\n            { 'risk': 1, 'vehicles': [], 'drivers': [] },\n            { 'risk': 2, 'vehicles': [], 'drivers': [] },\n            { 'risk': 3, 'vehicles': [], 'drivers': [] }\n        ];\n\n        this.groupedUniqueVehiclesAndDriversByRisk.forEach((gv) => {\n            let alarms: Alarm[] = this.alerts.filter(a => a.groupRisk == gv.risk);\n\n            alarms.forEach((alarm) => {\n                if (!gv.vehicles.find(v => v.id == alarm.vehicleId)) {\n                    gv.vehicles.push({\n                        \"id\": alarm.vehicleId,\n                        \"identification\": alarm.vehicle_plates,\n                        \"name\": alarm.vehicle_prefix,\n                        \"customerChildId\": alarm.customer_child_id\n                    });\n                }\n\n                if (!gv.drivers.find(v => v.id == alarm.driverId)) {\n                    gv.drivers.push({\n                        \"id\": alarm.driverId,\n                        \"identification\": alarm.driver_firstname,\n                        \"name\": alarm.driver_firstname,\n                        \"customerChildId\": alarm.customer_child_id\n                    });\n                }\n            })\n\n        })\n\n        // SEM RISCO\n        let noRisk = this.groupedUniqueVehiclesAndDriversByRisk\n            .find(grop => grop.risk == 3);\n\n        this.heartbeatComunication.forEach(heartBeat => {\n            if (!this.alerts.find(alert => alert.vehicleId == heartBeat.vehicle_id)) {\n                let asset: Asset = new Asset();\n                asset.id = heartBeat.vehicle_id;\n                asset.name = heartBeat.vehicle_plate;\n                asset.identification = heartBeat.vehicle_prefix;\n\n                noRisk.vehicles.push(asset);\n            }\n        })\n\n        this.chartsValues[\"no-alerts\"] = this.groupedUniqueVehiclesAndDriversByRisk\n            .find(grop => grop.risk == 3).vehicles.length;\n    }\n\n    getAlarmType(value: number): AlarmType {\n        return this.selItemAlarmTypes.find((at) => at.value == value);\n    }\n\n    convertAlarmInMarker(alerts: Alarm[]): ModelMarkers[] {\n        let markers = [];\n\n        alerts.forEach((alarm: Alarm) => {\n            let mrkr: ModelMarkers = new ModelMarkers;\n            mrkr.id = alarm.id;\n            mrkr.name = \"Alerta \" + alarm.id + \" - \" + alarm.driver_firstname;\n            mrkr.category = alarm.typeAlarm;\n            mrkr.enabled = true;\n            mrkr.latitude = alarm.latitude;\n            mrkr.longitude = alarm.longitude;\n\n            markers.push(mrkr);\n        })\n\n        return markers;\n    }\n\n    private getTranslateSubs(key: string) {\n        let translated;\n        this.translateService.get(key).subscribe((res: string) => { translated = res; });\n        return translated;\n    }\n\n    filters($event) {\n        let filters = $event.filters;\n    }\n\n    filterGroupRisk(groupRisk: number) {\n        let index = this.groupSelected.indexOf(groupRisk);\n\n        if (index > -1) {\n            this.groupSelected.splice(index, 1);\n        } else {\n            this.groupSelected.push(groupRisk);\n        }\n\n        if (this.groupSelected.length >= 3) {\n            this.groupSelected = [];\n        }\n\n        this.updateIsCheckAllDisabled();\n\n        this.dt.filter(this.groupSelected, 'groupRisk', 'in');\n    }\n\n    filterVehicleOrDriver(assetId: number, assetSelected, assetCol: string) {\n        let index = assetSelected.indexOf(assetId);\n\n        if (index > -1) {\n            assetSelected.splice(index, 1);\n        } else {\n            assetSelected.push(assetId);\n        }\n\n        this.dt.filter(assetSelected, assetCol, 'in');\n    }\n\n    onFilterTable($event) {\n        let alarms = $event.filteredValue;\n\n        (alarms.length > 0) ? this.allMarkers = this.convertAlarmInMarker($event.filteredValue) : this.allMarkers = [];\n    }\n\n    changeIconTreatment({ alertIds, treatmentStarted }: { alertIds: number[], treatmentStarted: boolean }) {\n        alertIds.forEach(alert => {\n            const indexTableAlert = this.tableDataAlerts.findIndex(tableAlert => alert === tableAlert.id);\n            if (treatmentStarted) {\n                if (!this.tableDataAlerts[indexTableAlert].treatmentStartedAt) {\n                    this.tableDataAlerts[indexTableAlert].treatmentStartedAt = moment(new Date()).format();\n                } else {\n                    this.tableDataAlerts[indexTableAlert].treatmentStartedAt = this.tableDataAlerts[indexTableAlert].treatmentStartedAt;\n                }\n            } else {\n                this.tableDataAlerts[indexTableAlert].treatmentStartedAt = null;\n            }\n        })\n    }\n\n    async openTreatmentModal(alert: Alarm, relatedAlarms: Alarm[]) {\n        const ws = this.dataService.getWorkspace();\n        const hasCentralPermission = ws.accessControlDesc.some(permission => permission.permissions === 31);\n\n        if (hasCentralPermission && !alert.treatmentStartedAt) {\n            alert.treatmentStartedAt = moment(new Date()).format();\n        }\n\n        const alarmsGrouped = [alert, ...relatedAlarms];\n        const alarmsUpdated = await this.setReadAlarm(alarmsGrouped);\n        const relatedAlarmsChecked = alarmsUpdated.filter(alarm => relatedAlarms.some(it => it.id == alarm.id));\n        alarmsGrouped.forEach(alarm => {\n            const checkCurAlarm = alarmsUpdated.find(item => alarm.id === item.id);\n            if (checkCurAlarm) {\n                alarm.alarmRead = checkCurAlarm.alarmRead;\n                alarm.alarmReadByUsername = checkCurAlarm.alarmReadByUsername;\n                alarm.urlMovies = checkCurAlarm.urlMovies;\n                alarm.urlPictures = checkCurAlarm.urlPictures;\n                if (checkCurAlarm.datetimestampFormatted != null) alarm.datetimestampFormatted = checkCurAlarm.datetimestampFormatted;\n                if (checkCurAlarm.availableMediaAtTimestampFormatted != null) alarm.availableMediaAtTimestampFormatted = checkCurAlarm.availableMediaAtTimestampFormatted;\n            }\n        });\n        this.treatmentFlowService.setAlarms(alarmsGrouped);\n        this.selectedAction = alert;\n        this.relatedAlarms = relatedAlarmsChecked;\n        this.showTreatment = true;\n        this.actionModal.show();\n    }\n\n    async openTreatmentModalToAudit(alert: Alarm, relatedAlarms: Alarm[], actionModal, showTreatment) {\n        const alarmsGrouped = [alert, ...relatedAlarms];\n        const alarmsUpdated = await this.setReadAlarm(alarmsGrouped);\n        const relatedAlarmsChecked = alarmsUpdated.filter(alarm => relatedAlarms.some(it => it.id == alarm.id));\n        alarmsGrouped.forEach(alarm => {\n            const checkCurAlarm = alarmsUpdated.find(item => alarm.id === item.id);\n            if (checkCurAlarm) {\n                if (checkCurAlarm.datetimestampFormatted != null) alarm.datetimestampFormatted = checkCurAlarm.datetimestampFormatted;\n                if (checkCurAlarm.availableMediaAtTimestampFormatted != null) alarm.availableMediaAtTimestampFormatted = checkCurAlarm.availableMediaAtTimestampFormatted;\n            }\n        });\n        this.treatmentFlowService.setAlarms(alarmsGrouped);\n\n        this.selectedAction = alert;\n        this.relatedAlarms = relatedAlarmsChecked;\n        this.showTreatment = showTreatment;\n        actionModal.show();\n    }\n\n    closeTreatmentModal() {\n        this.actionModal.hide();\n    }\n\n    closeTreatmentModalToAudit(actionModal) {\n        actionModal.hide();\n    }\n\n    onHideActionTreatmentModal() {\n        this.selectedAction = {};\n        this.showTreatment = false;\n        this.treatmentFlowService.reset();\n    }\n\n    removeAlarmsByIdList(ids: string[]) {\n        let alertsNotAudited = this.dataService.getFilteredAlarmDtoList().reduce((acumAlarms: Alarm[], alarm: Alarm) => {\n\n            let alarmIdIsSelected = this.alarmIdsBatchTreatmentList.find(selectedAlarmId => selectedAlarmId == alarm.id);\n\n            if (alarmIdIsSelected) {\n                alarm.isSelected = true;\n            }\n\n            if (!ids.map((id) => parseInt(id)).includes(alarm.id)) {\n                acumAlarms.push(alarm);\n            }\n            return acumAlarms;\n        }, []);\n\n        this.dataService.clearAlarms();\n        this.dataService.registerAlarms(alertsNotAudited);\n\n        this.getLocalAlarmData(this.alerts);\n    }\n\n    applyTypeAlertDescriptionInAll(alerts: Alarm[]) {\n        for (let i = 0; i < this.alerts.length; i++) {\n            const alarmType = this.getAlarmType(this.alerts[i].typeAlarm);\n            let label = alarmType.label\n            const iconPath = alarmType.icon\n            this.alerts[i].typeAlarmDescription = this.translateJsonService.getTranslateSubs(label);\n            this.alerts[i].iconPath = iconPath;\n        }\n    }\n\n    async fetchLastHeartbeat(selectedCustomersChild: number[], haveRefresh: boolean) {\n        this.loadingEquipInfos = true;\n        let listHeartbeat: LastHeartbeat[] = await this.heartbeatService.fetchLastHeartbeatByCustomersChild(selectedCustomersChild);\n\n        const COMUNICATING = this.checkCommunicatingImeisInDays(listHeartbeat, 1);\n        const NOT_COMUNICATING = this.checkNotCommunicationgImeis(listHeartbeat, COMUNICATING);\n        const MAINTENANCE_STANDBY = listHeartbeat.filter(result => result.vehicle_status == 3 || result.vehicle_status == 4);\n\n        this.heartbeatNotComunication = this.convertTimeStampToDate(NOT_COMUNICATING).filter(result => result.vehicle_status == 1 || result.vehicle_status == 2);\n        this.heartbeatMaintenanceStandby = this.convertTimeStampToDate(MAINTENANCE_STANDBY);\n        this.heartbeatComunication = COMUNICATING;\n        this.heartBeatAll = listHeartbeat;\n\n        this.loadingEquipInfos = false;\n\n        if (haveRefresh) this.refreshlastHeartbeat();\n    }\n\n    satelliteNotificationsList() {\n        this.satelliteNotificationsService.getSatNotificationsList(this.buildFilter(this.filterSelectedData))\n            .then((res) => {\n                this.satelliteNotification = res;\n            }\n            );\n    }\n\n    refreshlastHeartbeat() {\n        setTimeout(() => { this.fetchLastHeartbeat(this.filterSelectedData.selectedCustomers, true) }, 300000)\n    }\n\n    checkNotCommunicationgImeis(heartbeats: LastHeartbeat[], comunicating: LastHeartbeat[]): LastHeartbeat[] {\n        return heartbeats.filter((heartbeat) => !comunicating.includes(heartbeat));\n    }\n\n    checkCommunicatingImeisInDays(heartbeats: LastHeartbeat[], days: number) {\n        const maxTime = moment().subtract('days', days);\n        return heartbeats.filter(heartbeat => maxTime.toDate() <= new Date(heartbeat.inserted_on));\n    }\n\n    convertTimeStampToDate(heartbeats: LastHeartbeat[]): LastHeartbeat[] {\n        return heartbeats.map(heartbeat => {\n            if (heartbeat.datetime) {\n                heartbeat.datetime = new Date(heartbeat.datetime);\n            }\n            return heartbeat;\n        });\n    }\n\n\n    public notifyCountAlarmPending() {\n        let count: number = 0;\n        if (this.dataService.getFilteredAlarmList()) {\n            count = this.dataService.getFilteredAlarmList().reduce((total: number, alarm: Alarm) => { return (alarm.alarmRead) ? total : total + 1 }, 0);\n        }\n\n        this._state.notifyDataChanged('painel.setCountPendingValue', count);\n    }\n\n    public speak(message: string): void {\n\n        var y = window.speechSynthesis;\n        if (!y) {\n            return console.warn('Your browser does not support `speechSynthesis` yet.');\n        }\n        var s = new SpeechSynthesisUtterance(message);\n\n        s.lang = localStorage.getItem('lang');\n        y.speak(s);\n    }\n\n    public notifyNewAlarms(_alarms: Alarm[]) {\n        let _alarmsDiff: Alarm[] = this.dataService.getAlarmsDiff(_alarms);\n        if (_alarmsDiff && _alarmsDiff.length > 0) {\n            let alarm: Alarm = _alarmsDiff[0];\n\n            let _driver: Driver = this.dataService.getDriverById(alarm.assetId);\n            let _mensagem: string = 'Alarme   ';\n            let _enableAudio: boolean = false;\n            let _estilo = NotificationType.INFO;\n\n            switch (alarm.typeAlarm) {\n                case 2: {\n                    _mensagem = 'Alerta de Sonolência Nível 1';\n                    _estilo = NotificationType.ERROR;\n                    if (this.checkAlarmOptions.isAttenWarningChecked) {\n                        _enableAudio = true;\n                    }\n                    break;\n                }\n\n                case 5: {\n                    _estilo = NotificationType.SUCCESS;\n                    if (this.checkAlarmOptions.isChangeWarningChecked) {\n                        _enableAudio = true;\n                    }\n                    _mensagem = 'Alerta de Troca de Motorista';\n                    break;\n                }\n\n                case 1: {\n                    _estilo = NotificationType.WARNING;\n                    _mensagem = 'Alerta de Ausência';\n                    if (this.checkAlarmOptions.isFaceMissingChecked) {\n                        _enableAudio = true;\n                    }\n                    break;\n                }\n\n                case 3: {\n                    _estilo = NotificationType.SUCCESS\n                    _mensagem = 'Alerta de Distração Lateral';\n                    if (this.checkAlarmOptions.isLookAroundChecked) {\n                        _enableAudio = true;\n                    }\n                    break;\n                }\n\n                case 4: {\n                    _estilo = NotificationType.INFO;\n                    if (this.checkAlarmOptions.isPhoneWarningChecked) {\n                        _enableAudio = true;\n                    }\n                    _mensagem = 'Alerta uso de Celular';\n                    break;\n                }\n\n                case 6: {\n                    _estilo = NotificationType.ERROR;\n                    if (this.checkAlarmOptions.isTiredChecked) {\n                        _enableAudio = true;\n                    }\n                    _mensagem = 'Alerta de Sonolência Nível 2';\n                    break;\n                }\n\n                default: {\n                    _enableAudio = true;\n                    break;\n                }\n            }\n\n            if (alarm.driver_firstname) {\n                _mensagem = _mensagem + '  driver ' + alarm.driver_firstname;\n                if (alarm.driver_lastname) _mensagem = _mensagem + ' ' + alarm.driver_lastname;\n            } else if (_driver && _driver.name) {\n                _mensagem = _mensagem + '   driver ' + _driver.name;\n            };\n\n            _enableAudio = true;\n            if (_enableAudio) this.speak(_mensagem);\n\n        }\n\n    }\n\n    public async setReadAlarm(alarms: Alarm[]): Promise<Alarm[]> {\n        if (alarms && alarms.length) {\n\n            const alarmIds = alarms.map(alarm => alarm.id);\n            const timezone = this.dataService.getBrowserTimezoneOffset();\n            try {\n                const readAlarms = await this.alarmService.setReadAlarm(alarmIds, timezone).toPromise();\n                readAlarms.forEach(alarm => {\n                    this.dataService.setReadFilteredAlarmList(alarm.id);\n                    const row = this.tableDataAlerts ? this.tableDataAlerts.find(a => a.id === alarm.id) : null;\n                    if (row) {\n                        if (alarm.datetimestampFormatted != null) row.datetimestampFormatted = alarm.datetimestampFormatted;\n                        if (alarm.availableMediaAtTimestampFormatted != null) row.availableMediaAtTimestampFormatted = alarm.availableMediaAtTimestampFormatted;\n                    }\n                });\n                return readAlarms;\n            } catch (error) {\n                console.error('Falha ao definir leitura dos alarmes ou alarmes já lidos.', error);\n                alarms.forEach(alarm => {\n                    alarm.urlPictures = [];\n                });\n                return alarms;\n            }\n        }\n    }\n\n    showAndHideSearchInput() {\n        if (this.showSearchInput) {\n            this.showSearchInput = false;\n            this.dt.filterGlobal('', 'contains');\n        } else {\n            this.showSearchInput = true;\n        }\n    }\n\n    verifyNewAlerts(oldAlerts: Alarm[], newAlerts: Alarm[]) {\n        let notNotificatedAlerts = [];\n        let notReaded = [];\n\n        if (oldAlerts.length > 0) {\n            if (newAlerts.length > 0) {\n                newAlerts.forEach(alert => {\n                    if (!alert.alarmRead) {\n                        notReaded.push(alert.id);\n                    }\n\n                    const found = oldAlerts.find(_alert => _alert.id === alert.id);\n\n                    if (!found) {\n                        this.verifyCanShowToast(alert);\n                        notNotificatedAlerts.push(alert.id);\n                    }\n                })\n            }\n        }\n\n    }\n\n    verifyCanShowToast(alert: Alarm) {\n        let notificatedAlerts = JSON.parse(window.localStorage.getItem('notificatedAlerts'));\n\n        if (notificatedAlerts) {\n            if (notificatedAlerts.includes(alert.id)) {\n            } else {\n                if (alert.groupRisk == 0 && !this.notificationCenterService.getHideLowAlertToast()) {\n\n                    this.showToast(alert);\n                }\n                if (alert.groupRisk == 1 && !this.notificationCenterService.getHideMediumAlertToast()) {\n                    this.showToast(alert);\n                }\n                if (alert.groupRisk == 2 && !this.notificationCenterService.getHideHighAlertToast()) {\n\n                    this.showToast(alert);\n                }\n                notificatedAlerts.push(alert.id);\n                window.localStorage.setItem('notificatedAlerts', JSON.stringify(notificatedAlerts));\n            }\n        } else {\n            window.localStorage.setItem('notificatedAlerts', JSON.stringify([alert.id]));\n        }\n    }\n\n    showToast(alert: Alarm) {\n        let summary: string;\n        let detail: string;\n        let groupRisks = (alert.groupRisk) ? alert.groupRisk : 0;\n        let severity: string;\n\n        switch (groupRisks) {\n            case 0:\n                summary = this.translateJsonService.getTranslateSubs('RISK-RATING.low_risk'); \"Alerta Baixo Risco\"\n                severity = \"success\";\n                break;\n            case 1:\n                summary = this.translateJsonService.getTranslateSubs('RISK-RATING.medium_risk'); \"Alerta Médio Risco\"\n                severity = \"info\";\n                break;\n            case 2:\n                summary = this.translateJsonService.getTranslateSubs('RISK-RATING.high_risk'); \"Alerta Alto Risco\"\n                severity = \"error\";\n                break;\n        }\n\n        if (alert.driver_firstname) {\n            detail = this.translateJsonService.getTranslateSubs('GLOBAL.alert_1') + \" | \" +\n                this.translateJsonService.getTranslateSubs(alert.typeAlarmDescription) + \" - \" + this.translateJsonService.getTranslateSubs('GLOBAL.vehicle') + \": \" +\n                alert.vehicle_plates + \" \" + this.translateJsonService.getTranslateSubs('GLOBAL.driver') + \": \" +\n                alert.driver_firstname;\n        } else {\n            detail = this.translateJsonService.getTranslateSubs('GLOBAL.alert_1') + \" | \" +\n                this.translateJsonService.getTranslateSubs(alert.typeAlarmDescription) + \" - \" + this.translateJsonService.getTranslateSubs('GLOBAL.vehicle') + \": \" +\n                alert.vehicle_plates;\n        }\n\n\n        this.idLastNewAlert = alert.id;\n        this.messageService.add({ severity: severity, summary: summary, detail: detail, sticky: !this.notificationCenterService.getAutoCloseAlertToast() });\n\n        console.error('not auto' + this.notificationCenterService.getAutoCloseAlertToast());\n\n        if (this.notificationCenterService.getSoundVoice()) this.speak(detail);\n    }\n\n    logger(log) {\n        console.log(log);\n    }\n\n    public displayCamsNotComunication(): void {\n        this.displayModalNotComuniting = (this.heartbeatNotComunication && this.heartbeatNotComunication.length > 0)\n\n    }\n\n    public displayCamsMaintenanceStandby(): void {\n        this.displayMaintenanceStandby = (this.heartbeatMaintenanceStandby && this.heartbeatMaintenanceStandby.length > 0)\n    }\n\n    public displaySatelliteNotifications(satelliteNotification: SatelliteNotification[]): void {\n        this.displaySatelliteNotific = true;\n    }\n\n    private loadTreatmentAlarmsCount() {\n        this.totalTreatmentLoading = true;\n        const _filter = this.filterSelectedData;\n\n        if (!_filter.selectedCustomers || _filter.selectedCustomers.length === 0) {\n            const ws = this.dataService.getWorkspace();\n\n            _filter.selectedCustomers = ws.userCustomerChildIds.map((customerChildsPermissions: customerChildsPermissions) => customerChildsPermissions.customer)\n        }\n\n        this.alarmService.countAuditGroupDisk(this.buildFilter(this.filterSelectedData)).subscribe(result => {\n            this.totalTreatment[0] = result.lowRiskCount;\n