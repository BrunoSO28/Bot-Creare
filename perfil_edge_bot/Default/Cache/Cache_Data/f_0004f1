e(() => this.setUpdating(false))\n    );\n  }\n\n  private setLinks(links: ReportLinkEntity[]): void {\n    this.links$.next(links);\n  }\n\n  public getLinks$(): Observable<ReportLinkEntity[]> {\n    return this.links$.asObservable();\n  }\n\n  public loadEmbed(): Observable<any> {\n    this.setUpdating(true);\n\n    return this.biService.getEmbed().pipe(tap(response => {\n      this.setEmbed$(response)\n    } ));\n  }\n\n  private setEmbed$(embed: any): void {\n    this.embed$ = embed;\n  }\n\n  public getEmbed$(): Observable<any> {\n    return this.embed$.asObservable();\n  }\n\n  public isUpdating$(): Observable<boolean> {\n    return this.updating$.asObservable();\n  }\n\n  public setUpdating(updating: boolean): void {\n    this.updating$.next(updating);\n  }\n\n}\n","import { Injectable } from \"@angular/core\";\nimport { BehaviorSubject, Observable } from \"rxjs\";\nimport { Driver, Asset } from \"../models\";\nimport { AssetService } from \"../data/asset.service\";\n\n@Injectable()\nexport class DriverFacade {\n\n  protected updating$: BehaviorSubject<boolean> = new BehaviorSubject<boolean>(false);\n  protected driver$: BehaviorSubject<Driver[]> = new BehaviorSubject<Driver[]>([]);\n\n  constructor(\n    private assetService: AssetService\n  ){}\n\n  isUpdating$(){\n    return this.updating$.asObservable();\n  }\n\n  setUpdating(updating: boolean){\n    this.updating$.next(updating);\n  }\n\n  get$(){\n    return this.driver$.asObservable();\n  }\n\n  set(driver: Driver[]){\n    this.driver$.next(driver);\n  }\n\n  loadDriversByCustomersChild(customersChild: number[]){\n    this.setUpdating(true);\n\n    this.assetService\n      .getAssetsByManyCustomerChildAndAssetType(customersChild, 1000)\n      .subscribe(\n        assets => { this.set( assets.map(asset => { return {id: asset.id, name: asset.name, customerChildId: asset.customerChildId, identification: asset.identification, integration: null, status: asset.status }} ) ) },\n        error => { console.log