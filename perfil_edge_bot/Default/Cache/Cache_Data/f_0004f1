id {\n      that.loadingAnimateService.setValue(true);\n    }, delayMs);\n  }\n\n  public stopLoading(tempoLimiteMs: number): void {\n    let that: any = this;\n    setTimeout(function (): void {\n      that.loadingAnimateService.setValue(false);\n    }, tempoLimiteMs);\n  }\n\n  public registrarAcao() {\n    this.hideActionModal();\n  }\n\n  public onHideAction(e) {\n    this.loadedMap = false;\n    this.playedVideo = false;\n  }\n\n  public filterData() {\n    this.initLoading(0);\n    let _filter: FilterAlarms;\n\n    _filter = this.filterSelectedData;\n\n    this.alarmService.getAlarmsByFilterDefault(this.buildFilter(_filter))\n      .subscribe((_alarms: Array<Alarm>) => {\n          this.equipmentTypes = this.getUniqueEquipmentTypesFromAlarms(_alarms);\n          this.getAvailableAlarmTypes(_alarms);\n          this.dataService.registerAlarms(_alarms);\n          this.refreshGrid();\n          this.stopLoading(0);\n      },\n        error => {\n          this.stopLoading(0);\n          console.info(this.translateJsonService.getTranslateSubs('AUDIT.register_alarm_types_error'), error);\n        });\n  }\n\n  private loadAlarms(): void {\n    this.alarmService.getAlarms()\n      .subscribe((_alarms: Array<Alarm>) => {\n        this.dataService.registerAlarms(_alarms);\n        this.refreshGrid();\n      },\n        error => {\n          console.info(this.translateJsonService.getTranslateSubs('AUDIT.register_alarm_types_error'), error);\n        });\n  }\n\n\n\n  public getAlarmTypeByIndex(idx: number): number {\n    let result: number = 0;\n    /*\n    FaceMissing = 1,\n    Atten_Warning = 2,\n    Look_Around_Warning = 3,\n    Phone_Warning = 4,\n    Change_Warning = 5\n    */\n    switch (idx) {\n      case 0:\n        result = 1;\n        break;\n      case 1:\n        result = 2;\n        break;\n      case 2:\n        result = 3;\n        break;\n      case 3:\n        result = 4;\n        break;\n\n      default:\n        result = 5;\n        break;\n    }\n\n    return result;\n  }\n\n  private agGridAlarmRanking(): void {\n    for (let i = 0; i <= 3; i++) {\n      this.gridOptionsAlarms[i] = <GridOptions>{};\n      this.gridOptionsAlarms[i].columnDefs = this.createColumnDefsAlarm();\n      this.gridOptionsAlarms[i].rowData = this.createRowDataAlarm();\n      this.gridOptionsAlarms[i].enableFilter = true;\n      this.gridOptionsAlarms[i].enableSorting = true;\n      this.gridOptionsAlarms[i].paginationPageSize = 6;\n      this.gridOptionsAlarms[i].datasource = this.dataSource;\n    }\n  }\n\n  private dataSource = {\n    overflowSize: 100,\n    getRows: (params: any) => {\n      let rowData = ['cercas'];\n      let rowsThisPage;\n      if (rowData) {\n        rowsThisPage = rowData.slice(params.startRow, params.endRow);\n      }\n      let lastRow = -1;\n      params.successCallback(rowsThisPage, lastRow);\n    }\n  }\n\n  private createColumnDefsAlarm() {\n    return [\n      { headerName: 'Motorista', field: 'driverName', width: 100 },\n      {\n        headerName: 'Placa', field: 'assetIdentification',\n        cellRenderer: 'group',\n        cellRendererParams: { suppressCount: true },\n        width: 80\n      },\n\n      { headerName: 'Tipo', field: 'typeAlarmDescription', width: 100 },\n      { headerName: 'Nivel', field: 'level', width: 70 },\n      { headerName: 'Latitude', field: 'latitude', width: 100 },\n      { headerName: 'Longitude', field: 'longitude', width: 100 },\n      {\n        headerName: \"Tratamento\",\n        suppressMenu: true,\n        suppressSorting: true,\n        template:\n          `<button data-action-type=\"action\" >\n            <img t src=\"assets/images/phone.png\" data-action-type=\"action\" />\n          </button>`\n      }\n    ];\n  }\n\n  private createRowDataAlarm(): any[] {\n\n    return this.dataService.getAllAlarmsDtoByDriver();\n  }\n\n  public onRowClicked(e) {\n    if (e.event.target !== undefined) {\n      let data = e.data;\n      let actionType = e.event.target.getAttribute(\"data-action-type\");\n\n      switch (actionType) {\n        case \"action\":\n          return this.onActionViewClick(data);\n\n        case \"remove\":\n      }\n    }\n  }\n\n  public onActionViewClick(data): void {\n    this.selectedAction = data;\n    this.actionModalAudit.show();\n  }\n  \n  public hideActionModal(e?): void {\n    this.aiAlarmValidations = []\n    this.actionModalAudit.hide();\n  }\n\n  public onQuickFilterChanged($event) {\n    for (let i = 0; i < 3; i++) {\n      if (this.gridOptionsAlarms[i].api) {\n        this.gridOptionsAlarms[i].api.setQuickFilter($event.target.value);\n      }\n    }\n    this.filterRowData($event.target.value);\n    this.changeRowData();\n\n  }\n\n\n\n  public filterRowData(filter): void {\n    let alarms = this.dataService.getAllAlarmsDtoByDriver();\n    // ranking\n    for (let i = 0; i < 3; i++) {\n      this.gridOptionsAlarms[i].rowData = alarms;\n      if (this.gridOptionsAlarms[i].api) {\n        this.gridOptionsAlarms[i].api.setRowData(this.gridOptionsAlarms[i].rowData);\n      }\n\n    }\n  }\n\n  /**\n   * Avisa ao componente quando os dados do\n   * filtro estão carregados e prontos para uso\n   */\n  public subscribeFilterLoaded() {\n    this.loaded = this.workspaceService.filtroCarregado.subscribe(\n      (carregado) => {\n        if (carregado) this.getFilterAlarms();\n      }\n    )\n  }\n\n  /**\n   * Recupera os filtros do Workspace e chama os Alarmes\n   */\n  public getFilterAlarms(): FilterAlarms {\n    this.initLoading(0);\n    let _filterData: FilterAlarms = new FilterAlarms();\n    let kp: Workspace = this.dataService.getWorkspace();\n\n    if (kp) {\n      if (kp.selectedFilterAlams) {\n        this.filterSelectedData = kp.selectedFilterAlams;\n\n        this.refreshRankingData();\n      }\n    }\n    return _filterData;\n  }\n\n  /**\n   * Busca os Alarmes no servidor e registra-os no Workspace\n   */\n  public getAlarmsByFilter(): void {\n    let _filter: FilterAlarms;\n\n    if (this.filterSelectedData.isValidFilter()) {\n      _filter = this.filterSelectedData;\n\n      // reload data\n      this.alarmService.getAlarmsByFilterDefault(this.buildFilter(_filter))\n        .subscribe((_alarms: Array<Alarm>) => {\n          this.getAvailableAlarmTypes(_alarms);\n          this.dataService.registerAlarms(_alarms);\n\n          this.equipmentTypes = this.getUniqueEquipmentTypesFromAlarms(_alarms);\n          if (_alarms.length < 1) {\n            this.notificationService.printWarningMessage(this.translateJsonService.getTranslateSubs('PAGE-PORTAL.msg_no_results'));\n          }\n\n          this.refreshGrid();\n        },\n          error => {\n            console.info(this.translateJsonService.getTranslateSubs('AUDIT.register_alarm_types_error'), error);\n          });\n    } else {\n      alert(this.translateJsonService.getTranslateSubs('AUDIT.enter_the_search_filter') + '.(audit)');\n    }\n  }\n\n  private buildFilter(filter: FilterAlarms): DefaultFilter {\n    let defaultFilter = new DefaultFilter();\n    defaultFilter.custIds = filter.selectedCustomers;\n    defaultFilter.date1 = this.configService.convertDateToIsoString(filter.selectedDateStart);\n    defaultFilter.date2 = this.configService.convertDateToIsoString(filter.selectedDateEnd);\n    defaultFilter.alarmTypes = filter.selectedAlarmTypes;\n    defaultFilter.driverIds = filter.selectedDrivers;\n    defaultFilter.vehicleIds = filter.selectedVehicles;\n    defaultFilter.timezone = this.dataService.getBrowserTimezoneOffset();\n    return defaultFilter;\n  }\n\n  /**\n  * Alimenta o Grid com os Alertas\n  */\n\n  public refreshRankingData(): void {\n    this.loadingTable = true;\n    this.filteredValue = undefined\n    this.onChangeAlarmType(null, [])\n    this.initLoading(0);\n    this.requestInProgress.emit(true);\n\n    const _filter = this.filterSelectedData;\n\n    if(!_filter.selectedCustomers || _filter.selectedCustomers.length === 0) {\n        const ws = this.dataService.getWorkspace();\n        \n        _filter.selectedCustomers = ws.userCustomerChildIds.map((customerChildsPermissions : customerChildsPermissions) => customerChildsPermissions.customer)\n    }\n\n    this.alarmService.getAlarmsAuditByFilterDefault(this.buildFilter(_filter)).subscribe((_alarms: Alarm[]) => {\n      this.getAvailableAlarmTypes(_alarms);\n      this.equipmentTypes = this.getUniqueEquipmentTypesFromAlarms(_alarms);\n      _alarms.forEach((alarm: Alarm) => {\n        if (!alarm.validation && !alarm.auditDriver) {\n          alarm.auditTreatmentName = this.translateJsonService.getTranslateSubs('AUDIT.alert_not_validation');\n          alarm.auditCreate_date = null;\n        } else {\n          let treatmentFound = this.treatmentNames.find((treatmentName) => treatmentName.value == alarm.auditTreatmentName);\n          if (typeof treatmentFound == 'undefined') this.treatmentNames.push({ label: alarm.auditTreatmentName, value: alarm.auditTreatmentName });\n        }\n        if (alarm.auditWorkflowDtoList && alarm.auditWorkflowDtoList.length > 0) {\n          const audits = alarm.auditWorkflowDtoList.find(a => a.statusId == 3 || a.statusId == 4);\n\n          if (audits) {\n            alarm.revisado = true;\n          } else {\n            alarm.revisado = false;\n          }\n        }\n\n        const normalizedTimezone = this.dataService.normalizeTimezone(alarm.timeZone || '-03:00');\n        const rawDatetimeStr = typeof alarm.datetime === 'string' ? alarm.datetime : ((alarm as any).datetimestamp != null && typeof (alarm as any).datetimestamp === 'string' ? (alarm as any).datetimestamp : null);\n        const rawAvailableMediaAtStr = (alarm as any).availableMediaAtTimestamp != null && typeof (alarm as any).availableMediaAtTimestamp === 'string'\n          ? (alarm as any).availableMediaAtTimestamp\n          : (typeof alarm.availableMediaAt === 'string' ? alarm.availableMediaAt : (alarm.availableMediaAt != null ? String(alarm.availableMediaAt) : null));\n        const rawAvailableMediaAtForTooltip = (alarm as any).available_media_at != null\n          ? String((alarm as any).available_media_at)\n          : (typeof alarm.availableMediaAt === 'string' ? alarm.availableMediaAt : (alarm.availableMediaAt != null ? String(alarm.availableMediaAt) : null));\n        const browserDifferentFromMinus3 = this.dataService.getBrowserTimezoneOffset() !== '-03:00';\n\n        alarm['_timezoneDifferent'] = this.dataService.isTimezoneDifferent(alarm.timeZone);\n        alarm['_showAvailableMediaAtTooltip'] = browserDifferentFromMinus3;\n\n        if (rawDatetimeStr && alarm['_timezoneDifferent']) {\n          const tooltipStr = this.dataService.formatRawDateTimeForTooltip(rawDatetimeStr);\n          if (tooltipStr) (alarm as any)._tooltipDatetime = `${tooltipStr} (${normalizedTimezone})`;\n        }\n        \n        if (rawAvailableMediaAtForTooltip && browserDifferentFromMinus3) {\n          const tooltipStr = this.dataService.formatRawDateTimeForTooltip(rawAvailableMediaAtForTooltip);\n          if (tooltipStr) (alarm as any)._tooltipAvailableMediaAt = `${tooltipStr} (-03:00)`;\n        }\n        \n        if (rawAvailableMediaAtStr && !(alarm as any).availableMediaAtTimestamp) {\n          (alarm as any)._rawAvailableMediaAtForDisplay = rawAvailableMediaAtStr;\n        }\n\n        if (alarm.datetime) {\n          alarm.datetime = this.dataService.convertToAlarmTimezone(alarm.datetime.toString(), alarm.timeZone);\n        }\n\n        if ((alarm as any).availableMediaAtTimestamp) {\n          const availableMediaAtDate = this.parseTimestampToDate((alarm as any).availableMediaAtTimestamp);\n          if (availableMediaAtDate) alarm.availableMediaAt = availableMediaAtDate;\n        } else if (alarm.availableMediaAt) {\n          alarm.availableMediaAt = this.dataService.convertToAlarmTimezone(alarm.availableMediaAt.toString(), alarm.timeZone);\n        }\n\n        if (alarm.auditCreate_date) {\n          const timezone = alarm.timeZoneTreatment || alarm.timeZone;\n          alarm['_originalAuditCreateDate'] = alarm.auditCreate_date.toString();\n          const dateStr = alarm.auditCreate_date.toString();\n          alarm.auditCreate_date = dateStr.endsWith('Z')\n            ? new Date(dateStr)\n            : this.dataService.convertToAlarmTimezone(dateStr, timezone);\n        }\n        \n        if (alarm.treatmentStartedAt) {\n          alarm['_originalTreatmentStartedAt'] = alarm.treatmentStartedAt.toString();\n          const timezone = alarm.timeZoneTreatment || \"-03:00\";\n          const dateStr = alarm.treatmentStartedAt.toString();\n          alarm.treatmentStartedAt = dateStr.endsWith('Z')\n            ? new Date(dateStr)\n            : this.dataService.convertToAlarmTimezone(dateStr, timezone);\n        }\n        \n        if (alarm.firstAuditCreateDateWithTimezone) {\n          alarm.firstAuditCreateDate = new Date(alarm.firstAuditCreateDateWithTimezone);\n        } else if (alarm.firstAuditCreateDate) {\n          alarm['_originalFirstAuditCreateDate'] = alarm.firstAuditCreateDate.toString();\n\n          const timezone = alarm.timeZoneTreatment || \"-03:00\";\n          alarm.firstAuditCreateDate = this.dataService.convertToAlarmTimezone(\n            alarm.firstAuditCreateDate.toString(),\n            timezone\n          );\n        }\n\n        const dateNow = new Date();\n        const dateAlarm = new Date(alarm.datetime);\n        const availableMediaAt = new Date(alarm.availableMediaAt ? alarm.availableMediaAt : alarm.insertDate);\n        const dateTreat = new Date(alarm.auditCreate_date)\n        const read = this.dataService.diff(availableMediaAt, dateNow);\n        const delay = (this.dataService.diff(dateAlarm, availableMediaAt)).includes('-') ? \"0h 00m 00s\" : this.dataService.diff(dateAlarm, availableMediaAt);\n        const timeToTreat = this.dataService.diff(availableMediaAt, dateTreat);\n  \n        alarm.delayDate = delay;\n        alarm.timeRead = read;\n        alarm.auditCreate_date ? alarm.timeToTreat = timeToTreat : alarm.timeToTreat = null;\n      })\n      this.allAlarms = _alarms.map(item => ({\n            ...item,\n            plateOrPrefix: `${item.vehicle_plates || ''} ${item.vehicle_prefix || ''}`.toLowerCase()\n      }));\n      this.allAlarms = this.removeAlarmType(0, this.allAlarms);\n      \n      this.allAlarms.forEach(alarm => {\n\n        if ([AlarmTypeCodeEnum.DROWSINESS_L1_CONFIRMATION,\n              AlarmTypeCodeEnum.DROWSINESS_L2_CONFIRMATION,\n              AlarmTypeCodeEnum.SOMNOLENCE_L1,\n              AlarmTypeCodeEnum.SOMNOLENCE_L2,\n              AlarmTypeCodeEnum.ACCUMULATED_DROWSINESS].includes(alarm.originalTypeAlarm)) {\n          if (alarm.validation && alarm.auditDriver && alarm.purposeCode === 2)\n                alarm.humanEvaluationTreatment = \"INVALID\";\n          else if (alarm.validation && alarm.auditDriver && alarm.purposeCode === 1)\n            alarm.humanEvaluationTreatment = \"FINISH\";\n          else if (alarm.auditDriver)\n                alarm.humanEvaluationTreatment = \"VALID\";\n        }\n        alarm.typeAlarmTranslate = this.translateJsonService.getTranslateSubs(this.translateJsonService.getAlarmTypesTranslate(alarm.typeAlarm));\n        alarm.orignalTypeAlarmTranslate = this.translateJsonService.getTranslateSubs(this.translateJsonService.getAlarmTypesTranslate(alarm.originalTypeAlarm));\n\n        alarm.auditAlarm = alarm.auditDriver\n        alarm.alarmToFiltering = (typeof alarm.groupRisk != 'undefined') ? alarm.groupRisk : alarm.originalGroupRisk\n        if(alarm.auditTreatmentName == \"Alarme Inválido\" || alarm.auditTreatmentName == \"Alerta Inválido\") alarm.auditTreatmentName = this.translateJsonService.getTranslateSubs('AUDIT.invalid_alert')\n        alarm.auditTreatmentName = this.translateJsonService.getTranslatedTreatmentName(alarm.auditTreatmentName);\n      })\n\n      if (_alarms.length < 1) {\n        this.notificationService.printWarningMessage(this.translateJsonService.getTranslateSubs('PAGE-PORTAL.msg_no_results'));\n        this.loadingTable = false;\n      }\n\n      \n      this.loadingTable = false;\n      this.stopLoading(1000);\n    },\n    err => {\n      this.loadingTable = false;\n      this.stopLoading(1000);\n      this.notificationService.printErrorMessage(this.translateJsonService.getTranslateSubs('PAGE-PORTAL.error_to_retrieve_alerts'));\n      this.requestInProgress.emit(false);\n    },\n    () => { \n      this.requestInProgress.emit(false);\n    });\n  }\n\n  /**\n   * Chama o Refresh nos dados do Ranking\n   */\n  private refreshGrid(): void {\n    this.stopLoading(1000);\n    this.refreshRankingData();\n  }\n\n  /*\n   * TODO: Ainda não sei pra que serve.\n   */\n  public changeRowData(): void {\n    for (let i = 0; i <= 3; i++) {\n      this.gridOptionsAlarms[i]['data'] = ['Cansaço', 'Ausência Direção', 'Fumando', 'Sono', 'Celular'];\n      this.gridOptionsAlarms[i].paginationPageSize = 10;\n      this.gridOptionsAlarms[i] = Object.assign({}, this.gridOptionsAlarms[i]);\n    }\n  }\n\n  public relatedAuditAlarms(auditDriver?: number, auditAlarm?: number, notAudit?: number) {\n    let selectedAlarms: Alarm[];\n\n    if (auditDriver) {\n      selectedAlarms = this.allAlarms.filter((alarm: Alarm) => alarm.auditDriver == auditDriver);\n    }\n    if (auditAlarm) {\n      selectedAlarms = this.allAlarms.filter((alarm: Alarm) => alarm.auditAlarm == auditAlarm);\n    }\n    if (notAudit) {\n      selectedAlarms = this.allAlarms.filter((alarm: Alarm) => alarm.id == notAudit);\n    }\n\n    const finalAlarms = selectedAlarms.map(alarm => {\n        alarm.selected = true;\n        alarm.typeAlarmDescription = this.translateJsonService.getAlarmTypesTranslate(alarm.typeAlarm);\n        alarm.urlPictures = [];\n        alarm.picture = null;\n        return alarm;\n      })\n\n    this.treatmentFlowService.setAlarms(finalAlarms)\n\n    this.selectedAlarm = selectedAlarms[0];\n\n    this.showDetails = true;\n  }\n\n  public selectRelatedCamera(alarm: Alarm) {\n    this.selectedAlarm = alarm;\n  }\n\n  public playVideo(movie: string) {\n    this.playedVideo = true;\n  }\n\n  /**\n   * Carrega as informações da tratativa na Modal\n   * @param alarm\n   */\n\n  public selectedAlarmHistory(alarm: Alarm) {\n    this.isEditable = alarm.isEditable;\n    this.historyAuditList = alarm.auditHistories.map(result => result);\n    this.historyAuditList.pop();\n    this.historyAuditList.reverse();\n  }\n\n  removeAlarmType(alarmType : number, alerts : Alarm[]): Alarm[] {\n    return alerts.filter(a => a.typeAlarm != alarmType);\n  };\n\n  public async getAlarmAuditHistories(alarm: Alarm): Promise<Alarm> {\n    return new Promise<Alarm>((resolve, reject) => {\n\n      let alarmWithAuditHistory: Alarm = JSON.parse(JSON.stringify(alarm));\n\n      this.alarmService.getAuditHistories(alarm.id).subscribe(\n        auditHistories => {\n          alarmWithAuditHistory.isEditable = auditHistories.alarmIsEditable\n          alarmWithAuditHistory.auditHistories = auditHistories.history;\n          resolve(alarmWithAuditHistory);\n        },\n        error => {\n          reject(error);\n        }\n      )\n    });\n\n  }\n\n  btnAlarmAuditBlock = false\n  public async selectedAlarmAudit(alarm: Alarm) {\n    this.btnAlarmAuditBlock = true\n    const { id: currentUserId } = this.userService.currentUser()\n    this.getEmailLog(alarm)\n    this.getLinkedAlarms(alarm);\n    this.alarmSelectedRow.alarmOrigin = alarm.alarmOrigin as AlarmOrigin;\n    this.isAuditedAlarm = false;\n    //this.getAiAlarmValidationsByAlarm(alarm)\n    const evaluation = this.dataService.returnEvaluationStatus(alarm.aiEvaluationStatus);\n    this.aiAlarmValidations = evaluation ?  [evaluation] : [];\n    if (alarm.auditDriver || alarm.auditAlarm) {\n      try {\n        alarm = await this.getAlarmAuditHistories(alarm)\n        this.isAuditedAlarm = true;\n      } catch (error) {\n        console.log(\"Error on