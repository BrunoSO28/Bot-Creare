rv) => drv[0] == alarm.driverId)\n            if(driver){\n                driver[1] = driver[1] + 1;\n            }else{\n                drivers.push([alarm.driverId, 1, alarm.driver_firstname]);\n            }\n        })\n\n\n        this.data_chartTopDrivers = [];\n        drivers.sort((one, two) => (one[1] > two[1] ? -1 : 1)).forEach((driver, i) => {\n            if(i < 15){\n                this.data_chartTopDrivers.push([driver[1], driver[2]]);\n            }\n        })\n\n        /* this.data_chartTopDrivers = [\n            ['Motorista', 'Ocorrências'],\n            ['JUNIOR CESAR FAGUNDES DE MELO', 432],\n            ['LEONARDO SILVA LUZ', 422],\n            ['Motorista nao Identificado F. Veículos de Apoio', 380],\n            ['PAULO JOSUÉ DA CONCEIÇÃO', 311],\n            ['RICARDO AVILA', 222],\n            ['JUNIOR CESAR FAGUNDES DE MELO', 111],\n            ['LEONARDO SILVA LUZ', 80],\n            ['Motorista nao Identificado F. Veículos de Apoio', 72],\n            ['PAULO JOSUÉ DA CONCEIÇÃO', 20],\n            ['RICARDO AVILA', 11],\n            ['JUNIOR CESAR FAGUNDES DE MELO', 8],\n            ['LEONARDO SILVA LUZ', 8],\n            ['Motorista nao Identificado F. Veículos de Apoio', 5],\n            ['PAULO JOSUÉ DA CONCEIÇÃO', 2],\n            ['RICARDO AVILA', 1]\n        ]; */\n\n        this.type_chartTopDrivers = \"BarChart\";\n\n        this.options_chartTopDrivers = {\n            title: 'TOP 15 Condutores',\n            height: '650',\n            chartArea: {width: '10%'},\n            backgroundColor: { fill:'transparent' },\n            legend: { position: \"none\" },\n            hAxis: {\n              title: 'Ocorrências',\n              minValue: 0,\n              textStyle: {\n                bold: true,\n                fontSize: 12,\n                color: '#4d4d4d'\n              },\n              titleTextStyle: {\n                bold: true,\n                fontSize: 18,\n                color: '#4d4d4d'\n              }\