ata(false);\n      }\n    );\n  }\n  \n  // Avisa ao componente quando os dados do \n  // filtro estão carregados e prontos para uso\n  public subscribeFilterLoaded() {\n    this.loaded = this.workspaceService.filtroCarregado.subscribe(\n      (carregado) => {\n        //console.log(\"SubsFilter\");\n        if(carregado) this.getFilterAlarms();\n      }\n    )\n  }\n\n  public subscribeOnline() {\n    this.subOnline = this.workspaceService.botaoOnline.subscribe((online) => {\n      this.isOnlineChecked = online;\n      if(!this.isOnlineChecked){\n        if(online){\n          this.subscribeToData();\n        }\n      }\n    })\n  }\n\n  public subscribeCheckNewAlarms() {\n    this._state.subscribe('painel.setCheckNewAlarm', (checkOptions) => {      \n            this.checkAlarmOptions = checkOptions;\n    });  \n  }\n\n  public onFilterVehicles(place){\n    this.gridOptionsRanking.api.setQuickFilter(place);\n    this.filterRowData(place);\n    this.changeRowData();\n    this.changeRowDataMap();\n    this.changeMapRowData(); \n  }\n\n  // Caixa de pesquisa na Box \"Ultimos Alertas\"\n  public onQuickFilterChanged($event) {\n      this.gridOptionsRanking.api.setQuickFilter($event.target.value);\n      this.filterRowData($event.target.value);\n      this.changeRowData();\n      this.changeRowDataMap();\n      this.changeMapRowData(); \n  }\n\n  public limparFiltros(){\n    this.gridOptionsRanking.api.setQuickFilter(\"\");\n  }\n\n  // Atualiza os itens do Mapa\n  public changeRowDataMap(filteredAlarm? : Alarm[]): void {\n    let _alarms: AlarmDto[] = new Array<AlarmDto>();\n\n/*     if(filteredAlarm){\n      filteredAlarm.forEach((alarm : Alarm) => {\n        let _alarm;\n  \n        _alarm.latitude = alarm.latitude;\n        _alarm.longitude = alarm.longitude;\n        _alarms.push(_alarm);\n      })\n    }else{\n      this.allAlarms.forEach((alarm : GroupedAlarns) => {\n        let _alarm;\n  \n        _alarm.latitude = alarm.latitude;\n        _alarm.longitude = alarm.longitude;\n        _alarms.push(_alarm);\n      })\n    } */\n\n    if (this.gridOptionsRanking && this.gridOptionsRanking.api) {\n      this.gridOptionsRanking.api.forEachNodeAfterFilter( (rowNode) => {\n      let _alarm = Object.assign(<AlarmDto>{}, rowNode.data);\n\n      _alarm.latitude = rowNode.data.latitude;\n      _alarm.longitude = rowNode.data.longitude;\n      _alarms.push(_alarm);\n    })}\n\n    this.mapOptions.rowData = _alarms;   \n  }\n  \n  // Filtra os dados da Tabela Ag-Grid\n  public filterRowData(filter): void {\n      this.gridOptionsRanking.rowData = this.dataService.getFilteredAlarmDtoList();\n      if (this.gridOptionsRanking.api) {\n        this.gridOptionsRanking.api.setRowData(this.gridOptionsRanking.rowData);  \n      }\n  }\n\n  public removeAlarms(ids) {\n    this.gridOptionsRanking.rowData = this.dataService.getFilteredAlarmDtoList().reduce((acumAlarms : Alarm[], alarm: Alarm) => {\n      if(!ids.map((id) => parseInt(id)).includes(alarm.id)){\n        acumAlarms.push(alarm);\n      }\n      return acumAlarms;\n    }, []);\n\n    if (this.gridOptionsRanking.api) {\n      this.gridOptionsRanking.api.setRowData(this.gridOptionsRanking.rowData);  \n    }\n  }\n\n  public changeRowData(): void {\n      this.gridOptionsRanking.paginationPageSize = 10;\n      this.gridOptionsRanking = Object.assign({}, this.gridOptionsRanking);\n  }\n\n  public changeMapRowData(): void {\n    this.mapOptions = Object.assign({}, this.mapOptions);\n  }\n\n  // Carrega os filtros já setados no Workspace,\n  // chama o método para carregar os dados na pagina\n  public getFilterAlarms(): FilterAlarms {\n    let _filterData: FilterAlarms = new FilterAlarms();\n\n    let kp: Workspace  = this.dataService.getWorkspace();\n\n    if (kp) { \n      if (kp.selectedFilterAlams) {\n        this.filterSelectedData = kp.selectedFilterAlams;\n\n        if(this.workspaceService.botaoOnline.getValue()){\n          this.requestAlarmData(true);\n        }else{\n          this.refreshGrid();\n        }\n      }\n    }\n    return _filterData;\n  }\n\n  // Carrega os dados na página\n  public requestAlarmData(subscribe: boolean) {\n    let _filter: FilterAlarms;\n\n    if (this.filterSelectedData.isValidFilter()) {\n      this.initLoading(0);\n\n      _filter = this.filterSelectedData\n\n      this.subREquestAlarmData = this.alarmService.getAlarmsByFilter(_filter)\n      .subscribe((_alarms: Array<Alarm>) => {\n         this.notifyNewAlarms(_alarms);\n         this.dataService.registerAlarms(_alarms);\n         \n        if(_alarms.length < 1){\n          this.notificationService.printWarningMessage(this.getTranslateSubs('PAGE-PORTAL.msg_no_results'));\n        }\n         \n        if (subscribe && _alarms.length > 0) {\n            this.refreshGridSubscription();\n            this.subscribeToData();            \n        } else {\n          this.refreshGrid();  \n        }\n\n         this.stopLoading(1000);\n      },\n      error => {\n         this.stopLoading(1000);\n         console.info(this.translateJsonService.getTranslateSubs('AUDIT.register_alarm_types_error'), error);      \n      }); \n    } else {\n      this.notificationService.printWarningMessage(this.getTranslateSubs('FILTER-GLOBAL.msg_notfilter'));\n    }\n  }\n\n  // Para Animação Carregamento\n  public stopLoading(tempoLimiteMs: number): void {\n      let that: any = this;\n      setTimeout(function(): void {\n        that.loadingAnimateService.setValue(false);      \n      }, tempoLimiteMs);\n  }\n\n  // Inicia Animação Carregamento\n  public initLoading(delayMs: number): void {\n      let that: any = this;\n      setTimeout(function(): void {\n              that.loadingAnimateService.setValue(true);\n      }, delayMs);\n  }\n\n  // Para de verificar os Alarmes a cada 5 segundos\n  public stopLoadingAlarm() {\n    if (this.alarmSubscription) {\n      this.alarmSubscription.unsubscribe();\n    }\n  }\n\n  public subscribeToData(): void {\n    this.stopLoadingAlarm();\n    this.alarmSubscription = observableTimer(60000).pipe(first()).subscribe(() => this.requestLoadAlarms());\n  }\n\n  private requestLoadAlarms(): void {\n    if (this.isOnlineChecked) {\n        this.changeOnlineInterval();\n        this.requestAlarmData(true);\n    } else {\n        this.subscribeToData(); \n    }\n  }\n\n  /**\n   * Altera as Datas para as últimas 24 Horas\n   */\n  public changeOnlineInterval() {\n    let today: Date = new Date(), \n        today24hLast: Date = new Date(), \n        today24hForward: Date = new Date();\n        \n    today24hLast.setHours(today.getHours() - 1*24);\n    today24hForward.setHours(today.getHours());\n    this.filterSelectedData.selectedDateStart = today24hLast;\n    this.filterSelectedData.selectedDateEnd = today24hForward;\n  }\n \n  //**********   CONFIGURAÇÕES DO MAPA    **********//\n  private mapOptionsAlarm(): void {\n      this.mapOptions = <MapOptions>{};\n      this.mapOptions.rowData = this.createRowDataAlarm(); \n  }\n\n  public getFullWidthCellRenderer() {\n        return null;\n  }\n\n  //**********   CONFIGURAÇÕES TABELA AG-GRID    **********//\n\n  // Configurações da Tabela AG-GRID\n  private agGridAlarmRanking(): void {\n    this.gridOptionsRanking = <GridOptions>{};\n    this.gridOptionsRanking.columnDefs = this.createColumnDefsAlarm();\n    this.gridOptionsRanking.rowData = this.createRowDataAlarm();\n    this.gridOptionsRanking.enableFilter = true;\n    this.gridOptionsRanking.enableSorting = true;\n    this.gridOptionsRanking.paginationPageSize= 6;\n    this.gridOptionsRanking.datasource = this.dataSource;\n  }\n\n  private createRowDataAlarm(): any[] {\n    let result : Alarm[] = this.dataService.getAllAlarmsDtoByDriver();\n    result.forEach((alarm : Alarm) => {\n      //alarm.typeAlarmDescription = AlarmTypeEnum[alarm.typeAlarm];\n      alarm.typeAlarmDescription = this.translateJsonService.getAlarmTypesTranslate(alarm.typeAlarm);\n    })\n\n    return result;\n  }\n\n  private getTranslateSubs(key : string) {\n    let translated;\n    this.translateService.get(key).subscribe((res : string) => { translated = res; });\n    return translated;\n  }\n\n  // Colunas do AG-GRID\n  private createColumnDefsAlarm() {\n    \n      return [\n        {headerName: 'ID', field: 'id', width: 68},\n        {headerName: this.getTranslateSubs('GLOBAL.driver'), field: 'driverName', width: 410},\n        {\n          headerName: this.getTranslateSubs('GLOBAL.plate'), field: 'assetIdentification',\n          cellRenderer: 'group',\n          cellRendererParams: {suppressCount: true},\n          width: 80\n        },\n        {\n          headerName: this.getTranslateSubs('GLOBAL.prefix'), field: 'assetPrefix',\n          cellRenderer: 'group',\n          cellRendererParams: {suppressCount: true},\n          width: 80\n        },\n          {headerName: this.getTranslateSubs('GLOBAL.type'), field: 'typeAlarmDescription', width: 80},\n          //{headerName: 'Nivel', field: 'level', width: 50},\n          { headerName: this.getTranslateSubs('PAGE-PORTAL.treatment'),\n          suppressMenu: true,\n          suppressSorting: true,\n          width: 80,\n          template:\n            `<button data-action-type=\"action\" >\n              <i class=\"nb-gear\"></i>\n              <img t src=\"assets/images/phone.png\" data-action-type=\"action\" />\n            </button>\n            `\n        },\n        {headerName: this.getTranslateSubs('PAGE-PORTAL.on_hold'), field: 'timeRead', width: 90},\n        {headerName: this.getTranslateSubs('ROF.generate_in'), field: 'datetime', sort: \"desc\", hide: true},\n        {headerName: this.getTranslateSubs('PAGE-PORTAL.read'), field: 'leitura', width: 60}\n      ];\n  }\n\n  private dataSource = {\n          overflowSize: 100,\n          getRows: (params: any) => {\n              let rowData = ['cercas'];\n              let rowsThisPage;\n              if (rowData) {\n                  rowsThisPage = rowData.slice(params.startRow, params.endRow);    \n              }\n              let lastRow = -1;\n              params.successCallback(rowsThisPage, lastRow);\n          }\n  }\n\n  // ABRE MODAL *** ALTERAR **** \n  public onActionViewClick(data): void {      \n        this.selectedAction = data;\n        this.actionModal.show();\n  }\n\npublic setReadAlarm(alarm: Alarm) : void {\n  if (alarm) {\n      this.subAlarm = this.alarmService.setReadAlarm([alarm.id]).subscribe(() => {\n        this.dataService.setReadFilteredAlarmList(alarm.id);\n        this.refreshGrid();        \n    },\n    error => {\n        console.info('Falha ao definir leitura dos alarmes.' , error);      \n    });  ;\n  }\n}\n\n public onRowClicked(e) {\n        if (e.event.target !== undefined) {\n            let data = e.data;\n            let actionType = e.event.target.getAttribute(\"data-action-type\");\n\n            switch(actionType) {\n                case \"action\": \n                    this.setReadAlarm(data); \n                    return this.onActionViewClick(data);\n\n                case \"remove\":\n                    //return this.onActionRemoveClick(data);\n                    break;\n\n                default:\n                this.centerOnMap(e.data);\n                break;\n            }\n        }\n  }\n\n  // filtrar mosaico \n  public centerOnMap(filter: AlarmDto) {\n       // center maps\n       this.centerAlarm = Object.assign({}, filter);\n       //this.changeMapRowData();\n  }  \n\n\n  // ------------------------------------------------------------------\n  public refreshGridSubscription(): void {\n       // dados do ranking \n\n    this.changeRowData();\n\n    setTimeout(() => {\n      this.refreshRankingData(true);\n      this.changeMapRowData();\n      this.changeRowDataMap();\n    }, 1000)\n\n    this.notifyCountAlarmPending();  \n  }\n\n  public refreshGrid(): void {\n     // dados do ranking \n    this.changeRowData();\n\n    //this.refreshRankingData(); \n    //this.changeMapRowData();\n\n    setTimeout(() => {\n      this.refreshRankingData(true);\n      this.changeMapRowData();\n      this.changeRowDataMap();\n    }, 1000)\n\n    this.notifyCountAlarmPending();\n    //this.changeRowDataMap();\n  }\n\n  /**\n   * Ordena todos os alertas por Data e Hora\n   * @param alarms Alarmes desordenados\n   */\n  public sortByDate(alarms : Alarm[]): Alarm[] {\n    return alarms.sort((a, b) => {\n      let ba = new Date(a.datetime);\n      let bb = new Date(b.datetime);\n      return ba<bb ? -1 : ba>bb ? 1 : 0;      \n    });\n  }\n\n  /**\n   * Válida se o Alerta Folha é compativel com o Alerta Raiz\n   * @param parentAlarm Alerta Raiz\n   * @param childAlarm Alerta possívelmente Folha\n   */\n  private validChild(parentAlarm: Alarm, childAlarm: Alarm){\n    let nowDate = new Date(parentAlarm.datetime);\n    let maxDate = new Date(parentAlarm.datetime);\n    let childDate = new Date(childAlarm.datetime);\n\n    maxDate.setHours(nowDate.getHours() + 1);\n\n    if(childAlarm.id != parentAlarm.id \n      && parentAlarm.driverId == childAlarm.driverId \n      && parentAlarm.typeAlarm == childAlarm.typeAlarm\n      && childDate >= nowDate\n      && childDate <= maxDate\n    ){\n        return true;\n      }else{\n        return false;\n      }\n  }\n\n  /**\n   * Recebe uma lista Ordenada por Data, e agrupa-os\n   * @param alarmsList Lista Ordenada de Alarmes\n   */\n  private defineParent(alarmsList: Alarm[]): GroupedAlarns[] {\n    let groupedAlarms: GroupedAlarns[] = [];\n\n    alarmsList.forEach((alarm : Alarm, i) => {\n      if(i == 0){        \n        alarm['childs'] = [];\n        groupedAlarms.push(alarm);\n      }else{        \n        let group = groupedAlarms.find((group : GroupedAlarns) => this.validChild(group, alarm))\n        if(group){\n          group.childs.push(alarm);\n        }else{          \n          alarm['childs'] = [];\n          groupedAlarms.push(alarm);\n        }\n      }\n    })\n\n    groupedAlarms.forEach((group : GroupedAlarns) => group.quantAlarmsGroup = group.childs.length);\n\n    return groupedAlarms;\n  }\n\n  private refreshRankingData(cluster?: boolean): void { \n    let result : Alarm[] = this.dataService.getFilteredAlarmDtoList();\n\n    \n    // Grid NOVA\n/*     if(cluster){\n      this.allAlarms = this.defineParent(this.sortByDate(result));\n    }else{\n      this.allAlarms = [];\n      result.forEach((alarm : Alarm) => this.allAlarms.push(alarm));\n    } */\n      \n    this.totalAlarm = result.length;\n\n    //this.loadEquipments();\n\n    // GRID ANTIGA\n    result.forEach((alarm : Alarm) => {\n      //alarm.typeAlarmDescription = AlarmTypeEnum[alarm.typeAlarm];\n      alarm.typeAlarmDescription = this.translateJsonService.getAlarmTypesTranslate(alarm.typeAlarm);\n    })\n\n  this.gridOptionsRanking.rowData = result;\n    if (this.gridOptionsRanking.api) {\n      this.gridOptionsRanking.api.setRowData(this.gridOptionsRanking.rowData);\n      let data: any[]  = this.gridOptionsRanking.rowData;\n      this.loadEquipments();  \n    }\n  }\n\n  public removeArray(mArray:any[], toRemove: any[]): any[] {\n      for( var i=mArray.length - 1; i>=0; i--){\n         for( var j=0; j<toRemove.length; j++){\n             if(mArray[i] && (mArray[i] === toRemove[j])){\n              mArray.splice(i, 1);\n            }\n          }\n      }\n      return mArray;\n  }\n\n  public filterTeste(event) {\n    console.log(event);\n  }\n\n  public notifyCountAlarmPending() {\n    let count : number = 0;  \t\n  \tif (this.dataService.getFilteredAlarmList()) {\n  \t\tcount = this.dataService.getFilteredAlarmList().reduce((total:number, alarm: Alarm)=>{ return (alarm.alarmRead)?total:total+1}, 0);\n  \t} \n\n    this._state.notifyDataChanged('painel.setCountPendingValue', count);\n  }\n\n  public speak(message: string) : void {\n      var y = window.speechSynthesis;\n      if (!y) {\n        return console.warn('Your browser does not support `speechSynthesis` yet.');\n      }\n      var s = new SpeechSynthesisUtterance(message);\n      \n      //s.voice = y.getVoices()[1 || 0];\n      s.lang = 'pt-BR';\n      y.speak(s);\n  }\n   \n  public notifyNewAlarms(_alarms: Alarm[]) {\n    let _alarmsDiff : Alarm[] = this.dataService.getAlarmsDiff(_alarms);  \n    if (_alarmsDiff && _alarmsDiff.length > 0) {\n      let alarm : Alarm= _alarmsDiff[0];\n\n            let _driver: Driver = this.dataService.getDriverById(alarm.assetId);\n            let _mensagem: string = 'Alarme   ';\n            let _enableAudio: boolean = false;\n            let _estilo = NotificationType.INFO;\n\n            switch (alarm.typeAlarm) {\n                case 2: { \n                  _mensagem =  'Alerta de Sonolência Nível 1';\n                    _estilo = NotificationType.ERROR;\n                  if (this.checkAlarmOptions.isAttenWarningChecked) {\n                    _enableAudio = true;\n                  }\n                  break;\n                }\n\n                case 5: { \n                    _estilo = NotificationType.SUCCESS;\n                  if (this.checkAlarmOptions.isChangeWarningChecked) {\n                    _enableAudio = true;\n                  }\n                  _mensagem =  'Alerta de Troca de Motorista';\n                  break;\n                }\n\n                case 1: { \n                    _estilo = NotificationType.WARNING;\n                  _mensagem =  'Alerta de Ausência';\n                  if (this.checkAlarmOptions.isFaceMissingChecked) {\n                    _enableAudio = true;\n                  }\n                  break;\n                }\n\n                case 3: { \n                    _estilo = NotificationType.SUCCESS\n                  _mensagem =  'Alerta de Distração Lateral';\n                  if (this.checkAlarmOptions.isLookAroundChecked) {\n                    _enableAudio = true;\n                  }\n                  break;\n                }\n\n                case 4: { \n                   _estilo = NotificationType.INFO;\n                  if (this.checkAlarmOptions.isPhoneWarningChecked) {\n                    _enableAudio = true;\n                  }\n                  _mensagem =  'Alerta uso de Celular';\n                  break;\n                }\n\n                case 6: { \n                  _estilo = NotificationType.ERROR;\n                  if (this.checkAlarmOptions.isTiredChecked) {\n                    _enableAudio = true;\n                  }\n                  _mensagem =  'Alerta de Sonolência Nível 2';\n                  break;\n                }\n\n                default: { \n                  _enableAudio = true;\n                  //statements; \n                  break; \n                } \n            }\n\n\n           \n            if (alarm.driver_firstname) {\n              _mensagem =  _mensagem + '  driver ' + alarm.driver_firstname;\n              if (alarm.driver_lastname) _mensagem =  _mensagem + ' ' + alarm.driver_lastname; \n            } else if (_driver && _driver.name) {\n              _mensagem =  _mensagem + '   driver ' + _driver.name;\n            };\n\n            //_mensagem = \"Rafael \" + alarm.driver_firstname;\n            //_mensagem = \"Veiculo placa \" + alarm.driver_firstname + \" Alarme \"+ AlarmTypeEnum[alarm.typeAlarm];\n              \n\n\n            _enableAudio = true;\n            if (_enableAudio) this.speak(_mensagem);\n\n            this.notificationService.notify( _mensagem , _estilo, NotificationPosition.BOTTOM_LEFT, 20);\n    }\n\n  }\n\n  public hideActionModal($event): void {\n    this.actionModal.hide();\n  }\n\n  public onHideAction($event): void {\n    this.requestAlarmData(false);\n    this.selectedAction = \"\";\n  }\n\n  public registrarAcao(): void {\n     this.actionModal.hide();\n  }\n\n  public getRowHeight(params) {\n      var rowIsDetailRow = params.node.level === 1;\n      // return 300 when detail row, otherwise return 25\n      return rowIsDetailRow ? 300 : 25;\n  }\n\n  public isFullWidthC