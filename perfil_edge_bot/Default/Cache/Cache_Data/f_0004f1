ptionRoute = {color: '#FF0000', weight: 2, opacity: 0.5, dashArray: '5,5', clickable: false};\n    this.addPolyline('MAP_ROUTE_LAYER', 'route', latLongList, optionRoute, null);\n    this.centerMapInObject('MAP_ROUTE_LAYER', null);\n\n\n    let that: any = this;\n      setTimeout(()=>{this.map._onResize()}, 1000);   \n    }\n\n  private redrawAlarmsHeat(_alarms: Alarm[], _cluster: boolean) {\n\n    this.clearHeat();\n\n    this.createHeatLayer(_cluster);\n\n    let contador = 1;\n    let latLongList = [];\n    _alarms.forEach((alarm)=>{        \n          latLongList.push([alarm.latitude, alarm.longitude, 10]);\n    });\n\n    let option = {color: '#FF0000', weight: 5, opacity: 0.5, dashArray: '5,5', clickable: false};\n    this.addHeatMap('MAP_HEAT_LAYER', 'heat', latLongList, option);\n    this.centerMapInObject('MAP_ROUTE_LAYER', null);\n    this.stopLoading(1000);\n  }\n\n\n  private redrawAlarmsRoute(_alarms: Alarm[], _cluster: boolean) {\n    this.clearRoute();\n    this.createRouteLayer(_cluster);\n\n    let contador = 1;\n    let latLongList = [];\n    _alarms.forEach((alarm)=>{        \n        let rotulo = (alarm.id + ' ');\n        let icon = this.iconRoter(rotulo, 'FFFFFF');\n        let asset: Asset = this.dataService.getAssetById(alarm.assetId);\n        let alarmTypeIcon = this.dataService.alarmTypesNumber.find((alarms) => alarms.value === alarm.typeAlarm);\n        let alarmType = \"Teste\";\n        this.addMarker('MAP_ROUTE_LAYER', contador++,  \n          [alarm.latitude, alarm.longitude], icon, rotulo,this.messageRecRota.bind(null, alarm, asset, alarmType, alarmTypeIcon));\n        latLongList.push([alarm.latitude, alarm.longitude]);\n    });\n\n    let option = {color: '#FF0000', weight: 2, opacity: 0.5, dashArray: '5,5', clickable: false};\n    this.centerMapInObject('MAP_ROUTE_LAYER', null);\n    this.stopLoading(1000);\n  }\n\n\n\n  private messageRecRota(alarm: Alarm, asset: Asset, alarmType: AlarmType, alarmTypeIcon): string {\n    let stree