ange-password',\n  styleUrls: ['./user-change-password.component.scss'],\n  templateUrl: './user-change-password.component.html',\n})\nexport class UserChangePasswordComponent implements OnInit, OnDestroy {\n\n  model = {\n    \"password\": '',\n    \"newPassword\": '',\n    \"confirmNewPassword\": ''\n  };\n\n  userMustChangePassword = false;\n  isShowMessageUserMustChangePassword = false;\n  tokenInMemory = null;\n\n  isUppercaseValid = false;\n  isNumberValid = false;\n  isLowercaseValid = false;\n  isSpecialCharValid = false;\n  isLengthValid = false;\n  isPasswordConfirmationValid = false;\n  isValid = false;\n\n  constructor(\n    protected userService: UserService,\n    protected notificatioService: NotificationUtilService,\n    protected translateJsonService: TranslateJsonService,\n    protected router: Router\n  ) { }\n\n  ngOnInit(): void {\n    this.userMustChangePassword = JSON.parse(window.localStorage.getItem('currentUser')).isMustChangePassword;\n\n    if (this.userMustChangePassword) {\n      this.isShowMessageUserMustChangePassword = true\n      this.tokenInMemory = window.localStorage.getItem('access_token')\n      window.localStorage.removeItem(\"access_token\")\n    }\n  }\n\n  ngOnDestroy(): void {\n    if (this.userMustChangePassword) {\n      window.location.reload();\n    }\n  }\n\n  changePassword() {\n    let user = JSON.parse(localStorage.getItem('currentUser'));\n\n    let passwordValidation = this.checkIsValidPassword(this.model.newPassword, this.model.confirmNewPassword, this.model.password)\n\n    if (passwordValidation.isValidPassword) {\n      if (this.tokenInMemory && !window.localStorage.getItem('access_token')) {\n        window.localStorage.setItem('access_token', this.tokenInMemory)\n      }\n\n      let changePasswordJsonBody = JSON.stringify(\n        [\n          {\n            \"id\": user.id,\n            \"senha\": this.model.password\n          },\n          {\n            \"id\": user.id,\n            \"senha\": this.model.newPassword\n          }\n        ]\n      );\n\n      this.userService.changePassword(changePasswordJsonBody).subscribe((result) => {\n        user.isMustChangePassword = false;\n        const updatedCurrentUserString = JSON.stringify(user);\n        localStorage.setItem('currentUser', updatedCurrentUserString)\n    \n        this.notificatioService.printSuccessMessage(result);\n        localStorage.removeItem('userMustChangePassword')\n        this.userMustChangePassword = false;\n        this.router.navigateByUrl('/pages/ui-alarms/fatigue-v2');\n      }, error => {\n        this.notificatioService.printWarningMessage(error);\n      });\n    } else {\n      this.notificatioService.printWarningMessage(passwordValidation.invalidPasswordErrorMessage);\n    }\n  }\n    uppercaseCheck = /(?=[^A-Z]*[A-Z])/;\n    numberCheck = /(?=\\D*\\d)/;\n    lowercaseCheck = /(?=[^a-z]*[a-z])/;\n    specialCharCheck = /(?=.*[$@$!%*?&()#'_=+-,.;:£¢¬§|/<>~^´`])/;\n    lengthCheck = /^.{8,20}$/;\n\n    validatePassword(password: string, passwordConfirmation: string) {\n      this.isUppercaseValid = this.uppercaseCheck.test(password);\n      this.isNumberValid = this.numberCheck.test(password);\n      this.isLowercaseValid = this.lowercaseCheck.test(password);\n      this.isSpecialCharValid = this.specialCharCheck.test(password);\n      this.isLengthValid = this.lengthCheck.test(password);\n      this.isPasswordConfirmationValid = (password !== \"\" && passwordConfirmation !== \"\") ? (password === passwordConfirmation) : false;\n      this.isValid = this.isUppercaseValid && this.isNumberValid && this.isLowercaseValid && this.isSpecialCharValid && this.isLengthValid && this.isPasswordConfirmationValid;\n    } \n\n  checkIsValidPassword(newPassword: string, confirmPassword: string, currentPassword: string): {\n    isValidPassword: boolean,\n    invalidPasswordErrorMessage: string\n  } {\n    if (newPassword === currentPassword) {\n      return {\n        isValidPassword: false,\n     