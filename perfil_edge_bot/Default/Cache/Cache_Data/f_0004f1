ationList.length;\n\n                            if (isAlarmsListEmpty && isInfractionsListEmpty) {\n                                throw { isEmpty: true };\n                            }\n                            \n                            return data;\n                        }),\n                        catchError(err => throwError(err)),\n                    )\n            ),\n        )\n        .subscribe(\n            data => {\n                this.dataService.registerAlarms(data);\n                this.loadContent(this.checkAlerts, this.checkInfractions);\n\n                if (!this.isOnlineCheck && this.subAlarmsData) {\n                    if (this.subAlarmsData) this.subAlarmsData.unsubscribe();\n                }\n            },\n            err => {\n                if (err.isEmpty) {\n                    this.notificationService.printWarningMessage(this.getTranslateSubs('PAGE-PORTAL.msg_no_results'));\n                } else {\n                    this.notificationService.printErrorMessage(this.getTranslateSubs('PAGE-PORTAL.msg_default_error'));\n                }\n                \n                this.dataService.registerAlarms({\n                    alarmList: [],\n                    infractionInformationList: [],\n                });\n                this.loadContent();\n\n                this.workspaceService.setBotaoOnline(false);\n            }\n        )\n    }\n\n    private getWorkspaceFilter(): any {\n        const ws: Workspace = this.dataService.getWorkspace();\n\n        const { selectedFilterAlams } = ws;\n\n        if (!selectedFilterAlams) {\n            return null;\n        }\n\n        return selectedFilterAlams;\n    }\n\n    /**\n     * Função criada apenas para que os filtros sejam aplicados corretamente. \n     * Após o status ser alterado para online, os filtros de horas são atualizados \n     * e setados no workspace, porém, a fução createAlarmsDataSubscription pega o \n     * valor anterior pois o worskpace não é atu