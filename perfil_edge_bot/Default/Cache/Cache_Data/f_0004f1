ld } from '@angular/core';\nimport { DomSanitizer } from '@angular/platform-browser';\nimport { TranslateJsonService } from 'app/@core/data/translate-json.service';\nimport { TreeInputModel } from 'app/@core/models/treeInputModel.entity';\nimport { TreeInputComponent } from 'app/@theme/components';\nimport { environment } from 'environments/environment';\nimport { latLng, LatLng, tileLayer } from 'leaflet';\nimport leafletImage from 'leaflet-image';\nimport { ModalDirective } from 'ngx-bootstrap/modal';\nimport { SelectItem } from 'primeng/primeng';\nimport { AlarmService } from '../../../@core/data/alarm.service';\nimport { DataService } from '../../../@core/data/data.service';\nimport { DriverService } from '../../../@core/data/driver.service';\nimport { TreatmentService } from '../../../@core/data/treatment.service';\nimport { WorkspaceService } from '../../../@core/data/workspace.service';\nimport { mockAlarmTypesData } from '../../../@core/mock/data/alarm.type.mock.data';\nimport { Alarm } from '../../../@core/models';\nimport { PictureAndMovie } from '../../../@core/models/pictureAndMovie.entity';\nimport { Treatment, TreatmentBuild, TreatmentData } from '../../../@core/models/treatment.entity';\nimport { ValidationHistory } from '../../../@core/models/validationHistory.entity';\nimport { Workspace } from '../../../@core/models/workspace.data.entity';\nimport { NotificationUtilService } from '../../../@core/utils/notification.util.service';\nimport { ModelMarkers } from '../leaflet-map/marker-model';\nimport { CommandVoice } from 'app/@core/models/command-voice.entity';\nimport { Audio } from 'app/@core/models/audio.entity';\nimport { VoiceMessageService } from 'app/pages/ui-alarms/voice-message/voice-message.service';\nimport { NotificationPosition, NotificationType } from 'app/@core/enum/notification-options.enum';\n\n@Component({\n    selector: 'focus-treatment',\n    styleUrls: ['./treatment.component.scss'],\n    templateUrl: './treatment.component.html'\n})\n\nexport class TreatmentComponent {\n    @ViewChild('treeInputDrivers') treeInputDrivers: TreeInputComponent;\n    @ViewChild('exportableNotification') exportableNotificationModal: ModalDirective;\n    @ViewChild('alarmMap') alarmMap;\n\n    exportableMap;\n    voiceCommand;\n\n    // Mapa\n    public options = {\n        preferCanvas: true,\n        layers: [tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18, attribution: `&copy ${environment.creareName}` })],\n        zoom: 5,\n        center: latLng([ -29.8873545, -51.1590298 ])\n    };;\n    public allMarkers: ModelMarkers[] = [];\n    public zoom: number;\n    public center: LatLng;\n    public loaded = false;\n\n    /** Este Input foi criado apenas para a transição da Antiga Página Fatigue para a Nova Fatigue-v2\n     *  Após a transição ser concluída, e nenhum cliente utilizar mais a Fatigue antiga, retirar este parâmetro\n     *  bem como todas suas referências.\n     */\n    @Input('isNewFatiguePage') public isNewFatiguePage: boolean = false;\n    @Input('selectedTreatment') public selectedTreatment: Alarm;\n    @Input('relatedAlarms') public relatedAlarms;\n\n    @Output() public auditedAlarns: EventEmitter<number[]> = new EventEmitter();\n    @Output() public closeModal: EventEmitter<boolean> = new EventEmitter();\n\n    @ViewChild('moviePlayer') moviePlayer: any;\n\n    public itensAlarmTypes: SelectItem[];\n    public itensDrivers: TreeInputModel[];\n    public itensVehicle: SelectItem[];\n    public itensLevel: SelectItem[];\n    public itensTreatment: SelectItem[];\n\n    public selectedTypeAlarm;\n    public selectedDate;\n    public selectedDriver: number[] = [];\n    public selectedLevel;\n    public selectedVehicle;\n    public selectedVehiclePrefix;\n    public selectedAlarmId;\n    public checkAlarms: number[] = [];\n    public treatmentCat: number[] = [];\n    public treatmentContent;\n    public valided: boolean;\n    public selectedCustomerChild: number;\n    public validationLoad: boolean = false;\n    public auditionLoad: boolean = false;\n    public loadedDrivers: boolean = true;\n    public selectedDriverName;\n    //public multiAply: boolean = false;\n\n    public relatedsCams: Alarm[];\n\n    public previewCam: boolean;\n    public previewCamPicture: String;\n    public previewCamMovie: String;\n\n    public cars = mockAlarmTypesData;\n    public mapaLoaded = false;\n    public workspace: Workspace;\n    public loadedNotification = true;\n\n    public showVoiceCommand: boolean = false;\n    public isSendingVoiceCommand: boolean = false;\n\n    loadingMap: boolean = true;\n\n    treatmentNotification: TreatmentBuild;\n    alarmListNotification: Alarm[];\n\n    constructor(\n        private dataService: DataService,\n        private driverService: DriverService,\n        private workspaceService: WorkspaceService,\n        private notificationService: NotificationUtilService,\n        private alarmService: AlarmService,\n        private treatmentService: TreatmentService,\n        private domSanitizer: DomSanitizer,\n        protected translateJsonService: TranslateJsonService,\n        private httpClient: HttpClient,\n        private voiceMessageService: VoiceMessageService\n    ){\n        this.itensAlarmTypes = this.dataService.alarmTypesNumber;\n    }\n\n    ngOnInit(){\n        this.itensDrivers = [];\n        this.loadSelectedAlarm(this.selectedTreatment);\n        this.loadListAlarm(this.selectedTreatment, this.isNewFatiguePage);\n    }\n\n    ngAfterViewInit(){\n        this.workspace = this.dataService.getWorkspace();\n\n        this.treatmentService.getTreatments(this.workspace.customerProfileId).subscribe((treatments : TreatmentData[]) => {\n            this.itensTreatment = this.treatmentService.convertToSelectItem(treatments);\n        })\n    }\n\n    public loadListAlarm(alert: Alarm, isNewFatiguePage: boolean){\n        if(isNewFatiguePage){\n            this.relatedsCams = [];\n            this.relatedsCams = JSON.parse(JSON.stringify(this.relatedAlarms));\n            this.relatedsCams.push(alert);\n        }else{\n            this.relatedsCams = this.dataService.readyRelatedCam(this.selectedTreatment);\n        }\n\n        setTimeout(() => {\n            this.loadImages(this.relatedsCams);\n        },1000);\n    }\n\n    /**\n     * Carrega o alarme nos lugares corretos da Tela\n     * @param alarmSelected\n     */\n    public loadSelectedAlarm(alarmSelected : Alarm){\n        this.itensLevel = [\n            {'label': 'Fadiga N0', 'value': 0},\n            {'label': 'Fadiga N1', 'value': 1},\n            {'label': 'Fadiga N2', 'value': 2}\n        ]\n\n        this.selectedCustomerChild = alarmSelected.customer_child_id;\n        this.selectedDate = this.translateJsonService.transformDataFormat(alarmSelected.datetime);\n        this.selectedTypeAlarm = [alarmSelected.typeAlarm];\n\n        this.itensDrivers = [{id: alarmSelected.driverId, name: alarmSelected.driver_firstname, parentId: null}];\n        this.selectedDriverName = alarmSelected.driver_firstname;\n        this.selectedDriver = [alarmSelected.driverId];\n\n        this.selectedLevel = [alarmSelected.level];\n        this.selectedVehicle = [alarmSelected.vehicle_plates];\n        this.selectedVehiclePrefix = alarmSelected.vehicle_prefix;\n        this.selectedAlarmId = alarmSelected.id;\n        this.valided = alarmSelected.validation;\n    }\n\n    /**\n     * Carrega as Imagens de todos os Alertas\n     */\n    public loadImages(alarmList : Alarm[]){\n        alarmList.forEach((alarm : Alarm) => {\n            if (alarm.urlPictures[0] == 'NO_PICTURE') {\n                alarm.picture = 'NO_PICTURE'\n            } else if (alarm.picture == null) {\n                this.alarmService.getPictureByAlarm(alarm.id).subscribe((pictureAndMovie: PictureAndMovie) => {\n                    if(pictureAndMovie.urlMovies && pictureAndMovie.urlMovies.length > 0){\n                        alarm.movie = pictureAndMovie.urlMovies[0];\n                    }\n                    alarm.picture = pictureAndMovie.urlPictures[0];\n                    this.dataService.setPictureAlarm(alarm, pictureAndMovie.urlPictures[0]);\n                });\n            }\n        })\n    }\n\n    loadDrivers(){\n        if(this.itensDrivers.length <= 1){\n            this.loadedDrivers = false;\n            this.driverService.getDriversByManyCustomerIds(this.workspace.selectedFilterAlams.selectedCustomers).subscribe((result) => {\n                this.itensDrivers = this.driverService.convertAssetToTreeInputModel(result);\n                this.loadedDrivers = true;\n            })\n        }\n    }\n\n    public viewSelectedCam(cam: Alarm){\n        this.previewCamPicture = cam.picture;\n        this.previewCam = true;\n    }\n\n    public registrarAcao(){\n        this.notificationService.printSuccessMessage(this.translateJsonService.getTranslateSubs('TREATMENT-MODAL.msg_valid_alert'));\n    }\n\n    public selectRelatedCamera(cam: Alarm){\n        this.loadSelectedAlarm(cam);\n        this.previewCam = false;\n    }\n\n    public removeRelatedCam(cam){\n        this.notificationService.openConfirmationDialog(\n            this.translateJsonService.getTranslateSubs('TREATMENT-MODAL.comand_proccess'),\n            this.translateJsonService.getTranslateSubs('TREATMENT-MODAL.invalid_alert'),\n                ()=>{\n                    let index = this.relatedsCams.indexOf(cam);\n                    this.relatedsCams.splice(index, 1);\n                    this.notificationService.notify(this.translateJsonService.getTranslateSubs('TREATMENT-MODAL.comand_proccess'), NotificationType.SUCCESS);\n                },\n                ()=>{                    \n                    this.notificationService.notify(this.translateJsonService.getTranslateSubs('TREATMENT-MODAL.canceled'), NotificationType.ERROR);\n                });\n    }\n\n    /**\n     * Validar alerta\n     */\n    public validationAlarm(validationAlarm: boolean, multiAply?: boolean){\n        let validation: ValidationHistory = new ValidationHistory;\n        validation.level = this.selectedLevel[0];\n        validation.type = this.selectedTypeAlarm[0];\n        validation.ownerUser = this.workspace.currentUserId;\n\n        validation.driver = this.selectedDriver[0];\n        validation.vehicle = this.selectedTreatment.vehicleId;\n        validation.timeZoneTreatment = this.dataService.getBrowserTimezoneOffset() || \"-03:00\";\n        this.validationLoad = true;\n\n        if(validationAlarm){\n            validation.purpose = 1;\n\n            if(multiAply){\n                this.checkAlarms.forEach((id : number) => {\n                    validation.alarm = id;\n                    this.updateDriverInAlarms([id]);\n\n                    this.treatmentService.validationAlarm(validation).subscribe((result: any) => {\n                        if(result = \"O Alarme foi validado com sucesso!\"){\n                            this.valided = true;\n                            this.validationLoad = false;\n                        }\n                    });\n                    this.relatedsCams.find((alarm: Alarm) => alarm.id == id).validation = true;\n                })\n                this.notificationService.printSuccessMessage(this.translateJsonService.getTranslateSubs('TREATMENT-MODAL.msg_valid_alert'));\n            }else{\n                validation.alarm = this.selectedAlarmId;\n                this.updateDriverInAlarms([this.selectedAlarmId]);\n\n                this.treatmentService.validationAlarm(validation).subscribe((result: any) => {\n                    if(result = \"O Alarme foi validado com sucesso!\"){\n                        this.relatedsCams.find((alarm: Alarm) => alarm.id == validation.alarm).validation = true;\n                        this.valided = true;\n                        this.validationLoad = false;\n                    }\n                });\n\n                this.notificationService.printSuccessMessage(this.translateJsonService.getTranslateSubs('TREATMENT-MODAL.msg_valid_alert'));\n            }\n        }else{\n            this.checkAlarms.forEach((id : number) => {\n                validation.alarm = id;\n                validation.purpose = 2;\n\n                this.treatmentService.validationAlarm(validation).subscribe((result: any) => {\n                    if(result = \"O Alarme foi invalidado com sucesso!\"){\n                        this.valided = true;\n                    }\n                });\n\n                this.relatedsCams = this.relatedsCams.filter((alarm: Alarm) => alarm.id != validation.alarm);\n\n                if(this.relatedsCams.length > 0){\n                    this.selectRelatedCamera(this.relatedsCams[0]);\n                }else{\n                    this.closeModal.emit(true);\n                }\n            })\n\n            this.auditedAlarns.emit(this.checkAlarms);\n            this.notificationService.printSuccessMessage(this.translateJsonService.getTranslateSubs('TREATMENT-MODAL.valid_invalidated_alert'));\n            this.checkAlarms = [];\n        }\n    }\n\n    /**\n     * Salvar tratativa\n    */\n    public saveTreatment() {\n        this.auditionLoad = true;\n        let treatment: Treatment = new Treatment;\n\n            treatment.alarmIds = this.checkAlarms;\n            treatment.treatmentId = this.treatmentCat[0];\n            treatment.treatmentContent = this.treatmentContent;\n            treatment.ownerUser = this.workspace.currentUserId;\n\n            if(treatment.alarmIds.length < 1){\n                this.notificationService.printWarningMessage(this.translateJsonService.getTranslateSubs('TREATMENT-MODAL.select_alert'));\n                this.auditionLoad = false;\n                return;\n            }\n\n            if(treatment.treatmentId == null){\n                this.notificationService.printWarningMessage(this.translateJsonService.getTranslateSubs('TREATMENT-MODAL.select_treat'));\n                this.auditionLoad = false;\n                return;\n            }\n\n            this.treatmentService.newAudit(treatment).subscribe((result: any) => {\n                this.notificationService.printSuccessMessage(this.translateJsonService.getTranslateSubs('TREATMENT-MODAL.apply_success_treat'));\n                this.auditionLoad = false;\n                this.auditedAlarns.emit(this.checkAlarms);\n                this.closeModal.emit(true);\n            });\n    }\n\n   /**\n    * Insere os alertas no Mapa\n    */\n   public mapaLoadedRefresh() {\n        this.allMarkers = [];\n\n        this.checkAlarms.forEach((alarmId : number) => {\n            let alarm = this.relatedsCams.find((relatedCam: Alarm) => relatedCam.id == alarmId);\n\n            let mrkr: ModelMarkers = new ModelMarkers;\n            mrkr.id = alarm.id;\n            mrkr.name = alarm.driver_firstname;\n            mrkr.category = alarm.typeAlarm;\n            mrkr.enabled = true;\n            mrkr.latitude = alarm.latitude;\n            mrkr.longitude = alarm.longitude;\n\n            this.allMarkers.push(mrkr);\n        })\n\n        this.mapaLoaded = true;\n        this.loadingMap = false;\n   }\n\n   public logger(event){\n       console.log(event);\n   }\n\n   reloadMovie(){\n    this.moviePlayer.nativeElement.load()\n   }\n\n    getBase64ImageFromURLP(url: string): Promise<any> {\n        return new Promise((resolve, reject) => {\n           try {\n                let img = new Image();\n\n                img.crossOrigin = 'Anonymous';\n                img.src = url;\n                if (!img.complete) {\n                    img.onload = () => {\n                        resolve(this.getBase64Image(img));\n                    };\n                    img.onerror = (err) => {\n                        reject(err);\n                    };\n                } else {\n                    resolve(this.getBase64Image(img));\n                }\n           } catch(err) {\n               reject(err);\n           }\n        })\n    }\n\n    getBase64Image(img: HTMLImageElement) {\n        var canvas = document.createElement(\"canvas\");\n        canvas.width = img.width;\n        canvas.height = img.height;\n        var ctx = canvas.getContext(\"2d\");\n        ctx.drawImage(img, 0, 0);\n        var dataURL = canvas.toDataURL(\"image/png\");\n\n        return dataURL.replace(/^data:image\\/(png|jpg);base64,/, \"\");\n    }\n\n    private updateDriverInAlarms(alarmIds : number[]): void {\n        alarmIds.forEach(alarmId => {\n            let findedAlarm = this.relatedsCams.find(relatedCam => relatedCam.id == alarmId);\n\n            if(findedAlarm){\n                findedAlarm.driverId = this.selectedDriver[0];\n                findedAlarm.driver_firstname = this.selectedDriverName;\n                findedAlarm.type = this.selectedTypeAlarm[0];\n                findedAlarm.level = this.selectedLevel[0];\n            }\n        })\n    }\n\n    changedDriver(event) {\n        this.selectedDriverName = event[0].name;\n    }\n\n    generateNotification() {\n        this.loadedNotification = false;\n\n        this.fetchImageMap().then(canvas => {\n            this.exportableMap = JSON.parse(JSON.stringify(canvas.toDataURL()));\n\n            if(this.checkAlarms.length < 1){\n                this.notificationService.printWarningMessage(this.translateJsonService.getTranslateSubs('TREATMENT-MODAL.select_alert'));\n                this.loadedNotification = true;\n                return;\n            }\n\n            if(this.treatmentCat[0] == null){\n                this.notificationService.printWarningMessage(this.translateJsonService.getTranslateSubs('TREATMENT-MODAL.select_treat'));\n                this.loadedNotification = true;\n                return;\n            }\n\n            let alarmList = this.getAlarmByChecked();\n            let treatment: TreatmentBuild = new TreatmentBuild;\n\n            treatment.treatmentByUser = this.workspace.currentUser.name;\n            treatment.treatmentDate = this.translateJsonService.transformDataFormat(new Date());\n            treatment.treatmentName = this.getTreamentNameById(this.treatmentCat[0]);\n            treatment.treatmentObs = (this.treatmentContent) ? this.treatmentContent : '';\n\n            this.treatmentNotification = treatment;\n            this.alarmListNotification = alarmList;\n            this.loadedNotification = true;\n        })\n\n    }\n\n    getAlarmByChecked(){\n        let checks = [];\n\n        this.checkAlarms.forEach((alarmId) => {\n                checks.push(this.relatedsCams.find((rc) => rc.id == alarmId));\n        })\n\n        checks.forEach(check => check.datetime = this.translateJsonService.transformDataFormat(check.datetime));\n\n        return checks;\n    }\n\n    getTreamentNameById(treatId: number){\n        return this.itensTreatment.find((treat) => treat.value == treatId).label;\n    }\n\n    fetchImageMap(): Promise<any> {\n        return new Promise((resolve, reject) => {\n          leafletImage(this.alarmMap.map, function (err, canvas) {\n            resolve(canvas);\n          })\n        })\n    }\n\n    public onSendMessage(commandVoice: CommandVoice) {\n        this.isSendingVoiceCommand = true;\n    \n        const message = this.buildMessage([commandVoice]);\n    \n        this.voiceMessageService\n          .saveVoiceMessages(message)\n          .then(() => {\n            this.isSendingVoiceCommand = false;\n            this.notificationService.printSuccessMessage(this.translateJsonService.getTranslateSubs(\"VOICE-MESSAGE-PAGE.success_send_msg\"));\n          })\n          .catch(() => {\n            this.isSendingVoiceCommand = false;\n            this.notificationService.printErrorMessage(this.translateJsonService.getTranslateSubs(\"VOICE-MESSAGE-PAGE.error_send_msg\"));\n          })\n      }\n    \n      public buildMessage(commands: CommandVoice[]): Audio {\n        const audio = new Audio();\n    \n        audio.deviceId = this.selectedTreatment.imei;\n        audio.deviceTypeId = this.selectedTreatment.equipmentTypeId;\n        audio.userId = JSON.parse(localStorage.getItem(\"currentUser\")).id;\n        audio.voiceCommands = commands;\n    \n        return audio;\n      }\n    \n      private setShowVoiceCommand(deviceTypeId: number): void {\n        this.showVoiceCommand = this.voiceMessageService.deviceCanReceiveMessage(deviceTypeId);\n      }\n}\n","module.exports = \"<div class=\\\"box\\\">\\n    <div class=\\\"content\\\">\\n        <button (click)=\\\"searchVehicles()\\\" class=\\\"btn-search\\\">{{ 'EQUIPMENT-CAM-LIST.search' | translate }}</button>\\n        <div style=\\\"height: 70vh; width: 100%;\\\">\\n            <p-tree [value]=\\\"equipmentStreamingList\\\" selectionMode=\\\"checkbox\\\" [(selection)]=\\\"selectedEquipments\\\"\\n                scrollHeight=\\\"70vh\\\" [propagateSelectionUp]=\\\"false\\\" [propagateSelectionDown]=\\\"true\\\"\\n                [loading]=\\\"streamingFacade.isUpdating$() | async\\\" (onNodeSelect)=\\\"eventAddedOrRemove($event, true)\\\"\\n                (onNodeUnselect)=\\\"eventAddedOrRemove($event, false)\\\">\\n                <ng-template let-node pTemplate=\\\"channel\\\">\\n                    <div> <span>{{node.label}}</span> </div>\\n                </ng-template>\\n                <ng-template let-node pTemplate=\\\"default\\\">\\n                    <div [ngClass]=\\\"{ 'opacity-4': node.data.statusCode!=1, 'item-selected-vehicles': true }\\\">\\n                        <span class=\\\"isv-icon\\\">\\n                            <img src=\\\"assets/truck-streaming-page.svg\\\" />\\n                        </span>\\n                        <span style=\\\"min-width: 130px;\\\">\\n                            <h2>{{node.label}}</h2>\\n                            <span>{{node.data.status}}</span>\\n                        </span>\\n                        <!-- <span class=\\\"delete\\\">\\n  