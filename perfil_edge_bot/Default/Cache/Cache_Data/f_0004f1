                       <i class=\\\"fa fa-question-circle\\\" *ngIf=\\\"col.field === 'playbackMode'\\\" (click)=\\\"showInfo()\\\"></i>\\n                    </th>\\n                </tr>\\n                <tr>\\n                    <th *ngFor=\\\"let col of cols\\\" [ngSwitch]=\\\"col.field\\\">\\n                        <input *ngSwitchCase=\\\"'alarmNames'\\\" pInputText type=\\\"text\\\" (input)=\\\"dt.filter($event.target.value, col.field, 'contains')\\\" style=\\\"width: 90%;\\\">\\n                        <input *ngSwitchCase=\\\"'fileName'\\\" pInputText type=\\\"text\\\" (input)=\\\"dt.filter($event.target.value, col.field, 'contains')\\\" style=\\\"width: 90%;\\\">\\n                        <input *ngSwitchCase=\\\"'channelName'\\\" pInputText type=\\\"text\\\" (input)=\\\"dt.filter($event.target.value, col.field, 'contains')\\\" style=\\\"width: 90%\\\">\\n                        <input *ngSwitchCase=\\\"'requestDate'\\\" pInputText type=\\\"text\\\" (input)=\\\"dt.filter($event.target.value, col.field, col.filterMatchMode)\\\" style=\\\"width: 90%;\\\">\\n                    </th>\\n                </tr>\\n            </ng-template>\\n            <ng-template pTemplate=\\\"body\\\" let-rowData let-columns=\\\"columns\\\">\\n                <tr [pSelectableRow]=\\\"rowData\\\" style=\\\"min-height: '30vh'\\\">\\n                    <td *ngFor=\\\"let col of columns\\\" [ngSwitch]=\\\"col.field\\\">                                                        \\n                        <span *ngSwitchCase=\\\"'fileSize'\\\"> {{ rowData[col.field] }}</span>\\n                        <span *ngSwitchCase=\\\"'fileName'\\\" title=\\\"{{rowData[col.field]}}\\\"> {{ rowData[col.field].length > 20 ? rowData[col.field].substr(0, 20) + '...' : rowData[col.field]}}</span>\\n                        <span *ngSwitchCase=\\\"'datetime'\\\"> {{ rowData[col.field] | date: 'dd/MM/yyyy HH:mm:ss' }} </span>\\n                        <span *ngSwitchCase=\\\"'actions'\\\"> \\n                            <button class=\\\"btn-actions\\\" (click)=\\\"requestDownload(rowData)\\\" [disabled]=\\\"rowData['requested'] || statusPage.loading\\\">{{ 'PLAYBACK-PAGE.request_download' | translate }}</button>\\n                        </span>\\n                        <span *ngSwitchDefault> {{rowData[col.field]}} </span>\\n                    </td>\\n                </tr>\\n            </ng-template>\\n            <ng-template pTemplate=\\\"emptymessage\\\" let-columns>\\n                <tr>\\n                    <td [attr.colspan]=\\\"columns.length\\\" [attr.rowspan]=\\\"50\\\" style=\\\"padding: 10vh; text-align: center;\\\">\\n                        {{ 'PLAYBACK-PAGE.no_files_found' | translate }}\\n                    </td>\\n                </tr>\\n            </ng-template>\\n        </p-table>\\n    </div>\\n</div>\"","module.exports = \".device-syncronization-filelist{width:100%}.toolbar{width:100%;background-color:#4B4B4D;padding:.5em;margin:0;display:flex;flex-direction:row;align-items:center;justify-content:end;gap:10px;color:#FFF}.toolbar .refresh-button{height:100%;border:0px;padding:.5em;display:flex;background-color:#CC4040;color:#FFF}.toolbar .refresh-button:hover{cursor:pointer}.toolbar .refresh-button:disabled{opacity:0.7}.sync{padding:1em;text-align:center;background-color:#f6f7f9}\\n\"","import { Component, Input } from \"@angular/core\";\nimport { TranslateJsonService } from \"app/@core/data/translate-json.service\";\nimport { FilterAlarms } from \"app/@core/models\";\nimport { NotificationUtilService } from \"app/@core/utils/notification.util.service\";\nimport { moment } from 'ngx-bootstrap/chronos/test/chain';\nimport { Playback } from \"../playbackold.entity\";\nimport { PlaybackOldService } from \"../playbackold.service\";\nimport { PlaybackTask } from \"../playbackTask.entity\";\nimport { RemoteTask } from \"./remote-tasks.entity\";\nimport { EquipamentType } from \"app/@core/enum/equipament.type.enum\";\nimport { Subscription, of, throwError } from \"rxjs\";\nimport { delay, retryWhen, switchMap, tap } from \"rxjs/operators\";\nimport { TaskStatus } from \"app/@core/enum/taskStatus.enum\";\nimport { DataService } from \"app/@core/data/data.service\";\nimport { SelectItem } from \"primeng/api\";\n\n@Component({\n    selector: 'playback-remote-filelist',\n    styleUrls: ['./playbackold-remote-filelist.component.scss'],\n    templateUrl: './playbackold-remote-filelist.component.html',\n})\nexport class PlaybackOldRemoteFileList {\n    @Input('deviceIsOnline') public deviceIsOnline: boolean;\n    @Input('filterSelectedData') filterSelectedData: FilterAlarms;\n    @Input('deviceId') deviceId: string;\n    @Input('deviceTypeId') deviceTypeId: number;\n    @Input('asset') asset: any;\n\n    private subsPlaybackFileListTask: Subscription;\n\n    cols: any = [];\n    remoteTask: RemoteTask;\n    expirationOptions: SelectItem[] = [];\n    selectedExpirationLimit: number;\n    selectedCustomerChild: any;\n\n    statusPage: {\n        inSync: boolean\n        loading: boolean,\n        error: boolean,\n        message: string\n    } = { inSync: false, loading: false, error: false, message: \"\" };\n\n    constructor(\n        private translateJsonService: TranslateJsonService,\n        private playbackService: PlaybackOldService,\n        private notificationService: NotificationUtilService,\n        private dataService: DataService\n    ) {\n        this.cols = [\n            { field: 'fileSizeLabel', header: this.translateJsonService.getTranslateSubs('GLOBAL.file_size'), width: '100px' },\n            { field: 'fileDurationLabel', header: this.translateJsonService.getTranslateSubs('GLOBAL.media_length'), width: '100px' },\n            { field: 'channelNameLabel', header: this.translateJsonService.getTranslateSubs('GLOBAL.channel_name'), width: '145px' },\n            { field: 'datetime', header: this.translateJsonService.getTranslateSubs('GLOBAL.datetime'), width: '190px' },\n            { field: 'fileName', header: this.translateJsonService.getTranslateSubs('GLOBAL.datetime'), width: '190px' },\n            { field: 'actions', header: '', width: '150px', btn: true }\n        ]\n    }\n\n    ngOnInit() {\n        this.selectedCustomerChild = this.dataService.getAllCustomerChilds().find((item) => item.id == this.asset.customerChildId);\n        this.initializeExpirationOptions();\n        this.setDefaultExpiration();\n    }\n\n    ngOnDestroy() {\n        if (this.subsPlaybackFileListTask) this.subsPlaybackFileListTask.unsubscribe();\n    }\n\n    public async loadLastCompletedTask() {\n        this.statusPage.loading = true;\n        this.statusPage.inSync = false;\n        this.statusPage.error = false;\n\n        try {\n            const fileListTask = await this.playbackService.getLastCompletedPaybackFileListTask(this.deviceId);\n\n            this.remoteTask = this.processRemoteFileListTask(fileListTask);\n\n            if (this.remoteTask.playbackFileList.length === 0) {\n                this.statusPage.error = true;\n                this.statusPage.inSync = false;\n                this.statusPage.message = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.playback_notfound');\n            }\n\n            this.statusPage.loading = false;\n        } catch (err) {\n            this.statusPage.message = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.error_consult');\n            this.statusPage.error = true;\n            this.statusPage.inSync = false;\n        }\n    }\n\n    requestNewRemoteFileList() {\n        this.statusPage.loading = true;\n        this.statusPage.error = false;\n\n        this.playbackService.requestRemoteTasks(\n            this.deviceId,\n            this.deviceTypeId,\n            this.filterSelectedData.selectedDateStart.toISOString(),\n            this.filterSelectedData.selectedDateEnd.toISOString()\n        ).then((result: any) => {\n            const taskId = result.taskId;\n\n            this.statusPage.loading = false;\n\n            this.createRecurrentFileListRequest(taskId);\n        }).catch(_ => {\n            this.statusPage.loading = false;\n            this.statusPage.error = true;\n            \n            this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.error_consult');\n        })\n    }\n\n    requestDownload(data: PlaybackTask) {\n        this.statusPage.loading = true;\n        let playback = this.buildPlayback(data);\n\n        this.playbackService.requestDownload(playback).then(result => {\n            this.statusPage.loading = false;\n            this.remoteTask.playbackFileList.forEach(f => { (f.fileName == data.fileName) ? f.requested = true : false });\n            this.notificationService.printSuccessMessage(this.translateJsonService.getTranslateSubs(\"PLAYBACK-PAGE.success_task_save\"));\n        }).catch(error => {\n            this.statusPage.loading = false;\n            this.notificationService.printErrorMessage(this.getErrorMessage(error));\n        });\n    }\n\n    private getErrorMessage(error: string): string {\n        let messageKey = 'error_task_save';\n\n        if (error.includes(\"Limite de solicitações de playback atingido para esse dispositivo\")) {\n            messageKey = 'error_task_limit';\n        } else if (error.includes(\"Há uma solicitação de playback pendente ou concluída para esse arquivo\")) {\n            messageKey = 'error_task_duplicated';\n        }\n\n        return this.translateJsonService.getTranslateSubs(`PLAYBACK-PAGE.${messageKey}`)\n    }\n\n    private buildPlayback(data: PlaybackTask): Playback {\n        let playback: Playback = new Playback();\n        const expirationDate = this.selectedExpirationLimit != 0 ? this.getExpirationLimit() : null;\n\n        playback.deviceTypeId = this.deviceTypeId;\n        playback.deviceId = this.deviceId;\n        playback.playbackModeId = data.playbackModeId;\n        playback.fileName = data.fileName;\n        playback.channelId = data.channelId;\n        playback.userId = JSON.parse(localStorage.getItem(\"currentUser\")).id;\n        playback.requestDate = data.datetime;\n        playback.requiredTime = moment(data.datetime).format();\n        playback.expirationDate = expirationDate ? expirationDate.toISOString(): null;\n\n        return playback;\n    }\n\n    private createRecurrentFileListRequest(taskId: number) {\n        this.statusPage.inSync = true;\n\n        if (this.subsPlaybackFileListTask) {\n            this.subsPlaybackFileListTask.unsubscribe();\n        }\n\n        this.subsPlaybackFileListTask = this.playbackService\n            .getRemoteTaskById(taskId)\n            .pipe(\n                switchMap((remoteTask: RemoteTask) => {\n                    const taskStatus = remoteTask.taskStatusId;\n\n                    if ([TaskStatus.Criada, TaskStatus.Enviada].includes(taskStatus)) {\n                        this.statusPage.error = false;\n\n                        return throwError({ retry: true });\n                    }\n\n                    if ([TaskStatus.Cancelada, TaskStatus.Expirada, TaskStatus.Falhada].includes(taskStatus)) {\n                        this.statusPage.inSync = false;\n                        this.statusPage.error = true;\n\n                        return throwError({ retry: false });\n                    }\n\n                    if (TaskStatus.Completa === taskStatus) {\n                        this.statusPage.inSync = false;\n                        this.statusPage.error = false;\n\n                        if (remoteTask.playbackFileList && remoteTask.playbackFileList.length === 0) {\n                            {\n                            return throwError({ retry: false, isEmpty: true });\n                        }}\n\n                        return of(remoteTask)\n                    }\n                }),\n                retryWhen((err) => err.pipe(\n                    tap(value => {\n                        if (!value.retry) {\n                            throw value;\n                        }\n                    }),\n                    delay(10000),\n                )),\n            )\n            .subscribe(\n                result => this.remoteTask = this.processRemoteFileListTask(result),\n                error => {\n                    if (error.isEmpty) {\n                        this.statusPage.message = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.playback_notfound');\n                    } else {\n                        this.statusPage.message = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.sync_error');\n                    }\n                }\n            );\n    }\n\n    private returnLabelGeneratorFunction(deviceTypeId: number) {\n        const playbackService = this.playbackService;\n\n        if (deviceTypeId == EquipamentType.JIMI_V6 || deviceTypeId == EquipamentType.JIMI) {\n            return (_: number) =>  this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_2');\n        } else if (deviceTypeId == EquipamentType.JIMI_G5_PLUS || deviceTypeId == EquipamentType.JIMI_JC400AD_ID || deviceTypeId == EquipamentType.JIMI_JC400D_R) {\n            return (channelId: number) => this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_' + playbackService.getG5PlusCorrectChannel(channelId));\n        } else if (deviceTypeId == EquipamentType.JIMI_G7) {\n            return (channelId: number) => this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_' + playbackService.getG7CorrectChannel(channelId));\n        }else if (deviceTypeId == EquipamentType.STONKAM_K4) {\n            return (channelId: number) => this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_' + playbackService.getKdashCorrectChannel(channelId));\n        } else {\n            return (channelId: number) => this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_' + channelId);\n        }\n    }\n\n    private processRemoteFileListTask(task: RemoteTask): RemoteTask {\n        const result: RemoteTask = {\n            taskId: task.taskId,\n            deviceId: task.deviceId,\n            deviceTypeId: task.deviceTypeId,\n            taskStatusId: task.taskStatusId,\n            taskStatusDescription: task.taskStatusDescription,\n            requestParameters: task.requestParameters,\n            createDate: task.createDate,\n            playbackFileList: task.playbackFileList,\n        }\n\n        const period = JSON.parse(task.requestParameters);\n\n        const labelGenerator = this.returnLabelGeneratorFunction(Number(task.deviceTypeId));\n\n        this.filterSelectedData.selectedDateStart = new Date(period.startDatetime);\n        this.filterSelectedData.selectedDateEnd = new Date(period.endDatetime);\n\n        result.playbackFileList = task.playbackFileList\n            .filter(file => {\n                const fileDate = new Date(file.datetime);\n\n                return fileDate >= this.filterSelectedData.selectedDateStart && fileDate <= this.filterSelectedData.selectedDateEnd;\n            })\n            .map(file => {\n                file.fileSizeLabel = this.playbackService.formatMediaSize(file.fileSize) + \" MB\";\n                file.fileDurationLabel = this.playbackService.formatDuration(file.duration);\n                file.channelNameLabel = labelGenerator(file.channelId);\n\n                return file;\n            });\n\n        return result;\n    }\n\n    private initializeExpirationOptions() {\n        this.expirationOptions = [\n            { label: '1h', value: 1 },\n            { label: '6h', value: 6 },\n            { label: this.translateJsonService.getTranslateSubs(\"PLAYBACK-PAGE.no_expiration\"), value: 0 }\n        ];\n    }\n\n    private setDefaultExpiration() {\n        const configurations = this.selectedCustomerChild.configurations ? this.selectedCustomerChild.configurations : null;\n        if (configurations && configurations.playbackTaskDefaultExpirationLimit != null) {\n            this.selectedExpirationLimit = configurations.playbackTaskDefaultExpirationLimit;\n        } else {\n            this.selectedExpirationLimit = 1; \n        }\n    }\n\n    private getExpirationLimit() {\n        const currenDatetime = new Date();\n        const expirationDatetime = new Date(currenDatetime.setHours(currenDatetime.getHours() + this.selectedExpirationLimit));\n        return expirationDatetime;\n\n    }\n}\n","module.exports = \"\\n<div class=\\\"row\\\">\\n  <div class=\\\"col-md-12\\\">\\n    <nb-card>\\n\\n      <nb-card-body>       \\n        <nb-actions size=\\\"medium\\\" fullWidth>\\n                <nb-action>\\n                <!-- <i class=\\\"nb-gear\\\"></i> -->\\n                <p-multiSelect [options]=\\\"customers\\\" [(ngModel)]=\\\"selectedCustomers\\\" [panelStyle]=\\\"{minWidth:'26em', width:'200px'}\\\" defaultLabel=\\\"Selecione...&nbsp;&nbsp;\\\" scrollHeight=\\\"10px\\\" (onChange)=\\\"onChangeCustomers($event)\\\">\\n                                        <ng-template let-customer pTemplate=\\\"item\\\" >\\n                                          <img src=\\\"{{customer.value | customerPicture}}\\\" style=\\\"height:30px;width:70px;display:inline-block;vertical-align:middle\\\"/>\\n                                            <div style=\\\"font-size:14px;float:right;margin-top:4px\\\">{{customer.label}}</div>\\n                                        </ng-template>\\n                                    </p-multiSelect>                      \\n              </nb-action>\\n              <nb-action>               \\n                    <p-multiSelect [options]=\\\"drivers\\\" [(ngModel)]=\\\"selectedDrivers\\\" [panelStyle]=\\\"{minWidth:'16em', width:'100px'}\\\" defaultLabel=\\\"Selecione...&nbsp;&nbsp;\\\" scrollHeight=\\\"10px\\\">\\n                                        <ng-template let-driver pTemplate=\\\"item\\\" >\\n                                          <img src=\\\"{{driver.value | driverPicture}}\\\" s