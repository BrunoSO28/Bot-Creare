er\"\n                )}: ${event.driver\n                  ? event.driver.name\n                  : this.translateJsonService.getTranslateSubs(\n                    \"TELEMETRY-PAGE.unidentified\"\n                  )\n        } <br/>\n                ${this.translateJsonService.getTranslateSubs(\n                  \"TELEMETRY-PAGE.vehicle\"\n                )}:${event.vehicle ? event.vehicle.prefix + '/' + event.vehicle.plate\n                  : this.translateJsonService.getTranslateSubs(\"TELEMETRY-PAGE.unidentified\")}\n                <br/>\n                ${this.translateJsonService.getTranslateSubs(\n                    \"TELEMETRY-PAGE.date\"\n                  )}: ${moment(event.datetime).format(\"DD/MM/YYYY HH:mm:ss\")} <br/>\n            </div>`;\n\n      markers.push(mrkr);\n    });\n\n    return markers;\n  }\n\n  private convertPositionInMarker(assets: Asset[]): ModelMarkers[] {\n    let markers = [];\n    this.vehicleListCounterStatus = {\n      onMovement:0,\n      stopped: 0,\n      offline: 0\n    }\n    const events = this.telemetryState.getEvents();\n\n    assets.forEach((asset: Asset) => {\n      let category = 1000;\n\n      if (asset.riskGroup) {\n        if (asset.riskGroup == \"0\") {\n          category = 1001;\n        }\n\n        if (asset.riskGroup == \"1\") {\n          category = 1002;\n        }\n\n        if (asset.riskGroup == \"2\") {\n          category = 1003;\n        }\n      }\n\n      const existsEvents = events.find(\n        (e) => e.vehicle.id == asset.id.toString()\n      );\n\n      if (existsEvents) {\n        category = 1003;\n      }\n\n      if (asset.telemetry) {\n\n        const twoHoursInterval = 7200000\n        const assetTelemetryDate = new Date(asset.telemetry.datetime).getTime()\n        const dateNow = new Date().getTime()\n\n        if(dateNow - assetTelemetryDate > twoHoursInterval) {\n          this.vehicleListCounterStatus.offline ++\n        } else {\n          if(asset.telemetry.speed == 0) {\n            this.vehicleListCounterStatus.stopped ++\n          } else {\n            this.vehicleListCounterStatus.onMovement ++\n          }\n        }\n\n        const position = asset.telemetry;\n\n        let mrkr: ModelMarkers = new ModelMarkers;\n        mrkr.id = Number(position.asset_id);\n        mrkr.name = `${position.asset_identification} - ${position.asset_name}`;\n        mrkr.category = category;\n        mrkr.enabled = true;\n        mrkr.latitude = position.lat;\n        mrkr.longitude = position.lng;\n        mrkr.type = this.MARKER_TYPE_POSITIONS;\n        mrkr.datetime = moment(position.datetime).format('DD/MM/YYYY HH:mm:ss');\n        mrkr.speed = Number(Number(position.speed).toFixed(0))\n        mrkr.speed_unit = position.speed_unit;\n        mrkr.description = `\n        <div style=\"width: 200px;\"> \n            ${this.translateJsonService.getTranslateSubs('GLOBAL.vehicle')}: ${\n          mrkr.name\n        } <br/> \n            ${this.translateJsonService.getTranslateSubs('GLOBAL.datetime')}: ${\n          mrkr.datetime\n        } <br/> \n            ${this.translateJsonService.getTranslateSubs('MOSAIC.velocity')}: ${\n          mrkr.speed\n        } ${mrkr.speed_unit} <br/>\n            <button style=\"width: 100%; margin-top: 10px; padding: 8px; border: none; border-radius: 4px; background-color: #4B4B4D; color: white; cursor: pointer; transition: background-color 0.3s, border-color 0.3s; outline: none;\" \n        onmouseover=\"this.style.backgroundColor='#5b327a'\" \n        onmouseout=\"this.style.backgroundColor='#4B4B4D'\" \n        onfocus=\"this.style.borderColor='#352a40'\"\n        onclick=\"window.open('https://www.google.com/maps/@${position.lat},${\n          position.lng\n        },17z/data=!3m1!1e3', '_blank')\">\n    <i class=\"fa fa-street-view\" style=\"font-size: 1.5em; margin-right: 8px;\"></i> Acessar Street View\n</button>\n\n        </div>`;\n\n        if (position.direction == null || position.direction == undefined) {\n          mrkr.direction = 0;\n        } else {\n          mrkr.direction = Number(position.direction);\n        }\n\n        markers.push(mrkr);\n      }\n    })\n    return markers;\n  }\n\n  changeOpenOrClose(event) {\n    this.menuDisplay = event;\n  }\n\n  changeIndicatorsOpen(display) {\n    this.indicatorMinDisplayed = display;\n  }\n\n  assetClicked(event) {\n    this.subMenuDisplay = true;\n    this.selectedAsset = event;\n    this.allSelectedAssets = [this.selectedAsset];\n    this.loadEvents(this.allSelectedAssets);\n\n    if (this.selectedAsset.telemetry) {\n      this.centerInMap(\n        this.selectedAsset.telemetry.lat,\n        this.selectedAsset.telemetry.lng\n      );\n    }\n  }\n\n  displayAssetTrack(event) {\n    this.selectedAsset = event;\n    this.allSelectedAssets = [this.selectedAsset];\n    this.subMenuDisplay = true;\n    this.selectedSubMenuTab = TelemetrySubMenuTabsEnum.TRACK;\n  }\n\n  displayAssetPosition(event) {\n    this.selectedAsset = event;\n\n    if (this.selectedAsset.telemetry) {\n      this.centerInMap(\n        this.selectedAsset.telemetry.lat,\n        this.selectedAsset.telemetry.lng\n      );\n    }\n  }\n\n  displayAssetEvent(event) {\n    this.selectedAsset = event;\n    this.allSelectedAssets = [this.selectedAsset];\n    this.subMenuDisplay = true;\n    this.selectedSubMenuTab = TelemetrySubMenuTabsEnum.EVENTS;\n\n    this.dateNow = new Date();\n    this.historyFilters = {\n      startDate: new Date(this.dateNow.getTime() - 86400000),\n      endDate: this.dateNow,\n    };\n  }\n\n  showAllEvents(event) {\n    this.selectedAsset = null;\n    this.subMenuDisplay = true;\n    this.selectedSubMenuTab = TelemetrySubMenuTabsEnum.EVENTS;\n    this.loadEvents(event);\n  }\n\n  searchHistory() {\n    this.loadEvents(this.allSelectedAssets);\n  }\n\n  loadEvents(assets: Asset[]) {\n    this.telemetryState.removeEvents(this.selectedVehicleEvents);\n\n    this.loadingHistory = true;\n    this.allSelectedAssets = assets;\n    this.telemetryService\n      .getEvents(\n        [],\n        assets\n          .filter(\n            (asset) =>\n              asset.assetType == AssetType.truck ||\n              asset.assetType == AssetType.car\n          )\n          .map((a) => a.id.toString()),\n        assets\n          .filter((asset) => asset.assetType == AssetType.driver)\n          .map((a) => a.id.toString()),\n        this.historyFilters.startDate,\n        this.historyFilters.endDate,\n        true,\n        true\n      )\n      .then((result) => {\n        result.forEach((e) => (e.fromHistory = true));\n        this.telemetryState.addEvents(result);\n        this.selectedVehicleEvents = result.sort(\n          (a, b) => b.datetime.getTime() - a.datetime.getTime()\n        );  \n        this.loadingHistory = false;\n        this.handleLoadingFilters()\n      })\n      .catch((err) => {\n        console.error(err);\n        this.loadingHistory = false;\n      });\n  }\n\n  locationClicked(event) {\n    this.centerInMap(event.lat, event.lng);\n  }\n\n  initiateTimer() {\n    if (this.subsReload) {\n      this.subsReload.unsubscribe();\n    }\n\n    const isPlaying = this.isRouteLoadingInProgress || this.isShowingTrip;\n\n    if(!isPlaying) {\n      this.subsReload = Observable.timer(30000)\n        .take(5)\n        .subscribe(() => {\n          this.submitFilter(false);\n        });\n    }\n\n  }\n\n  initTrackPlaySub() {\n    this.subsTrackPlay = this.telemetryState.getTrackPlayed().subscribe(isPlaying => {\n      this.isRouteLoadingInProgress = isPlaying;\n\n      this.initiateTimer();\n    });\n  }\n\n  initShowingTrackSub() {\n    this.subsShowTrip = this.showTripSubject.subscribe(isShowing => {\n      this.isShowingTrip = isShowing;\n    })\n  }\n\n  private buildFilter(filter: FilterAlarms): DefaultFilter {\n    let defaultFilter = new DefaultFilter();\n\n    defaultFilter.custIds = filter.selectedCustomers;\n    defaultFilter.date1 = this.configService.convertDateToIsoString(filter.selectedDateStart);\n    defaultFilter.date2 = this.configService.convertDateToIsoString(filter.selectedDateEnd);\n    defaultFilter.alarmTypes = filter.selectedAlarmTypes;\n    defaultFilter.driverIds = filter.selectedDrivers;\n    defaultFilter.vehicleIds = filter.selectedVehicles;\n    return defaultFilter;\n  }\n\n  submitFilter(centralizar: boolean) {\n    this.loadingAnimateService.setValue(true);\n\n    if (centralizar) {\n      this.centralizar = true;\n      setTimeout(() => (this.centralizar = false), 2000);\n    } else {\n      this.centralizar = false;\n    }\n\n    this.initiateTimer();\n\n    if (this.telemetryState.getVehicles().length < 1) {\n      this.loadingAnimateService.setValue(false);\n      return null;\n    }\n\n        // Chamar última posição\n        this.telemetryService.getCurrentPositionsByAssetsIdList(this.telemetryState.getVehicles().map(v => v.id.toString()))\n            .subscribe(data => {\n                this.telemetryState.updateTelemetryStatus(data);\n\n                // Chamar os alertas, CASO nao tenha veiculos marcados envia por CUSTOMER, caso contrario envia somente os veiculos.\n                let workspace = this.dataService.getWorkspace();\n\n                if (workspace.selectedFilterAlams) {\n                    this.alarmService.getAlarmsAndInfractionsDefault(this.buildFilter(workspace.selectedFilterAlams))\n                    .subscribe(\n                      async (_alarmAndInfractions: AlarmAndInfraction) => {\n                        this.allAlarmsAndInfractions = _alarmAndInfractions\n                        this.telemetryState.updateAlarms(this.allAlarmsAndInfractions.alarmList);\n                        this.telemetryState.updateInfractions(this.allAlarmsAndInfractions.infractionInformationList);\n\n                this.loadingAnimateService.setValue(false);\n              }\n            );\n        } else {\n          this.loadingAnimateService.setValue(false);\n        }\n      }, error => {\n        this.notificationUtilsService.printErrorMessage(\n          this.translateJsonService.getTranslateSubs(\n            \"TELEMETRY-PAGE.loading_positions_error\"\n          )\n        );\n        this.loadingAnimateService.setValue(false);\n        console.error(error);\n      });\n  }\n\n  private selectRiskFilter(risk: RiskFilter) {\n    let current = [ ...this.currentRiskFilter ];\n\n    const hasFilter = current.includes(risk);\n\n    if (hasFilter) {\n      current = current.filter(item => item !== risk);\n    } else {\n      current.push(risk);\n    }\n\n    this.currentRiskFilter = current;\n  }\n\n  closeHistoryMenu() {\n    this.subMenuDisplay = false;\n    this.telemetryState.removeEvents(this.selectedVehicleEvents);\n  }\n\n\n  showTrip(value: boolean) {\n    this.showTripSubject.next(value);\n  }\n\n  handleFilterChange(filters: { [key: string]: boolean }) {\n    const newFilters: RiskFilter[] = [];\n\n    if(filters.lowRisk) {\n      newFilters.push('LOW-RISK');\n    }\n\n    if(filters.mediumRisk) {\n      newFilters.push('MEDIUM-RISK');\n    }\n\n    if(filters.highRisk) {\n      newFilters.push('HIGH-RISK');\n    }\n\n    if(filters.onMovement) {\n      newFilters.push('MOVE');\n    }\n\n    if(filters.onStop) {\n      newFilters.push('STOP');\n    }\n\n    if(filters.onlyOffline) {\n      newFilters.push('DISCONNECTED');\n    }\n\n    this.currentRiskFilter = newFilters;\n    this.handleLoadingFilters();\n  }\n\n  convertStringToDate(datetime: string): Date {\n    let parts = datetime.split(\" \");\n    let dateParts = parts[0].split(\"/\");\n    let timeParts = parts[1].split(\":\");\n\n    return new Date(\n      parseInt(dateParts[2]),\n      parseInt(dateParts[1]) - 1,\n      parseInt(dateParts[0]),\n      parseInt(timeParts[0]),\n      parseInt(timeParts[1]),\n      parseInt(timeParts[2])\n    );\n  }\n\n  private filterMarkers(filters: RiskFilter[], markers: ModelMarkers[]) {\n    if (filters.length === 0) {\n      return markers;\n    }\n\n    const riskLevels: number[] = [];\n    const vehicleStatuses: string[] = [];\n\n    if(filters.includes('LOW-RISK')) {\n      riskLevels.push(1001);\n    }\n\n    if(filters.includes('MEDIUM-RISK')) {\n      riskLevels.push(1002);\n    }\n\n    if(filters.includes('HIGH-RISK')) {\n      riskLevels.push(1003);\n    }\n\n    if(filters.includes('MOVE')) {\n      vehicleStatuses.push('MOVE');\n    }\n\n    if(filters.includes('STOP')) {\n      vehicleStatuses.push('STOP');\n    }\n\n    if(filters.includes('DISCONNECTED')) {\n      vehicleStatuses.push('DISCONNECTED');\n    }\n\n    const intervalMinutes = 120;\n    const cutoffTime = new Date(Date.now() - intervalMinutes * 60 * 1000);\n    \n    const getMarkerStatus = (markerTime: Date, markerSpeed: number) => {\n\n      if(markerTime < cutoffTime) {\n        return 'DISCONNECTED';\n      }\n\n      if(markerSpeed === 0) {\n        return 'STOP';\n      }\n\n      return 'MOVE';\n    }\n\n    return markers.filter(marker => { \n      const markerTime = this.convertStringToDate(marker.datetime);\n      const markerSpeed = marker.speed;\n      const markerStatus = getMarkerStatus(markerTime, markerSpeed);\n\n      const riskLevel = riskLevels.includes(marker.category);\n      const vehicleStatus = vehicleStatuses.includes(markerStatus);\n\n      if(riskLevels.length > 0 && !riskLevel) {\n        return false;\n      }\n\n      if(vehicleStatuses.length > 0 && !vehicleStatus) {\n        return false;\n      }\n\n      return true;\n    });\n  }\n\n\n  handleLowRisk() {\n    this.handleLoadingFilters();\n\n    let filters = this.allMarkers.filter((x) => x.category === 1001);\n    this.allMarkers = filters;\n  }\n\n  handleMediumRisk() {\n    this.handleLoadingFilters();\n\n    let filters = this.allMarkers.filter((x) => x.category === 1002);\n    this.allMarkers = filters;\n  }\n\n  handleHighRisk() {\n    this.handleLoadingFilters();\n\n    let filters = this.allMarkers.filter((x) => x.category === 1003);\n    this.allMarkers = filters;\n  }\n\n  handleOnMovement() {\n    this.handleLoadingFilters();\n\n    const intervalMinutes = 120;\n    const cutoffTime = new Date(Date.now() - intervalMinutes * 60 * 1000);\n\n    this.allMarkers = this.allMarkers.filter(\n      (x) => x.speed > 0 && this.convertStringToDate(x.datetime) >= cutoffTime\n    );\n  }\n\n  handleOnStop() {\n    this.handleLoadingFilters();\n\n    const intervalMinutes = 120;\n    const cutoffTime = new Date(Date.now() - intervalMinutes * 60 * 1000);\n\n    this.allMarkers = this.allMarkers.filter(\n      (x) => x.speed === 0 && this.convertStringToDate(x.datetime) >= cutoffTime\n    );\n  }\n\n  handleOffline() {\n    this.handleLoadingFilters();\n\n    const intervalMinutes = 120;\n    const cutoffTime = new Date(Date.now() - intervalMinutes * 60 * 1000);\n\n    this.allMarkers = this.allMarkers.filter(\n      (marker) => this.convertStringToDate(marker.datetime) < cutoffTime\n    );\n  }\n\n  \n  handleLoadingFilters() {  \n    this.subsFullInfoVehicles = this.telemetryState\n      .getVehicles$()\n      .subscribe((vehicles) => {\n        const assets = vehicles.filter((v) => v.telemetry);\n        const events: EventModel[] = [];\n\n        vehicles\n          .filter((v) => v.events)\n          .forEach((vehicle) => {\n            events.push(...vehicle.events);\n          });\n\n        if (!this.telemetryState.getHidePositionsIcons()) {\n          const positionsMarkers = this.convertPositionInMarker(assets);\n          const eventsMarkers = this.convertEventMarker(events);\n\n          const markers = [...eventsMarkers, ...positionsMarkers];\n\n          this.allMarkers = this.filterMarkers(this.currentRiskFilter, markers);\n\n          this.initiateTimer();\n        }\n      });\n  }\n\n  selectIdToMap(e){\n    this.selectedIds = []\n    const matrixCustomer = new Set<number>()\n\n    for (const element of e.list) {\n        const customer = element.customerChild;\n        if (customer.parentId === null) {\n            const customerId = customer.id;\n\n            this.selectedIds.push(customerId)\n            matrixCustomer.add(customerId)\n        }\n    }\n\n    this.matrixCustomerIds = [...matrixCustomer]\n  }\n}","module.exports = \"<div class=\\\"main_div\\\">\\n    <div class=\\\"d-flex flex-column justify-content-start align-items-center\\\">\\n\\n            <div class=\\\"d-flex flex-row justify-content-between align-items-center py-1\\\" style=\\\"width: 100%; background-color: #ffffff\\\">\\n                <span class=\\\"screen-title\\\">{{ 'TRIPS-PAGE.title' | translate }}</span>\\n\\n                <div class=\\\"d-flex flex-row align-items-center\\\">\\n                    <div *ngIf=\\\"showCustomerChildDropdown\\\" class=\\\"d-flex justify-content-end ms-2\\\">\\n                        <div style=\\\"width:462px;\\\">\\n                            <focus-tree-input [pendingContent]=false [contentNodes]=\\\"customers\\\" [loadedContent]=\\\"loadedCustomers\\\"\\n                                [selectedNodes]=\\\"selectedCustomers\\\" [checkBox]=true [triStateChk]=true [multChk]=true\\n                                [contentName]=\\\"'GLOBAL.customers' | translate\\\" [overlayPanelWidth]=\\\"'450px'\\\"\\n                                (changedNodes)=\\\"changedCustomers($event)\\\" [isTripsPage]=\\\"isTripsPage\\\" (submitCustomerEmit)=\\\"loadPreSelectedCustomer($event)\\\">\\n                            </focus-tree-input>\\n                        </div>\\n                    </div>\\n                    <div class=\\\"d-flex flex-row\\\">\\n                        <button class=\\\"export-button\\\" (click)=\\\"openExportModal()\\\" [disabled]=\\\"isLoadingExport\\\" [ngClass]=\\\"{'disabled-style' : isLoadingExport }\\\">\\n                            <div *ngIf=\\\"!isLoadingExport; else exporting\\\" class=\\\"d-flex justify-content-around align-items-center\\\" style=\\\"width: 100%;\\\">\\n                                <label style