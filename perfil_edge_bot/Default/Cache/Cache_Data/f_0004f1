hannel: \"ADAS\",\n      id: 2,\n      mediaDate: \"\",\n      startDate: null,\n      endDate: null,\n      mediaOrigin: \"\",\n      videoUrl: \"\",\n    },\n    {\n      channel: \"RIGHT_SIDE\",\n      id: 3,\n      mediaDate: \"\",\n      startDate: null,\n      endDate: null,\n      mediaOrigin: \"\",\n      videoUrl: \"\",\n    },\n    {\n      channel: \"LEFT_SIDE\",\n      id: 4,\n      mediaDate: \"\",\n      startDate: null,\n      endDate: null,\n      mediaOrigin: \"\",\n      videoUrl: \"\",\n    },\n    {\n      channel: \"CABIN\",\n      id: 5,\n      mediaDate: \"\",\n      startDate: null,\n      endDate: null,\n      mediaOrigin: \"\",\n      videoUrl: \"\",\n    },\n  ];\n  public currentGrid = \"grid-2x2\";\n  public gridLayouts: { [key: string]: number } = {\n    \"grid-1x1\": 1,\n    \"grid-2x2\": 4,\n    \"grid-3x3\": 9,\n    \"grid-4x4\": 16,\n  };\n  public selectedDate: Date = null;\n  private startDateSubscription: any;\n  private hasInitialSearchDone: boolean = false;\n\n  constructor(\n    private playbackService: PlaybackOldService,\n    private telemetryService: TelemetryService,\n    private translateJsonService: TranslateJsonService,\n    private playbackState: PlaybackState,\n    private mediaService: MediaDownloadService,\n    private notificationService: NotificationUtilService\n  ) {}\n\n  ngOnInit(): void {\n    this.updateDisplayedVideos();\n    this.calendarDateFormat = this.getDateFormat();\n    this.calendarLocalization = this.translateJsonService.getTranslateCalendar();\n    \n    this.playbackState.getAsset()\n      .pipe(takeUntil(this.destroy$))\n      .subscribe((asset) => {\n        this.asset = asset;\n        this.checkAndDoInitialSearch();\n      });\n  \n    this.startDateSubscription = this.playbackState.getStartDate()\n      .pipe(takeUntil(this.destroy$))\n      .subscribe((date) => {\n        if (date) {\n          this.selectedDate = new Date(date);\n          this.checkAndDoInitialSearch();\n          this.loadActiveDays(this.selectedDate.getMonth(), this.selectedDate.getFullYear());\n        } else if (this.asset && this.deviceImei && !this.hasInitialSearchDone) {\n          this.selectedDate = new Date();\n          this.playbackState.setStartDate(this.selectedDate);\n          const endDate = moment(this.selectedDate).add(1, 'hour').toDate();\n          this.playbackState.setEndDate(endDate);\n          this.playbackState.setHasUserSelectedDate(true);\n          this.hasInitialSearchDone = true;\n          this.onSearchMidias();\n          this.loadActiveDays(this.selectedDate.getMonth(), this.selectedDate.getFullYear());\n        }\n      });\n    \n    this.playbackState.getMovementPeriods()\n      .pipe(takeUntil(this.destroy$))\n      .subscribe((periods) => {\n        const communicationEvent = this.events.find(e => e.type === EventType.ACTIVITY);\n        if (communicationEvent) {\n          communicationEvent.movementPeriods = periods;\n        }\n      });\n  }\n\n  private getDateFormat(): string {\n    const lang = this.translateJsonService.getCurrentTranslate();\n    const format = {\n      \"en\": \"mm/dd/y\",\n      \"ptbr\": \"dd/mm/y\"\n    }[lang];\n    return format ? format : \"dd/mm/y\";\n  }\n\n  public onMonthChange(event: any) {\n    const realMonth = event.month - 1;\n    const year = event.year;\n    this.loadActiveDays(realMonth, year);\n  }\n\n  public isActive(date: any): boolean {\n    const day = moment(date.year + '-' + (date.month + 1) + '-' + date.day).format('YYYY-MM-DD');\n    return this.activeDays.includes(day);\n  }\n\n  private loadActiveDays(month: number, year: number): void {\n    if (!this.asset || !this.deviceImei) return;\n    this.loadingActiveDays = true;\n    const startDate = new Date(Date.UTC(year, month, 1));\n    const endDate = new Date(Date.UTC(year, month + 1, 1));\n\n    const formatDate = (date: Date): string => {\n      const y = date.getUTCFullYear();\n      const m = ('0' + (date.getUTCMonth() + 1)).slice(-2);\n      const d = ('0' + date.getUTCDate()).slice(-2);\n      return `${y}-${m}-${d}`;\n    };\n    const start = formatDate(startDate);\n    const end = formatDate(endDate);\n\n    this.playbackService.getActiveDays(this.deviceImei, start, end)\n      .subscribe({\n        next: (response: any[]) => {\n          this.activeDays = response.map(item => item.date);\n          this.loadingActiveDays = false;\n        },\n        error: _ => {\n          this.activeDays = [];\n          this.loadingActiveDays = false;\n        }\n      });\n  }\n\n  public getDateStyle(date: any) {\n    const dayDate = new Date(date.year, date.month, date.day);\n    const today = new Date();\n    today.setHours(0, 0, 0, 0);\n\n    if (this.isSelected(dayDate)) {\n      return {\n        backgroundColor: '#CC4040',\n        color: 'white',\n        borderRadius: '10%',\n        display: 'inline-block',\n        width: '1.5rem',\n        height: '1.5rem',\n        lineHeight: '1.5rem',\n        textAlign: 'center'\n      };\n    }\n\n    if (this.isActive(date)) {\n      return {\n        backgroundColor: '#20ACAC',\n        color: 'white',\n        borderRadius: '10%',\n        display: 'inline-block',\n        width: '1.5rem',\n        height: '1.5rem',\n        lineHeight: '1.5rem',\n        textAlign: 'center'\n      };\n    }\n\n    if (dayDate.getTime() === today.getTime()) {\n      return {\n        backgroundColor: '#e0e0e0',\n        color: '#212121',\n        borderRadius: '10%',\n        display: 'inline-block',\n        width: '1.5rem',\n        height: '1.5rem',\n        lineHeight: '1.5rem',\n        textAlign: 'center'\n      };\n    }\n\n    return {};\n  }\n\n  private isSelected(date: Date): boolean {\n    if (!this.selectedDate) return false;\n    const selected = new Date(this.selectedDate);\n    selected.setHours(0, 0, 0, 0);\n    return date.getTime() === selected.getTime();\n  }\n  \n  private checkAndDoInitialSearch(): void {\n    if (!this.hasInitialSearchDone && this.asset && this.selectedDate && this.deviceImei) {\n      this.hasInitialSearchDone = true;\n      this.playbackState.setLastEventMosaicSearchDate(null);\n      this.onSearchMidias();\n    }\n  }\n\n  ngOnDestroy(): void {\n    this.destroy$.next();\n    this.destroy$.complete();\n    this.hasInitialSearchDone = false;\n  }\n\n  private loadMovementPeriods(): void {\n    if (!this.asset || !this.selectedDate) {\n      return;\n    }\n\n    const startDate = moment(this.selectedDate).startOf('day').toDate();\n    const endDate = moment(this.selectedDate).endOf('day').toDate();\n\n    this.telemetryService\n      .getMovementPeriodsByAssetAndDeviceId(this.asset.id, this.deviceImei, startDate, endDate)\n      .then((periods) => {\n        this.playbackState.setMovementPeriods(periods);\n      })\n      .catch((error) => {\n        this.notificationService.notify(\n          this.translateJsonService.getTranslateSubs(\"PLAYBACK-PAGE.error_to_load_movements\"),\n          NotificationType.ERROR,\n          NotificationPosition.TOP_CENTER,\n          5\n        );\n      });\n  }\n\n  public setGrid(gridClass: string): void {\n    this.currentGrid = gridClass;\n  }\n\n  public onTabChange(event: any) {\n    if (event.index === 1) {\n      this.loadJoinedRequests();\n    }\n  }\n\n  public loadJoinedRequests(retry = true): void {\n    this.mediaService.getPlaybackMediaJoinedRequests(this.asset.imei).pipe(takeUntil(this.destroy$))\n    .subscribe({\n      next: (data) => {\n        this.joinedRequests = data.sort(\n          (a, b) =>\n            new Date(b.requestedAt).getTime() - new Date(a.requestedAt).getTime()\n        );\n        const hasProcessing = this.joinedRequests.some(req => req.status === \"PROCESSING\");\n        if (hasProcessing && retry) {\n          setTimeout(() => this.loadJoinedRequests(), 5000);\n        }\n      },\n      error: (error) => {\n        this.notificationService.notify(\n          \"Erro ao carregar solicitações de mídias concatenadas\",\n          NotificationType.ERROR,\n          NotificationPosition.TOP_CENTER,\n          5\n        );\n      },\n    });\n  }\n\n  public formatStatus(status: string): string {\n    return status === \"PROCESSING\"\n      ? this.translateJsonService.getTranslateSubs(\"PLAYBACK-PAGE.processing\")\n      : this.translateJsonService.getTranslateSubs(\"PLAYBACK-PAGE.available\");\n  }\n\n  public formatDate(date: string): string {\n    return new Date(date).toLocaleString(\"pt-BR\");\n  }\n\n  public getDisplayedChannels(): Medias[] {\n    const channelsWithVideos = this.medias.filter(\n      (channel) => channel.videoUrl\n    );\n\n    if (channelsWithVideos.length <= 1) {\n      this.currentGrid = \"grid-1x1\";\n    } else if (channelsWithVideos.length <= 4) {\n      this.currentGrid = \"grid-2x2\";\n    } else if (channelsWithVideos.length <= 9) {\n      this.currentGrid = \"grid-3x3\";\n    } else {\n      this.currentGrid = \"grid-4x4\";\n    }\n\n    const maxChannels =\n      this.gridLayouts[this.currentGrid] || this.medias.length;\n\n    return this.medias\n      .filter((channel) => channel.videoUrl)\n      .slice(0, maxChannels);\n  }\n\n  private updateDisplayedVideos(): void {\n    this.displayedVideos = this.events;\n  }\n\n  public onSearchMidias(): void {\n    if (!this.selectedDate) {\n      return;\n    }\n    const lastSearchedDate = this.playbackState.getLastEventMosaicSearchDate();\n    const isSameDate = lastSearchedDate && \n                      lastSearchedDate.getDate() === this.selectedDate.getDate() &&\n                      lastSearchedDate.getMonth() === this.selectedDate.getMonth() &&\n                      lastSearchedDate.getFullYear() === this.selectedDate.getFullYear();\n    \n    if (isSameDate) {\n      return;\n    }\n\n    this.displayLoader = true;\n\n    const startDate = moment(this.selectedDate).startOf(\"day\").toDate();\n    \n    this.playbackState.setLastEventMosaicSearchDate(new Date(this.selectedDate));\n    this.playbackState.setStartDate(this.selectedDate);\n    const endDate = moment(this.selectedDate).add(1, 'hour').toDate();\n    this.playbackState.setEndDate(endDate);\n    this.playbackState.setHasUserSelectedDate(true);\n\n    this.playbackService\n      .getAllMediasFromDevice(this.deviceImei, startDate)\n      .pipe(takeUntil(this.destroy$))\n      .subscribe({\n        next: (response) => {\n          this.populateEvents(response);\n          this.processMediaResponse(response);\n          this.displayLoader = false;\n          this.hasSearched = true;\n          this.loadMovementPeriods();\n        },\n        error: (error) => {\n          this.displayLoader = false;\n        },\n      });\n  }\n\n  public canConcatenate(): boolean {\n    const selectedMedias = this.mediaList.filter((m) => m.selected);\n    if (selectedMedias.length === 0) {\n        return false;\n    }\n\n    const firstChannel = selectedMedias[0].channel;\n    const isSameChannel = selectedMedias.every((media) => media.channel === firstChannel);\n\n    if (!isSameChannel) {\n        return false;\n    }\n    return selectedMedias.length <= this.getVideoLimitFromDevice();\n}\n\npublic canBuildMosaic(): boolean {\n    const selectedMedias = this.mediaList.filter((m) => m.selected);\n    return selectedMedias.length > 0 && selectedMedias.length <= 16;\n}\n\n  public onConcatenate(): void {\n    const selectedMedias = this.getSelectedMedias();\n    if (selectedMedias.length < 2) {\n      return;\n    }\n\n    const payload = this.buildPlaybackMediaJoinerPayload(selectedMedias, FfmpegOperationType.JOIN_MEDIAS);\n    this.mediaService.joinPlaybackMedia(payload).subscribe({\n      next: this.handleSuccess.bind(this),\n      error: this.handleError.bind(this),\n    });\n  }\n\n  public onBuildMosaic(): void {\n    const selectedMedias = this.getSelectedMedias();\n    if (selectedMedias.length < 2) {\n      return;\n    }\n\n    const payload = this.buildPlaybackMediaJoinerPayload(selectedMedias, FfmpegOperationType.BUILD_MOSAIC);\n    this.mediaService.joinPlaybackMedia(payload).subscribe({\n      next: this.handleSuccess.bind(this),\n      error: this.handleError.bind(this),\n    });\n  }\n\n  public getChannelTranslation(channel: string): string {\n    switch (channel) {\n      case \"ADAS\":\n        return this.translateJsonService.getTranslateSubs(\n          \"EQUIPMENT-CAM-LIST.front_camera\"\n        );\n      case \"DMS\":\n        return this.translateJsonService.getTranslateSubs(\n          \"EQUIPMENT-CAM-LIST.fatigue_camera\"\n        );\n      case \"RIGHT_SIDE\":\n        return this.translateJsonService.getTranslateSubs(\n          \"EQUIPMENT-CAM-LIST.side_camera\"\n        );\n      case \"LEFT_SIDE\":\n        return this.translateJsonService.getTranslateSubs(\n          \"EQUIPMENT-CAM-LIST.side_camera\"\n        );\n      case \"CABIN\":\n        return this.translateJsonService.getTranslateSubs(\n          \"EQUIPMENT-CAM-LIST.cabin_camera\"\n        );\n      default:\n        return channel;\n    }\n  }\n\n  public getMediaByChannel(channel: string): PlaybacksToJoin[] {\n    return this.mediaList.filter((media) => media.channel === channel);\n  }\n\n  public toggleVideoSelection(media: PlaybacksToJoin): void {\n    const selectedMedias = this.mediaList.filter((m) => m.selected);\n    const videoLimit = Math.max(this.getVideoLimitFromDevice(), 16);\n\n    if (selectedMedias.length >= videoLimit && !media.selected) {\n        return;\n    }\n\n    media.selected = !media.selected;\n    this.mediaList = [...this.mediaList];\n}\n\n\npublic isCheckboxDisabled(media: PlaybacksToJoin): boolean {\n  const selectedMedias = this.mediaList.filter((m) => m.selected);\n  const videoLimit = Math.max(this.getVideoLimitFromDevice(), 16);\n  if (selectedMedias.length >= videoLimit && !media.selected) {\n      return true;\n  }\n  if (selectedMedias.length === 0) {\n      return false;\n  }\n\n  const selectedChannels = new Set(selectedMedias.map((m) => m.channel));\n  const isSameChannel = selectedChannels.size === 1;\n  return !isSameChannel && selectedMedias.length >= this.getVideoLimitFromDevice();\n}\n\n\n  public getFormattedDate(dateString: string): string {\n    return moment(dateString).format(\"DD/MM/YYYY HH:mm:ss\");\n  }\n\n  public handleDownload(url: string) {\n    window.open(url, \"_blank\");\n  }\n\n  public calculateProgress(event: any): string {\n    if (event.videos.length === 0) return \"0%\";\n    const start = new Date(event.startDate).getTime();\n    const end = new Date(event.endDate).getTime();\n    const now = new Date().getTime();\n    const progress = ((now - start) / (end - start)) * 100;\n    return `${Math.min(Math.max(progress, 0), 100)}%`;\n  }\n\n  public onDateChange(newDate: Date): void {\n    if (!newDate) {\n      return;\n    }\n    const lastSearchDate = this.playbackState.getLastEventMosaicSearchDate();\n    const isSameDate = lastSearchDate && \n                      lastSearchDate.getDate() === newDate.getDate() &&\n                      lastSearchDate.getMonth() === newDate.getMonth() &&\n                      lastSearchDate.getFullYear() === newDate.getFullYear();\n    \n    if (isSameDate) {\n      return;\n    }\n    \n    this.events.forEach((event) => {\n      event.videos = [];\n      if (event.type === EventType.ACTIVITY) {\n        event.movementPeriods = [];\n      }\n    });\n    this.allMarkers = [];\n    this.devicePositions = [];\n    this.displayedVideos = [];\n    \n    this.playbackState.setLastEventMosaicSearchDate(null);\n    this.playbackState.setStartDate(newDate);\n    const endDate = moment(newDate).add(1, 'hour').toDate();\n    this.playbackState.setEndDate(endDate);\n    this.playbackState.setHasUserSelectedDate(true);\n    \n    this.onSearchMidias();\n  }\n\n  public isVideo(url: string): boolean {\n    return url ? url.includes(\".mp4\") || url.includes(\".mov\") : false;\n  }\n  \n  public isSnapshot(url: string): boolean {\n    return url ? url.includes(\".jpeg\") || url.includes(\".jpg\") || url.includes(\".png\") : false;\n  }\n\n  public toggleFullscreen(element: HTMLElement): void {\n    try {\n      if (!document.fullscreenElement) {\n        element.requestFullscreen();\n        this.isFullScreen = true;\n      } else {\n        document.exitFullscreen();\n        this.isFullScreen = false;\n      }\n    } catch (err) {}\n  }\n\n  public playVideo(video: any): void {\n    this.displayLoader = true;\n    if (video.isAuthenticated) {\n      this.processVideoWithGroupedMedias(video);\n      this.displayLoader = false;\n      return;\n    }\n    this.playbackService.downloadFile(video.urlMovie)\n      .then((authenticatedUrl) => {\n        video.urlMovie = authenticatedUrl;\n        video.isAuthenticated = true;\n        this.processVideoWithGroupedMedias(video);\n      })\n      .catch(() => {\n        this.handleError();\n        this.processVideoWithGroupedMedias(video);\n      });\n  }\n\nprivate processVideoWithGroupedMedias(video: any): void {\n  const groupedMedias = this.findGroupedMedias(\n    video,\n    [].concat(...this.events.map((e) => e.videos)).filter(media => media.mediaOrigin === video.mediaOrigin)\n  );\n  const authenticationPromises = groupedMedias.map((media) => {\n    if (media.isAuthenticated) {\n      return Promise.resolve(media);\n    }\n    return this.playbackService.downloadFile(media.urlMovie)\n      .then((authenticatedUrl) => {\n        media.urlMovie = authenticatedUrl;\n        media.isAuthenticated = true;\n        return media;\n      })\n      .catch(() => media);\n  });\n  Promise.all(authenticationPromises).then((authenticatedMedias) => {\n    this.processVideo(video, authenticatedMedias);\n  });\n}\n\nprivate processVideo(video: any, groupedMedias: any[] = []): void {\n    const videoDate = new Date(video.mediaDate);\n    let threeHours = 3 * 60 * 60 * 1000;\n    const adjustedVideoDate = new Date(videoDate.getTime() - threeHours);\n    const startDate = new Date(adjustedVideoDate.getTime());\n    const endDate = new Date(adjustedVideoDate.getTime());\n    this.clearDisplayedVideos();\n    const channelsToUpdate = [\n      video.channel,\n      ...groupedMedias.map((g) => g.channel),\n    ];\n    this.telemetryService\n      .getTrackingByDeviceId(this.deviceImei, startDate, endDate)\n      .then((positions) => {\n        this.devicePositions = positions;\n\n        const closestPosition = this.getClosestPosition(videoDate, positions);\n        if (closestPosition) {\n          this.updateMapCenter(closestPosition);\n        }\n      })\n      .catch((error) => {});\n\n    this.updateChannelsWithVideos(video, groupedMedias, channelsToUpdate);\n  }\n\n  public getMovementPeriodPosition(periodStartDateTime: string): number {\n    if (!this.selectedDate) {\n      return 0;\n    }\n\n    const dayStart = new Date(this.selectedDate).setHours(0, 0, 0, 0);\n    const dayEnd = new Date(this.selectedDate).setHours(23, 59, 59, 999);\n    const totalMilliseconds = dayEnd - dayStart;\n\n    const periodStart = new Date(periodStartDateTime).getTime();\n    const position = ((periodStart - dayStart) / totalMilliseconds) * 100;\n\n    return Math.max(0, Math.min(100, position));\n  }\n\n  public getMovementPeriodWidth(periodStartDateTime: string, periodEndDateTime: string): number {\n    if (!this.selectedDate) {\n      return 0;\n    }\n\n    const dayStart = new Date(this.selectedDate).setHours(0, 0, 0, 0);\n    const dayEnd = new Date(this.selectedDate).setHours(23, 59, 59, 999);\n    const totalMilliseconds = dayEnd - dayStart;\n\n    const periodStart = new Date(periodStartDateTime).getTime();\n    const periodEnd = new Date(periodEndDateTime).getTime();\n    \n    const duration = periodEnd - periodStart;\n    const width = (duration / totalMilliseconds) * 100;\n\n    return Math.max(0, Math.min(100, width));\n  }\n\n  public calculatePosition(eventDate: Date, previousEventDate?: Date): string {\n    if (!this.selectedDate) {\n      return \"0%\";\n    }\n\n    const start = new Date(this.selectedDate).setHours(0, 0, 0, 0);\n    const end = new Date(this.selectedDate).setHours(23, 59, 59, 999);\n    const totalMilliseconds = end - start;\n\n    const eventMilliseconds = new Date(eventDate).getTime() - start;\n\n    if (eventMilliseconds < 0 || eventMilliseconds > totalMilliseconds) {\n      return \"0%\";\n    }\n\n    let position = (eventMilliseconds / totalMilliseconds) * 100;\n\n    if (previousEventDate) {\n      const prevMilliseconds = new Date(previousEventDate).getTime() - start;\n      const prevPosition = (prevMilliseconds / totalMilliseconds) * 100;\n\n      const minSpacing = 1;\n      if (position - prevPosition < minSpacing) {\n        position = prevPosition + minSpacing;\n      }\n    }\n\n    return `${position}%`;\n  }\n\n  private getSelectedMedias(): PlaybacksToJoin[] {\n    return this.mediaList.filter((media) => media.selected);\n  }\n\n  private processMediaResponse(response: PlaybacksToJoin): void {\n    this.mediaList = Object.keys(response)\n      .map((key) => response[key])\n      .filter((media) => media.mediaOrigin === MediaOrigin.PLAYBACK)\n      .map((media) => ({ ...media, selected: false }));\n  }\n\n  private getVideoLimitFromDevice(): number {\n    switch (this.asset.equipmentTypeId) {\n      case 2:\n      case 12:\n      case 13:\n        return 12;\n      case 3:\n      case 14:\n      case 11:\n        return 60;\n      case 4:\n        return 20;\n      default:\n        return 12;\n    }\n  }\n\n  private buildPlaybackMediaJoinerPayload(\n    selectedMedias: PlaybacksToJoin[], operationType: FfmpegOperationType\n  ): PlaybackMediaJoiner {\n\n    const ffmpegOperationType = operationType === FfmpegOperationType.BUILD_MOSAIC ? FfmpegOperationType.BUILD_MOSAIC : FfmpegOperationType.JOIN_MEDIAS;\n\n    return {\n      urlMedia: selectedMedias.map((media) => media.urlMovie).join(\";\"),\n      newUrlMedia: null,\n      mediaCount: selectedMedias.length,\n