;\n  public loadedCustomers: boolean;\n  public selectedCustomers: number[];\n\n  public onlineVehiclesOnly: boolean = false;\n\n  public vehicles: Asset[];\n  public isTableLoaded: boolean = false;\n  public isTableLoading: boolean = false;\n\n  public isSearchDisabled: boolean = true;\n\n  public ngOnInit(): void {\n    this.dataService.havePermission('PLAYBACK', 'MEDIAS');\n\n    this.vehicles = [];\n    \n    this.initSubscriptions();\n    this.loadWorkspace();\n    this.getWorkspaceCustomersIds();\n    this.loadAvailabelCustomers();\n    this.initSearchDebounce();\n  }\n\n  public ngOnDestroy(): void {\n    if (this.subsCustomers) this.subsCustomers.unsubscribe();\n    if (this.subsSelectedCustomers) this.subsSelectedCustomers.unsubscribe();\n    if (this.subsSelectedAssetStatus) this.subsSelectedAssetStatus.unsubscribe();\n    if (this.subsCurrentSearch) this.subsCurrentSearch.unsubscribe();\n  }\n\n  public onCustomersChange(event: number[]): void {\n    this.selectedCustomers = event;\n    this.isSearchDisabled = event.length === 0;\n    this.playbackState.setSelectedCustomers(event);\n  }\n\n  public onOnlineVehiclesOnlyChange(value: boolean): void {\n    if (this.vehiclesTable) {\n      this.onlineVehiclesOnly = value;\n      const filterValue = value ? value : null;\n\n      this.playbackState.setSelectedAssetStatus(value);\n      this.vehiclesTable.filter(filterValue, 'isOnline', 'equals');\n    }\n  }\n\n  public onInputWrapperClick() {\n    const wrapper = this.inputWrapper.nativeElement;\n    \n    wrapper.querySelector('input').focus();\n  }\n\n  public onSearchButtonClick() {\n    if (this.selectedCustomers && this.selectedCustomers.length > 0) {\n      this.loadCustomersVehicles(this.selectedCustomers);\n    } else {\n      const customersIds = this.customers.map(customer => customer.id);\n\n      this.loadCustomersVehicles(customersIds);\n    }\n  }\n\n  public onSelectMedias(vehicle: Asset): void {\n    this.playbackState.setAsset(vehicle);\n    this.playbackState.setSelectedOption('media');\n    this.router.navigate(['stream'], { relativeTo: this.activatedRoute });\n  }\n\n  public onSelectPlayback(vehicle: Asset): void {\n    this.playbackState.setAsset(vehicle);\n    this.playbackState.setSelectedOption('playback');\n    this.router.navigate(['stream'], { relativeTo: this.activatedRoute });\n  }\n  \n\n  private loadWorkspace(): void {\n    this.workspace = this.dataService.getWorkspace();\n  }\n\n  private getWorkspaceCustomersIds(): void {\n    this.availableCustomers = this.workspace\n      .userCustomerChildIds\n      .map(customerChildPermission => customerChildPermission.customer)\n  }\n\n  private loadAvailabelCustomers(): void {\n    this.subsCustomers = this.customerService\n      .getCustomerChildsByIds(this.availableCustomers)\n      .subscribe((_customers: CustomerChild[]) => {\n\n        this.customers = _customers;\n        this.customersOptions = this.customerService\n          .convertCustomerChildsToTreeInputModel(_customers);\n        this.playbackState.setSelectedCustomerChilds(_customers);\n        this.loadedCustomers = true;\n    })\n  }\n\n  private loadCustomersVehicles(customersIds: number[]) {\n    this.isTableLoading = true;\n    this.isTableLoaded = false;\n    this.vehicles = [];\n\n    this.assetService\n      .checkOnlineStatusByCustomersChildAndAssetType(customersIds, 3, [EquipamentFeatures.PLAYBACK])\n      .subscribe(\n        (vehicles) => {\n          this.vehicles = vehicles;\n          this.isTableLoading = false;\n          this.isTableLoaded = true;\n\n          const isOnlineValue = this.onlineVehiclesOnly ? true : null;\n\n          (this.vehiclesTable as any).filterGlobal(this.searchValue, 'contains');\n          this.vehiclesTable.filter(isOnlineValue, 'isOnline', 'equals');\n        }, \n        () => { \n          this.isTableLoading = false;\n          this.isTableLoaded = true;\n        },\n      );\n  }\n  \n  private initSearchDebounce(): void {\n    if (this.vehiclesTable) {\n      this.searchDebounce.pipe(\n        debounceTime(500),\n        distinctUntilChanged()\n      )\n      .subscribe(value => {\n        (this.vehiclesTable as any).filterGlobal(value, 'contains')\n        this.playbackState.setCurrentSearch(value);\n      });\n    }\n  }\n\n  private initSubscriptions(): void {\n    this.subsSelectedCustomers = this.playbackState.getSelectedCustomers().subscribe(value => this.handleSelectedCustomersSubscription(value));\n    this.subsSelectedAssetStatus = this.playbackState.getSelectedAssetStatus().subscribe(value => this.onlineVehiclesOnly = value);\n    this.subsCurrentSearch = this.playbackState.getCurrentSearch().subscribe(value => this.searchValue = value);\n  }\n\n  private handleSelectedCustomersSubscription(customersIds: number[]) {\n    const isSearchDisabled = !customersIds.length;\n\n    this.selectedCustomers = customersIds;\n    this.isSearchDisabled = isSearchDisabled;\n\n    if (!isSearchDisabled) {\n      this.loadCustomersVehicles(customersIds);\n    }\n  }\n}","import { Injectable } from \"@angular/core\";\nimport { BehaviorSubject, Observable, combineLatest } from \"rxjs\";\n\nimport { Camera, PlaybackRoute, PlaybackTask, PlaybackVideo } from \"../types\";\nimport { Asset } from \"app/@core/models\";\nimport { TranslateJsonService } from \"app/@core/data/translate-json.service\";\nimport { EquipamentType } from \"app/@core/enum/equipament.type.enum\";\nimport { MovementPeriod } from \"app/@core/models/movementPeriod.entity\";\nimport { map } from 'rxjs/operators';\n\nexport interface SchedulePeriod {\n  start: Date;\n  end: Date;\n}\n\n\n@Injectable()\nexport class PlaybackState {\n  constructor(\n    private translateJsonService: TranslateJsonService\n  ) {}\n\n  protected selectedCustomers$: BehaviorSubject<number[]> = new BehaviorSubject<number[]>([]);\n  protected selectedAssetStatus$: BehaviorSubject<boolean> = new BehaviorSubject<boolean>(false);\n  protected currentSearch$: Behavio