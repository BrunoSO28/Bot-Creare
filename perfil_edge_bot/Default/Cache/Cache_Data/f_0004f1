rdinate, _icon, _title, _popup) {\n      if (!this.layerDict[_layerName]) return ;\n\n      let icon = new L.Icon(_icon);\n\n      let marker = (this.layerDict[_layerName].mapObjects)?this.layerDict[_layerName].mapObjects[_markerId]: undefined;\n\n      if(this.layerDict[_layerName].drawnItems.hasLayer(marker)) {\n        this.layerDict[_layerName].mapObjects[_markerId] = [];\n        var newLatLng = new L.LatLng(_coordinate[0], _coordinate[1]);\n        marker.setLatLng(newLatLng); \n        if (_icon !== null){\n          marker.setIcon(icon);\n        }\n        this.layerDict[_layerName].mapObjects[_markerId] = marker;\n      } else {\n        try{\n          if ((_icon !== null) && (_icon != {})){\n            marker = new L.Marker(_coordinate, {icon: icon, title: _title});\n          } else {\n            marker = new L.Marker(_coordinate, {title: _title});          \n          }\n\n          this._addObj(_layerName, _markerId, marker);\n\n        } catch(e) {\n          console.log('addMarker error:' + e);\n          console.log('coordenadas: ' + _coordinate);\n        }\n      }\n      if((_popup !== '') && (typeof marker != 'undefined' )) {\n        marker.bindPopup(_popup, {className: 'map-popup-vehicle'});\n      };\n  } \n\n  private _addObj(_layerName, _id, _obj) {\n    this.layerDict[_layerName].mapObjects[_id] = _obj; \n    this.layerDict[_layerName].drawnItems.addLayer(_obj);\n  }\n\n\n    private iconRoter(label,color){\n        let img = 'https://chart.googleapis.com/chart?chst=d_bubble_text_small&chld=bb|'+label+'|'+color+'|000000'; \n        return {iconUrl:img, iconAnchor:[0,42]}\n    };\n\n\n    ngOnDestroy(): void {      \n      console.info('ngOnDestroy'); \n      if(this.subPictureAlarms) this.subPictureAlarms.unsubscribe();\n    }\n  \n\n    private centerMapInObject(_layerName, _objId) {\n      let bounds;\n      if(_objId) {\n        let mapObj = this.layerDict[_layerName].mapObjects[_objId];\n        if(typeof mapObj !== 'undefined') {\n