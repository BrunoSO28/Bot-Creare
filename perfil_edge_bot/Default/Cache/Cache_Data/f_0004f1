rip } from \"../models/trip.model\";\nimport { Tag } from \"app/@core/models/tag.entity\";\nimport { TagType} from \"app/@core/enum/tag-type.enum\";\nimport { Infraction } from \"app/@core/models/infraction.entity\";\nimport { LastInstalledEquipModel } from \"../models/last-installed-equip.model\";\nimport { ExportFilesService } from \"app/@core/data/export-files.service\";\nimport { AlarmAndInfraction } from \"app/@core/models/alarmAndInfraction.entity\";\nimport { TripEvents } from \"../models/trip-events.model\";\n\nconst FIVE_MINUTES = 60 * 5;\nconst TEN_MINUTES = FIVE_MINUTES * 2\nconst ONE_HOUR = TEN_MINUTES * 6\nconst THREE_HOURS = ONE_HOUR * 3\n\n@Component({\n    selector: 'sub-menu-telemetry',\n    styleUrls: ['./sub-menu.component.scss'],\n    templateUrl: './sub-menu.component.html'\n})\nexport class SubMenuTelemetryComponent implements OnChanges, OnDestroy {\n    @ViewChild('mediasShow') mediasShow: ModalDirective;\n    @Input('selectedAsset') selectedAsset: Asset;\n    @Output('closeHistoryMenu') closeHistoryMenuEmit: EventEmitter<boolean> = new EventEmitter<boolean>();\n    @Output('center') centerEmitter: EventEmitter<{ lat: number, lng: number }> = new EventEmitter<{ lat: number, lng: number }>();\n    @Output('showingTrip') showingTrip: EventEmitter<boolean> = new EventEmitter<boolean>();\n\n    public historyFilters: { startDate: Date, endDate: Date };\n    public subMenuDisplay: boolean = false; \n    public selectedVehicleEvents: EventModel[] = [];\n    public loadingHistory: boolean;\n    public trips: Trip[] = [];\n    public selectedTrip: Trip;\n    public alarms: Alarm[];\n    public playerPlayed: boolean = false;\n    public curTimePlayer: number;\n    public curPlayerSpeed: number = 1;\n    private playerWasPlayingWhileScrubbing: boolean = false\n    public deviceList:Equipament[] = [];\n    public selectedDevice:any;\n    public lastInstalledDevice: LastInstalledEquipModel\n    public selectedAlarmMedias: PictureAndMovie;\n    public assetType = AssetType;\n    public tripEventType = TripEventsType;\n    public fullTripsInTimeRange;\n    public infractions: Infraction[];\n    public tripReport: any[] = [];\n    public exportReport;\n\n    constructor(\n        private telemetryState: TelemetryState,\n        public translateJsonService: TranslateJsonService,\n        private telemetryService: TelemetryService,\n        private alarmService: AlarmService,\n        private configService: ConfigService,\n        private dialogService: DialogService,\n        private equipmentService: EquipmentService,\n        private exportFilesService: ExportFilesService,\n    ){\n        const dateNow = new Date();\n        const twelveHoursInMilliseconds = 43200000;\n        this.historyFilters = { startDate: new Date(dateNow.getTime()-twelveHoursInMilliseconds), endDate: dateNow };\n\n        this.telemetryState.getTrackingInfos$().subscribe(result => {\n            this.curTimePlayer = Number(result.curTime);\n        })\n    }\n\n    ngOnChanges(changes : SimpleChanges){  \n        \n        if(changes['selectedAsset']) {  \n            this.resetDeviceFilter()\n            this.getEquipmentsByAsset(this.selectedAsset);\n        }\n    }\n\n    getEquipmentsByAsset(asset: Asset) {\n        this.equipmentService.getEquipmentsByAsset(asset.id).subscribe(equipments=>{\n            equipments.forEach(equip=>equip.label = ` ${equip.equipmentTypeName} - ${equip.identification}  `)\n            this.deviceList= equipments\n            if (equipments.length==1){\n                this.selectedDevice = equipments[0]\n                this.getTracking()\n            }\n            else if (equipments.length==0){\n                this.lastInstalledDevice = { identification: asset.telemetry[\"device_id\"], deviceLastTrackingDate: asset.telemetry[\"datetime\"]};\n                this.historyFilters.endDate = new Date(this.lastInstalledDevice.deviceLastTrackingDate)\n                const twelveHoursInMilliseconds = 43200000;\n                this.historyFilters.startDate = new Date(this.historyFilters.endDate.getTime() - twelveHoursInMilliseconds)\n                this.selectedDevice = this.lastInstalledDevice; \n                this.getTracking(this.lastInstalledDevice.identification)\n            } else {\n                this.trips = []\n                this.fullTripsInTimeRange = null\n            }\n        })\n    }\n\n    resetDeviceFilter(){\n        this.selectedDevice=null\n        this.deviceList = [];\n    }\n\n    ngOnDestroy(): void {\n        this.playOrStop(false)\n        this.telemetryState.setIsReconstructingRoute(false);\n    }\n\n    public getTracking(deviceIdentification?: string) {\n        this.loadingHistory = true;\n        this.trips = []\n        this.fullTripsInTimeRange = null\n        const deviceId = deviceIdentification ? deviceIdentification : this.selectedDevice.identification;\n\n        this.telemetryService\n            .getTrackingByDeviceId(deviceId, this.historyFilters.startDate, this.historyFilters.endDate)\n            .then(async result => {\n\n                let track = result.map(r => {\n                    return { \n                        time: new Date(r.device_datetime).getTime() / 1000,\n                        dir: 320,\n                        lng: r.longitude,\n                        lat: r.latitude,\n                        speed: r.data.telemetry.speed == null ? r.data.telemetry.gps_speed : r.data.telemetry.speed,\n                        ignition: r.data.telemetry.ignition\n                    }\n                });\n\n                track = track.sort((a, b) => a.time - b.time);\n\n                let trips: Trip[] = [];\n\n                let fullTrips: Trip = new Trip();\n                \n                let trip: Trip = new Trip();\n\n                trips.push(trip);\n\n                if(track.length > 0) {\n\n                    let lastValidTime = track[0].time;\n                    let lastSpeed = track[0].speed;\n                    let timeStopped = 0\n                    let breakTrip = false\n                    let lastIgnition = false\n\n                    track.forEach((t, i) => {\n                        \n                        fullTrips.positions.push(t)\n\n                        breakTrip = false\n\n                        let timeSinceLast = t.time - lastValidTime\n                        \n                        if(timeSinceLast > TEN_MINUTES)\n                            trip.failedComms = true\n\n                        if(timeSinceLast > ONE_HOUR)\n                            breakTrip = true\n\n                        if((t.speed == 0 || lastSpeed == 0) && !this.hasIgnition(t)) {\n\n                            timeStopped += timeSinceLast\n\n                            if(timeStopped > FIVE_MINUTES)\n                                breakTrip = true\n                        }\n                        else\n                            timeStopped = 0\n\n                        if(t.ignition == false && lastIgnition == true) {\n                            breakTrip = true\n                        }\n                        \n                        if (breakTrip) {\n                            trip = new Trip();\n                            trips.push(trip);\n                            timeStopped = 0;\n                        }\n\n                        lastValidTime = t.time;\n                        lastIgnition = t.ignition;\n                        lastSpeed = t.speed;\n\n                        if(t.speed > 0 && t.ignition != false)\n                            trip.positions.push(t)\n                    })\n                }\n\n                trips = trips.filter(t => t.positions.length > 1);\n\n                let events: EventModel[] = await this.loadEvents();\n                let tags: Tag[] = await this.loadTags();\n\n                this.getAlarmsAndInfractionsByPeriod().then((alarmsInfractions: AlarmAndInfraction) => {\n\n                    let infractions = alarmsInfractions.infractionInformationList.length > 0 ?\n                        alarmsInfractions.infractionInformationList[0].infractionList\n                        .filter(a=>a.deviceId == deviceId) : []\n\n                    let alarms = alarmsInfractions.alarmList.filter(a=>a.imei == deviceId)\n\n                    this.enrichTripInfo(fullTrips, alarms, infractions, events, tags);\n\n                    trips.forEach(t => {\n                        this.enrichTripInfo(t, alarms, infractions, events, tags)\n                    })\n                    this.fullTripsInTimeRange = fullTrips\n                    this.trips = trips;\n                    this.loadingHistory = false;\n                    \n                }).catch(err => {\n                    console.log(err);\n                    this.loadingHistory = false;\n                })\n            }).catch(err =>{this.loadingHistory = false; console.log(err)})\n    }\n\n    private hasIgnition(position: any) {\n        return position.ignition === false || position.ignition === true || position.ignition instanceof Boolean;\n    }\n\n    public selectTrip(trip) {\n\n        this.telemetryState.setIsReconstructingRoute(true);\n        \n        let tripEventsMarkers: ModelMarkers[] = [];\n        let tripAlertsMarkers: ModelMarkers[] = [];\n        \n        this.tripReport = trip['positions'];\n        this.selectedTrip = trip;\n\n        this.telemetryState.addTracking(trip.positions);\n        this.center(trip.positions[0].lat, trip.positions[0].lng);\n        this.telemetryState.setHidePositionIcons(true);\n\n        if(trip.alarms) {\n            const converted = this.convertAlarmsMarker(trip.alarms);\n            tripAlertsMarkers.push(...converted)\n        }\n        if(trip.infractions) {\n            const converted = this.convertInfractionsMarker(trip.infractions);\n            tripAlertsMarkers.push(...converted)\n        }\n        if (trip.events) {\n            const converted = this.convertEventMarker(trip.events);\n            tripEventsMarkers.push(...converted)\n        } \n        if (trip.tags) {\n            const converted = this.convertTagMarker(trip.tags);\n            tripEventsMarkers.push(...converted);\n        }\n\n        this.telemetryState.setTrackingAlerts(tripAlertsMarkers);\n        this.telemetryState.setTrackingEvents(tripEventsMarkers);\n\n        this.showingTrip.emit(true);            \n    }\n\n    public closeHistoryMenu(){\n        this.telemetryState.removeEvents(this.selectedVehicleEvents);\n        this.closeHistoryMenuEmit.emit(true);\n        this.subMenuDisplay = false;\n    }\n\n    clickSlider() {\n        this.playerWasPlayingWhileScrubbing = this.playerPlayed\n        this.playOrStop(false)\n    }\n\n    loadEvents(): Promise<EventModel[]> {\n        if (this.selectedAsset.assetType == AssetType.driver) {\n            return this.telemetryService.getEvents([],[], [this.selectedAsset.id.toString()], this.historyFilters.startDate,\n                this.historyFilters.endDate, true, true);\n\n        } else {\n            return this.telemetryService.getEvents([],[this.selectedAsset.id.toString()], [], this.historyFilters.startDate,\n                this.historyFilters.endDate, true, true);\n        }\n    }\n\n    private async loadTags() {\n        try {\n            const tags = await this.telemetryService.getTagsByDevices([this.selectedDevice.identification], this.historyFilters.startDate,\n                this.historyFilters.endDate).toPromise();\n            return tags\n        } catch (error) {\n            return null;\n        }\n    }\n\n    unClickSlider() {\n        if (this.playerWasPlayingWhileScrubbing){\n            this.playOrStop(true)\n            this.playerWasPlayingWhileScrubbing = this.playerPlayed\n        }\n    }\n\n    changePlayerSpeed() {\n        const speedOptions = {\n            0.5 : { nextSpeed: 1, playbackSpeed: 2},\n            1: { nextSpeed: 2, playbackSpeed: 