nkedAuditList = audits.map(audit => ({\n        ...audit.linkedAlarm,\n        type: this.translateJsonService.getTranslateSubs(this.translateJsonService.getAlarmTypesTranslate(audit.linkedAlarm.typeAlarm))\n        }))\n        this.loadingLinkedAlarms = true\n    })\n  }\n\n  public auditoriaJaRevisada(alarm: Alarm) {\n    if (alarm.auditWorkflowDtoList) {\n      const audits = alarm.auditWorkflowDtoList.find(a => a.statusId == 3 || a.statusId == 4);\n\n      if (audits) {\n        this.revisaoFull = `${audits.statusLabel}: ${audits.obs} - Realizado por: ${audits.userName}`;\n\n        return true;\n      } else {\n        return false;\n      }\n    }\n\n    return false;\n  }\n\n  private updateReadByCustomer(alarm:Alarm):void{\n    if(!alarm.readByCustomer){\n      this.alarmService.updateReadByCustomer(alarm.id).subscribe((alarmIdList:number[]) => {\n        alarmIdList.forEach((alarmId:number) =>{\n          const indexAlarm = this.allAlarms.findIndex(obj => obj.id === alarmId);\n          this.allAlarms[indexAlarm]['readByCustomer'] = true;\n        }\n        )\n      })\n    }\n  }\n\n  /**\n   * Carrega a imagem do Alerta.\n   * @param alarmList\n   */\n  public loadImages(alarmList : Alarm[]){\n    alarmList.forEach((alarm : Alarm) => {\n      if (alarm.urlPictures[0] == 'NO_PICTURE') {\n        alarm.picture = 'NO_PICTURE'\n      } else if (alarm.picture == null) {\n          this.alarmService.getPictureByAlarm(alarm.id).subscribe((pictureAndMovie: PictureAndMovie) => {  \n            this.getBase64ImageFromURL(pictureAndMovie.urlPictures[this.whatsChannel(alarm.originalTypeAlarm ? alarm.originalTypeAlarm: alarm.typeAlarm)]).subscribe(result => {\n              alarm.picture = result;\n              alarm.urlPictures = pictureAndMovie.urlPictures;\n              if(pictureAndMovie.urlMovies && pictureAndMovie.urlMovies.length > 0){\n                alarm.movie = pictureAndMovie.urlMovies[this.whatsChannel(alarm.originalTypeAlarm ? alarm.originalTypeAlar