d(date.getSeconds());\n    const milliseconds = padMs(date.getMilliseconds());\n    \n    return `${year}-${month}-${day}T${hours}:${minutes}:${seconds}.${milliseconds}`;\n  }\n}","module.exports = \"<div class=\\\"row padding-default\\\">\\n    <div class=\\\"col-md-12\\\">\\n        <nb-card style=\\\"margin-bottom: 0; min-height: 75vh;\\\">\\n            <nb-card-header>\\n                <div class=\\\"row\\\">\\n                    <div class=\\\"col-sm-6\\\">\\n                        <span\\n                            style=\\\"float: left; margin-top: 0.4em; font-family: 'Roboto', sans-serif; font-size: 24px; color: #4B4B4D\\\">{{'MENU-GLOBAL.playback'\\n                            | translate}}</span>\\n                    </div>\\n                </div>\\n            </nb-card-header>\\n            <nb-card-body>\\n                <div class=\\\"row\\\">\\n                   \\n                    <div class=\\\"col-md-12\\\">\\n                        <div class=\\\"row d-flex justify-content-center\\\">\\n                            <div class=\\\"col-md-12\\\">\\n                                <div class=\\\"row\\\">\\n                                    <div class=\\\"col-md-12\\\">\\n                                        <playback-filter (submitFilter)=\\\"refreshRankingData($event)\\\"></playback-filter>\\n                                    </div>\\n                                </div>\\n\\n                                <div class=\\\"playback-content\\\" *ngIf=\\\"deviceId; else notDevice\\\">\\n                                    <div class=\\\"loader-container\\\" *ngIf=\\\"pageLoading\\\"><spinnerLoader></spinnerLoader></div>\\n                                    \\n                                    <div class=\\\"header-content\\\">\\n                                        <span>\\n                                            <div [ngClass]=\\\"{'header-content-item': true, 'header-content-item-selected': activedTab == 1}\\\" (click)=