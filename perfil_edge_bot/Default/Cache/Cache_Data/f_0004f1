this.generateCameraFilterOptions(this.equipmentTypeId);\n    this.playbackState.setMessage(`PLAYBACK-PAGE.search_to_start`);\n    \n    const currentSelectedIncrement = this.playbackState.getSelectedTimeIncrementValue();\n    if (currentSelectedIncrement === null) {\n      const baseIncrement = this.playbackState.getEquipmentBaseIncrement(this.equipmentTypeId);\n      this.currentTimeIncrement = baseIncrement;\n      this.updateTickSize(this.currentTimeIncrement);\n      this.playbackState.setSelectedTimeIncrement(baseIncrement);\n    } else {\n      this.currentTimeIncrement = currentSelectedIncrement;\n      this.updateTickSize(this.currentTimeIncrement);\n    }\n    \n    this.playbackState.getSelectedOption().subscribe(option => {\n      if (!this._isSettingOption) {\n        this.selectedOption = option;\n      }\n    })\n  }\n\n  private verifyTicket(): void {\n    this.ticketService.getTickets([this.assetId], this.openedTicketStatusList).then(value => {\n      const ticket = value.find(t => !!t.ticketId);\n      this.haveTicket = ticket ? true : false;\n      this.ticketLink = ticket ? ticket.ticketUrl : null;\n      this.ticketId = ticket ? ticket.ticketId : null;\n      this.ticketUrl = ticket ? `<a href=\"${this.ticketLink}\" target=\"_blank\">${this.ticketId}</a>` : null;\n    });\n  }\n\n  public ngOnDestroy(): void {\n    this.destroySubscritions();\n    this.resetStateVariables();\n  }\n\n  public onToggleVideoPlay() {\n    this.playbackState.setIsPlaying(!this.isVideoPlaying);\n  }\n\n  public onBackClick(): void {\n    this.navigateToPlaybacks();\n    this.playbackState.setPlaybackRoutes([]);\n  }\n\n  onSelectionChange(event: any): void {\n    this.selectedOption = event.value.value\n  }\n\n  public async onRequestDownload(): Promise<void> {\n    this.isProcessingDownload = true;\n    try {\n        if (this.isScheduledMode) {\n            await this.schedulePlayback();\n        } else {\n            await this.requestNormalDownload();\n        }\n    } catch (error) {\n        this.handleDownloadError(error);\n        this.getDownloadRequests();\n    } finally {\n        this.isProcessingDownload = false;\n    }\n}\n\nprivate async requestNormalDownload(): Promise<void> {\n    const playbacks = this.createPlaybacks();\n    const downloadPromises = playbacks.map(playback => \n        this.playbackService.requestDownload(playback)\n    );\n\n    await Promise.all(downloadPromises);\n    this.notificationService.notify(\n      this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.popup_download_requested'),\n      NotificationType.SUCCESS,\n      NotificationPosition.TOP_CENTER,\n      this.notificationService.DEFAULT_TIME_SECONDS\n  );\n    this.getDownloadRequests();\n}\n\nprivate async schedulePlayback(): Promise<void> {\n  if (!this.selectedPeriod || !this.selectedCameras.length) {\n    throw new Error('Selecione um período e pelo menos uma câmera');\n  }\n  const start = this.formatDateWithOffset(this.selectedPeriod.start);\n  const end = this.formatDateWithOffset(this.selectedPeriod.end);\n\n  await this.playbackService.createPlaybackScheduled(\n    this.deviceImei,\n    start,\n    end,\n    this.equipmentTypeId,\n    this.mapChannelsForAPI()\n  ).toPromise();\n  this.getDownloadRequests();\n  this.notificationService.notify(\n    this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.popup_download_requested_scheduled'),\n    NotificationType.SUCCESS,\n    NotificationPosition.TOP_CENTER,\n    this.notificationService.DEFAULT_TIME_SECONDS\n);\n}\n\nprivate formatDateWithOffset(date: Date): string {\n  const tzo = -date.getTimezoneOffset();\n  const pad = (n: number) => {\n    const str = n.toString();\n    return str.length === 1 ? '0' + str : str; \n  };\n\n  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}` +\n    `T${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())}` +\n    `${tzo >= 0 ? '+' : '-'}${pad(Math.floor(Math.abs(tzo) / 60))}:${pad(Math.abs(tzo) % 60)}`;\n}\n\n\nprivate mapChannelsForAPI(): string[] {\n    return this.selectedCameras.map(cam => {\n        switch(cam.toUpperCase()) {\n            case 'FRONT': return 'ADAS';\n            case 'FATIGUE': return 'DMS';\n            case 'INTERNAL': return 'CABIN';\n            case 'SIDE-1': return 'RIGHT_SIDE';\n            case 'SIDE-2': return 'LEFT_SIDE';\n            default: return cam;\n        }\n    });\n}\n\nprivate showSuccessMessage(messageKey: string): void {\n    this.showStatusMessage(\n        \"GLOBAL.success\",\n        messageKey,\n        'success'\n    );\n}\n\nprivate handleDownloadError(error: any): void {\n  const config = this.ERROR_CONFIGS.find(cfg => \n    error.includes(cfg.keyword)\n  );\n\n  const messageKey = config.messageKey ? config.messageKey : 'popup_download_error';\n    \n    this.notificationService.notify(\n        this.translateJsonService.getTranslateSubs(`PLAYBACK-PAGE.${messageKey}`),\n        NotificationType.WARNING,\n        NotificationPosition.TOP_CENTER,\n        this.notificationService.DEFAULT_TIME_SECONDS\n    );\n}\n\npublic increaseTimeWindow() {\n  const incrementStep = this.playbackState.getEquipmentBaseIncrement(this.equipmentTypeId)\n  if (this.currentTimeIncrement + incrementStep <= 60) {\n    this.currentTimeIncrement += incrementStep;\n    this.updateTickSize(this.currentTimeIncrement);\n    this.playbackState.setSelectedTimeIncrement(this.currentTimeIncrement);\n    this.updateSchedulePeriod();\n    \n    this.reprocessPlaybacksForNewRange();\n  }\n}\n\npublic decreaseTimeWindow() {\n  const incrementStep = this.playbackState.getEquipmentBaseIncrement(this.equipmentTypeId)\n   if (this.currentTimeIncrement - incrementStep >= incrementStep) {\n     this.currentTimeIncrement -= incrementStep;\n     this.updateTickSize(this.currentTimeIncrement);\n     this.playbackState.setSelectedTimeIncrement(this.currentTimeIncrement);\n     this.updateSchedulePeriod();\n     \n     this.reprocessPlaybacksForNewRange();\n  }\n}\n\n\nprivate updateTickSize(minutes: number) {\n  const baseIncrement = this.playbackState.getEquipmentBaseIncrement(this.equipmentTypeId)\n  const ticksCount = minutes / baseIncrement;\n  this.playbackState.setCursorSize(ticksCount);\n}  \n\n\nprivate createPlaybacks(): Playback[] {\n  const downloadAllVideos = this.playbackState.getDownloadAllVideos();\n  const videosToProcess = downloadAllVideos \n      ? this.playbackState.getAllVideosInRangeValue()\n      : this.playbackState.getCurrentVideosValue();\n\n  const playbackRoutes = this.playbackState.getCurrentPlaybacksValue();\n  const selectedCameras = this.playbackState.getSelectedCamerasValue();\n  const filteredVideos = videosToProcess.filter(video => \n      selectedCameras.some(camera => \n          camera.trim().toUpperCase() === video.channel.trim().toUpperCase()\n      )\n  );\n\n  const expirationDate =  this.getExpirationLimit();\n\n  return filteredVideos.map(video => {\n      const matchingRoute = playbackRoutes.find(route => \n          route.videos.some(v => v.videoUrl === video.videoUrl)\n      );\n\n      const playback = new Playback();\n      playback.deviceTypeId = this.equipmentTypeId;\n      playback.deviceId = this.deviceImei;\n      playback.playbackModeId = 3;\n      playback.fileName = video.videoUrl;\n      playback.channelId = video.channelId;\n      playback.userId = JSON.parse(localStorage.getItem(\"currentUser\")).id;\n      const playbackTime = matchingRoute\n          ? moment(matchingRoute.startDate).format()\n          : moment(this.currentPlayback.startDate).format();\n      playback.requestDate = playbackTime;\n      playback.requiredTime = playbackTime;\n      playback.expirationDate = expirationDate ? expirationDate.toISOString(): null\n\n      return playback;\n  });\n}\n\nprivate reprocessPlaybacksForNewRange(): void {\n  const cursorDate = this.playbackState.getCursorDate();\n  const selectedCameras = this.playbackState.getSelectedCamerasValue();\n  \n  if (!cursorDate || !selectedCameras.length || this.playbackState.isUsingBaseIncrement(this.equipmentTypeId)) {\n    return;\n  }\n\n  const newRange = this.calculateNewTimeRange(cursorDate);\n  const routesInRange = this.getRoutesInTimeRange(newRange);\n  \n  if (!routesInRange.length) return;\n\n  this.updateStateWithNewRoutes(routesInRange, cursorDate, selectedCameras);\n}\n\nprivate calculateNewTimeRange(cursorDate: Date): {start: Date, end: Date} {\n  const baseIncrement = this.playbackState.getEquipmentBaseIncrement(this.equipmentTypeId);\n  return {\n    start: moment(cursorDate).toDate(),\n    end: moment(cursorDate).add(this.currentTimeIncrement - baseIncrement, 'minutes').toDate()\n  };\n}\n\nprivate getRoutesInTimeRange({start, end}: {start: Date, end: Date}): PlaybackRoute[] {\n  return (this.playbackRoutes || []).filter(route =>\n    moment(route.startDate).isBefore(end) && moment(route.endDate).isAfter(start)\n  );\n}\n\nprivate updateStateWithNewRoutes(routes: PlaybackRoute[], cursorDate: Date, selectedCameras: string[]): void {\n  const closestRoute = this.findClosestRoute(routes, cursorDate);\n  const allVideos = routes.reduce((acc, route) => acc.concat(route.videos), []);\n  const filteredVideos = this.filterVideosByCameras(allVideos, selectedCameras);\n  const uniqueVideos = this.getUniqueVideosByChannel(filteredVideos);\n\n  this.playbackState.setOriginalAllVideosInRange(allVideos);\n  this.playbackState.setAllVideosInRange(allVideos);\n  this.playbackState.setCurrentVideos(uniqueVideos);\n  this.playbackState.setDownloadAllVideos(true);\n  this.playbackState.setCurrentPlaybacks(routes);\n  this.playbackState.setCurrentPlayback(closestRoute);\n}\n\nprivate findClosestRoute(routes: PlaybackRoute[], targetDate: Date): PlaybackRoute {\n  const targetTime = targetDate.getTime();\n  return routes.reduce((closest, route) => \n    Math.abs(route.startDate.getTime() - targetTime) < Math.abs(closest.startDate.getTime() - targetTime)\n      ? route : closest\n  );\n}\n\nprivate filterVideosByCameras(videos: PlaybackVideo[], cameras: string[]): PlaybackVideo[] {\n  return videos.filter(video => \n    cameras.some(camera => camera.trim().toUpperCase() === video.channel.trim().toUpperCase())\n  );\n}\n\nprivate getUniqueVideosByChannel(videos: PlaybackVideo[]): PlaybackVideo[] {\n  return videos.reduce((unique, video) => {\n    if (!unique.some(v => v.channel === video.channel)) {\n      unique.push(video);\n    }\n    return unique;\n  }, [] as PlaybackVideo[]).slice(0, 5);\n}\n\n  public async onDownloadVideo(playback: PlaybackTask): Promise<void> {\n    this.isDownloadingVideo = true;\n    \n    try {\n      const { urlVideo, fileName } = playback;\n\n      const authUrl = await this.playbackService\n        .downloadFile(urlVideo)\n        .then(res => res);\n\n      this.playbackService.processAuthUrlGet(authUrl, fileName)\n    } catch {\n      this.showStatusMessage(\n        this.translateJsonService.getTranslateSubs(\"GLOBAL.warning\"),\n        this.translateJsonService.getTranslateSubs(\"PLAYBACK-PAGE.popup_download_error\"),\n        'error',\n      );\n    }\n\n    this.isDownloadingVideo = false;\n  }\n\n  handleDownload(plate, prefix, playback: PlaybackTask) {\n    const filename = this.mediaDownloadService.extractFileNameFromUrl(playback.urlVideo);\n    this.downloadingTasks.push(playback.taskId);\n    this.mediaDownloadService\n        .downloadFile(this.mediaDownloadService.buildVideoTelemetryWatermarkBody(plate, prefix, playback.urlVideo))\n        .subscribe(\n            (blob) => {\n                this.mediaDownloadService.saveFileLocally(blob, filename);\n                this.downloadingTasks = this.downloadingTasks.filter(id => id !== playback.taskId);\n            },\n            (err) => {\n                this.downloadingTasks = this.downloadingTasks.filter(id => id !== playback.taskId);\n            }\n        );\n}\n\n  public isPendingTask(taskStatusId: number): boolean {\n    return [TaskStatus.Criada, TaskStatus.Enviada, TaskStatus.Aguardando, TaskStatus.Processando, TaskStatus.Falhada, TaskStatus.Recebida].includes(taskStatusId);\n  }\n\n  public getTaskStatus(taskStatusId: number): string {\n    let statusDescription: string;\n\n    if (taskStatusId === TaskStatus.Criada) {\n      statusDescription = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.task_waiting');\n    }\n\n    if (taskStatusId === TaskStatus.Enviada) {\n      statusDescription = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.task_waiting');\n    }\n\n    if (taskStatusId === TaskStatus.Completa) {\n      statusDescription = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.download_available');\n    }\n\n    if (taskStatusId === TaskStatus.Cancelada) {\n      statusDescription = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.task_canceled');\n    }\n\n    if (taskStatusId === TaskStatus.Expirada) {\n      statusDescription = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.task_expired');\n    }\n\n    if (taskStatusId === TaskStatus.Falhada) {\n      statusDescription = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.task_waiting');\n    }\n\n    if (taskStatusId === TaskStatus.Aguardando) {\n      statusDescription = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.task_waiting');\n    }\n\n    if(taskStatusId === TaskStatus.Waiting_Device_Connection) {\n      statusDescription = this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.task_waiting');\n    }\n\n    return statusDescription;\n  }\n\n  public getFormatedDate(taskDate: string): string {\n    return moment(taskDate).format(\"DD/MM/yyyy HH:mm:ss\");\n  }\n\n  public getChannelLabel(channelId: number): string {\n    let label: string;\n\n    switch (this.equipmentTypeId) {\n      case EquipamentType.STONKAM:\n      case EquipamentType.STONKAM_K1_PLUS:\n      case EquipamentType.STONKAM_K4:\n        label = this.getStonkamChannelLabel(channelId);\n        break;\n\n      case EquipamentType.JIMI:\n      case EquipamentType.JIMI_V6:\n        label = this.getJimiG5ChannelLabel();\n        break;\n\n      case EquipamentType.JIMI_G5_PLUS:\n      case EquipamentType.JIMI_JC400AD_ID:\n      case EquipamentType.JIMI_JC400D_R:\n        label = this.getJimiG5PlusChannelLabel(channelId);\n        break;\n    }\n\n    return label;\n  }\n\n  public onPreviousPlaybackClick() {\n    if (this.currentPlayback) {\n      const currentPlaybackIndex = this.playbackRoutes.findIndex(playback => playback.routeName === this.currentPlayback.routeName);\n      \n      if (currentPlaybackIndex === 0) {\n        return;\n      }\n\n      const previousPlayback = this.playbackRoutes[currentPlaybackIndex - 1];\n\n      if (previousPlayback) {\n        this.playbackState.setCurrentPlayback(previousPlayback);\n        this.playbackState.getSelectedCameras().subscribe(selectedCameras => {\n          const availableVideos = previousPlayback.videos.filter(video => selectedCameras.includes(video.channel));\n          if (availableVideos.length > 0) {\n            this.playbackState.setCurrentVideos(availableVideos);\n          }\n        });\n      }\n    }\n  }\n\n\n  public onNextPlaybackClick() {\n    if (this.currentPlayback) {\n      const currentPlaybackIndex = this.playbackRoutes.findIndex(playback => playback.routeName === this.currentPlayback.routeName);\n      if (currentPlaybackIndex === this.playbackRoutes.length - 1) {\n        return;\n      }\n      const nextPlayback = this.playbackRoutes[currentPlaybackIndex + 1];\n      if (nextPlayback) {\n        this.playbackState.setCurrentPlayback(nextPlayback);\n        this.playbackState.getSelectedCameras().subscribe(selectedCameras => {\n          const availableVideos = nextPlayback.videos.filter(video => selectedCameras.includes(video.channel));\n          if (availableVideos.length > 0) {\n            this.playbackState.setCurrentVideos(availableVideos);\n          }\n        });\n      }\n    }\n  }\n\n  private getStonkamChannelLabel(channelId: number): string {\n    return this.translateJsonService.getTranslateSubs(`PLAYBACK-PAGE.channel_${channelId}`);\n  }\n\n  private getJimiG5ChannelLabel(): string {\n    return this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_2');\n  }\n  \n  private getJimiG5PlusChannelLabel(channelId: number): string {\n    if (channelId == 1) {\n      return this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_2');\n    }\n\n    if (channelId == 2) {\n      return this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_1');\n    }\n  }\n\n  private initSubscriptions() {\n      this.subsVehicle = this.playbackState.getAsset().subscribe(this.handleVehicleSubscription);\n      this.subsPlaybacks = this.playbackState.getPlaybackRoutes().subscribe(value => this.playbackRoutes = value);\n      this.subsCurrentVideoTime = this.playbackState.getCurrentTime().subscribe(value => this.updateCurrentVideoTime(value));\n      this.subsCurrentPlayback = this.playbackState.getCurrentPlayback().subscribe(value =>  this.handlePlaybackSubscription(value));\n      this.subsIsPlaying = this.playbackState.getIsPlaying().subscribe(value => this.isVideoPlaying = value);\n      this.subsCurrentVideo = this.playbackState.getCurrentVideo().subscribe(value => this.handleVideoSubscription(value));\n      this.subsPlaybackTasks = this.playbackState.getPlaybackTasks().subscribe(value => this.playbackTasks = value);\n      this.subsTracking = this.telemetryState.getTracking().subscribe(value => this.showMap = !!value.length);\n      this.subsSpeed = this.telemetryState.getTrackingInfos$().subscribe(value => this.currentSpeed = `${value.speed} Km/h`);\n      this.subsAssetStatus = this.generateDeviceStatusSubs(this.assetId);\n      this.playbackState.getSelectedSchedulePeriod().subscribe(period => { this.selectedPeriod = period });\n      this.playbackState.getSelectedCameras().subscribe(cameras => { this.selectedCameras = cameras });\n      this.playbackState.getEnablePlaybackScheduled(this.equipmentTypeId).subscribe(value => { this.isScheduledMode = value }); \n  }\n\n  private destroySubscritions() {\n    if (this.subsVehicle) this.subsVehicle.unsubscribe();\n    if (this.subsPlaybacks) this.subsPlaybacks.unsubscribe();\n    if (this.subsCurrentVideoTime) this.subsCurrentVideoTime.unsubscribe();\n    if (this.subsCurrentPlayback) this.subsCurrentPlayback.unsubscribe();\n    if (this.subsIsPlaying) this.subsIsPlaying.unsubscribe();\n    if (this.subsCurrentVideo) this.subsCurrentVideo.unsubscribe();\n    if (this.subsPlaybackTasks) this.subsPlaybackTasks.unsubscribe();\n    if (this.subsTracking) this.subsTracking.unsubscribe();\n    if (this.subsSpeed) this.subsSpeed.unsubscribe();\n    if (this.subsAssetStatus) this.subsAssetStatus.unsubscribe();\n    if (this.subsDownloadRequests) this.subsDownloadRequests.unsubscribe();\n  }\n\n  private resetStateVariables() {\n    this.playbackState.setCurrentPlayback(null);\n    this.playbackState.setCurrentVideo(null);\n    this.playbackState.setChannel(null);\n    this.playbackState.setPlaybackTasks(null);\n    this.playbackState.setTimeOffset(null);\n    this.playbackState.setIsLoading(false);\n    this.playbackState.setSelectedTimeIncrement(null);\n    this.playbackState.setHasUserSelectedDate(false);\n    this.playbackState.setLastEventMosaicSearchDate(null);\n    this.playbackState.setLastPlaybackControlsSearchDate(null);\n    this.telemetryState.addTracking([]);\n  }\n\n  private navigateToPlaybacks() {\n    this.router.navigate([ this.parentRoute ], { replaceUrl: true });\n  }\n\n  private updateCurrentVideoTime(currentDate: Date) {\n    if (currentDate) {\n      this.currentVideoTime = moment(currentDate).format('DD/MM/yyyy HH:mm:ss');\n      this.telemetryState.setTrackingCurTime(currentDate.getTime() / 1000);\n    }\n  }\n\n\n  private getDownloadRequests () {\n    this.isLoadingDownloadRequests = true;\n\n    const endDateDownload = new Date();\n    const startDateDownload = moment(endDateDownload).subtract(this.downloadLimitMonths, 'months').toDate();\n\n    if (this.subsDownloadRequests) {\n      this.subsDownloadRequests.unsubscribe();\n    }\n\n    this.subsDownloadRequests = timer(0, 30000)\n      .pipe(\n        concatMap(() => this.playbackService\n          .getFileList(this.deviceImei, startDateDownload, endDateDownload, this.equipmentTypeId) \n          .then(res => this.formatDownloadRequests(res))\n          .then(res => {\n            this.playbackState.setPlaybackTasks(res);\n            const filteredTasks = res.filter(\n              (task: any) => ![2, 3, 4].includes(task.taskStatusId)\n            );\n            this.pendingTasks = filteredTasks.length;\n\n            this.isLoadingDownloadRequests = false;\n          }))\n      ).subscribe();\n  }\n\n  private handleVehicleSubscription = (vehicle: Asset): void => {\n    if (vehicle === null) {\n      this.navigateToPlaybacks();\n      \n      return;\n    }\n    \n    const isNewVehicle = this.assetId !== vehicle.id;\n    \n    this.assetId = vehicle.id;\n    this.deviceImei = vehicle.imei;\n    this.equipmentTypeId = vehicle.equipmentTypeId;\n    this.customerName = vehicle.customerChildName;\n    this.vehicleName = `${vehicle.identification} - ${vehicle.name} (${vehicle.equipmentType})`;\n    this.plate = vehicle.identification;\n    this.prefix = vehicle.name;\n    const baseIncrement = this.playbackState.getEquipmentBaseIncrement(this.equipmentTypeId);\n    const maxCursorSize = 60 / baseIncrement;\n    this.playbackState.setMaxCursorSize(maxCursorSize);\n\n    if (isNewVehicle) {\n      this.currentTimeIncrement = baseIncrement;\n      this.updateTickSize(this.currentTimeIncrement);\n      this.playbackState.setSelectedTimeIncrement(baseIncrement);\n    }\n  }\n\n  private handlePlaybackSubscription(playback: PlaybackRoute) {\n    this.telemetryState.addTracking([]);\n\n    if (playback) {\n      if (this.playbackRoutes) {\n        const playbackIndex = this.playbackRoutes.findIndex(pb => pb.routeName === playback.routeName);\n\n        this.hasPreviousVideo = playbackIndex >= 1;\n        this.hasNextVideo = playbackIndex < (this.playbackRoutes.length - 1);\n      }\n\n      const tracking = playback.positions.map(position => {\n        return {\n          lat: position.latitude,\n          lng: position.longitude,\n          time: position.dateTime.getTime() / 1000,\n          speed: position.speed,\n        };\n      });\n  \n      this.currentPlayback = playback;\n\n      this.setMapCenter(tracking);\n      this.telemetryState.addTracking(tracking);\n      this.playbackState.setMessage(`PLAYBACK-PAGE.select_a_camera`);\n    }\n  }\n\n  private handleVideoSubscription(video: PlaybackVideo) {\n    this.currentVideos = [video];\n\n    if (this.currentPlayback) {\n      const tracking = this.currentPlayback.positions.map(position => {\n        return {\n          lat: position.latitude,\n          lng: position.longitude,\n          time: position.dateTime.getTime() / 1000,\n          speed: position.speed,\n        };\n      });\n  \n      this.setMapCenter(tracking);\n    }\n  }\n\n  private setMapCenter(positions: any[]) {\n    const positionsCount = positions.length;\n\n    if (positionsCount > 0) {\n      const totalLat = positions.reduce((acc, coord) => acc + coord.lat, 0);\n      const totalLng = positions.reduce((acc, coord) => acc + coord.lng, 0);\n\n      const mapCenter = latLng({\n          lat: totalLat / positionsCount,\n          lng: totalLng / positionsCount,\n      });\n\n      this.mapCenter = mapCenter;\n    }\n  }\n\n  private initMap() {\n    this.mapCenter = latLng({\n      lat: -29.8873545, \n      lng: -51.1590298,\n    });\n\n    if (navigator && navigator.geolocation) {\n      navigator.geolocation.getCurrentPosition(\n        position => {\n          this.mapCenter = latLng({\n            lat: position.coords.latitude, \n            lng: position.coords.longitude,\n          });\n        }\n      );\n    }\n  }\n\n  private generateDeviceStatusSubs(assetId: number): Subscription {\n    return timer(0, 30000).pipe(\n      concatMap(() => this.assetService.checkOnlineStatusByAssetId(assetId, this.deviceImei))\n    ).subscribe({\n      next: (data) => {\n        this.isAssetOnline = data.isOnline; \n        this.playbackState.setSelectedDeviceOnlineStatus(data.isOnline); \n      },\n      error: () => {\n        this.isAssetOnline = false; \n        this.playbackState.setSelectedDeviceOnlineStatus(false);  \n      }\n    });\n  }\n\n  private generateCameraFilterOptions(deviceType: EquipamentType): void {\n    switch (deviceType) {\n      case EquipamentType.STONKAM:\n      case EquipamentType.STONKAM_K1_PLUS:\n      case EquipamentType.STONKAM_K4:\n        this.cameraFilterOptions = [\n          { label: this.translateJsonService.getTranslateSubs('GLOBAL.no_filter'), value: null },\n          { label: this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_1'), value: 1 },\n          { label: this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_2'), value: 2 },\n          { label: this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_3'), value: 3 },\n          { label: this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_4'), value: 4 },\n          { label: this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_5'), value: 5 },\n        ];\n        break;\n\n      case EquipamentType.JIMI:\n      case EquipamentType.JIMI_V6:\n        this.cameraFilterOptions = [\n          { label: this.translateJsonService.getTranslateSubs('GLOBAL.no_filter'), value: null },\n          { label: this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_2'), value: 1 },\n        ];\n        break;\n\n      case EquipamentType.JIMI_G5_PLUS:\n      case EquipamentType.JIMI_JC400AD_ID:\n      case EquipamentType.JIMI_JC400D_R:\n        this.cameraFilterOptions = [\n          { label: this.translateJsonService.getTranslateSubs('GLOBAL.no_filter'), value: null },\n          { label: this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_1'), value: 2 },\n          { label: this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_2'), value: 1 },\n        ];\n        break;\n\n      case EquipamentType.JIMI_G7:\n        this.cameraFilterOptions = [\n          { label: this.translateJsonService.getTranslateSubs('GLOBAL.no_filter'), value: null },\n          { label: this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_2'), value: 1 },\n          { label: this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_5'), value: 2 },\n          { label: this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_1'), value: 3 },\n          { label: this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_3'), value: 4 },\n          { label: this.translateJsonService.getTranslateSubs('PLAYBACK-PAGE.channel_4'), value: 5 },\n        ];\n        break;\n\n      default:\n        this.cameraFilterOptions = [\n          { label: this.translateJsonService.getTranslateSubs('GLOBAL.no_filter'), value: null },\n        ];\n        break;\n    }\n  }\n\n  private formatDownloadRequests(response: any): PlaybackTask[] {\n    const playbackTasks = response.availablePlaybackTasks.map((task: any) => {\n      if (this.equipmentTypeId === 12) {\n        task.channelId = this.playbackService.getKdashCorrectChannel(task.channelId);\n      }\n  \n      return {\n        taskType: 'playback',\n        taskId: task.taskId,\n        playbackMode: task.playbackMode,\n        playbackModeId: task.playbackModeId,\n        fileName: task.fileName,\n        fileSize: task.fileSize ? this.playbackService.formatMediaSize(task.fileSize) + \"MB\" : '-',\n        channelId: task.channelId,\n        taskStatusId: task.taskStatusId,\n        taskStatusDescription: task.taskStatusDescription,