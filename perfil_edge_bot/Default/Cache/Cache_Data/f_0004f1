 {\n    public recentRezise = false;\n\n    // Mapa\n    public showSpinningGlobe: boolean = false\n    public options;\n    public allMarkers: ModelMarkers[] = [];\n    public zoom: number = 7;\n    public center: LatLng = latLng([-29.8873545, -51.1590298]);\n    public layers = [\n        tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18, attribution: `&copy ${environment.creareName}` }),\n        tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', { maxZoom: 18, attribution: '...' })\n    ];\n\n    public loaded: boolean = false;\n    public clusted: boolean = false;\n    public hideIcons: boolean = false;\n    public hideHeat: boolean = true;\n    public checkAlerts: boolean = true;\n    public checkInfractions: boolean = true;\n\n    // Tabela\n    public tableCols;\n\n    public tableContent;\n    public alarmTypeEnum = AlarmTypeEnum;\n    public selectedAlarm: Alarm;\n\n    public infractionTypes\n    public alarmAndInfractionTypes\n\n    public alarmTypes\n\n    // Filter\n    public allCustomers;\n    public hasInfraction: boolean = false;\n\n    // Resize\n    px: number;\n    py: number;\n    height: number;\n    minArea: number;\n    draggingCorner: boolean;\n    draggingWindow: boolean;\n    resizer: Function;\n\n    loadingMap: boolean = true;\n\n    public alarmSubscription: any;\n    public isLoading: boolean = false;\n    public subOnline: Subscription;\n    public isOnlineCheck: boolean;\n\n    public subIsOnline: Subscription;\n    public subAlarmsData: Subscription;\n\n    private isFirstOnlineChange = true;\n\n    constructor(\n        private notificationService: NotificationUtilService,\n        private dataService: DataService,\n        private workspaceService: WorkspaceService,\n        private router: Router,\n        private alarmService: AlarmService,\n        private loadingAnimateService: LoadingAnimateService,\n        private translateService: TranslateService,\n        private translateJsonService: TranslateJsonService,\n        private configService: ConfigService\n    ){\n        this.dataService.havePermission('ALERTS', 'MAPA');\n        this.alarmTypes = this.dataService.alarmTypesNumber        \n        this.infractionTypes = this.dataService.infractionTypesNumber\n        this.alarmAndInfractionTypes = this.alarmTypes.concat(this.infractionTypes)\n\n        this.alarmTypes.forEach(opt => { opt.label = this.translateJsonService.getTranslateSubs(opt.label) })\n        this.infractionTypes.forEach(opt => { opt.label = this.translateJsonService.getTranslateSubs(opt.label) })\n\n\n        this.px = 0;\n        this.py = 0;\n        this.height = 450;\n        this.draggingCorner = false;\n        this.draggingWindow = false;\n\n        this.tableCols  = [\n            { field: 'id', header: '#', width: 70 },\n            { field: 'driver_firstname', header: this.getTranslateSubs('GLOBAL.driver'), },\n            { field: 'typeAlarm', header: this.getTranslateSubs('GLOBAL.type'), width: 160 },\n            { field: 'infractionInfo', header: this.getTranslateSubs('MARKER-DETAILS.infraction_info'), width: 210 } ,\n            { field: 'alarmRisk', header: this.getTranslateSubs('GLOBAL.risk_level'), width: 135 },\n            { field: 'vehicle_plates', header: this.getTranslateSubs('GLOBAL.plate'), width: 90 },\n            { field: 'vehicle_prefix', header: this.getTranslateSubs('GLOBAL.prefix'), width: 90 },\n            { field: 'datetime', header: this.getTranslateSubs('TREATMENT-MODAL.date'), width: 150 },\n        ];\n    }\n\n    private getTranslateSubs(key : string) {\n        let translated;\n        this.translateService.get(key).subscribe((res : string) => { translated = res; });\n        return translated;\n    }\n\n    ngOnInit(){\n        this.verifyWorkspace();\n        \n        this.workspaceService.setBotaoOnline(true);\n\n        this.initSubs();\n    }\n\n    ngOnDestroy(){\n        this.workspaceService.setBotaoOnline(false);\n\n        this.destroySubs();\n    }\n\n    showLoadingMap(isSubmitted: boolean) {\n        this.showSpinningGlobe = isSubmitted;\n    }\n\n    getAlarmType(value: number) {\n        return this.alarmAndInfractionTypes.find((at) => at.value == value).label;\n    }\n\n    private verifyWorkspace() {\n        let workspace: Workspace = this.dataService.getWorkspace();\n\n        if(!workspace){\n            this.router.navigate(['/pages/f/fatigue']);\n        }else if(workspace.userCustomerChildIds.length === 1){\n            this.handleAlarmsDataSubscription();\n        }\n    }\n\n    private loadContent(checkAlerts?, checkInfractions?) {\n        this.hasInfraction = false\n        const INFRACTION_RISK = 10\n        this.allMarkers = [];\n        let alarmTableData: Alarm[];\n        let infractionTableData = [];\n        let tempList = [];\n        \n        alarmTableData = this.dataService.getFilteredAlarmDtoList();\n        infractionTableData = this.dataService.getFilteredInfractionsDtoList();\n        \n        alarmTableData.forEach(alarm => {\n            alarm.alarmRisk = alarm.groupRisk ? alarm.groupRisk : alarm.originalGroupRisk\n        })\n\n        infractionTableData.forEach(infractionData => {\n            infractionData.infractionList.forEach(infraction => {\n                const infractionTemp:any = {\n                    id: infraction.id,\n                    driver_firstname: infraction.infractionData.driver && infraction.infractionData.driver.name ? infraction.infractionData.driver.name : this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.unidentified_driver'),\n                    infractionTypeId: this.convertInfractionCategoryType(infraction.infractionTypeId),\n                    datetime: moment(infraction.deviceDatetime).tz('UTC', true).local(),\n                    fullInfractionData: infraction,\n                    typeAlarm: this.convertInfractionCategoryType(infraction.infractionTypeId),\n                    alarmRisk: INFRACTION_RISK,\n                    infractionInfo: infraction.infractionData ? this.loadInfractionDetails(infraction.infractionTypeId, infraction.infractionData.infraction) : null\n                }\n                if (infraction.infractionData.deviceType != null && infraction.infractionData.deviceType == 'DRIVER_HERO'){\n                    infractionTemp.driver_firstname= infraction.infractionData.asset ? infraction.infractionData.asset.assetName : this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.unidentified_driver')\n                    infractionTemp.vehicle_plates = infraction.infractionData.customVehiclePlate\n                }else{\n                    infractionTemp.vehicle_plates= infraction.infractionData.asset ? infraction.infractionData.asset.assetName : null,\n                    infractionTemp.vehicle_prefix= infraction.infractionData.asset ? infraction.infractionData.asset.assetIdentification : null\n                }\n                tempList.push(infractionTemp);\n            })\n        })\n\n        if(checkAlerts && !checkInfractions) {\n            this.tableContent = alarmTableData\n        } else if(!checkAlerts && checkInfractions) {\n            this.tableContent = tempList\n        } else {\n            this.tableContent = alarmTableData.concat(tempList)\n        }\n\n        this.tableContent.forEach(content => {\n            let groupedEvents = []\n            groupedEvents = (this.tableContent.filter(tableItem => tableItem.infractionTypeId == content.infractionTypeId && tableItem.vehicle_plates == content.vehicle_plates && tableItem.vehicle_prefix == content.vehicle_prefix))\n            content.groupedEvents = groupedEvents\n        })\n        this.verifyInfractions(this.tableContent)\n        this.allMarkers = this.convertAlarmInMarker(this.tableContent);\n    }\n\n    private loadInfractionDetails(infractionId, infractionDetails) {\n        const SPEED_INFRACTION = 1\n        const NO_SEATBELT_INFRACTION = 4\n        const ABRUPT_BREAK_INFRACTION = 6\n        const ABRUPT_SPEED_INFRACTION = 7\n        const ABRUPT_CURVE_INFRACTION = 9\n        const VIBRATION_INFRACTION = 10\n        const DEVICE_REMOVED_INFRACTION = 11\n        const DEVICE_NO_BATTERY_INFRACTION = 12\n        const DEVICE_SLEEP_INFRACTION = 13\n\n        switch (infractionId) {\n            case SPEED_INFRACTION:\n                return (infractionDetails.limit !== undefined ? `${infractionDetails.limit} ${infractionDetails.unit}` : this.getTranslateSubs('GLOBAL.unavailable')) + ` - ` + (infractionDetails.maxSpeed !== undefined ? `${infractionDetails.maxSpeed} ${infractionDetails.unit}` : this.getTranslateSubs('GLOBAL.unavailable'))\n            case NO_SEATBELT_INFRACTION:\n                return (infractionDetails.duration !== undefined ? `${infractionDetails.duration} ${infractionDetails.unit}` : this.getTranslateSubs('GLOBAL.unavailable'))\n            case ABRUPT_BREAK_INFRACTION:\n                return (infractionDetails.limit !== undefined ? `${infractionDetails.limit} ${infractionDetails.unit}` : this.getTranslateSubs('GLOBAL.unavailable')) + ` - ` + (infractionDetails.speedVariation !== undefined ? `${infractionDetails.speedVariation} ${infractionDetails.unit}` : this.getTranslateSubs('GLOBAL.unavailable'))\n            case ABRUPT_SPEED_INFRACTION:\n                return (infractionDetails.limit !== undefined ? `${infractionDetails.limit} ${infractionDetails.unit}` : this.getTranslateSubs('GLOBAL.unavailable')) + ` - ` + (infractionDetails.speedVariation !== undefined ? `${infractionDetails.speedVariation} ${infractionDetails.unit}` : this.getTranslateSubs('GLOBAL.unavailable'))\n            case ABRUPT_CURVE_INFRACTION:\n                return (infractionDetails.limit !== undefined ? `${infractionDetails.limit} ${infractionDetails.unit}` : this.getTranslateSubs('GLOBAL.unavailable')) + ` - ` + (infractionDetails.speedVariation !== undefined ? `${infractionDetails.speedVariation} ${infractionDetails.unit}` : this.getTranslateSubs('GLOBAL.unavailable'))\n            case VIBRATION_INFRACTION:\n                return (infractionDetails.limit !== undefined ? `${infractionDetails.limit} ${infractionDetails.unit}` : this.getTranslateSubs('GLOBAL.unavailable')) + ` - ` + (infractionDetails.speedVariation !== undefined ? `${infractionDetails.speedVariation} ${infractionDetails.unit}` : this.getTranslateSubs('GLOBAL.unavailable'))\n            case DEVICE_REMOVED_INFRACTION:\n                return (infractionDetails.limit !== undefined ? `${infractionDetails.limit} ${infractionDetails.unit}` : this.getTranslateSubs('GLOBAL.unavailable')) + ` - ` + (infractionDetails.speedVariation !== undefined ? `${infractionDetails.speedVariation} ${infractionDetails.unit}` : this.getTranslateSubs('GLOBAL.unavailable'))\n            case DEVICE_NO_BATTERY_INFRACTION:\n                return (infractionDetails.limit !== undefined ? `${infractionDetails.limit} ${infractionDetails.unit}` : this.getTranslateSubs('GLOBAL.unavailable')) + ` - ` + (infractionDetails.speedVariation !== undefined ? `${infractionDetails.speedVariation} ${infractionDetails.unit}` : this.getTranslateSubs('GLOBAL.unavailable'))\n            case DEVICE_SLEEP_INFRACTION:\n                return (infractionDetails.limit !== undefined ? `${infractionDetails.limit} ${infractionDetails.unit}` : this.getTranslateSubs('GLOBAL.unavailable')) + ` - ` + (infractionDetails.speedVariation !== undefined ? `${infractionDetails.speedVariation} ${infractionDetails.unit}` : this.getTranslateSubs('GLOBAL.unavailable'))\n            default:\n                return null\n        }\n    }\n\n    private groupTableData(clusted) {\n        let tempList = []\n        if(clusted) {\n            this.tableContent.forEach(content => {\n                if(!tempList.includes(content.groupedEvents[0])) {\n                    tempList.push(content.groupedEvents[0])\n                }\n            })\n            this.tableContent = tempList\n        } else {\n            this.loadContent()\n        }\n    }\n\n    private verifyInfractions(tableContent) {\n        tableContent.forEach(content => {\n            let keys = Object.keys(content)\n            keys.forEach(key => {\n                if(key == 'fullInfractionData') this.hasInfraction = true\n            })\n        })\n    }\n\n    private convertAlarmInMarker(alertsAndInfractions: any[]): ModelMarkers[] {\n        let markers = [];\n\n        alertsAndInfractions.forEach((alarmOrInfraction : any) => {\n            let mrkr: ModelMarkers = new ModelMarkers;\n            mrkr.id = alarmOrInfraction.id;\n            mrkr.name = \"Alerta \"+alarmOrInfraction.id+\" - \"+alarmOrInfraction.driver_firstname;\n            mrkr.driverName = alarmOrInfraction.driver_firstname ? alarmOrInfraction.driver_firstname : this.translateJsonService.getTranslateSubs('TELEMETRY-PAGE.unidentified_driver');\n            mrkr.plateAndPrefix = alarmOrInfraction.fullInfractionData ? alarmOrInfraction.vehicle_plates : `${alarmOrInfraction.assetIdentification} - ${alarmOrInfraction.assetPrefix}`\n            mrkr.alarmType = alarmOrInfraction.typeAlarm ? this.translateJsonService.getTranslateSubs(this.getAlarmType(alarmOrInfraction.typeAlarm)) : this.getAlarmType(alarmOrInfraction.infractionTypeId);\n            mrkr.datetime = this.translateJsonService.transformDataFormat(alarmOrInfraction.datetime);\n            mrkr.category = alarmOrInfraction.typeAlarm || alarmOrInfraction.infractionTypeId;\n            mrkr.alarmRisk = alarmOrInfraction.alarmRisk;\n            mrkr.enabled = true;\n            mrkr.latitude = alarmOrInfraction.fullInfractionData ? parseFloat(alarmOrInfraction.fullInfractionData.latitude) : alarmOrInfraction.latitude;\n            mrkr.longitude = alarmOrInfraction.fullInfractionData ? parseFloat(alarmOrInfraction.fullInfractionData.longitude) : alarmOrInfraction.longitude;\n            mrkr.isAlarm = typeof alarmOrInfraction.groupRisk != \"undefined\"\n            mrkr.infractionInfo = alarmOrInfraction.infractionInfo\n            mrkr.isInfraction = alarmOrInfraction.fullInfractionData\n\n            markers.push(mrkr);\n        })\n        this.loadingMap = false;\n        return markers;\n    }\n\n    convertInfractionCategoryType(infractionTypeId) {\n        const SPEED_INFRACTION = 1\n        const NO_SEATBELT_INFRACTION = 4\n        const ABRUPT_BREAK_INFRACTION = 6\n        const ABRUPT_SPEED_INFRACTION = 7\n        const ABRUPT_CURVE_INFRACTION = 9        \n        const VIBRATION_INFRACTION = 10\n        const DEVICE_REMOVED_INFRACTION = 11\n        const DEVICE_NO_BATTERY_INFRACTION = 12\n        const DEVICE_SLEEP_INFRACTION = 13\n        if(infractionTypeId === SPEED_INFRACTION) return 3003\n        if(infractionTypeId === NO_SEATBELT_INFRACTION) return 3004\n        if(infractionTypeId === ABRUPT_BREAK_INFRACTION) return 3006\n        if(infractionTypeId === ABRUPT_SPEED_INFRACTION) return 3007\n        if(infractionTypeId === ABRUPT_CURVE_INFRACTION) return 3009\n        if(infractionTypeId === VIBRATION_INFRACTION) return 3010\n        if(infractionTypeId === DEVICE_REMOVED_INFRACTION) return 3011\n        if(infractionTypeId === DEVICE_NO_BATTERY_INFRACTION) return 3012\n        if(infractionTypeId === DEVICE_SLEEP_INFRACTION) return 3013\n        \n    }\n\n    public getFilteredAlarms(): void {\n        this.loadingMap = true;\n\n        this.subAlarmsData = this.createAlarmsDataSubscription();\n    }\n\n    private buildFilter(filter: FilterAlarms): DefaultFilter {\n        let defaultFilter = new DefaultFilter();\n        defaultFilter.custIds = filter.selectedCustomers;\n        defaultFilter.date1 = this.configService.convertDateToIsoString(filter.selectedDateStart);\n        defaultFilter.date2 = this.configService.convertDateToIsoString(filter.selectedDateEnd);\n        defaultFilter.alarmTypes = filter.selectedAlarmTypes;\n        defaultFilter.driverIds = filter.selectedDrivers;\n        defaultFilter.vehicleIds = filter.selectedVehicles;\n        defaultFilter.infractionTypes = [1, 4, 6, 7, 9, 10, 11, 12, 13]\n        return defaultFilter;\n    }\n\n    onFilterTable($event) {\n        let alarms = $event.filteredValue;\n\n        (alarms.length > 0) ? this.allMarkers = this.convertAlarmInMarker($event.filteredValue) : this.allMarkers = [];\n    }\n\n    public centerInMap(clickedAlarm : any){\n        if(clickedAlarm.fullInfractionData) {\n            this.center = latLng([\n                parseFloat(clickedAlarm.fullInfractionData.latitude), \n                parseFloat(clickedAlarm.fullInfractionData.longitude)\n\n            ])\n        } else { \n            this.center = latLng([ clickedAlarm.latitude, clickedAlarm.longitude ])\n        }\n        this.zoom = 16;\n    }\n\n    /* LOADING ALARMS START */\n    public initLoading(delayMs: number): void {\n        setTimeout(() => {\n            this.loadingAnimateService.setValue(true)\n        }, delayMs);\n    }\n    /* LOADING ALARMS STOP */\n    public stopLoading(delayMs: number): void {\n        setTimeout(() => {\n            this.loadingAnimateService.setValue(false)\n        }, delayMs);\n    }\n\n    logger($event) {\n        console.log($event);\n    }\n\n\n    onWindowPress(event: MouseEvent) {\n    this.draggingWindow = true;\n    this.px = event.clientX;\n    this.py = event.clientY;\n    }\n\n    onWindowDrag(event: MouseEvent) {\n        if (!this.draggingWindow) {\n        return;\n    }\n    let offsetX = event.clientX - this.px;\n    let offsetY = event.clientY - this.py;\n\n    this.px = event.clientX;\n    this.py = event.clientY;\n    }\n\n    bottomRightResize(offsetX: number, offsetY: number) {\n        this.height += offsetY;\n    }\n\n    onCornerClick(event: MouseEvent, resizer?: Function) {\n        this.draggingCorner = true;\n        this.px = event.clientX;\n        this.py = event.clientY;\n        this.resizer = resizer;\n        event.preventDefault();\n        event.stopPropagation();\n    }\n\n    markOffClusted(event) {\n        if(event) this.clusted = false;\n    }\n\n    filterByAlertsOrInfractions(checkAlerts, checkInfractions) {\n        this.checkAlerts = checkAlerts;\n        this.checkInfractions = checkInfractions;\n        this.loadingMap = true;\n        this.loadContent(checkAlerts, checkInfractions)\n    }\n\n    public onChangeOnline(isOnline: boolean) {\n        this.workspaceService.setBotaoOnline(isOnline);\n    }\n\n    @HostListener('document:mousemove', ['$event']) onCornerMove(event: MouseEvent) {\n        if (!this.draggingCorner) {\n            return;\n        }\n        let offsetX = event.clientX - this.px;\n        let offsetY = event.clientY - this.py;\n\n        this.resizer(offsetX, offsetY);\n        this.px = event.clientX;\n        this.py = event.clientY;\n\n        this.recentRezise = true;\n    }\n\n    @HostListener('document:mouseup', ['$event']) onCornerRelease(event: MouseEvent) {\n        this.draggingWindow = false;\n        this.draggingCorner = false;\n    }\n    \n    private initSubs() {        \n        this.subIsOnline = this.workspaceService.botaoOnline.subscribe(isOnline => this.handleOnlineStatusChange(isOnline));\n    }\n\n    private destroySubs() {\n        if (this.subIsOnline) this.subIsOnline.unsubscribe();\n        if (this.subAlarmsData) this.subAlarmsData.unsubscribe();\n    }\n\n    private handleOnlineStatusChange(isOnline: boolean) {\n        this.isOnlineCheck = isOnline;\n\n        if (this.isOnlineCheck && !this.isFirstOnlineChange) {\n            this.delayCreateAlarmsDataSubscription();\n        } else {\n            this.isFirstOnlineChange = false;\n        } \n        \n        if (this.subAlarmsData) {\n            this.subAlarmsData.unsubscribe();\n        }\n    }\n\n    private handleAlarmsDataSubscription() {\n        if (this.subAlarmsData) this.subAlarmsData.unsubscribe();\n\n        this.subAlarmsData = this.createAlarmsDataSubscription();\n    }\n\