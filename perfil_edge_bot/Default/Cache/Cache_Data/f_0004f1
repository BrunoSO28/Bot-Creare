mponent } from '../../zoom-medias/zoom-medias.component';\nimport { TreatmentFlowState } from '../treatment-flow.state';\nimport { environment } from 'environments/environment';\nimport { EquipamentType } from 'app/@core/enum/equipament.type.enum';\nimport { CommandVoice } from 'app/@core/models/command-voice.entity';\nimport { Audio } from 'app/@core/models/audio.entity';\nimport { VoiceMessageService } from 'app/pages/ui-alarms/voice-message/voice-message.service';\nimport { NotificationUtilService } from 'app/@core/utils/notification.util.service';\nimport * as moment from 'moment';\nimport { AiAlarmValidation } from 'app/@core/models/aiAlarmValidation.entity';\n\n@Component({\n  selector: 'treatment-step-four',\n  templateUrl: './step-four.component.html',\n  styleUrls: ['./step-four.component.scss']\n})\nexport class StepFourComponent implements OnInit, OnDestroy {\n\n  public alarms$: Observable<Alarm[]> = new Observable<Alarm[]>();\n  public allMarkers: ModelMarkers[] = [];\n\n  public selectedPicture: string;\n  public selectedMovie: string;\n  public errorVideoNotFound = false;\n\n  @ViewChild('alarmMap') alarmMap;\n  @ViewChild(ChartLastVelocitiesAndAlarmsComponent) chartLastVelocitiesAndAlarms: ChartLastVelocitiesAndAlarmsComponent\n\n  public exportableMap;\n  public sourceChartLastVelocitiesAndAlarms\n  public alarm: Alarm\n  public audit;\n  public treatmentNotification;\n  public alarmListNotification;\n  public loadingMap: boolean = true;\n  public loadedNotification: boolean = false;\n  public workspace: Workspace;\n\n  public imei: string;\n  public customerChildId: number;\n  public sendNotificationByEmail: boolean = false;\n  public isPrintAlarmNotification: boolean = false;\n  public showButton: boolean = false;\n\n  public auditId: number;\n  public riskRating: number;\n  public vehicleId: number\n  public vehicleLastAlarm: Date\n  public driverId: number\n  public alertTableData: any[];\n  public alertTableDataCols: any[];\n  public alarmWithoutMediasColumns: any[];\n  public imgSignature: string = ''\n  public signatureInfo: string = ''\n  public isFromDevicesWithoutMedia: boolean = false;\n  public devicesWithoutMedia:number[] = environment.equipmentsTypeIdWithoutMedia.split(',').map(a => Number(a));\n  public lastAlarmId: number;\n\n  public showVoiceCommand: boolean = false;\n  public isSendingVoiceCommand: boolean = false;\n  public aiAlarmValidations: AiAlarmValidation[] = [];\n\n  @Input()\n  isShowSendNotificationTools = false;\n\n  @Input('customerProfileName') customerProfileName: string;\n  @Output('eventCloseModal') eventCloseModal: EventEmitter<boolean> = new EventEmitter();\n\n  constructor(\n    public treatmentFlowState: TreatmentFlowState,\n    public dataService: DataService,\n    public translateJsonService: TranslateJsonService,\n    private dialogService: DialogService,\n    private alarmService: AlarmService,\n    private voiceMessageService: VoiceMessageService,\n    private notificationService: NotificationUtilService\n  ) {\n    this.alarms$ = treatmentFlowState.getSelectedAlarms$();\n    this.workspace = dataService.getWorkspace();\n\n    this.alertTableDataCols = [\n      {field: 'id', header: 'id'},\n      {field: 'datetime', header: 'datetime'},\n      {field: 'speed', header: 'speed'}\n    ];\n    this.alarmWithoutMediasColumns = [\n      {field: 'speed', header: 'GLOBAL.speed'},\n      {field: 'datetime', header: 'GLOBAL.datetime'},\n      {field: 'driver_firstname', header: 'GLOBAL.driver'}\n    ];\n  }\n\n  ngOnDestroy(): void {\n    this.resetNotificationState();\n    this.lastAlarmId = undefined;\n  }\n\n  ngOnInit() {\n      this.treatmentFlowState.getAiAlarmValidations$().subscribe(aiAlarmValidations => {this.aiAlarmValidations = aiAlarmValidations});\n      this.treatmentFlowState.getAudit$().subscribe(result => {\n        this.audit = result;\n        this.audit.auditAutor ? this.showButton = true : this.showButton = false\n\n        this.alarms$.subscribe(async (alarms) => {\n          this.alertTableData = alarms;\n          this.loadingMap = true;\n\n          this.alarm = alarms[0];\n          this.auditId = result.id; \n          this.vehicleId = this.alarm.vehicleId\n          this.vehicleLastAlarm = new Date(this.alarm.datetime)\n          this.driverId = this.alarm.driverId\n          this.riskRating = (this.alarm.groupRisk != undefined) ? this.alarm.groupRisk : this.alarm.originalGroupRisk ;\n          this.customerProfileName = this.alarm.customer_profile_name ? this.alarm.customer_profile_name : this.customerProfileName;\n\n          this.setShowVoiceCommand(this.alarm.equipmentTypeId);\n\n          if(this.isNewAlarm(this.alarm.id)){\n            this.chartLastVelocitiesAndAlarms.isCompact = true\n            this.chartLastVelocitiesAndAlarms.renderChartInHtmlComponent(this.vehicleId, this.driverId, this.vehicleLastAlarm)\n          }       \n          this.isFromDevicesWithoutMedia= this.devicesWithoutMedia.includes(this.alarm.equipmentTypeId)\n\n          if(this.alarm.driver_firstname === undefined){\n            this.alarm.driver_firstname = this.translateJsonService.getTranslateSubs('TREATMENT-FLOW.not_driver');\n          }\n\n          this.imei = alarms[0].imei;\n          this.customerChildId = alarms[0].customer_child_id;\n\n          if(this.alarm.auditDriver == this.auditId){\n            this.imgSignature = this.alarm.signature ? 'data:image/png;base64,' + this.alarm.signature : ''\n            this.signatureInfo = this.translateJsonService.getTranslateSubs('AUDIT.signed_driver') + ' ' + this.alarm.signatureDriverName + ' ' + moment(this.alarm.signatureDate).format(\"DD/MM/YYYY HH:mm\")\n          }else{ \n            this.imgSignature = ''\n            this.signatureInfo = ''\n          }\n\n          setTimeout(() => {\n    \n            this.allMarkers = [];\n    \n            alarms.forEach(alarm => {\n              let mrkr: ModelMarkers = new ModelMarkers;\n    \n              mrkr.id = alarm.id;\n              mrkr.category = alarm.typeAlarm;\n              mrkr.enabled = true;\n              mrkr.latitude = alarm.latitude;\n              mrkr.longitude = alarm.longitude;\n    \n              this.allMarkers.push(mrkr);\n            });\n    \n            this.loadingMap = false;\n    \n          }, 2000);\n        });\n      });\n  }\n\n  public async getAlarmAuditHistories(alarmId: number): Promise<any> {\n    return new Promise<any>((resolve, reject) => {\n      this.alarmService.getAuditHistories(alarmId).subscribe(\n        auditHistories => {\n          resolve(auditHistories);\n        },\n        error => {\n          reject(error);\n        }\n      )\n    });\n  }\n\n  zoomAlarmImage(event, urlPictures, urlMovies, container, alarm, aiAlarmValidations = this.aiAlarmValidations) {\n    if (urlPictures[0] == 'NO_PICTURE') return;\n    this.dialogService.open(ZoomMediasComponent, { data: { urlPictures, urlMovies, alarm, aiAlarmValidations }});\n  }\n\n  async generateNotification(sendNotificationByEmail: boolean) {\n    this.loadedNotification = false;\n    this.isPrintAlarmNotification = false;\n    this.sendNotificationByEmail = false;\n    this.treatmentNotification = null;\n\n    let canvas = await this.fetchImageMap();\n\n    this.exportableMap = JSON.parse(JSON.stringify(canvas.toDataURL()));\n    this.sourceChartLastVelocitiesAndAlarms = this.fetchChartLastVelocitiesAndAlarms()\n\n    let treatment: TreatmentBuild = new TreatmentBuild;\n\n    treatment.treatmentByUser = (this.audit.auditAutor) ? this.audit.auditAutor : this.workspace.currentUser.name;\n    treatment.alarmDate = this.translateJsonService.transformDataFormat(this.audit.datetime);\n    treatment.treatmentDate = this.translateJsonService.transformDataFormat(this.audit.create_date);\n    treatment.treatmentName = this.audit.treatmentname\n    treatment.treatmentObs = (this.audit.comments) ? this.audit.comments : '';\n\n    this.alarmListNotification = this.treatmentFlowState.getSelectedAlarms();\n    this.loadedNotification = true;\n    \n    setTimeout(() => {\n      this.isPrintAlarmNotification = !sendNotificationByEmail;\n      this.sendNotificationByEmail = sendNotificationByEmail;\n      this.treatmentNotification = treatment;\n    }, 0);\n}\n\n  private fetchImageMap(): Promise<any> {\n    return new Promise((resolve, reject) => {\n      leafletImage(this.alarmMap.map, function (err, canvas) {\n        resolve(canvas);\n      })\n    })\n  }\n\n  private fetchChartLastVelocitiesAndAlarms() {\n    if (this.chartLastVelocitiesAndAlarms && this.chartLastVelocitiesAndAlarms.chart) {\n      return this.chartLastVelocitiesAndAlarms.chart.toBase64Image();\n    } else {\n      // Handle the case where chartLastVelocitiesAndAlarms or chart is undefined\n      return null; // or throw an error, return a default image, etc.\n    }\n  }\n\n  public closeModal(){\n    this.resetNotificationState();\n    this.eventCloseModal.emit();\n  }\n\n  isNewAlarm(alarmId: number){\n    if(this.lastAlarmId === undefined || this.lastAlarmId !== alarmId){\n      this.lastAlarmId = alarmId;\n      this.resetNotificationState();\n      return true\n    }\n    else return false\n  }\n\n  private resetNotificationState(): void {\n    this.treatmentNotification = null;\n    this.alarmListNotification = null;\n    this.isPrintAlarmNotification = false;\n    this.sendNotificationByEmail = false;\n    this.loadedNotification = false;\n  }\n\n  public onSendMessage(commandVoice: CommandVoice) {\n    this.isSendingVoiceCommand = true;\n\n    const message = this.buildMessage([commandVoice]);\n\n    this.voiceMessageService\n      .saveVoiceMessages(message)\n      .then(() => {\n        this.isSendingVoiceCommand = false;\n        this.notificationService.printSuccessMessage(this.translateJsonService.getTranslateSubs(\"VOICE-MESSAGE-PAGE.success_send_msg\"));\n      })\n      .catch(() => {\n        this.isSendingVoiceCommand = false;\n        this.notificationService.printErrorMessage(this.translateJsonService.getTranslateSubs(\"VOICE-MESSAGE-PAGE.error_send_msg\"));\n      })\n  }\n\n\n  public buildMessage(commands: CommandVoice[]): Audio {\n    const audio = new Audio();\n\n    audio.deviceId = this.alarm.imei;\n    audio.deviceTypeId = this.alarm.equipmentTypeId;\n    audio.userId = JSON.parse(localStorage.getItem(\"currentUser\")).id;\n    audio.voiceCommands = commands;\n\n    return audio;\n  }\n\n  private setShowVoiceCommand(deviceTypeId: number): void {\n    this.showVoiceCommand = this.voiceMessageService.deviceCanReceiveMessage(deviceTypeId);\n  }\n\n  public getTranslatedTreatmentName(treatmentName: string): string {\n    if (!treatmentName) return '';\n    \n    const treatmentTranslations: { [key: string]: string } = {\n      'Alerta invalidado': 'TREATMENT-FLOW.invalidated_alert',\n      'Invalidated Alert': 'TREATMENT-FLOW.invalidated_alert',\n      'Alerta Invalidada': 'TREATMENT-FLOW.invalidated_alert',\n      'Alarme Válido': 'TREATMENT-FLOW.valid_alarm',\n      'Alerta validado': 'TREATMENT-FLOW.valid_alarm',\n      'Alerta Válida': 'TREATMENT-FLOW.valid_alarm'\n    };\n\n    const translationKey = treatmentTranslations[treatmentName];\n    if (translationKey) {\n      return this.translateJsonService.getTranslateSubs(translationKey);\n    }\n    \n    return treatmentName;\n  }\n\n  public getTranslatedComments(comments: string): string {\n    if (!comments) return '';\n    \n    const seatbeltMarkers: { [key: string]: string } = {\n      '#[MOTORISTA COM CINTO]': 'TREATMENT-FLOW.driver_with_seatbelt',\n      '#[MOTORISTA SEM CINTO]': 'TREATMENT-FLOW.driver_without_seatbelt',\n      '#[DRIVER WITH SEATBELT]': 'TREATMENT-FLOW.driver_with_seatbelt',\n      '#[DRIVER WITHOUT SEATBELT]': 'TREATMENT-FLOW.driver_without_seatbelt',\n      '#[CONDUCTOR CON CINTURÓN]': 'TREATMENT-FLOW.driver_with_seatbelt',\n      '#[CONDUCTOR SIN CINTURÓN]': 'TREATMENT-FLOW.driver_without_seatbelt'\n    };\n\n    const validationTexts: { [key: string]: string } = {\n      'Validação de Alerta': 'TREATMENT-FLOW.alert_validation',\n      'Alert Validation': 'TREATMENT-FLOW.alert_validation',\n      'Validación de Alerta': 'TREATMENT-FLOW.alert_validation'\n    };\n\n    let translatedComments = comments;\n\n    Object.keys(seatbeltMarkers).forEach(marker => {\n      if (comments.includes(marker)) {\n        const translatedMarker = this.translateJsonService.getTranslateSubs(seatbeltMarkers[marker]);\n        translatedComments = translatedComments.replace(marker, `[${translatedMarker}]`);\n      }\n    });\n\n    Object.keys(validationTexts).forEach(text => {\n      if (translatedComments.includes(text)) {\n        const translatedText = this.translateJsonService.getTranslateSubs(validationTexts[text]);\n        translatedComments = translatedComments.replace(text, translatedText);\n      }\n    });\n\n    return translatedComments.trim();\n  }\n}\n","export class StepInfosModel {\n  alarmType?: number;\n  vehicleDetails?: string;\n  driverDetails?: string;\n  customerChild?: string;\n  customerProfileName?: string;\n  alarmIds?: number[];\n  alarmId?: number;\n  treatmentStartedAt?: Date | string;\n  recalcRiskByRecurrence?: boolean = false;\n  equipmentTypeId?: number;\n}","module.exports = \"<div class=\\\"row\\\" *ngIf=\\\"infos != undefined && infos.recalcRiskByRecurrence\\\">\\n  <div class=\\\"col-md-12\\\">\\n    <p>\\n      <i class=\\\"fa fa-exclamation-triangle\\\" aria-hidden=\\\"true\\\" style=\\\"color: #f0b907\\\"></i>\\n      {{ \\\"TREATMENT-MODAL.recurrence_treated_warning\\\" | translate }}\\n    </p>\\n  </div>\\n</div>\\n<div class=\\\"row step__infos\\\" *ngIf=\\\"(step$ | async) !== 4; else finish\\\">\\n  <div class=\\\"col-md-2 step__inputs\\\">\\n    <label>{{ \\\"TREATMENT-FLOW.alert_type\\\" | translate }}</label>\\n    <p-dropdown *ngIf=\\\"infos?.alarmType\\\" [options]=\\\"itensAlarmTypesDMS\\\" [disabled]=\\\"isFromDevicesWithoutMedia || !editAlarmType\\\" [(ngModel