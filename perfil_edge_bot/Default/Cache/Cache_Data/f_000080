ong>${this.translateJsonService.getTranslateSubs(\"GLOBAL.alert_1\")}:</strong> ${_marker.id} </br>\n          <strong>${this.translateJsonService.getTranslateSubs('MARKER-DETAILS.driver_name')}:</strong> ${_marker.driverName}</br>\n          <strong>${this.translateJsonService.getTranslateSubs('MARKER-DETAILS.license_plate_prefix')}:</strong> ${_marker.plateAndPrefix}</br>\n          <strong>${this.translateJsonService.getTranslateSubs('MARKER-DETAILS.alarm_type')}:</strong> ${_marker.alarmType}</br>\n          <strong>${this.translateJsonService.getTranslateSubs('MARKER-DETAILS.risk_level')}:</strong> ${riskLevel}</br> \n          <strong>${this.translateJsonService.getTranslateSubs('MARKER-DETAILS.date_time')}:</strong> ${_marker.datetime}</br>\n          <a href=\"${streetView}\" target=\"_blank\" class=\"street-view-popup\"><i class=\"fa fa-street-view\"></i> <span>Street View</span></a>`\n        }\n      }\n      popupContent =\n        this.translateJsonService.getTranslateSubs(\"GLOBAL.alert_1\") +\n        \" \" +\n        _marker.id +\n        \"<br/>\" +\n        \"Latitude: \" + _marker.latitude +\n        \"<br/>\" +\n        \"Longitude: \" + _marker.longitude +\n        '<br/> <a href=\"' +\n        streetView +\n        '\" target=\"_blank\" class=\"street-view-popup\"><i class=\"fa fa-street-view\"></i> <span>Street View</span></a>';\n    }\n\n      return marker([_marker.latitude, _marker.longitude], {\n        title: _marker.id.toString(),\n        icon: this.getIcon(_marker.category, _marker),\n      }).bindPopup(popupContent);\n  }\n\n  getImageUrl(type: number, _marker: ModelMarkers): string {\n    const supportedTypes = [1000, 1001, 1002, 1003, 1004];\n    const intervalMinutes = 120;\n\n    const currentUTCTime = new Date(\n      Date.UTC(\n        new Date().getUTCFullYear(),\n        new Date().getUTCMonth(),\n        new Date().getUTCDate(),\n        new Date().getUTCHours(),\n        new Date().getUTCMinutes()\n      )\n    );\n    const cutoffTime = new Date(\n      currentUTCTime.getTime() - intervalMinutes * 60 * 1000\n    );\n\n    if (supportedTypes.includes(type)) {\n\n        // Convertendo _marker.datetime para objeto Date\n        let parts = _marker.datetime.split(\" \");\n        let dateParts = parts[0].split(\"/\");\n        let timeParts = parts[1].split(\":\");\n        let markerDate = new Date(\n            parseInt(dateParts[2]), \n            parseInt(dateParts[1]) - 1, \n            parseInt(dateParts[0]), \n            parseInt(timeParts[0]), \n            parseInt(timeParts[1]), \n            parseInt(timeParts[2])\n        );\n\n        // Verificando se o veículo está offline (não visto por 2 horas ou mais)\n        if (markerDate < cutoffTime) {\n            return this.vehicleOfflinePath;\n        }\n        \n        // Verificando se o veículo está em movimento (visto nas últimas 2 horas e velocidade maior que 0)\n        if (_marker.speed > 0 && markerDate >= cutoffTime) {\n            return this.vehicleMovingPath;\n        }\n        \n        // Verificando se o veículo está parado (visto nas últimas 2 horas e velocidade é 0)\n        if (_marker.speed === 0 && markerDate >= cutoffTime) {\n            return this.vehicleStoppedPath;\n        }\n    }\n\n    const icon =\n      this.iconsImage.find((i) => i.type === type) ||\n      this.iconsImage.find((i) => i.type === 0);\n    return icon ? icon.image : \"\";\n  }\n\n  getIcon(type: number, _marker: ModelMarkers) {\n    const url = this.getImageUrl(type, _marker);\n    let borderColor = \"transparent\";\n    let backgroundColor = \"transparent\";\n\n    if (type === 1000) borderColor = \"#2CC13B\"; // no risk\n    else if (type === 1001) borderColor = \"#2a46be\"; // low risk\n    else if (type === 1002) borderColor = \"#F0C632\"; // medium risk\n    else if (type === 1003) borderColor = \"#F04949\"; // high risk\n\n    // if showBorder is false, borderColor and backgroundColor will be set to transparent, removing t