\");\n    }\n  }\n}\n","import { NgModule } from '@angular/core';\nimport { LeafletMapComponent } from './leaflet-map.component';\nimport { LeafletModule } from '@asymmetrik/ngx-leaflet';\nimport { LeafletMarkerClusterModule } from '@asymmetrik/ngx-leaflet-markercluster';\nimport { CommonModule } from '@angular/common';\nimport { LeafletHeatMapModule } from './heatmap/heatmap.module';\nimport { FormsModule } from '@angular/forms';\nimport { CheckboxModule, AccordionModule } from 'primeng/primeng';\nimport { LeafletMapService } from './leaflet-map.service';\nimport { TranslateModule } from '@ngx-translate/core';\nimport { LeafletPlaybackModule } from './playback/playback.module';\n\n@NgModule({\n    imports: [\n        CommonModule,\n        LeafletModule.forRoot(),\n        LeafletMarkerClusterModule,\n        LeafletHeatMapModule,\n        LeafletPlaybackModule,\n        FormsModule,\n        AccordionModule,\n        CheckboxModule,\n        TranslateModule\n    ],\n    declarations: [\n        LeafletMapComponent\n    ],\n    providers: [\n        LeafletMapService\n    ],\n    entryComponents: [],\n    exports: [\n        LeafletMapComponent\n    ]\n})\nexport class LeafletMapModule { }","import { HttpClient } from \"@angular/common/http\";\nimport { Injectable } from \"@angular/core\";\nimport { Http } from \"@angular/http\";\nimport { environment } from \"environments/environment\";\nimport { GeoJsonObject } from \"geojson\";\n\n@Injectable()\nexport class LeafletMapService {\n    private JSON_LINK = [\n        //'https://raw.githubusercontent.com/rafaelmacedox/anotacoes/390c809cac5d2829eb61126ec3e338b4dc676f13/ABRANGENCIA_PERIMETRO_SVAA_2019.geojson'\n        environment.jsonLink\n      ]\n  \n    constructor(\n      private http: HttpClient\n    ){}\n  \n    getGeoJsonFromGitHub(id) {\n      return this.http.get<GeoJsonObject>(this.JSON_LINK[id])\n        .toPromise()\n    }\n}","import { Directive, EventEmitter, Input, Output, SimpleChange } from \"@angular/core\";\nimport { P } from \"@angular/core/src/render3\";\nimport { LeafletDirective } from \"@asymmetrik/ngx-leaflet\";\n\nimport * as L from 'leaflet';\nimport 'leaflet-plugin-trackplayback';\nimport { TrackPlayBackEvent } from \"./playback-event.model\";\n\n@Directive({\n\tselector: '[leafletPlayback]'\n})\nexport class LeafletPlaybackDirective {\n\tleafletDirective: LeafletDirective;\n\tmap;\n\n\t\n\ttrackplayback;\n\ttrackplaybackOptions = {\n\t\tclockOptions: {\n\t\t\tspeed: 3,\n\t\t\tmaxSpeed: 50\n\t\t},\n\t\ttargetOptions: {\n\t\t\tuseImg: true,\n\t\t\timgUrl: 'assets/images/telemetry-icons/icon.png',\n\t\t\twidth: 60,\n\t\t\theight: 60,\n\t\t},\n\t\ttrackLineOptions: {\n\t\t\tisDraw: false,\n\t\t\tstroke: true,\n\t\t\tcolor: '#4b4b4b',\n\t\t\tweight: 5,\n\t\t\tfill: false,\n\t\t\tfillColor: '#000',\n\t\t\topacity: 0.9\n\t\t},\n\t};\n\n\tcurrentSpeed: number = 0\n\n\t@Input('leafletPlaybackT') markerData: any[] = [];\n\t@Input('played') played: boolean = false;\n\t@Input('curTime') curTime: number;\n\t@Input('playSpeed') playSpeed: number = 1;\n\n\t@Output('infos') infos: EventEmitter<TrackPlayBackEvent> = new EventEmitter();\n\n\tconstructor(leafletDirective: LeafletDirective) {\n\t\tthis.leafletDirective = leafletDirective;\n\t}\n\n\tngOnInit() {\n\t\tthis.map = this.leafletDirective.getMap();\n\t}\n\n\tngOnChanges(changes: { [key: string]: SimpleChange }) {\n\t\tif (changes['markerData'] && changes['markerData'].currentValue.length > 0) {\n\n\t\t\tif (this.trackplayback) {\n\t\t\t\tthis.trackplayback.dispose();\n\t\t\t\tthis.trackplayback = null;\n\t\t\t}\n\n\t\t\tthis.trackplayback = new (L as any).TrackPlayBack(this.markerData.map(p => { return { lat: p.lat, lng: p.lng, dir: 320, time: p.time, info:[{key: 'speed', value: p.speed}]  } }), this.map, this.trackplaybackOptions);\n\t\t\t\n\t\t\tthis.trackplayback.showTrackLine()\n\t\t\t\n\t\t\t\n\t\t\tthis.infos.emit({ \n\t\t\t\tcurTime: this.trackplayback.getStartTime(),\n\t\t\t\tendTime: this.trackplayback.getEndTime(),\n\t\t\t\tstartTime: this.trackplayback.getCurTime(),\n\t\t\t\tspeed: (this.markerData[0] ? this.markerData[0].speed: null) as number\n\t\t\t})\n\n\t\t\tthis.trackplayback.on('tick', e => {\n\t\t\t\ttry {\n\t\t\t\t\tlet trackPointsBeforeTime = e.target.tracks[0].getTrackPointsBeforeTime(e.time);\n\t\t\t\t\tthis.currentSpeed = trackPointsBeforeTime[trackPointsBeforeTime.length - 2].info[0].value as number\n\t\t\t\t} catch(err) {}\n\n\t\t\t\tthis.infos.emit({ \n\t\t\t\t\tcurTime: e.time,\n\t\t\t\t\tendTime: this.trackplayback.getEndTime(),\n\t\t\t\t\tstartTime: this.trackplayback.getStartTime(),\n\t\t\t\t\tspeed: this.currentSpeed\n\t\t\t\t})\n\t\t\t}, this)\n\t\t}\n\n\t\tif(changes['markerData'] && changes['markerData'].currentValue.length < 1) {\n\t\t\tif (this.trackplayback && this.trackplayback.dispose){\n\t\t\t\tthis.trackplayback.dispose();\n\t\t\t\tthis.trackplayback = null;\n\t\t\t\tthis.trackplayback = new (L as any).TrackPlayBack(this.markerData.map(p => { return { lat: p.lat, lng: p.lng, dir: 320, time: p.time, speed: p.speed } }), this.map, this.trackplaybackOptions);\n\t\t\t}\n\t\t}\n\n\t\tif (changes['played'] && !changes['played'].firstChange) {\n\t\t\tif(this.played) {\n\t\t\t\tthis.trackplayback.start();\n\t\t\t}else{\n\t\t\t\tthis.trackplayback.stop();\n\t\t\t}\n\t\t}\n\n\t\tif (changes.curTime && !changes.curTime.firstChange) {\n\t\t\tthis.trackplayback.setCursor(Number(changes.curTime.currentValue));\n\t\t}\n\n\t\tif (changes.playSpeed && changes.playSpeed.currentValue) {\n\t\t\tthis.trackplayback.setSpeed(changes.playSpeed.currentValue);\n\t\t}\n\n\t}\n}","import { ModuleWithProviders, NgModule } from '@angular/core';\nimport { LeafletPlaybackDirective } from './playback.directive';\n\n@NgModule({\n\texports: [ LeafletPlaybackDirective ],\n\tdeclarations: [ LeafletPlaybackDirective ]\n})\nexport class LeafletPlaybackModule {\n\n\tstatic forRoot(): ModuleWithProviders {\n\t\treturn { ngModule: LeafletPlaybackModule, providers: [] };\n\t}\n}","import {Injectable} from \"@angular/core\";\nimport {ConfigService} from \"app/@core/config/config.service\";\nimport {LastHeartbeat} from \"app/@core/models/last-heartbeat.entity\";\nimport {AuthenticationService} from \"app/pages/login/authentication.service\";\nimport * as moment from \"moment\";\nimport {Observable, throwError as observableThrowError} from \"rxjs\";\nimport {catchError, map} from \"rxjs/operators\";\nimport {Playback} from \"./playbackold.entity\";\nimport {RemoteTask} from \"./remote-list/remote-tasks.entity\";\nimport {HttpClient, HttpErrorResponse, HttpHeaders, HttpParams, HttpResponse} from \"@angular/common/http\";\nimport {GetPlaybackUrlRequest, PlaybackRoute} from \"../playback/types\";\n\n@Injectable({\n    providedIn: 'root'\n})\nexport class PlaybackOldService {\n\n    constructor(\n        private http: HttpClient,\n        private config: ConfigService,\n        private auth: AuthenticationService,\n        private configService: ConfigService\n    ) {}\n\n    public async getRemoteTasks(taskId: number, deviceId: string): Promise<RemoteTask | any> {\n        return new Promise(async (resolve, reject) => {\n\n            let _ws = 'playback/remote?';\n            let params = (taskId == 0) ? `deviceId=${deviceId}` : `taskId=${taskId}`;\n\n            const URL = `${this.configService.getApiURI()}${_ws}${params}`;\n\n            this.get(URL).subscribe((response: any) => {\n                resolve(response)\n            }, err => {\n                reject(err);\n            });\n        });\n    }\n\n    public getRemoteTaskById(taskId: number): Observable<RemoteTask> {\n        const ws = 'playback/remote';\n        const options = { \n            headers: this.getHttpHeaders(),\n            params: new HttpParams().set('taskId', taskId ? taskId.toString() : '')\n        };\n\n        const url = `${this.configService.getApiURI()}${ws}`;\n\n        return this.http\n            .get<RemoteTask>(url, options)\n            .pipe(\n                catchError(this.handleError)\n            );\n    }\n\n    public getLastCompletedPaybackFileListTask(deviceImei: string): Promise<RemoteTask> {\n        return new Promise((resolve, reject) => {\n            const requestUrl = `${this.configService.getApiURI()}playback/file-list/current?deviceImei=${deviceImei}`;\n\n            this.get(requestUrl).subscribe(\n                (response: any) => {\n                    resolve(response)\n                },\n                err => {\n                    reject(err);\n                }\n            );\n        });\n    }\n\n    public async requestRemoteTasks(deviceId: string, deviceTypeId: number, startDatetime: string, endDatetime: string): Promise<any> {\n        return new Promise((resolve, reject) => {\n\n            let _ws = 'playback/remote';\n\n            const URL = `${this.configService.getApiURI()}${_ws}`;\n\n            this.post(URL, { deviceId, deviceTypeId, startDatetime, endDatetime }, 'body')\n                .subscribe((response: any) => {\n                    resolve(response)\n                }, err => {\n                    reject(err);\n                });\n        });\n    } \n\n    public cancelRemoteTasksRequest(taskId: number): Observable<any> {\n        const url = `${this.configService.getApiURI()}playback/remote/${taskId}`;\n        const options = {\n            headers: this.getHttpHeaders()\n        }\n\n        return this\n            .http\n            .delete<RemoteTask>(url, options)\n            .pipe(\n                catchError(this.handleError)\n            );\n    }\n\n    public async getDownloadTasks(deviceId: string, beginTime: Date, endTime: Date): Promise<any> {\n        return new Promise(async (resolve, reject) => {\n\n            let beginTimeWithTimeZone = moment(beginTime).seconds(0).format();\n            let endTimeWithTimeZone = moment(endTime).seconds(0).format();\n\n            let _ws = 'playback/remote?';\n            let params = \"deviceId=\" + deviceId + \"&startDate=\" + beginTimeWithTimeZone + \"&endDate=\" + endTimeWithTimeZone;\n\n            const URL = `${this.configService.getApiURI()}${_ws}${params}`;\n\n            this.get(URL).subscribe((response: any) => {\n                resolve(response)\n            }, err => {\n                reject([]);\n            });\n        });\n    }\n\n    public getChannelNumberByFileName(fileName: String): number {\n        return parseInt(fileName.split(\"_\")[9]);\n    }\n\n    public formatDuration(duration: string | number): string {\n        let minutes = moment(duration).format(\"mm\");\n        let seconds = moment(duration).format(\"ss\");\n        return `${minutes}m ${seconds}s`;\n    }\n\n    public formatMediaSize(fileSize: string): string {\n        const bytesToMegabytes = 1048576;\n        return ((parseFloat(fileSize) / bytesToMegabytes).toFixed(2)).toString();\n    }\n\n    async getFileList(deviceId: string, beginTime: Date, endTime: Date, deviceTypeId: number): Promise<any> {\n        return new Promise(async (resolve, reject) => {\n\n            let beginTimeWithTimeZone = moment(beginTime).seconds(0).format();\n            let endTimeWithTimeZone = moment(endTime).seconds(59).format();\n\n            let _ws = 'playback/available?';\n            let params = \"deviceTypeId=\" + deviceTypeId +\n                         \"&deviceId=\" + deviceId +\n                         \"&startDate=\" + encodeURIComponent(beginTimeWithTimeZone) +\n                         \"&endDate=\" + encodeURIComponent(endTimeWithTimeZone);\n            const URL = `${this.configService.getApiURI()}${_ws}${params}`;\n            this.get(URL).subscribe((response: any) => {\n                resolve(response)\n            }, err => {\n                reject([]);\n            });\n        });\n    }\n\n    public requestDownload(playback: Playback): Promise<boolean> {\n        return new Promise((resolve, reject) => {\n            let ws = \"playback\";\n            const URL = `${this.configService.getApiURI()}${ws}`;\n\n            this.post(URL, playback, 'response').subscribe((response: any) => {\n                resolve(response);\n            }, error => {\n                reject(error);\n            });\n        });\n    }\n\n    downloadFile(urlFile: string): Promise<any> {\n        return new Promise((resolve, reject) => {\n            let ws = \"playback/preAuthenticateUrl?\";\n            let param = \"urlFile=\" + urlFile;\n            const URL = `${this.configService.getApiURI()}${ws}${param}`;\n\n            this.get(URL).subscribe((response: any) => {\n                resolve(response.urlVideo)\n            }, err => {\n                reject();\n            });\n        });\n    }\n\n    public processAuthUrlGet(authUrl: string, fileName: string): Promise<boolean> {\n        return new Promise((resolve, reject) => {\n            this.http.get(authUrl, { responseType: 'blob' }).subscribe((response) => {\n                const anchor = document.createElement(\"a\");\n                const objectUrl = URL.createObjectURL(response);\n                anchor.href = objectUrl;\n                anchor.download = fileName;\n                anchor.click();\n                URL.revokeObjectURL(objectUrl);\n                resolve(true)\n            }, error => {\n                reject(false);\n            });\n        });\n    }\n\n    private get(URL: string) {\n        return this.http.get(URL, { headers: this.getHttpHeaders() })\n        .pipe(\n            catchError(this.handleError)\n        );\n    }\n\n    private post(URL: string, body: any, observe: 'response' | 'body') {\n        return this.http.post(URL, body, { headers: this.getHttpHeaders(), observe: observe as 'body' })\n        .pipe(catchError(this.handleError));\n    }\n\n    private handleError(res: HttpErrorResponse) {\n        const { error } = res;\n        return observableThrowError((error.message) ? error.message : error);\n    }\n\n    private getHttpHeaders(): HttpHeaders {\n        return new HttpHeaders({\n            'Content-Type': 'application/json',\n            'Authorization': this.auth.getToken()\n        });\n    }\n\n    private handleErrorResponse(err: Response) {\n        const status = err.status;\n        return observableThrowError({\n            status,\n            err,\n        });\n    }\n\n    async getEvent(transactionCode: string): Promise<string> {\n        const events = null; //await this.getEvents(transactionCode);\n\n        if (events.find(event => event.eventType == 'download_file_uploaded')) {\n            return 'available';\n        } else {\n            return 'in_progress';\n        }\n    }\n\n    getVehiclesON(customersChildArray: any): Observable<LastHeartbeat[]> {\n        let _ws = 'v2/heartbeat/last-heartbeat/customerChild'\n\n        return this.http.post<LastHeartbeat[]>(`${this.configService.getApiURI()}${_ws}`, customersChildArray, { headers: this.getHttpHeaders() })\n        .pipe(catchError(this.handleError));\n    }\n\n    getActiveDays(deviceId: string, startDate: string, endDate: string): Observable<any[]> {\n        let _ws = 'v2/heartbeat/active-days?';\n        let params = `imei=${deviceId}&startDate=${startDate}&endDate=${endDate}`;\n        const URL = `${this.configService.getApiURI()}${_ws}${params}`;\n        return this.http.get<any[]>(URL, { headers: this.getHttpHeaders() })\n            .pipe(\n                catchError(this.handleError)\n            );\n    }\n\n    public getG7CorrectChannel(channelId: number) {\n        switch (channelId) {\n            case 1: return 2;\n            case 2: return 5;\n            case 3: return 1;\n            case 4: return 3;\n            case 5: return 4;\n        }\n    }\n\n    public getG5PlusCorrectChannel(channelId: number) {\n        switch (channelId) {\n            case 1: return 2;\n            case 2: return 1;\n            default: return channelId;\n        }\n    }\n\n    public getKdashCorrectChannel(channelId: number) {\n        switch (channelId) {\n            case 1: return 2;\n            case 2: return 1;\n            default: return channelId;\n        }\n    }\n\n    public getPlaybackRoutes(taskId: number): Observable<PlaybackRoute[]> {\n        const ws = this.config.webServicesV2[\"getPlaybackRoutes\"];\n        const options = { \n            headers: this.getHttpHeaders(),\n            params: new HttpParams().set('taskId', taskId ? taskId.toString() : ''),\n            observe: 'response' as 'body',\n        };\n\n        return this.http\n            .get(\n                ws.url(this.configService.getApiURI()), \n                options,\n            )\n            .pipe(\n                map((res: HttpResponse<any>) => {\n                    if (res.status === 202) {\n                        return [];\n                    }\n\n                    return res.body;\n                }),\n                map((res: any) => {\n                    return res.map((playbackRoute: any) => {\n                        return {\n                            ...playbackRoute,\n                            startDate: new Date(playbackRoute.startDate),\n                            endDate: new Date(playbackRoute.endDate),\n                            positions: playbackRoute.positions \n                            ? playbackRoute.positions.map((position: any) => ({\n                                ...position,\n                                dateTime: new Date(position.dateTime),\n                            }))\n                            : [],\n                        };\n                    })\n                }),\n                catchError(this.handleErrorResponse)\n            );\n    }\n\n    public getPlaybackUrl(body: GetPlaybackUrlRequest): Observable<string> {\n        const ws = this.config.webServicesV2[\"getPlaybackUrl\"];\n        const options = { headers: this.getHttpHeaders() };\n\n        return this.http\n            .post(\n                ws.url(this.configService.getApiURI()),\n                body,\n                options,\n            )\n            .pipe(\n                map((res: any) => res.videoUrl),\n                catchError(this.handleError),\n            );\n    }\n\n    public getAllMediasFromDevice(deviceId: string, date: Date) {\n        const ws = this.config.webServicesV2[\"getAllMediasByImei\"];\n        const options = {\n            headers: this.getHttpHeaders(),\n            params: {\n              startDate: moment(date).startOf('day').toISOString(),\n              endDate: moment(date).endOf('day').toISOString()\n            }\n        };\n\n      return this.http\n            .get(ws.url(this.configService.getApiURI(), deviceId), options)\n            .pipe(\n                map((res: any) => res),\n                catchError((error) => {\n                    return observableThrowError(() => new Error(\"Erro ao buscar mídias do dispositivo.\"));\n                })\n            );\n    }\n\n    public createPlaybackScheduled(deviceId:string, startDatetime: string, endDatetime: string, deviceTypeId: number, channels: string[]): Observable<any> {\n        let _ws = 'v2/playback/playback-schedule';\n\n        const URL = `${this.configService.getApiURI()}${_ws}`\n\n        return this.post(URL, { deviceId, startDatetime, endDatetime, deviceTypeId, channels }, 'body')\n        .pipe(\n            map((res: any) => res),\n            catchError((error) => {\n                return observableThrowError(() => new Error(\"Erro ao criar playback agendado.\"));\n            })\n        );\n    }\n}\n"],"sourceRoot":""}