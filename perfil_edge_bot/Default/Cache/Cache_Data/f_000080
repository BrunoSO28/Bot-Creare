}\n\n  private agroupIcons(agroup: boolean) {\n    if (!this.hideIcons) {\n      if (agroup) {\n        this.layersClusted = this.filterEnabled();\n        this.layersNotClusted = [];\n\n        if (this.hideIcons) {\n          this.hideIcons = false;\n        }\n      } else {\n        this.layersNotClusted = this.filterEnabled();\n        this.layersClusted = [];\n      }\n    }\n\n    this.insertInMapOverlays(this.OVERLAY_MOSAIC.layer);\n    this.insertInMapOverlays(this.OVERLAY_MOSAIC_CATALAO.layer);\n\n    this.layersNotClusted.push(this.layersControl.baseLayers[\"Default\"]);\n\n    if (!this.generatePDF) {\n      // ToDo: Feito apenas para a Usina Santa Vitória\n      let customerUser = window.localStorage.getItem(\"currentCustomer\");\n\n      if (customerUser === \"21\" || customerUser === \"1\") {\n        this.loadGeoJSON();\n      } else {\n        this.clearMapLocalStorage();\n      }\n    }\n  }\n\n  private createOrDestroyHeat(hide: boolean) {\n    if (!hide) {\n      this.heatMap = this.dataMarkers;\n    } else {\n      this.heatMap = [];\n    }\n  }\n\n  private hideOrShowIcons(hide: boolean) {\n    if (hide) {\n      this.clusted = false;\n      this.layersClusted = [];\n      this.layersNotClusted = [];\n      this.layersNotClusted.push(this.layersControl.baseLayers[\"Default\"]);\n    } else {\n      this.agroupIcons(this.clusted);\n    }\n  }\n\n  setMapBounds(): void {\n    const latitudes = this.getLatitudes(this.dataMarkers);\n    const longitudes = this.getLongitudes(this.dataMarkers);\n    const minLat = Math.min(...latitudes) - 0.001;\n    const maxLat = Math.max(...latitudes) + 0.05;\n    const minLong = Math.min(...longitudes) - 0.001;\n    const maxLong = Math.max(...longitudes) + 0.001;\n    const corner1 = latLng(minLat, minLong),\n      corner2 = latLng(maxLat, maxLong);\n    this.fitBounds = latLngBounds(corner1, corner2);\n  }\n\n  private getLatitudes(markers: ModelMarkers[]) {\n    return markers.length ? markers.map((d) => d.lat