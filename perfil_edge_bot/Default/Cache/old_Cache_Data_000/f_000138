nslateJsonService.getAlarmTypesTranslate(26), value: 26, icon: 'assets/images/drowsiness-confirmation.png' },\n    { label: this.translateJsonService.getAlarmTypesTranslate(27), value: 27, icon: 'assets/images/speed.png' },\n    { label: this.translateJsonService.getAlarmTypesTranslate(28), value: 28, icon: 'assets/images/sharp-turn.png'},\n    { label: this.translateJsonService.getAlarmTypesTranslate(29), value: 29, icon: 'assets/images/hard-braking.png'},\n    { label: this.translateJsonService.getAlarmTypesTranslate(30), value: 30, icon: 'assets/images/hard-acceleration.png'},\n    {label: this.translateJsonService.getAlarmTypesTranslate(31), value: 31, icon: 'assets/images/stop-sign.png'},\n    { label: this.translateJsonService.getAlarmTypesTranslate(32), value: 32, icon: 'assets/images/accumulated-drowsiness.png'},\n    { label: this.translateJsonService.getAlarmTypesTranslate(33), value: 33, icon: 'assets/images/invalid-alarm.png'}\n  ]\n  public  returnEvaluationStatus(aiEvaluationStatus: string): {label: string; value: string; icon: string} | undefined  {\n      return this.aiEvaluationStatusIcon.find(value => value.value === aiEvaluationStatus);\n  }\n  public aiEvaluationStatusIcon = [\n        {label: \"aiEvaluationConfirmed\" , value: \"CONFIRMED\", icon: 'assets/images/iaEvaluationConfirmed.png'},\n        {label: \"aiEvaluationInconclusive\", value: \"INCONCLUSIVE\", icon: 'assets/images/iaEvaluationInconclusive.png'},\n        {label: \"aiEvaluationFalse\", value: \"FALSE\", icon: 'assets/images/iaEvaluationFalse.png'}\n\n  ]\n\n    public returnHumanEvaluationStatus(humanEvaluationStatus: string): {label: string; value: string; icon: string} | undefined  {\n        return this.humanEvaluationStatusIcon.find(value => value.value === humanEvaluationStatus);\n    }\n    public humanEvaluationStatusIcon = [\n        {label: \"humanEvaluationInvalid\" , value: \"INVALID\", icon: 'assets/images/humanEvaluationInvalid.png'},\n        {label: \"humanEvaluationValid\" , value: \"VALID\", icon: 'assets/images/humanEvaluationValid.png'},\n        {label: \"humanNotEvaluation\" , value: \"NOTEVALUATION\", icon: 'assets/images/humanNotEvaluation.png'},\n        {label: \"humanEvaluationFinish\" , value: \"FINISH\", icon: 'assets/images/humanEvaluationFinish.png'}\n\n    ]\n\n  public infractionTypesNumber =  [\n    {label: this.translateJsonService.getAlarmTypesTranslate(3003), value: 3003, icon: ''},\n    {label: this.translateJsonService.getAlarmTypesTranslate(3004), value: 3004, icon: ''},\n    {label: this.translateJsonService.getAlarmTypesTranslate(3006), value: 3006, icon: ''},\n    {label: this.translateJsonService.getAlarmTypesTranslate(3007), value: 3007, icon: ''},\n    {label: this.translateJsonService.getAlarmTypesTranslate(3009), value: 3009, icon: ''},\n    {label: this.translateJsonService.getAlarmTypesTranslate(3010), value: 3010, icon: ''},\n    {label: this.translateJsonService.getAlarmTypesTranslate(3011), value: 3011, icon: ''},\n    {label: this.translateJsonService.getAlarmTypesTranslate(3012), value: 3012, icon: ''},\n    {label: this.translateJsonService.getAlarmTypesTranslate(3013), value: 3013, icon: ''},\n  ]\n\n  constructor(\n    private configService: ConfigService,\n      private http: Http,\n      private itemsService: ItemsUtilService,\n      private mockService: MockService,\n      private driverService: DriverService,\n      private assetService: AssetService,\n      private translateJsonService: TranslateJsonService,\n      private router: Router\n    )\n  {\n      this._baseUrl = configService.getApiURI();\n  }\n\n  public registerRoadDefendData(data: RoadDefendData): RoadDefendData {\n    this.roadDefendData = data;\n    return this.roadDefendData;\n  }\n\n  public registerRiskRating(riskRatingList : RiskRating[]): RiskRating[] {\n    let riskRatingListSalved = this.roadDefendData.riskRatingList;\n\n    riskRatingList.forEach((rr) => {\n      if(!riskRatingListSalved.includes(rr)){\n        riskRatingListSalved.push(rr);\n      }\n    })\n\n    return riskRatingListSalved;\n  }\n\n  public getRiskRating(): RiskRating[] {\n    return this.roadDefendData.riskRatingList;\n  }\n\n // *****************************************************************\n // alarmes\n public getAlarmsDiff(_alarms: Alarm[]): Alarm[] {\n   let _alarmList: Alarm[] = [];\n    _alarms.forEach((alarm) => {\n        if (!this.roadDefendData.alarmList.find(_alarm_ => _alarm_ && _alarm_.id === alarm.id)) {\n             _alarmList.push(alarm);\n        }\n      });\n   return _alarmList;\n }\n\n  diff(startDate, endDate) {\n  let startDateMoment = moment.utc(startDate);\n  let endDateMoment = moment.utc(endDate);\n  let diffMiliseconds = moment(endDateMoment).diff(startDateMoment);\n  let duration = moment.duration(diffMiliseconds);\n  let hours = Math.floor(duration.asHours());\n  let minutes = moment.utc(diffMiliseconds).format(\"mm\");\n  let seconds = moment.utc(diffMiliseconds).format(\"ss\");\n  return `${hours}h ${minutes}m ${seconds}s`;\n}\n\n  private static readonly MICROSERVICE_GMT3_OFFSET_MS = 3 * 60 * 60 * 1000;\n\n  public undoMicroserviceGmt3(dateString: string): Date {\n    if (!dateString) return null;\n    try {\n      let isoString = dateString.trim();\n      if (!isoString.includes('T')) {\n        isoString = isoString.replace(' ', 'T');\n      }\n      if (!isoString.includes('.')) {\n        isoString = isoString + '.000';\n      }\n      if (!isoString.endsWith('Z') && !isoString.match(/[+-]\\d{2}:\\d{2}$/)) {\n        isoString = isoString + 'Z';\n      }\n      const parsed = new Date(isoString);\n      if (isNaN(parsed.getTime())) return null;\n      return new Date(parsed.getTime() + DataService.MICROSERVICE_GMT3_OFFSET_MS);\n    } catch (e) {\n      console.warn('Erro ao desfazer GMT-3 do microserviço:', dateString, e);\n      return null;\n    }\n  }\n\n  /**\n   * Converte uma data string para Date considerando o timezone do alarme\n   * A Date retornada representa o momento correto, mas quando formatada será exibida no timezone do navegador\n   * @param dateString String da data no formato do backend (ex: \"2026-01-07 07:20:47.000\")\n   * @param timezone Timezone do alarme (ex: \"-02:00\", \"-03:00\", \"UTC\", \"GMT\")\n   * @returns Date que representa o momento correto no tempo\n   */\n  public convertToAlarmTimezone(dateString: string, timezone?: string): Date {\n    if (!dateString) return null;\n    \n    const trimmed = dateString.trim();\n    if (/^\\d+$/.test(trimmed)) {\n      const num = Number(trimmed);\n      const ms = num < 1e12 ? num * 1000 : num;\n      const d = new Date(ms);\n      return isNaN(d.getTime()) ? null : d;\n    }\n    \n    // Normalizar o formato do timezone\n    let normalizedTimezone = timezone ? this.normalizeTimezone(timezone) : \"-03:00\";\n    \n    // Se não conseguiu normalizar, usar o timezone original ou padrão\n    if (!normalizedTimezone || !normalizedTimezone.match(/^[+-]\\d{2}:\\d{2}$/)) {\n      normalizedTimezone = timezone || \"-03:00\";\n    }\n    \n    try {\n      if (trimmed.endsWith('Z') || trimmed.match(/[+-]\\d{2}:?\\d{2}$/)) {\n        const d = new Date(trimmed);\n        return isNaN(d.getTime()) ? null : d;\n      }\n      \n      // Converter formato de data do banco para ISO\n      let isoString = dateString.trim();\n      \n      // Se não tem 'T', adicionar\n      if (!isoString.includes('T')) {\n        isoString = isoString.replace(' ', 'T');\n      }\n      \n      // Garantir que tem milissegundos\n      if (!isoString.includes('.')) {\n        isoString = isoString + '.000';\n      } else {\n        // Verificar se tem 3 dígitos de milissegundos\n        const millisMatch = isoString.match(/\\.(\\d+)/);\n        if (millisMatch) {\n          const millis = millisMatch[1];\n          if (millis.length !== 3) {\n            // Completar ou truncar para 3 dígitos\n            const parts = isoString.split('.');\n            isoString = parts[0] + '.' + millis.padEnd(3, '0').substring(0, 3);\n          }\n        }\n      }\n      \n      // Adicionar o timezone normalizado\n      const dateWithTimezone = isoString + normalizedTimezone;\n      \n      return new Date(dateWithTimezone);\n    } catch (e) {\n      // Em caso de erro, fallback para comportamento padrão\n      console.warn('Erro ao converter timezone:', timezone, 'String:', dateString, e);\n      const fallbackDate = dateString.includes('.') ? dateString : dateString + '.000';\n      return new Date(fallbackDate.replace(' ', 'T') + \"-03:00\");\n    }\n  }\n\n  /**\n   * Converte uma Date do timezone do alarme para o timezone do navegador\n   * @param date Date que representa um momento no timezone do alarme\n   * @param alarmTimezone Timezone do alarme (ex: \"-02:00\", \"-03:00\")\n   * @returns Date ajustada para quando for formatada, mostrar a hora correta no timezone do navegador\n   */\n  public convertFromAlarmTimezoneToBrowser(date: Date, alarmTimezone?: string): Date {\n    if (!date) return null;\n    \n    // Se não há timezone do alarme ou é o mesmo do navegador, retornar sem alteração\n    if (!alarmTimezone || !this.isTimezoneDifferent(alarmTimezone)) {\n      return date;\n    }\n    \n    // Obter offsets em minutos\n    const browserOffset = this.getBrowserTimezoneOffset();\n    const alarmOffset = this.normalizeTimezone(alarmTimezone);\n    \n    const browserMinutes = this.timezoneToMinutes(browserOffset);\n    const alarmMinutes = this.timezoneToMinutes(alarmOffset);\n    \n    // Calcular diferença: se o alarme está em -02:00 e o navegador em -03:00\n    const diffMinutes = browserMinutes - alarmMinutes;\n    \n    // Ajustar a Date: se a hora do alarme é 07:20 em -02:00, queremos mostrar 06:20 em -03:00\n    const adjustedDate = new Date(date.getTime() - (diffMinutes * 60 * 1000));\n    \n    return adjustedDate;\n  }\n\n  /**\n   * Obtém o offset do timezone do navegador em formato ±HH:MM\n   * @returns String no formato \"-03:00\" ou \"+05:30\"\n   */\n  public getBrowserTimezoneOffset(): string {\n    const offset = new Date().getTimezoneOffset();\n    // getTimezoneOffset retorna o offset em minutos, mas com sinal invertido\n    // Se retorna -180 (Brasil), significa UTC-3, então precisamos inverter\n    const offsetHours = Math.floor(Math.abs(offset) / 60);\n    const offsetMinutes = Math.abs(offset) % 60;\n    const sign = offset <= 0 ? '+' : '-'; // Invertido porque getTimezoneOffset é invertido\n    \n    return `${sign}${String(offsetHours).padStart(2, '0')}:${String(offsetMinutes).padStart(2, '0')}`;\n  }\n\n  /**\n   * Compara o timezone do alarme com o timezone do navegador\n   * @param alarmTimezone Timezone do alarme (ex: \"-01:00\", \"UTC\")\n   * @returns true se os timezones forem diferentes\n   */\n  public isTimezoneDifferent(alarmTimezone?: string): boolean {\n    if (!alarmTimezone) return false;\n    \n    const browserOffset = this.getBrowserTimezoneOffset();\n    \n    // Normalizar ambos para comparação\n    const normalizedAlarm = this.normalizeTimezone(alarmTimezone);\n    const normalizedBrowser = this.normalizeTimezone(browserOffset);\n    \n    return normalizedAlarm !== normalizedBrowser;\n  }\n\n  /**\n   * Normaliza um timezone para formato ±HH:MM para comparação\n   * @param timezone Timezone em qualquer formato\n   * @returns Timezone normalizado no formato ±HH:MM\n   */\n  public normalizeTimezone(timezone: string): string {\n    if (!timezone) return null;\n    \n    // Se já está no formato ±HH:MM, retornar\n    if (timezone.match(/^[+-]\\d{2}:\\d{2}$/)) {\n      return timezone;\n    }\n    \n    // Para UTC/GMT\n    if (timezone === \"UTC\" || timezone === \"GMT\" || timezone === \"0\" || timezone === \"UTC+0\" || timezone === \"GMT+0\") {\n      return \"+00:00\";\n    }\n    \n    // Tentar parsear formatos como UTC+3, GMT-5\n    const utcMatch = timezone.match(/(UTC|GMT)([+-])(\\d+)/);\n    if (utcMatch) {\n      const sign = utcMatch[2];\n      const hours = parseInt(utcMatch[3], 10);\n      return `${sign}${String(hours).padStart(2, '0')}:00`;\n    }\n    \n    // Se não conseguir normalizar, retornar original\n    return timezone;\n  }\n\n  /**\n   * Converte uma data para o timezone do navegador e retorna formatada\n   * @param date Data a ser convertida\n   * @param alarmTimezone Timezone do alarme\n   * @returns String formatada no horário local do navegador\n   */\n  public formatDateInBrowserTimezone(date: Date, alarmTimezone?: string): string {\n    if (!date) return null;\n    \n    // Se o timezone do alarme é o mesmo do navegador, retornar formatado normalmente\n    if (!this.isTimezoneDifferent(alarmTimezone)) {\n      return moment(date).format('DD/MM/YYYY HH:mm:ss');\n    }\n    \n    // Converter para o timezone do navegador\n    // A data já está no timezone do alarme, então precisamos ajustar\n    const browserOffset = this.getBrowserTimezoneOffset();\n    const alarmOffset = this.normalizeTimezone(alarmTimezone);\n    \n    // Calcular diferença em minutos\n    const browserMinutes = this.timezoneToMinutes(browserOffset);\n    const alarmMinutes = this.timezoneToMinutes(alarmOffset);\n    const diffMinutes = browserMinutes - alarmMinutes;\n    \n    const adjustedDate = new Date(date.getTime() + (diffMinutes * 60 * 1000));\n    \n    return moment(adjustedDate).format('DD/MM/YYYY HH:mm:ss');\n  }\n\n  public formatBackendFormattedDate(formattedStr: string, useComma?: boolean): string {\n    if (!formattedStr || typeof formattedStr !== 'string') return null;\n    const trimmed = formattedStr.trim();\n    const parts = trimmed.split(/\\s+/);\n    if (parts.length < 2) return trimmed;\n    const sep = useComma ? ', ' : ' ';\n\n    if (parts.length >= 3) {\n      const offsetPart = parts[2];\n      const offsetNormalized = (offsetPart === '+0' || offsetPart === '-0') ? (offsetPart + '0:00') : offsetPart;\n      const isoStr = parts[0] + 'T' + parts[1] + (offsetNormalized.startsWith('+') || offsetNormalized.startsWith('-') ? offsetNormalized : '');\n      const date = new Date(isoStr);\n      if (!isNaN(date.getTime())) return moment(date).format(useComma ? 'DD/MM/YYYY, HH:mm:ss' : 'DD/MM/YYYY HH:mm:ss');\n    }\n\n    const [y, m, d] = parts[0].split('-');\n    const timePart = parts[1];\n    const [h, min, sWithMs] = timePart.split(':');\n    const s = sWithMs ? sWithMs.split('.')[0] : '00';\n    if (!d || !m || !y) return trimmed;\n    return `${d}/${m}/${y}${sep}${h}:${min}:${s}`;\n  }\n\n  public getAlarmDisplayDatetime(alarm: any, useComma?: boolean): string {\n    if (!alarm) return null;\n    const formatted = alarm.datetimestampFormatted != null ? alarm.datetimestampFormatted : alarm['datetimestamp_formatted'];\n    if (formatted) return this.formatBackendFormattedDate(formatted, useComma);\n    const dt = alarm.datetime;\n    if (!dt) return null;\n    return moment(dt).format(useComma ? 'DD/MM/YYYY, HH:mm:ss' : 'DD/MM/YYYY HH:mm:ss');\n  }\n\n  public formatRawDateTimeForTooltip(rawValue: string | Date): string {\n    if (rawValue == null) return null;\n    let str: string = typeof rawValue === 'string' ? rawValue.trim() : (rawValue instanceof Date ? rawValue.toISOString() : String(rawValue));\n    str = str.replace('T', ' ').replace(/Z$/i, '').replace(/\\s+[+-]\\d{2}:?\\d{2}$/, '').trim();\n    const dateTimeMatch = str.match(/^(\\d{4})-(\\d{2})-(\\d{2})\\s+(\\d{2}):(\\d{2}):(\\d{2})(?:\\.(\\d+))?/);\n    if (dateTimeMatch) {\n      const [, y, m, d, h, min, s, ms] = dateTimeMatch;\n      return ms != null ? `${d}/${m}/${y} ${h}:${min}:${s}.${ms.padStart(3, '0').slice(0, 3)}` : `${d}/${m}/${y} ${h}:${min}:${s}`;\n    }\n    return null;\n  }\n\n  /**\n   * Formata uma data no timezone do alarme (hora original do banco)\n   * @param date Data que representa o momento correto\n   * @param alarmTimezone Timezone do alarme\n   * @returns String formatada no timezone do alarme\n   */\n  public formatDateInAlarmTimezone(date: Date, alarmTimezone?: string): string {\n    if (!date) return null;\n    \n    if (!alarmTimezone) {\n      return moment(date).format('DD/MM/YYYY HH:mm:ss');\n    }\n    \n    // Converter o timezone para minutos de offset\n    const offsetMinutes = this.timezoneToMinutes(this.normalizeTimezone(alarmTimezone));\n    \n    // Usar utcOffset do moment para formatar no timezone do alarme\n    return moment(date).utcOffset(offsetMinutes).format('DD/MM/YYYY HH:mm:ss');\n  }\n\n  /**\n   * Converte um timezone no formato ±HH:MM para minutos de offset\n   * @param timezone Timezone no formato ±HH:MM\n   * @returns Offset em minutos\n   */\n  private timezoneToMinutes(timezone: string): number {\n    if (!timezone) return 0;\n    \n    const match = timezone.match(/^([+-])(\\d{2}):(\\d{2})$/);\n    if (match) {\n      const sign = match[1];\n      const hours = parseInt(match[2], 10);\n      const minutes = parseInt(match[3], 10);\n      const totalMinutes = (hours * 60) + minutes;\n      return sign === '+' ? totalMinutes : -totalMinutes;\n    }\n    \n    return 0;\n  }\n\n  private parseTimestampToDate(value: string): Date | null {\n    if (!value || typeof value !== 'string') return null;\n    const trimmed = value.trim();\n    const match = trimmed.match(/^(\\d{4}-\\d{2}-\\d{2})\\s+(\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?)\\s+([+-])(\\d{2})(\\d{2})$/);\n    if (!match) return null;\n    const [, datePart, timePart, sign, hh, mm] = match;\n    const isoString = `${datePart}T${timePart}${sign}${hh}:${mm}`;\n    const d = new Date(isoString);\n    return isNaN(d.getTime()) ? null : d;\n  }\n\n  public registerAlarms(_alarmsAndInfractions: any) {\n    if (_alarmsAndInfractions.alarmList) {\n      _alarmsAndInfractions.alarmList.forEach((alarm) => {\n        const datetimestamp = alarm.datetimestamp != null ? alarm.datetimestamp : alarm['datetimestamp'];\n        const availableMediaAtTimestamp = alarm.availableMediaAtTimestamp != null ? alarm.availableMediaAtTimestamp : alarm['available_media_at_timestamp'];\n\n        if (datetimestamp) {\n          const datetimeDate = this.parseTimestampToDate(datetimestamp);\n          if (datetimeDate) alarm.datetime = datetimeDate;\n        } else if (alarm.datetime) {\n          alarm.datetime = this.convertToAlarmTimezone(alarm.datetime, alarm.timeZone);\n        }\n\n        if (availableMediaAtTimestamp) {\n          const availableMediaAtDate = this.parseTimestampToDate(availableMediaAtTimestamp);\n          if (availableMediaAtDate) alarm.availableMediaAt = availableMediaAtDate;\n        } else if (alarm.availableMediaAt) {\n          alarm.availableMediaAt = this.convertToAlarmTimezone(alarm.availableMediaAt, alarm.timeZone);\n        }\n\n        const dateNow = new Date();\n        const dateAlarm = new Date(alarm.datetime);\n        const availableMediaAt = new Date(alarm.availableMediaAt ? alarm.availableMediaAt : alarm.insertDate);\n        const dateTreat = new Date(alarm.auditCreate_date);\n        const read = this.diff(availableMediaAt, dateNow);\n        const delay = (this.diff(dateAlarm, availableMediaAt)).includes('-') ? \"0h 00m 00s\" : this.diff(dateAlarm, availableMediaAt);\n        const timeToTreat = this.diff(availableMediaAt, dateTreat);\n  \n        alarm.delayDate = delay;\n        alarm.timeRead = read;\n        alarm.auditCreate_date ? alarm.timeToTreat = timeToTreat : alarm.timeToTreat = null;\n  \n          if (!this.roadDefendData.alarmList.find(_alarm_ => _alarm_ && _alarm_.id === alarm.id)) {\n            this.roadDefendData.alarmList.push(alarm);\n          }\n      });\n\n      // sort data\n      _alarmsAndInfractions.alarmList.sort((e1,e2)=>{if (e1.datetime < e2.datetime) return 1; else if (e1.datetime > e2.datetime) return -1; else return 0});\n  \n      this.roadDefendData.filteredAlarmList = _alarmsAndInfractions.alarmList;\n    } \n\n    if (_alarmsAndInfractions.infractionInformationList) {\n\n      this.roadDefendData.infractionList = _alarmsAndInfractions.infractionInformationList;\n      this.roadDefendData.filteredInfractionList = _alarmsAndInfractions.infractionInformationList;\n    }\n\n    return this.roadDefendData.alarmList;\n  }\n\n  public setReadFilteredAlarmList(alarmId: number) {\n    this.roadDefendData.filteredAlarmList.map((alarm: Alarm)=>{\n      if (alarm.id === alarmId) {\n        alarm.alarmRead = true;\n      }\n    });\n  }\n\n  public setFilteredAlarmList(filteredAlarmList: Alarm[]) {\n    return this.roadDefendData.filteredAlarmList = filteredAlarmList ;\n  }\n\n  public getFilteredAlarmList(): Alarm[] {\n    return this.roadDefendData.filteredAlarmList;\n  }\n\n  public getFilteredAlarmDtoList(): AlarmDto[] {\n\n    return this.roadDefendData.filteredAlarmList.map(\n      (alarm: Alarm) => <AlarmDto>this.convertAlarmToAlarmDto(alarm)\n    );\n  }\n\n  public getFilteredInfractionsDtoList():InfractionDto[] {\n    return this.roadDefendData.filteredInfractionList.map(\n      (infraction: Infraction) => <InfractionDto>this.convertInfractionDto(infraction)\n    )\n  }\n\n  public getFilteredAlarmDtoListByDriverAndType(driverId: number, typeAlarm: number): AlarmDto[] {\n    let _listFiltered: AlarmDto[] = this.getFilteredAlarmDtoList();\n    return _listFiltered.filter((alarm: AlarmDto)=>{\n        return alarm.driverId == driverId && alarm.typeAlarm == typeAlarm;\n    });\n  }\n\n  public getFilteredAlarmDtoListByDriver(driverId: number): AlarmDto[] {\n    let _listFiltered: AlarmDto[] = this.getFilteredAlarmDtoList();\n    return _listFiltered.filter((alarm: AlarmDto)=>{\n      return alarm.driverId == driverId;\n  });\n  }\n\n  public getFilteredAlarmDtoListByType(type:number): AlarmDto[] {\n    let _listFiltered: AlarmDto[] = this.getFilteredAlarmDtoList();\n    return _listFiltered.filter((alarm: AlarmDto)=>{\n        return alarm.typeAlarm == type;\n    });\n  }\n\n  public getFilteredAlarmDtoCategoryByDriverType(type:number): AlarmDto[] {\n      let _result : AlarmDto[] = new Array<AlarmDto>()\n      ,  _