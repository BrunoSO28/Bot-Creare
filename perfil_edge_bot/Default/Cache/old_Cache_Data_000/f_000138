;\n    return this.http.put<Alarm>(this.baseUrl + '/api/todos/' + alarmData.id, {  \n      headers: headers\n    }).pipe(catchError(this.handleError)); \n  }\n\n  public novaRevisaoAuditoria(auditId: number, obs: string, aproved: boolean) {\n    let _ws = this.configService.webServices['novaRevisao'];\n    \n    return this.http.post(_ws.url(this.baseUrl), { auditId, statusId: (aproved) ? 3 : 4, obs }, { headers: this.getHttpHeaders() })\n    .pipe(catchError(this.handleError));\n  }\n\n  public deleteImgSignature(signatureId: number) {\n    let _ws = this.configService.webServices['deleteImgSignature'];\n    \n    return this.http.delete(_ws.url(this.baseUrl)+`/v2/audit/driver-signature/${signatureId}`, { headers: this.getHttpHeaders() })\n    .pipe(catchError(this.handleError));\n  }\n\n  public updateReadByCustomer(alarmId: number) {\n    let _ws = this.configService.webServices['readByCustomer'];\n    return this.http.patch(_ws.url(this.baseUrl, alarmId), {}, { headers: this.getHttpHeaders() })\n    .pipe(catchError(this.handleError));\n  }\n\n  public buscaRevisoesByAlarm(alarmId: number){\n    let _ws = this.configService.webServices['buscaRevisoesAuditoria'];\n    \n    return this.http.get(_ws.url(this.baseUrl, alarmId), { headers: this.getHttpHeaders() })\n    .pipe(catchError(this.handleError));\n  }\n\n  public getAuditHistories(alarmId: number): Observable<any> {\n    let webService = this.configService.webServices['getAlarmAuditHistories'];\n\n    let url = webService.url(this.baseUrl, alarmId)\n    let requestConfig = { headers: this.getHttpHeaders() }\n\n    return this.http.get(url, requestConfig).pipe(\n      catchError(this.handleError)\n    );\n  }\n\n  public getAlarmsAuditHistories(alarmsIds: number[]): Observable<any> {\n    let webService = this.configService.webServices['getAlarmsAuditHistories'];\n\n    let url = webService.url(this.baseUrl)\n    let requestConfig = { headers: this.getHttpHeaders() }\n\n    return this.http.post(url, alarmsIds, requestConfig).pipe(\n      catchError(this.handleError)\n    );\n  }\n\n  public getHistoryByImeiAndReferenceDate(imei: String, vehicleId: number, referenceDate: String ): Observable<any> {\n    let webService = this.configService.webServicesV2['getHistoryByImeiAndReferenceDate'];\n\n    let url = webService.url(this.baseUrl, imei, vehicleId, referenceDate );\n    let requestConfig = { headers: this.getHttpHeaders() }\n\n    return this.http.get(url, requestConfig).pipe(\n        catchError(this.handleError)\n    );\n  }\n\n\n  public getEmailLog(alarmId: number): Observable<any> {\n    let webService = this.configService.webServices['getEmailLog'];\n    let url = webService.url(this.baseUrl, alarmId)\n    let requestConfig = { headers: this.getHttpHeaders() }\n\n    return this.http.get(url, requestConfig).pipe(\n      catchError(this.handleError)\n    );\n  }\n\n  public getAlarmByEmail(emailLogId: number) {\n    let webService = this.configService.webServices['getAlarmByEmail'];\n    let url = webService.url(this.baseUrl, emailLogId)\n    let requestConfig = { headers: this.getHttpHeaders() }\n\n    return this.http.get<any>(url, requestConfig).pipe(\n      catchError(this.handleError)\n    );\n  }\n\n  private handleError(error: any) {\n    let errMsg = (error.message) ? error.message : error.status ? `${error.status} - ${error.statusText}` : 'Server error';\n    console.error('Erro:', error);\n    return observableThrowError(errMsg);\n  }\n\n  getHttpHeaders() : HttpHeaders {\n    const token = this.auth.getToken();\n    let headers = new HttpHeaders({\n      'Content-Type': 'application/json',\n      'Authorization': token || ''\n    });\n\n    return headers;\n  }\n\n  public countAuditGroupDisk(filter: DefaultFilter): Observable<any> {\n    let _ws = this.configService.webServices['countAuditGroupDisk'];\n\n    return this.http.post(_ws.url(this.baseUrl), filter).pipe(catchError(this.handleError))\n  }\n\n  public getLastAlarm(imeis: string[]): Promise<any[]> {\n    return new Promise((resolve, reject) => {\n      let _ws = this.configService.webServices['lastAlarm'];\n      \n      this.http.post(_ws.url(this.baseUrl), imeis, { headers: this.getHttpHeaders() })\n      .pipe(catchError(this.handleError))\n    })\n  }\n  \n  public getLastValidAlarm(imeis: string[]): Promise<any[]> {\n    return new Promise((resolve, reject) => {\n      let _ws = this.configService.webServices['lastValidAlarm'];\n      \n      this.http.post<any[]>(_ws.url(this.baseUrl), imeis, { headers: this.getHttpHeaders() }).subscribe(res => resolve(res), err => reject(err))\n    })\n  }\n  \n  public getUpdatedAlarmsDataAfterCompletion(auditIds: number[]): Promise<Alarm[]> {\n    const _ws = this.configService.webServices['updatedAlarmsByAuditId'];\n    const url = _ws.url(this.baseUrl);\n    const headers = { headers: this.getHttpHeaders() };\n\n    return this.http\n      .post<Alarm[]>(url, auditIds, headers)\n      .toPromise()\n      .catch(err => Promise.reject(err));\n  }\n\n  public getDataForChartLastVelocitiesAndAlarms(vehicleId: number, driverId: number, startDate: Date, endDate: Date): Observable<any> {\n    let webService = this.configService.webServices['getDataForChartLastVelocitiesAndAlarms'];\n    let url = webService.url(this.baseUrl, vehicleId, driverId, startDate, endDate)\n    let requestConfig = { headers: this.getHttpHeaders() }\n\n    return this.http.get(url, requestConfig).pipe(\n      catchError(this.handleError)\n    );\n  }\n\n  public getAlarmsTypeByCustomerId(customerId: number) {\n    let webService = this.configService.webServices['getAlarmsTypeByCustomerId'];\n    let url = webService.url(this.baseUrl, customerId)\n    let requestConfig = { headers: this.getHttpHeaders() }\n\n    return this.http.get(url.toString(), requestConfig).pipe(\n      catchError(this.handleError)\n    );\n  }\n\n  public setAlarmReadByCustomer(alarmId: number, userId: number): Observable<any> {\n    const data = { userId, alarmId }\n    const _ws = this.configService.webServices['setAlarmReadByCustomer'];\n    const url = _ws.url(this.baseUrl)\n\n    return this.http.patch(url, data, { headers: this.getHttpHeaders() })\n    .pipe(\n      catchError(this.handleError)\n    )\n  }\n\n  emailsLogsObservable() {\n    return this.emailsLogs.asObservable();\n  }\n\n  public getLinkedAlarms(alarmIdList: number[]):Observable<LinkedAlarms[]>{\n    if(alarmIdList.length==0)return from([]);\n    const _ws = this.configService.webServices['getLinkedAlarms'];\n    const url = _ws.url(this.baseUrl, alarmIdList)\n\n    return this.http.get<LinkedAlarms[]>(url, { headers: this.getHttpHeaders() }).pipe(\n      map((res) => {\n        let linkedAlarms =  res\n        linkedAlarms.forEach((linkedAlarm) => {\n          const indexOfAlarmType = this.dataService.alarmTypesNumber.findIndex(type => type.value == linkedAlarm.linkedAlarm.typeAlarm)\n          if (indexOfAlarmType != -1) {\n            const alarmType = this.dataService.alarmTypesNumber[indexOfAlarmType];\n            linkedAlarm.linkedAlarm.typeAlarmDescription = alarmType.label\n            linkedAlarm.linkedAlarm.iconPath = alarmType.icon;\n          }\n          if(linkedAlarm.linkedAlarm.urlPictures[0]=='NO_PICTURE'){\n            linkedAlarm.linkedAlarm.picture='NO_PICTURE';\n          }\n        })\n        return linkedAlarms;\n      }),\n      catchError(this.handleError)\n    )\n  }\n\n  public getAiAlarmValidationsByAlarmIds(alarmIds: number[]): Observable<AiAlarmValidation[]> {\n    const _ws = this.configService.webServicesV2['getAiAlarmValidationsByAlarmIds'];\n    const url = _ws.url(this.baseUrl, alarmIds)\n\n    return this.http.get<AiAlarmValidation[]>(url, { headers: this.getHttpHeaders() }).pipe(\n      catchError(this.handleError)\n    )\n  }\n}\n","/**\n * Reviewed By Rafael\n * 03-12-18\n */\nimport {Injectable} from '@angular/core';\nimport {Observable, throwError as observableThrowError} from 'rxjs';\nimport {catchError, map} from 'rxjs/operators';\n\nimport {SelectItem} from 'primeng/primeng';\n\nimport {HttpClient, HttpErrorResponse, HttpHeaders} from '@angular/common/http';\nimport {AuthenticationService} from 'app/pages/login/authentication.service';\nimport {ConfigService} from '../config/config.service';\nimport {EquipamentType} from '../enum/equipament.type.enum';\nimport {CustomerEmail} from '../interfaces/customerEmail';\nimport {PaginatedAssetResponse} from '../interfaces/paginatedAssetResponse';\nimport {Asset, Equipament} from '../models';\nimport {IntegrationDevice} from '../models/integrationDevice.entity';\nimport {TreeInputModel} from '../models/treeInputModel.entity';\nimport {EquipamentFeatures} from '../enum/equipament-features.enum';\n\n\n@Injectable()\nexport class AssetService {\n  private baseUrl;\n\n  constructor(\n    private http: HttpClient,     \n    private configService: ConfigService,\n    protected auth: AuthenticationService\n  ) { \n    this.baseUrl = configService.getApiURI();\n  }\n\n  /**\n   * Busca Assets por Lista de IDs\n   * @param assetsIds Asset IDs\n   */\n  public getAssetsByIds(assetsIds: number[]): Observable<IntegrationDevice[]> {\n    let _ws = this.configService.webServices['assetsByIds'];\n\n    return this.http.get<IntegrationDevice[]>(_ws.url(this.baseUrl, assetsIds.join(',')), {headers: this.getHttpHeaders()})\n    .pipe(catchError(this.handleError));\n  }\n\n  /**\n   * Busca Assets por Filiais e Tipo\n   * @param customerChildsId Lista de Filiais\n   * @param assetType Tipo de Asset\n   */\n  public getAssetsByManyCustomerChildAndAssetType(customerChildsId : number[], assetType : number, filterInactive?: boolean, filterWithoutEquipment?: boolean, vehicleTypeIdList?: number[], filterVehicleWithAlarm?: boolean): Observable<Asset[]> {\n    let _ws = this.configService.webServices['getAssetsByManyCustomerChildAndAssetType'];\n\n    type Body = {\n      assetType: number\n      customerChildIdList: number[]\n      filterInactive?: boolean\n      filterWithoutEquipment?: boolean\n      vehicleTypeIdList?: number[]\n      filterVehicleWithAlarm?: boolean\n    }\n\n    let body: Body = {\n      assetType: assetType,\n      customerChildIdList: customerChildsId,\n      vehicleTypeIdList: vehicleTypeIdList,\n    }\n    \n    if(filterInactive) body.filterInactive = filterInactive\n    if(filterWithoutEquipment) body.filterWithoutEquipment = filterWithoutEquipment\n    if(vehicleTypeIdList) body.vehicleTypeIdList = vehicleTypeIdList\n    if(filterVehicleWithAlarm) body.filterVehicleWithAlarm = filterVehicleWithAlarm\n\n    return this.http.post<Asset[]>(_ws.url(this.baseUrl),  body, {headers: this.getHttpHeaders()})\n    .pipe(catchError(this.handleError));\n  }\n\n  public getRecursiveAssetListFromCustomerChildId(customerChildId: number, assetType: number): Observable<Asset[]> {\n    let _ws = this.configService.webServices['getRecursiveAssetListFromCustomerChildId'];\n\n    return this.http.get<Asset[]>(_ws.url(this.baseUrl, customerChildId, assetType), {headers: this.getHttpHeaders()})\n    .pipe(catchError(this.handleError))\n  }\n\n  public getAssetListByCustomerChildCustomerProfile(customerChildId: number, assetType: number): Observable<Asset[]> {\n    let _ws = this.configService.webServices['getAssetListByCustomerChildCustomerProfile'];\n\n    return this.http.get<Asset[]>(_ws.url(this.baseUrl, customerChildId, assetType), {headers: this.getHttpHeaders()})\n    .pipe(catchError(this.handleError))\n  }\n\n  public getPaginatedAssetListByCustomer(customerChildId: number, assetType: number, currentPage?: number, name?: string): Observable<PaginatedAssetResponse> {\n    let _ws = this.configService.webServices['getPaginatedAssetListByCustomer'];\n\n    return this.http.get<PaginatedAssetResponse>(_ws.url(this.baseUrl, customerChildId, assetType, currentPage, name), {headers: this.getHttpHeaders()})\n    .pipe(catchError(this.handleError))\n  }\n\n\n  \n\n  public getAssetsByCustomerChildAndAssetType(customerChildsId : number, assetType : number): Observable<Asset[]> {\n    let _ws = this.configService.webServices['assetsByCustomerIdAndType'];\n\n    return this.http.get<Asset[]>(_ws.url(this.baseUrl,  customerChildsId, assetType), {headers: this.getHttpHeaders()})\n    .pipe(catchError(this.handleError));\n  }\n\n  public checkOnlineStatusByCustomersChildAndAssetType(customersChildId : number[], assetType : number, equipamentFeatures?: EquipamentFeatures[]): Observable<Asset[]> {\n    let _ws = this.configService.webServicesV2['checkOnlineStatusByCustomersChildAndAssetType'];\n\n    return this.http.get<Asset[]>(_ws.url(this.baseUrl,  customersChildId, assetType, equipamentFeatures), {headers: this.getHttpHeaders()})\n    .pipe(catchError(this.handleError));\n  }\n\n  public getVehiclesWithTypesByCustomerChildIds(customerChildIdList: number[], vehicleTypeIdList: number[]) {\n    let _ws = this.configService.webServicesV2['getVehiclesWithTypesByCustomerChildIds']\n    return this.http.get(_ws.url(this.baseUrl, customerChildIdList, vehicleTypeIdList), {headers: this.getHttpHeaders()})\n    .pipe(catchError(this.handleError))\n  }\n\n  public checkOnlineStatusByAssetId(assetId: number, imei: string): Observable<Asset> {\n    let _ws = this.configService.webServicesV2['checkOnlineStatusByAssetId'];\n\n    return this.http.get<Asset[]>(_ws.url(this.baseUrl, assetId, imei), { headers: this.getHttpHeaders() }).pipe(\n      map((res) => {\n        const assetList= res;\n        return assetList.find((device) => imei === device.imei)\n      }),\n      catchError(this.handleError),);\n  }\n\n  /**\n   * Converte Lista de Assets no Formato Tree\n   * @param assets Assets\n   */\n  public convertAssetToTreeInputModel(assets: Asset[]) {\n    let result: TreeInputModel[] = [];\n    \n    assets.forEach((asset : Asset) => {\n      result.push({id: asset.id, name: asset.name + ' - ' + asset.identification, parentId: null, online: false, imei: asset.imei, equipmentType: asset.equipmentType, vehicleTypeId: asset.vehicleTypeId, status: asset.status });\n    })\n    \n    return result;\n  }\n\n  public convertAssetToTreeInputModelPlayback(assets: Asset[]) {\n    let result: TreeInputModel[] = [];\n    \n    assets.forEach((asset : Asset) => {\n      result.push({id: asset.id, name: asset.name + ' - ' + asset.identification + this.getEquipmentType(asset.equipmentType), parentId: null, online: false, imei: asset.imei, equipmentType: asset.equipmentType });\n    })\n    \n    return result;\n  }\n\n  private getEquipmentType(equipmentTypeId: any): string {\n    let equipmentTypeDescription: string = \"\";\n\n    if (equipmentTypeId === EquipamentType.JIMI) {\n      equipmentTypeDescription = \" (G5)\";\n    } else if (equipmentTypeId === EquipamentType.STONKAM) {\n      equipmentTypeDescription = \" (K1)\";\n    } else if (equipmentTypeId === EquipamentType.STONKAM_K1_PLUS) {\n      equipmentTypeDescription = \" (K1 PLUS)\";\n    } else if (equipmentTypeId === EquipamentType.STONKAM_K4) {\n      equipmentTypeDescription = \" (K4)\";\n    } else if (equipmentTypeId === EquipamentType.JIMI_JC400AD_ID) {\n      equipmentTypeDescription = \" (G5 PLUS ID)\";\n    } else if (equipmentTypeId === EquipamentType.JIMI_JC400D_R) {\n      equipmentTypeDescription = \" (G5 Plus R)\";\n    } else {\n      equipmentTypeDescription = \"\";\n    }\n\n    return equipmentTypeDescription;\n  }\n\n  public convertEquipmentToTreeInputModel(equipments: Equipament[]) {\n    let result: TreeInputModel[] = [];\n\n    equipments.forEach((equipment: Equipament) => {\n      result.push({id: equipment.id, name: equipment.identification, parentId: null, label: this.getAssetName(equipment.asset)});\n    });\n\n    return result;\n  }\n\n  getAssetName(assetName: string): string{\n    if(assetName === null){\n      return null;\n    }\n    let nameSplited :string[] = assetName.split(\" - \");\n    return nameSplited[1];\n  }\n\n  public syncDrivers(customersChild: number): Observable<Asset[]> {\n    let _ws = this.configService.webServices['syncDriver'];\n\n    return this.http.get<Asset[]>(_ws.url(this.baseUrl,  customersChild), {headers: this.getHttpHeaders()})\n    .pipe(catchError(this.handleSyncError));\n  }\n\n  public getAssetsIdByCustomerChildAndEquipmentType(customersChildId: number[], equipmentType: number[]): Observable<{ id: number, assetType: number }[]> {\n    let _ws = this.configService.webServices['assetsIdByCustomersChildAndEquipType'];\n\n    return this.http.post<{ id: number, assetType: number }[]>(_ws.url(this.baseUrl, equipmentType), { custIds: customersChildId }, {headers: this.getHttpHeaders()})\n    .pipe(catchError(this.handleError));\n  }\n\n  public getEmailListByAssetId(assetId: number): Observable<CustomerEmail>{\n    let _ws = this.configService.webServices['getEmailListByAssetId']\n    return this.http.get<CustomerEmail>(_ws.url(this.baseUrl, assetId), {headers: this.getHttpHeaders()})\n    .pipe(catchError(this.handleError))\n  }\n\n  public syncVehicle(customersChild: number): Observable<Asset[]> {\n    let _ws = this.configService.webServices['syncVehicle'];\n\n    return this.http.get<Asset[]>(_ws.url(this.baseUrl,  customersChild), {headers: this.getHttpHeaders()})\n    .pipe(catchError(this.handleSyncError));\n  }\n\n  public saveNewAsset(asset : Asset): Observable<any> {\n    let _ws = this.configService.webServices['saveAsset'];\n\n    let string = {      \n      \"customerChildId\": asset.customerChildId,\n      \"customerId\": asset.customerId,\n      \"identification\": asset.identification,\n      \"name\": asset.name,\n      \"status\": asset.status,\n      \"assetType\": asset.assetType\n    }\n\n    return this.http.post(_ws.url(this.baseUrl), string, {headers: this.getHttpHeaders()}).pipe(catchError(this.handleError)\n    )\n  }\n\n  /**\n   * Converte Lista de Assets no Formato Select Item Menu\n   * @param _assets Assets\n   */\n  public getAssetsSelectItem(_assets: Asset[]): SelectItem[]